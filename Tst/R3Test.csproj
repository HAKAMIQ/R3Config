    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>R3Test</AssemblyName>
    <RootNamespace>R3Config.Tests</RootNamespace>
    <Version>0.1.0-preview</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\App\R3App.csproj" />
    <ProjectReference Include="..\Core\R3Core.csproj" />
    <ProjectReference Include="..\Script\ArtImport\R3ArtImport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\Official\patch.yml" CopyToOutputDirectory="PreserveNewest" />
