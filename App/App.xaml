<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:markup="clr-namespace:System.Windows.Markup;assembly=PresentationCore" xmlns:svc="clr-namespace:R3Config.Svc" x:Class="R3Config.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Thm/Colors.xaml"/>
                <ResourceDictionary Source="Thm/Type.xaml"/>
                <ResourceDictionary Source="Thm/Ctrl.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <svc:ContentTextFlowConverter x:Key="ContentTextFlowConverter"/>
            <svc:ContentTextLanguageConverter x:Key="ContentTextLanguageConverter"/>
            <FlowDirection x:Key="App.FlowDirection">RightToLeft</FlowDirection>
            <FlowDirection x:Key="App.CaptionButtonsFlowDirection">RightToLeft</FlowDirection>
            <FlowDirection x:Key="App.ShellFlowDirection">RightToLeft</FlowDirection>
            <FlowDirection x:Key="App.TextFlowDirection">RightToLeft</FlowDirection>
            <FlowDirection x:Key="App.TechnicalFlowDirection">LeftToRight</FlowDirection>
            <TextAlignment x:Key="App.DefaultTextAlignment">Left</TextAlignment>
            <TextAlignment x:Key="App.TextAlignment">Left</TextAlignment>
            <TextAlignment x:Key="App.TechnicalTextAlignment">Left</TextAlignment>
            <TextAlignment x:Key="Options.SettingsTextAlignment">Left</TextAlignment>
            <HorizontalAlignment x:Key="App.HorizontalAlignment">Right</HorizontalAlignment>
            <HorizontalAlignment x:Key="App.TrailingHorizontalAlignment">Left</HorizontalAlignment>
            <Thickness x:Key="App.After6Margin">6,0,0,0</Thickness>
            <Thickness x:Key="App.After8Margin">8,0,0,0</Thickness>
            <Thickness x:Key="App.After10Margin">10,0,0,0</Thickness>
            <Thickness x:Key="App.After12Margin">12,0,0,0</Thickness>
            <Thickness x:Key="App.Before8Margin">0,0,8,0</Thickness>
            <Thickness x:Key="App.Before10Margin">0,0,10,0</Thickness>
            <Thickness x:Key="App.Indent24Margin">0,6,24,0</Thickness>
            <Thickness x:Key="App.ScrollPadding4">4,0,0,0</Thickness>
            <markup:XmlLanguage x:Key="App.XmlLanguage">ar-SA</markup:XmlLanguage>
            <FlowDirection x:Key="TechnicalText.FlowDirection">LeftToRight</FlowDirection>
            <TextAlignment x:Key="TechnicalText.TextAlignment">Left</TextAlignment>
            <HorizontalAlignment x:Key="TechnicalText.HorizontalAlignment">Left</HorizontalAlignment>
            <markup:XmlLanguage x:Key="TechnicalText.Language">en-US</markup:XmlLanguage>
            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Body}">
                <Setter Property="TextAlignment" Value="{DynamicResource App.DefaultTextAlignment}"/>
                <Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}"/>
                <Setter Property="Language" Value="{DynamicResource App.XmlLanguage}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
            <Style x:Key="TechnicalTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Technical}">
                <Setter Property="FlowDirection" Value="{DynamicResource TechnicalText.FlowDirection}"/>
                <Setter Property="Language" Value="{DynamicResource TechnicalText.Language}"/>
                <Setter Property="TextAlignment" Value="{DynamicResource TechnicalText.TextAlignment}"/>
                <Setter Property="HorizontalAlignment" Value="{DynamicResource TechnicalText.HorizontalAlignment}"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
