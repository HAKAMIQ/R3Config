<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:R3Config.Lang"
        x:Class="R3Config.View.Dlg.AppDlg"
        Title="R3Config"
        Width="440"
        MinWidth="380"
        MaxWidth="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="{DynamicResource Type.Font.Body}"
        Foreground="{DynamicResource Text.Primary}"
        Language="{DynamicResource App.XmlLanguage}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FlowDirection="{DynamicResource App.FlowDirection}">

    <Window.Resources>
        <Style x:Key="AppDlgLocalizedTitleText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource FluentDialog.Title}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
        </Style>

        <Style x:Key="AppDlgLocalizedMessageText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource FluentDialog.Message}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
        </Style>

        <Style x:Key="AppDlgSecondaryActionButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FluentButton.Secondary}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="MinWidth"
                    Value="96" />
            <Setter Property="Height"
                    Value="32" />
            <Setter Property="MinHeight"
                    Value="32" />
            <Setter Property="Padding"
                    Value="12,4" />
            <Setter Property="Margin"
                    Value="4,0" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextBlock.TextAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="AppDlgPrimaryActionButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FluentButton.Primary}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="MinWidth"
                    Value="96" />
            <Setter Property="Height"
                    Value="32" />
            <Setter Property="MinHeight"
                    Value="32" />
            <Setter Property="Padding"
                    Value="12,4" />
            <Setter Property="Margin"
                    Value="4,0" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextBlock.TextAlignment"
                    Value="Center" />
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource FluentSurface.Dialog}"
            CornerRadius="{StaticResource Radius.None}">

        <Grid ClipToBounds="True"
              Language="{DynamicResource App.XmlLanguage}"
              KeyboardNavigation.TabNavigation="Cycle">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="CntGrid"
                  Grid.Row="0"
                  Margin="24"
                  Style="{StaticResource FluentDialog.Flow}"
                  FlowDirection="{Binding FlowDirection,
                                          RelativeSource={RelativeSource AncestorType={x:Type Window}}}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBdg"
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        CornerRadius="{StaticResource Radius.Circle.32}"
                        BorderThickness="1"
                        VerticalAlignment="Top">

                    <TextBlock x:Name="IconText"
                               FlowDirection="LeftToRight"
                               Language="{DynamicResource TechnicalText.Language}"
                               TextAlignment="{DynamicResource TechnicalText.TextAlignment}"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Stretch">

                    <TextBlock x:Name="TitlTxt"
                               Style="{StaticResource AppDlgLocalizedTitleText}"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="MsgText"
                               Style="{StaticResource AppDlgLocalizedMessageText}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource R3DialogActionBar}"
                    CornerRadius="{StaticResource Radius.None}"
                    FlowDirection="LeftToRight">

                <StackPanel x:Name="Btns"
                            Style="{StaticResource FluentDialog.Buttons}"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FlowDirection="LeftToRight">

                    <Button x:Name="AltBtn"
                            Style="{StaticResource AppDlgSecondaryActionButton}"
                            Click="AltClick" />

                    <Button x:Name="MainBtn"
                            Style="{StaticResource AppDlgPrimaryActionButton}"
                            Click="MainClk" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>