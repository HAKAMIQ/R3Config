<Window x:Class="R3Config.View.Dlg.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:R3Config.Lang"
        Title="R3Config"
        Width="440"
        SizeToContent="Height"
        MinWidth="380"
        MaxWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{StaticResource TextPrimaryBrush}"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}"
        Tag="{x:Static lang:UiText.IsRtl}">
    <Window.Resources>
        <Style x:Key="AppDialogRootFlow"
               TargetType="{x:Type FrameworkElement}">
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                    <Setter Property="FlowDirection" Value="RightToLeft" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AppDialogTitleText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource R3SettingsTitleText}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                    <Setter Property="TextAlignment" Value="Right" />
                    <Setter Property="FlowDirection" Value="RightToLeft" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AppDialogMessageText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource R3SettingsDescriptionText}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                    <Setter Property="TextAlignment" Value="Right" />
                    <Setter Property="FlowDirection" Value="RightToLeft" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AppDialogButtonPanel"
               TargetType="{x:Type StackPanel}">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="FlowDirection" Value="RightToLeft" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource R3WindowRootFrame}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="ContentGrid"
                  Grid.Row="0"
                  Margin="16"
                  Style="{StaticResource AppDialogRootFlow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBadge"
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        CornerRadius="14"
                        BorderThickness="1"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0">
                    <TextBlock x:Name="IconText"
                               FlowDirection="LeftToRight"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Stretch">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource AppDialogTitleText}" />

                    <TextBlock x:Name="MessageText"
                               Style="{StaticResource AppDialogMessageText}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource R3DialogActionBar}"
                    CornerRadius="0,0,14,14">
                <StackPanel x:Name="ButtonPanel"
                            Style="{StaticResource AppDialogButtonPanel}">
                    <Button x:Name="SecondaryButton"
                            MinWidth="92"
                            Margin="4,0"
                            Click="SecondaryButton_Click" />
                    <Button x:Name="PrimaryButton"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="92"
                            Margin="4,0"
                            Click="PrimaryButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>