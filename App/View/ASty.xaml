<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lang="clr-namespace:R3Config.Lang">

    <Style x:Key="AdvLocalizedTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource R3SettingsTitleText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
    </Style>

    <Style x:Key="AdvLocalizedRowTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource R3SettingsRowTitleText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
    </Style>

    <Style x:Key="AdvLocalizedDescriptionText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource R3SettingsRowDescriptionText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
    </Style>

    <Style x:Key="AdvLocalizedLabelText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource LabelText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
    </Style>

    <Style x:Key="AdvLocalizedEmptyStateText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource ArabicEmptyStateText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
    </Style>

    <Style x:Key="AdvLocalizedDataGridHeader"
           TargetType="{x:Type DataGridColumnHeader}"
           BasedOn="{StaticResource DataGridHeaderUi}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="HorizontalContentAlignment"
                Value="{DynamicResource App.HorizontalAlignment}" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="MinHeight"
                Value="32" />
        <Setter Property="Padding"
                Value="8,0" />
        <Setter Property="TextBlock.TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
    </Style>

    <Style x:Key="AdvStandardActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButton.Secondary}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="MinWidth"
                Value="96" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="MinHeight"
                Value="32" />
        <Setter Property="Padding"
                Value="12,4" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextBlock.TextAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="AdvDangerActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButton.Danger}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="MinWidth"
                Value="96" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="MinHeight"
                Value="32" />
        <Setter Property="Padding"
                Value="12,4" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextBlock.TextAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="AdvCompactActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButton.Compact}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="MinWidth"
                Value="64" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="MinHeight"
                Value="32" />
        <Setter Property="Padding"
                Value="12,4" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextBlock.TextAlignment"
                Value="Center" />
    </Style>

</ResourceDictionary>