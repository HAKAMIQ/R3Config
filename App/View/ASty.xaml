<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lang="clr-namespace:R3Config.Lang"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="AdvLocalizedTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource R3SettingsTitleText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="AdvLocalizedRowTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource R3SettingsRowTitleText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="AdvLocalizedDescriptionText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource R3SettingsRowDescriptionText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="AdvLocalizedLabelText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource LabelText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="AdvLocalizedEmptyStateText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource ArabicEmptyStateText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="AdvLocalizedDataGridHeader"
           TargetType="{x:Type DataGridColumnHeader}"
           BasedOn="{StaticResource DataGridHeaderUi}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="HorizontalContentAlignment"
                Value="{DynamicResource App.HorizontalAlignment}" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Height"
                Value="{StaticResource DataGrid.HeaderHeight}" />
        <Setter Property="MinHeight"
                Value="{StaticResource DataGrid.HeaderHeight}" />
        <Setter Property="Padding"
                Value="8,0" />
        <Setter Property="TextBlock.TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
    </Style>

    <Style x:Key="AdvStandardActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButton.Secondary}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="MinWidth"
                Value="{StaticResource Button.MinWidth.Standard}" />
        <Setter Property="Height"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="MinHeight"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="Padding"
                Value="{StaticResource Button.Padding.Standard}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextBlock.TextAlignment"
                Value="Center" />
    </Style>

    <!-- Inline Fluent MessageBar equivalent: it takes layout space next to
         the surface it describes and never floats over other content. The
         intent (Info by default) is text + glyph + color, never color alone. -->
    <Style x:Key="AdvInlineNotice"
           TargetType="{x:Type Border}">
        <Setter Property="Background"
                Value="{DynamicResource Status.InfoSurface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Stroke.Subtle}" />
        <Setter Property="BorderThickness"
                Value="{StaticResource Stroke.Thickness.Default}" />
        <Setter Property="CornerRadius"
                Value="{StaticResource Radius.Medium}" />
        <Setter Property="Padding"
                Value="12,8" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
    </Style>

    <!-- Readable width of a single-line field and its action: the column
         fills narrower surfaces and stops growing on wide ones. -->
    <sys:Double x:Key="AdvField.MaxWidth">480</sys:Double>

    <Style x:Key="AdvDangerActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButton.Danger}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="MinWidth"
                Value="{StaticResource Button.MinWidth.Standard}" />
        <Setter Property="Height"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="MinHeight"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="Padding"
                Value="{StaticResource Button.Padding.Standard}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextBlock.TextAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="AdvCompactActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButton.Compact}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="MinWidth"
                Value="{StaticResource Button.MinWidth.Compact}" />
        <Setter Property="Height"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="MinHeight"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="Padding"
                Value="{StaticResource Button.Padding.Standard}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextBlock.TextAlignment"
                Value="Center" />
    </Style>

</ResourceDictionary>