<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lang="clr-namespace:R3Config.Lang">

    <Style x:Key="HCanSavedLocalizedTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource R3SettingsTitleText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="HCanSavedLocalizedDescriptionText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource SectionCaptionText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="HCanSavedLocalizedPatchNameText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource SectionTitleText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="HCanSavedTechnicalHashText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Technical}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource TechnicalText.FlowDirection}" />
        <Setter Property="Language"
                Value="{DynamicResource TechnicalText.Language}" />
        <Setter Property="NumberSubstitution.Substitution"
                Value="European" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource TechnicalText.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
        <Setter Property="ToolTip"
                Value="{Binding Text,
                                RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style x:Key="HCanSavedLocalizedEmptyText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource SectionCaptionText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="HCanSavedPrimaryActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButton.Primary}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="MinWidth"
                Value="{StaticResource Button.MinWidth.Standard}" />
        <Setter Property="Height"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="MinHeight"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="Padding"
                Value="{StaticResource Button.Padding.Standard}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextBlock.TextAlignment"
                Value="Center" />
    </Style>

</ResourceDictionary>