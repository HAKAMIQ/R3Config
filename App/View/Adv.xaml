<Window x:Class="R3Config.View.AdvancedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{lang:Text Key=Adv.Title}"
        Width="860"
        Height="560"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}">

        <shell:WindowChrome.WindowChrome>
            <shell:WindowChrome CaptionHeight="40"
                                ResizeBorderThickness="6"
                                CornerRadius="0"
                                GlassFrameThickness="0"
                                UseAeroCaptionButtons="False" />
        </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource R3WindowRootFrame}">
        <Grid ClipToBounds="True"
              FlowDirection="{DynamicResource App.FlowDirection}"
              Language="{DynamicResource App.XmlLanguage}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{lang:Text Key=Adv.Title}"
                                   Style="{StaticResource R3SettingsTitleText}" />

                        <TextBlock Margin="0,4,0,0"
                                   Text="{lang:Text Key=Adv.Description}"
                                   Style="{StaticResource R3SettingsDescriptionText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                FlowDirection="LeftToRight"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource HeaderCloseButton}"
                                ToolTip="{lang:Text Key=Window.CloseTip}"
                                Click="CloseButton_Click">
                            <Grid Width="14" Height="14">
                                <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1"
                        Margin="14"
                        Style="{StaticResource R3SettingsSideNavTabControl}"
                        ItemContainerStyle="{StaticResource R3SettingsSideNavTabItem}"
                        FlowDirection="{DynamicResource App.FlowDirection}"
                        Language="{DynamicResource App.XmlLanguage}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{lang:Text Key=Adv.Recovery}"
                                   Style="{StaticResource R3SideNavHeaderText}" />
                    </TabItem.Header>

                    <Grid Style="{StaticResource R3SettingsPageRoot}">
                        <Grid Margin="14"
                              FlowDirection="{DynamicResource App.FlowDirection}"
                              Language="{DynamicResource App.XmlLanguage}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Style="{StaticResource R3SettingsSection}"
                                    Padding="14"
                                    Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{lang:Text Key=Adv.RecoveryTitle}"
                                                   Style="{StaticResource R3SettingsRowTitleText}" />
                                        <TextBlock Text="{Binding BackupsStatus}"
                                                   Style="{StaticResource R3SettingsRowDescriptionText}" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="{lang:Text Key=Adv.RestoreSelected}"
                                            MinWidth="150"
                                            VerticalAlignment="Center"
                                            ToolTip="{lang:Text Key=Adv.RestoreTip}"
                                            Command="{Binding RestoreBackupCommand}" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <DataGrid ItemsSource="{Binding Advanced.Backups}"
                                          SelectedItem="{Binding Advanced.SelectedBackup, Mode=TwoWay}"
                                          IsReadOnly="True"
                                          AutoGenerateColumns="False"
                                          CanUserResizeColumns="True"
                                          EnableColumnVirtualization="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          FlowDirection="{DynamicResource App.FlowDirection}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          ToolTip="{lang:Text Key=Adv.BackupsTip}">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Advanced.IsBackupsEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{lang:Text Key=Adv.Date}"
                                                            HeaderStyle="{StaticResource DataGridHeaderUi}"
                                                            Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                            Width="160"
                                                            MinWidth="140"
                                                            ElementStyle="{StaticResource DataGridCellTextLeft}" />

                                        <DataGridTextColumn Header="{lang:Text Key=Adv.Files}"
                                                            HeaderStyle="{StaticResource DataGridHeaderUi}"
                                                            Binding="{Binding Files.Count}"
                                                            Width="80"
                                                            MinWidth="70"
                                                            ElementStyle="{StaticResource DataGridCellTextCenter}" />

                                        <DataGridTextColumn Header="{lang:Text Key=Adv.Folder}"
                                                            HeaderStyle="{StaticResource DataGridHeaderUi}"
                                                            Binding="{Binding DirectoryPath}"
                                                            Width="*"
                                                            MinWidth="260"
                                                            ElementStyle="{StaticResource TechText}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Style="{StaticResource EmptyStatePanel}"
                                        Visibility="{Binding Advanced.IsBackupsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Advanced.EmptyBackupsText}"
                                               Style="{StaticResource ArabicEmptyStateText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FlowDirection="{DynamicResource App.FlowDirection}"
                                               TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Margin="0,6,0,-6">
                    <TabItem.Header>
                        <TextBlock Text="{lang:Text Key=Adv.Diagnostics}"
                                   Style="{StaticResource R3SideNavHeaderText}" />
                    </TabItem.Header>

                    <Grid Style="{StaticResource R3SettingsPageRoot}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="14"
                                        FlowDirection="{DynamicResource App.FlowDirection}"
                                        Language="{DynamicResource App.XmlLanguage}">

                                <Border Style="{StaticResource R3SettingsSection}"
                                        Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{lang:Text Key=Adv.Rpcs3Connection}"
                                                   Style="{StaticResource R3SettingsRowTitleText}" />

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{lang:Text Key=Adv.ConfigPath}"
                                                       Style="{StaticResource LabelText}"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="2"
                                                    Style="{StaticResource R3ValuePill}"
                                                    MaxWidth="900">
                                                <TextBlock Text="{Binding Advanced.ConfigPath}"
                                                           Style="{StaticResource R3TechnicalValueText}" />
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{lang:Text Key=Adv.PatchesPath}"
                                                       Style="{StaticResource LabelText}"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="2"
                                                    Style="{StaticResource R3ValuePill}"
                                                    MaxWidth="900">
                                                <TextBlock Text="{Binding Advanced.PatchesPath}"
                                                           Style="{StaticResource R3TechnicalValueText}" />
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{lang:Text Key=Adv.TargetCfg}"
                                                       Style="{StaticResource LabelText}"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="2"
                                                    Style="{StaticResource R3ValuePill}"
                                                    MaxWidth="900">
                                                <TextBlock Text="{Binding Advanced.TargetConfigPath}"
                                                           Style="{StaticResource R3TechnicalValueText}" />
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{lang:Text Key=Adv.CatVersion}"
                                                       Style="{StaticResource LabelText}"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="2"
                                                    Style="{StaticResource R3ValuePill}"
                                                    MaxWidth="280">
                                                <TextBlock Text="{Binding Advanced.CatalogVersion}"
                                                           Style="{StaticResource R3TechnicalValueText}" />
                                            </Border>

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding RecommendationsStatus}"
                                                       Style="{StaticResource R3SettingsRowDescriptionText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource R3SettingsSection}"
                                        Padding="14"
                                        Margin="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="120" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{lang:Text Key=Adv.SessionLog}"
                                                   Style="{StaticResource R3SettingsRowTitleText}" />

                                        <Border Grid.Row="2"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10">
                                            <TextBox Text="{Binding Advanced.LogText, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     VerticalContentAlignment="Top"
                                                     TextWrapping="NoWrap"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     VerticalScrollBarVisibility="Auto"
                                                     FlowDirection="LeftToRight"
                                                     TextAlignment="Left"
                                                     FontFamily="Consolas, Cascadia Mono, Segoe UI Mono"
                                                     FontSize="12"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Border>

                                        <Button Grid.Row="4"
                                                Content="{lang:Text Key=Adv.CopyLog}"
                                                MinWidth="120"
                                                HorizontalAlignment="{DynamicResource App.HorizontalAlignment}"
                                                ToolTip="{lang:Text Key=Adv.CopyLogTip}"
                                                Command="{Binding CopyLogCommand}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2"
                    Style="{StaticResource R3DialogActionBar}"
                    CornerRadius="0,0,14,14">
                <Button Content="{lang:Text Key=Adv.Close}"
                        Width="110"
                        HorizontalAlignment="{DynamicResource App.HorizontalAlignment}"
                        IsCancel="True" />
            </Border>
        </Grid>
    </Border>
</Window>
