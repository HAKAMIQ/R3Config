<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:controls="clr-namespace:R3Config.Ctrl"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:R3Config.View"
        x:Class="R3Config.View.AdvDlg"
        Title="{lang:TextExt Key=Adv.Title}"
        Width="960"
        Height="640"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Type.Font.Body}"
        Language="{DynamicResource App.XmlLanguage}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FlowDirection="{DynamicResource App.FlowDirection}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ASty.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource FluentSurface.Dialog}"
            CornerRadius="{StaticResource Radius.None}">

        <Grid ClipToBounds="True"
              Language="{DynamicResource App.XmlLanguage}"
              KeyboardNavigation.TabNavigation="Cycle"
              RenderTransformOrigin="0.5,0.5">

            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    Padding="0"
                    CornerRadius="{StaticResource Radius.None}"
                    MouseLeftButtonDown="DragWin">

                <Grid Height="32"
                      FlowDirection="LeftToRight"
                      ClipToBounds="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            AutomationProperties.Name="{lang:TextExt Key=Window.CloseTip}"
                            ToolTip="{lang:TextExt Key=Window.CloseTip}"
                            Click="CloseWin"
                            Width="46"
                            Height="32"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            TextBlock.TextAlignment="Center">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource FluentButton.Close.Caption}">
                                <Setter Property="Height"
                                        Value="32" />
                                <Setter Property="MinHeight"
                                        Value="32" />
                            </Style>
                        </Button.Style>

                        <Grid Width="16"
                              Height="16"
                              FlowDirection="LeftToRight"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">

                            <TextBlock Text=""
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="10"
                                       Foreground="{Binding Foreground,
                                                            RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       FlowDirection="LeftToRight"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType" />
                        </Grid>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="{lang:TextExt Key=Adv.Title}"
                               Style="{StaticResource AdvLocalizedTitleText}"
                               FlowDirection="{DynamicResource App.TextFlowDirection}"
                               Language="{DynamicResource App.XmlLanguage}"
                               Margin="0,0,14,0"
                               HorizontalAlignment="{DynamicResource App.HorizontalAlignment}"
                               VerticalAlignment="Center"
                               TextAlignment="{DynamicResource App.TextAlignment}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="16"
                  FlowDirection="{DynamicResource App.FlowDirection}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource FluentSurface.Subtle}"
                        Padding="8"
                        VerticalAlignment="Stretch">

                    <ListBox x:Name="AdvancedNavigation"
                             SelectedIndex="0"
                             SelectionChanged="AdvancedNavigationChanged"
                             AutomationProperties.Name="{lang:TextExt Key=Adv.Title}"
                             FlowDirection="{DynamicResource App.FlowDirection}"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Stretch"
                             VerticalAlignment="Top"
                             Language="{DynamicResource App.XmlLanguage}">

                        <ListBoxItem MinHeight="32"
                                     FlowDirection="{DynamicResource App.FlowDirection}"
                                     HorizontalContentAlignment="Stretch"
                                     VerticalContentAlignment="Center">

                            <TextBlock Text="{lang:TextExt Key=HCanary.Title}"
                                       Style="{StaticResource AdvLocalizedRowTitleText}"
                                       TextTrimming="CharacterEllipsis" />
                        </ListBoxItem>

                        <ListBoxItem MinHeight="32"
                                     FlowDirection="{DynamicResource App.FlowDirection}"
                                     HorizontalContentAlignment="Stretch"
                                     VerticalContentAlignment="Center">

                            <TextBlock Text="{lang:TextExt Key=Adv.Recovery}"
                                       Style="{StaticResource AdvLocalizedRowTitleText}"
                                       TextTrimming="CharacterEllipsis" />
                        </ListBoxItem>

                        <ListBoxItem MinHeight="32"
                                     FlowDirection="{DynamicResource App.FlowDirection}"
                                     HorizontalContentAlignment="Stretch"
                                     VerticalContentAlignment="Center">

                            <TextBlock Text="{lang:TextExt Key=Adv.Diagnostics}"
                                       Style="{StaticResource AdvLocalizedRowTitleText}"
                                       TextTrimming="CharacterEllipsis" />
                        </ListBoxItem>
                    </ListBox>
                </Border>

                <Grid x:Name="AdvancedContentHost"
                      Grid.Column="2"
                      FlowDirection="{DynamicResource App.FlowDirection}">

                    <controls:HCanView x:Name="HCanaryWorkspace"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       FlowDirection="{Binding FlowDirection,
                                                               RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       Language="{DynamicResource App.XmlLanguage}"
                                       Loaded="HCanaryWorkspace_Loaded" />

                    <local:ARecView x:Name="RecoveryWorkspace"
                                    Visibility="Collapsed" />

                    <local:ADiagView x:Name="DiagnosticsWorkspace"
                                     Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>