<Window x:Class="R3Config.View.AdvDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:controls="clr-namespace:R3Config.Ctrl"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{lang:TextExt Key=Adv.Title}"
        Width="780"
        Height="420"
        MinWidth="600"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Type.Font.Body}"
        Language="{DynamicResource App.XmlLanguage}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FlowDirection="{DynamicResource App.FlowDirection}">

    <Window.Resources>
        <Style x:Key="AdvLocalizedTitleText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource R3SettingsTitleText}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
        </Style>

        <Style x:Key="AdvLocalizedRowTitleText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource R3SettingsRowTitleText}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
        </Style>

        <Style x:Key="AdvLocalizedDescriptionText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource R3SettingsRowDescriptionText}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
        </Style>

        <Style x:Key="AdvLocalizedLabelText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource LabelText}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
        </Style>

        <Style x:Key="AdvLocalizedEmptyStateText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource ArabicEmptyStateText}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource FluentSurface.Dialog}">
        <Grid ClipToBounds="True"
              Language="{DynamicResource App.XmlLanguage}"
              KeyboardNavigation.TabNavigation="Cycle">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    MouseLeftButtonDown="DragWin">

                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource FluentButton.Close}"
                            AutomationProperties.Name="{lang:TextExt Key=Window.CloseTip}"
                            ToolTip="{lang:TextExt Key=Window.CloseTip}"
                            Click="CloseWin"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <Grid Width="14"
                              Height="14"
                              FlowDirection="LeftToRight">

                            <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                                  Stroke="{Binding Foreground,
                                                   RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="{lang:TextExt Key=Adv.Title}"
                               Style="{StaticResource AdvLocalizedTitleText}"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="12"
                  FlowDirection="{DynamicResource App.FlowDirection}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource FluentSurface.Subtle}"
                        Padding="8"
                        VerticalAlignment="Stretch">

                    <ListBox x:Name="AdvancedNavigation"
                             SelectedIndex="0"
                             SelectionChanged="AdvancedNavigationChanged"
                             AutomationProperties.Name="{lang:TextExt Key=Adv.Title}"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Stretch"
                             VerticalAlignment="Top"
                             Language="{DynamicResource App.XmlLanguage}">

                        <ListBoxItem HorizontalContentAlignment="Stretch">
                            <TextBlock Text="{lang:TextExt Key=HCanary.Title}"
                                       Style="{StaticResource AdvLocalizedRowTitleText}"
                                       TextTrimming="CharacterEllipsis" />
                        </ListBoxItem>

                        <ListBoxItem HorizontalContentAlignment="Stretch">
                            <TextBlock Text="{lang:TextExt Key=Adv.Recovery}"
                                       Style="{StaticResource AdvLocalizedRowTitleText}"
                                       TextTrimming="CharacterEllipsis" />
                        </ListBoxItem>

                        <ListBoxItem HorizontalContentAlignment="Stretch">
                            <TextBlock Text="{lang:TextExt Key=Adv.Diagnostics}"
                                       Style="{StaticResource AdvLocalizedRowTitleText}"
                                       TextTrimming="CharacterEllipsis" />
                        </ListBoxItem>
                    </ListBox>
                </Border>

                <Grid x:Name="AdvancedContentHost"
                      Grid.Column="2">

                    <controls:HCanView x:Name="HCanaryWorkspace"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       FlowDirection="{Binding FlowDirection,
                                                               RelativeSource={RelativeSource AncestorType=Window}}"
                                       Language="{DynamicResource App.XmlLanguage}"
                                       Loaded="HCanaryWorkspace_Loaded" />

                    <Grid x:Name="RecoveryWorkspace"
                          Visibility="Collapsed"
                          Language="{DynamicResource App.XmlLanguage}">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource R3SettingsSection}"
                                Margin="0"
                                Padding="12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           MinWidth="0"
                                           Text="{Binding BkpStat}"
                                           Style="{StaticResource AdvLocalizedDescriptionText}"
                                           Margin="0"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="2"
                                        Content="{lang:TextExt Key=Adv.RestoreSelected}"
                                        VerticalAlignment="Center"
                                        ToolTip="{lang:TextExt Key=Adv.RestoreTip}"
                                        Command="{Binding RstCmd}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <DataGrid ItemsSource="{Binding Advanced.Backups}"
                                      SelectedItem="{Binding Advanced.SelBkp, Mode=TwoWay}"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      CanUserResizeColumns="True"
                                      EnableColumnVirtualization="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      Language="{DynamicResource App.XmlLanguage}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ToolTip="{lang:TextExt Key=Adv.BackupsTip}">

                                <DataGrid.Style>
                                    <Style TargetType="{x:Type DataGrid}"
                                           BasedOn="{StaticResource FluentDataGrid}">

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Advanced.BkpEmpty}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{lang:TextExt Key=Adv.Date}"
                                                        HeaderStyle="{StaticResource DataGridHeaderUi}"
                                                        Binding="{Binding MadeAt,
                                                                          StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                        Width="Auto"
                                                        MinWidth="140"
                                                        MaxWidth="170"
                                                        ElementStyle="{StaticResource DataGridCellTextLeft}" />

                                    <DataGridTextColumn Header="{lang:TextExt Key=Adv.Files}"
                                                        HeaderStyle="{StaticResource DataGridHeaderUi}"
                                                        Binding="{Binding Files.Count}"
                                                        Width="Auto"
                                                        MinWidth="70"
                                                        MaxWidth="90"
                                                        ElementStyle="{StaticResource DataGridCellTextLeft}" />

                                    <DataGridTextColumn Header="{lang:TextExt Key=Adv.Folder}"
                                                        HeaderStyle="{StaticResource DataGridHeaderUi}"
                                                        Binding="{Binding DirPath}"
                                                        Width="*"
                                                        MinWidth="240"
                                                        ElementStyle="{StaticResource DataGridCellPathText}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Style="{StaticResource EmptyStatePanel}"
                                    Visibility="{Binding Advanced.BkpEmpty,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">

                                <TextBlock Text="{Binding Advanced.BkpText}"
                                           Style="{StaticResource AdvLocalizedEmptyStateText}"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="DiagnosticsWorkspace"
                          Visibility="Collapsed"
                          Grid.IsSharedSizeScope="True"
                          Language="{DynamicResource App.XmlLanguage}">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource R3SettingsSection}"
                                Margin="0"
                                Padding="12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"
                                                      MaxWidth="160"
                                                      SharedSizeGroup="DiagnosticsLabel" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.ColumnSpan="3"
                                           Text="{lang:TextExt Key=Adv.Rpcs3Connection}"
                                           Style="{StaticResource AdvLocalizedRowTitleText}" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="{lang:TextExt Key=Adv.ConfigPath}"
                                           Style="{StaticResource AdvLocalizedLabelText}"
                                           VerticalAlignment="Center" />

                                <Border Grid.Row="2"
                                        Grid.Column="2"
                                        Style="{StaticResource R3ValuePill}">

                                    <TextBlock Text="{Binding Advanced.CfgPath}"
                                               Style="{StaticResource R3TechnicalValueText}"
                                               FlowDirection="LeftToRight"
                                               TextAlignment="Left"
                                               Language="en-US" />
                                </Border>

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Text="{lang:TextExt Key=Adv.PatchesPath}"
                                           Style="{StaticResource AdvLocalizedLabelText}"
                                           VerticalAlignment="Center" />

                                <Border Grid.Row="4"
                                        Grid.Column="2"
                                        Style="{StaticResource R3ValuePill}">

                                    <TextBlock Text="{Binding Advanced.PatPath}"
                                               Style="{StaticResource R3TechnicalValueText}"
                                               FlowDirection="LeftToRight"
                                               TextAlignment="Left"
                                               Language="en-US" />
                                </Border>

                                <TextBlock Grid.Row="6"
                                           Grid.Column="0"
                                           Text="{lang:TextExt Key=Adv.TargetCfg}"
                                           Style="{StaticResource AdvLocalizedLabelText}"
                                           VerticalAlignment="Center" />

                                <Border Grid.Row="6"
                                        Grid.Column="2"
                                        Style="{StaticResource R3ValuePill}">

                                    <TextBlock Text="{Binding Advanced.TgtCfg}"
                                               Style="{StaticResource R3TechnicalValueText}"
                                               FlowDirection="LeftToRight"
                                               TextAlignment="Left"
                                               Language="en-US" />
                                </Border>

                                <TextBlock Grid.Row="8"
                                           Grid.Column="0"
                                           Text="{lang:TextExt Key=Adv.CatVersion}"
                                           Style="{StaticResource AdvLocalizedLabelText}"
                                           VerticalAlignment="Top" />

                                <StackPanel Grid.Row="8"
                                            Grid.Column="2"
                                            MinWidth="0">

                                    <Border Style="{StaticResource R3ValuePill}">
                                        <TextBlock Text="{Binding Advanced.CatVer}"
                                                   Style="{StaticResource R3TechnicalValueText}"
                                                   FlowDirection="LeftToRight"
                                                   TextAlignment="Left"
                                                   Language="en-US" />
                                    </Border>

                                    <TextBlock Text="{Binding RecStat}"
                                               Style="{StaticResource AdvLocalizedDescriptionText}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Style="{StaticResource R3SettingsSection}"
                                Margin="0"
                                Padding="12">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{lang:TextExt Key=Adv.SessionLog}"
                                           Style="{StaticResource AdvLocalizedRowTitleText}" />

                                <TextBox Grid.Row="2"
                                         Text="{Binding Advanced.LogText, Mode=OneWay}"
                                         Style="{StaticResource TechnicalTextBox}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"
                                         FlowDirection="LeftToRight"
                                         TextAlignment="Left"
                                         Language="en-US"
                                         FontFamily="Cascadia Mono, Consolas, Segoe UI Mono"
                                         FontSize="12" />

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="{lang:TextExt Key=Adv.CopyLog}"
                                            Style="{StaticResource FluentButton.Compact}"
                                            ToolTip="{lang:TextExt Key=Adv.CopyLogTip}"
                                            Command="{Binding CopyCmd}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>