<Window x:Class="R3Config.View.AdvDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:R3Config.Ctrl"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{lang:TextExt Key=Adv.Title}"
        Width="1120"
        Height="700"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}">

	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>

	<Border Style="{StaticResource R3WindowRootFrame}">
		<Grid ClipToBounds="True"
              FlowDirection="{DynamicResource App.FlowDirection}"
              Language="{DynamicResource App.XmlLanguage}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    MouseLeftButtonDown="DragWin">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0"
                                MinWidth="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
						<TextBlock Text="{lang:TextExt Key=Adv.Title}"
                                   Style="{StaticResource R3SettingsTitleText}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />

						<TextBlock Margin="0,4,0,0"
                                   Text="{lang:TextExt Key=Adv.Description}"
                                   Style="{StaticResource R3SettingsDescriptionText}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTip="{lang:TextExt Key=Adv.Description}" />
					</StackPanel>

					<Button Grid.Column="1"
                            Style="{StaticResource HeaderCloseButton}"
                            ToolTip="{lang:TextExt Key=Window.CloseTip}"
                            Click="CloseWin"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
						<Grid Width="14"
                              Height="14">
							<Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
						</Grid>
					</Button>
				</Grid>
			</Border>

			<TabControl Grid.Row="1"
                        Margin="12,10,12,12"
                        Style="{StaticResource PremiumTopTabControl}"
                        ItemContainerStyle="{StaticResource PremiumTopTabItem}"
                        FlowDirection="{DynamicResource App.FlowDirection}"
                        Language="{DynamicResource App.XmlLanguage}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

				<TabItem Header="{lang:TextExt Key=Adv.PatchDevelopment}">
					<ScrollViewer VerticalScrollBarVisibility="Auto"
					              HorizontalScrollBarVisibility="Disabled">
						<StackPanel FlowDirection="{DynamicResource App.FlowDirection}"
						            Language="{DynamicResource App.XmlLanguage}">
							<Border Style="{StaticResource R3SettingsSection}"
							        Margin="0"
							        Padding="12">
								<StackPanel>
									<TextBlock Text="{lang:TextExt Key=Adv.PatchDev.IntroTitle}"
									           Style="{StaticResource R3SettingsRowTitleText}" />
									<TextBlock Text="{lang:TextExt Key=Adv.PatchDev.Intro}"
									           Style="{StaticResource R3SettingsRowDescriptionText}"
									           TextWrapping="Wrap"
									           Margin="0,6,0,0" />
								</StackPanel>
							</Border>

							<Border Style="{StaticResource R3SettingsSection}"
							        Margin="0,8,0,0"
							        Padding="12">
								<StackPanel>
									<TextBlock Text="{lang:TextExt Key=Adv.PatchDev.SourcesTitle}"
									           Style="{StaticResource R3SettingsRowTitleText}" />
									<TextBlock Text="{lang:TextExt Key=Adv.PatchDev.Sources}"
									           Style="{StaticResource R3SettingsRowDescriptionText}"
									           TextWrapping="Wrap"
									           Margin="0,6,0,0" />
								</StackPanel>
							</Border>

							<Border Style="{StaticResource R3SettingsSection}"
							        Margin="0,8,0,0"
							        Padding="12">
								<StackPanel>
									<TextBlock Text="{lang:TextExt Key=Adv.PatchDev.MatchTitle}"
									           Style="{StaticResource R3SettingsRowTitleText}" />
									<TextBlock Text="{lang:TextExt Key=Adv.PatchDev.Match}"
									           Style="{StaticResource R3SettingsRowDescriptionText}"
									           TextWrapping="Wrap"
									           Margin="0,6,0,0" />
								</StackPanel>
							</Border>

							<Border Style="{StaticResource R3SettingsSection}"
							        Margin="0,8,0,0"
							        Padding="12">
								<StackPanel>
									<TextBlock Text="{lang:TextExt Key=Adv.PatchDev.TemplateTitle}"
									           Style="{StaticResource R3SettingsRowTitleText}" />
									<TextBox Text="{lang:TextExt Key=Adv.PatchDev.Template}"
									         IsReadOnly="True"
									         AcceptsReturn="True"
									         TextWrapping="NoWrap"
									         HorizontalScrollBarVisibility="Auto"
									         VerticalScrollBarVisibility="Auto"
									         FlowDirection="LeftToRight"
									         TextAlignment="Left"
									         FontFamily="Consolas, Cascadia Mono, Segoe UI Mono"
									         MinHeight="210"
									         Margin="0,8,0,0" />
								</StackPanel>
							</Border>

							<Border Style="{StaticResource R3SettingsSection}"
							        Margin="0,8,0,0"
							        Padding="12">
								<StackPanel>
									<TextBlock Text="{lang:TextExt Key=Adv.PatchDev.WorkflowTitle}"
									           Style="{StaticResource R3SettingsRowTitleText}" />
									<TextBlock Text="{lang:TextExt Key=Adv.PatchDev.Workflow}"
									           Style="{StaticResource R3SettingsRowDescriptionText}"
									           TextWrapping="Wrap"
									           Margin="0,6,0,0" />
								</StackPanel>
							</Border>

							<Border Style="{StaticResource R3SettingsSection}"
							        Margin="0,8,0,0"
							        Padding="12">
								<StackPanel>
									<TextBlock Text="{lang:TextExt Key=Adv.PatchDev.SafetyTitle}"
									           Style="{StaticResource R3SettingsRowTitleText}" />
									<TextBlock Text="{lang:TextExt Key=Adv.PatchDev.Safety}"
									           Style="{StaticResource R3SettingsRowDescriptionText}"
									           TextWrapping="Wrap"
									           Margin="0,6,0,0" />
								</StackPanel>
							</Border>
						</StackPanel>
					</ScrollViewer>
				</TabItem>

				<TabItem Header="{lang:TextExt Key=HCanary.Title}">
					<controls:HCanView HorizontalAlignment="Stretch"
					                      VerticalAlignment="Stretch" />
				</TabItem>

				<TabItem>
					<TabItem.Header>
						<TextBlock Text="{lang:TextExt Key=Adv.Recovery}" />
					</TabItem.Header>

					<Grid FlowDirection="{DynamicResource App.FlowDirection}"
                          Language="{DynamicResource App.XmlLanguage}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="8" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<Border Grid.Row="0"
                                Style="{StaticResource R3SettingsSection}"
                                Margin="0"
                                Padding="10">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="8" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<TextBlock Grid.Row="0"
                                           MinWidth="0"
                                           Text="{Binding BkpStat}"
                                           Style="{StaticResource R3SettingsRowDescriptionText}"
                                           Margin="0"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />

								<Button Grid.Row="2"
                                        Content="{lang:TextExt Key=Adv.RestoreSelected}"
                                        MinWidth="120"
                                        Margin="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        ToolTip="{lang:TextExt Key=Adv.RestoreTip}"
                                        Command="{Binding RstCmd}" />
							</Grid>
						</Border>

						<Grid Grid.Row="2">
							<DataGrid ItemsSource="{Binding Advanced.Backups}"
                                      SelectedItem="{Binding Advanced.SelBkp, Mode=TwoWay}"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      CanUserResizeColumns="True"
                                      EnableColumnVirtualization="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      FlowDirection="LeftToRight"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ToolTip="{lang:TextExt Key=Adv.BackupsTip}">
								<DataGrid.Style>
									<Style TargetType="DataGrid"
                                           BasedOn="{StaticResource {x:Type DataGrid}}">
										<Style.Triggers>
											<DataTrigger Binding="{Binding Advanced.BkpEmpty}"
                                                         Value="True">
												<Setter Property="Visibility"
                                                        Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</DataGrid.Style>

								<DataGrid.Columns>
									<DataGridTextColumn Header="{lang:TextExt Key=Adv.Date}"
                                                        HeaderStyle="{StaticResource DataGridHeaderUi}"
                                                        Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                        Width="Auto"
                                                        MinWidth="140"
                                                        MaxWidth="170"
                                                        ElementStyle="{StaticResource DataGridCellTextLeft}" />

									<DataGridTextColumn Header="{lang:TextExt Key=Adv.Files}"
                                                        HeaderStyle="{StaticResource DataGridHeaderUi}"
                                                        Binding="{Binding Files.Count}"
                                                        Width="Auto"
                                                        MinWidth="70"
                                                        MaxWidth="90"
                                                        ElementStyle="{StaticResource DataGridCellTextLeft}" />

									<DataGridTextColumn Header="{lang:TextExt Key=Adv.Folder}"
                                                        HeaderStyle="{StaticResource DataGridHeaderUi}"
                                                        Binding="{Binding DirectoryPath}"
                                                        Width="*"
                                                        MinWidth="240"
                                                        ElementStyle="{StaticResource DataGridCellPathText}" />
								</DataGrid.Columns>
							</DataGrid>

							<Border Style="{StaticResource EmptyStatePanel}"
                                    Visibility="{Binding Advanced.BkpEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock Text="{Binding Advanced.BkpText}"
                                           Style="{StaticResource ArabicEmptyStateText}"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           FlowDirection="LeftToRight"
                                           TextAlignment="Left" />
							</Border>
						</Grid>
					</Grid>
				</TabItem>

				<TabItem>
					<TabItem.Header>
						<TextBlock Text="{lang:TextExt Key=Adv.Diagnostics}" />
					</TabItem.Header>

					<Grid Grid.IsSharedSizeScope="True"
						  FlowDirection="LeftToRight"
                          Language="{DynamicResource App.XmlLanguage}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="8" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<Border Grid.Row="0"
								Style="{StaticResource R3SettingsSection}"
								Margin="0"
								Padding="14">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"
												  MaxWidth="180"
												  SharedSizeGroup="DiagnosticsLabel" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="8" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="6" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="6" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="6" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<TextBlock Grid.Row="0"
										   Grid.ColumnSpan="2"
										   Text="{lang:TextExt Key=Adv.Rpcs3Connection}"
										   Style="{StaticResource R3SettingsRowTitleText}" />

								<TextBlock Grid.Row="2" Grid.Column="0"
										   Text="{lang:TextExt Key=Adv.ConfigPath}"
										   Style="{StaticResource LabelText}"
										   VerticalAlignment="Center" />
								<Border Grid.Row="2" Grid.Column="1"
										Margin="12,0,0,0"
										Style="{StaticResource R3ValuePill}">
									<TextBlock Text="{Binding Advanced.CfgPath}"
											   Style="{StaticResource R3TechnicalValueText}"
											   TextWrapping="NoWrap"
											   TextTrimming="CharacterEllipsis" />
								</Border>

								<TextBlock Grid.Row="4" Grid.Column="0"
										   Text="{lang:TextExt Key=Adv.PatchesPath}"
										   Style="{StaticResource LabelText}"
										   VerticalAlignment="Center" />
								<Border Grid.Row="4" Grid.Column="1"
										Margin="12,0,0,0"
										Style="{StaticResource R3ValuePill}">
									<TextBlock Text="{Binding Advanced.PatPath}"
											   Style="{StaticResource R3TechnicalValueText}"
											   TextWrapping="NoWrap"
											   TextTrimming="CharacterEllipsis" />
								</Border>

								<TextBlock Grid.Row="6" Grid.Column="0"
										   Text="{lang:TextExt Key=Adv.TargetCfg}"
										   Style="{StaticResource LabelText}"
										   VerticalAlignment="Center" />
								<Border Grid.Row="6" Grid.Column="1"
										Margin="12,0,0,0"
										Style="{StaticResource R3ValuePill}">
									<TextBlock Text="{Binding Advanced.TgtCfg}"
											   Style="{StaticResource R3TechnicalValueText}"
											   TextWrapping="NoWrap"
											   TextTrimming="CharacterEllipsis" />
								</Border>

								<TextBlock Grid.Row="8" Grid.Column="0"
										   Text="{lang:TextExt Key=Adv.CatVersion}"
										   Style="{StaticResource LabelText}"
										   VerticalAlignment="Top" />
								<StackPanel Grid.Row="8" Grid.Column="1"
											Margin="12,0,0,0"
											MinWidth="0">
									<Border Style="{StaticResource R3ValuePill}">
										<TextBlock Text="{Binding Advanced.CatVer}"
												   Style="{StaticResource R3TechnicalValueText}"
												   TextWrapping="NoWrap"
												   TextTrimming="CharacterEllipsis" />
									</Border>
									<TextBlock Text="{Binding RecStat}"
											   Style="{StaticResource R3SettingsRowDescriptionText}"
											   Margin="0,6,0,0"
											   MaxWidth="360"
											   TextWrapping="Wrap" />
								</StackPanel>
							</Grid>
						</Border>

						<Border Grid.Row="2"
								Style="{StaticResource R3SettingsSection}"
								Margin="0"
								Padding="14">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="8" />
									<RowDefinition Height="*" />
									<RowDefinition Height="8" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<TextBlock Grid.Row="0"
										   Text="{lang:TextExt Key=Adv.SessionLog}"
										   Style="{StaticResource R3SettingsRowTitleText}" />
								<Border Grid.Row="2"
										MinHeight="120"
										Background="{StaticResource SurfaceAltBrush}"
										BorderBrush="{StaticResource BorderSubtleBrush}"
										BorderThickness="1"
										CornerRadius="8"
										Padding="8">
									<TextBox Text="{Binding Advanced.LogText, Mode=OneWay}"
											 IsReadOnly="True"
											 AcceptsReturn="True"
											 VerticalContentAlignment="Top"
											 TextWrapping="NoWrap"
											 HorizontalScrollBarVisibility="Auto"
											 VerticalScrollBarVisibility="Auto"
											 FlowDirection="LeftToRight"
											 TextAlignment="Left"
											 FontFamily="Consolas, Cascadia Mono, Segoe UI Mono"
											 FontSize="12"
											 BorderThickness="0"
											 Background="Transparent"
											 Foreground="{StaticResource TextPrimaryBrush}" />
								</Border>

								<Button Grid.Row="4"
										Content="{lang:TextExt Key=Adv.CopyLog}"
										MinWidth="110"
										Margin="0"
										HorizontalAlignment="Left"
										ToolTip="{lang:TextExt Key=Adv.CopyLogTip}"
										Command="{Binding CopyCmd}" />
							</Grid>
						</Border>
					</Grid>
				</TabItem>
			</TabControl>

			<Border Grid.Row="2"
                    Style="{StaticResource R3DialogActionBar}"
                    CornerRadius="0,0,14,14">
				<Button Content="{lang:TextExt Key=Adv.Close}"
                        MinWidth="100"
                        Margin="0"
                        HorizontalAlignment="{DynamicResource App.HorizontalAlignment}"
                        IsCancel="True" />
			</Border>
		</Grid>
	</Border>
</Window>
