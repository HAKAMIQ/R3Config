<Window x:Class="R3Config.View.AdvancedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:R3Config.Ctrl"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{lang:Text Key=Adv.Title}"
        Width="1120"
        Height="700"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}">

	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>

	<Border Style="{StaticResource R3WindowRootFrame}">
		<Grid ClipToBounds="True"
              FlowDirection="{DynamicResource App.FlowDirection}"
              Language="{DynamicResource App.XmlLanguage}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
						<TextBlock Text="{lang:Text Key=Adv.Title}"
                                   Style="{StaticResource R3SettingsTitleText}" />

						<TextBlock Margin="0,4,0,0"
                                   Text="{lang:Text Key=Adv.Description}"
                                   Style="{StaticResource R3SettingsDescriptionText}"
                                   TextWrapping="Wrap" />
					</StackPanel>

					<Button Grid.Column="1"
                            Style="{StaticResource HeaderCloseButton}"
                            ToolTip="{lang:Text Key=Window.CloseTip}"
                            Click="CloseButton_Click"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
						<Grid Width="14"
                              Height="14">
							<Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
						</Grid>
					</Button>
				</Grid>
			</Border>

			<TabControl Grid.Row="1"
                        Margin="12,10,12,12"
                        Background="Transparent"
                        BorderThickness="0"
                        FlowDirection="{DynamicResource App.FlowDirection}"
                        Language="{DynamicResource App.XmlLanguage}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

				<TabControl.Resources>
					<Style TargetType="{x:Type TabControl}">
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="{x:Type TabControl}">
									<Grid KeyboardNavigation.TabNavigation="Local">
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>

										<TabPanel Grid.Row="0"
                                                  IsItemsHost="True"
                                                  Margin="0,0,0,8"
                                                  Background="Transparent"
                                                  KeyboardNavigation.TabIndex="1" />

										<ContentPresenter Grid.Row="1"
                                                          ContentSource="SelectedContent"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"
                                                          KeyboardNavigation.TabIndex="2" />
									</Grid>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>

					<Style TargetType="{x:Type TabItem}">
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
						<Setter Property="Padding" Value="12,7" />
						<Setter Property="FocusVisualStyle" Value="{x:Null}" />
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="{x:Type TabItem}">
									<Border x:Name="HeaderBorder"
                                            Margin="0,0,4,0"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="6">
										<ContentPresenter ContentSource="Header"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True" />
									</Border>

									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="HeaderBorder"
                                                    Property="Background"
                                                    Value="{StaticResource SurfaceHoverBrush}" />
											<Setter TargetName="HeaderBorder"
                                                    Property="BorderBrush"
                                                    Value="{StaticResource BorderSubtleBrush}" />
											<Setter Property="Foreground"
                                                    Value="{StaticResource TextPrimaryBrush}" />
										</Trigger>

										<Trigger Property="IsSelected" Value="True">
											<Setter TargetName="HeaderBorder"
                                                    Property="Background"
                                                    Value="{StaticResource TabSelectedBackgroundBrush}" />
											<Setter TargetName="HeaderBorder"
                                                    Property="BorderBrush"
                                                    Value="{StaticResource BorderSubtleBrush}" />
											<Setter Property="Foreground"
                                                    Value="{StaticResource TextPrimaryBrush}" />
											<Setter Property="FontWeight"
                                                    Value="SemiBold" />
										</Trigger>

										<Trigger Property="IsEnabled" Value="False">
											<Setter Property="Opacity" Value="0.45" />
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</TabControl.Resources>

				<TabItem Header="{lang:Text Key=Adv.PatchDevelopment}">
					<ScrollViewer VerticalScrollBarVisibility="Auto"
					              HorizontalScrollBarVisibility="Disabled">
						<StackPanel FlowDirection="{DynamicResource App.FlowDirection}"
						            Language="{DynamicResource App.XmlLanguage}">
							<Border Style="{StaticResource R3SettingsSection}"
							        Margin="0"
							        Padding="12">
								<StackPanel>
									<TextBlock Text="{lang:Text Key=Adv.PatchDev.IntroTitle}"
									           Style="{StaticResource R3SettingsRowTitleText}" />
									<TextBlock Text="{lang:Text Key=Adv.PatchDev.Intro}"
									           Style="{StaticResource R3SettingsRowDescriptionText}"
									           TextWrapping="Wrap"
									           Margin="0,6,0,0" />
								</StackPanel>
							</Border>

							<Border Style="{StaticResource R3SettingsSection}"
							        Margin="0,8,0,0"
							        Padding="12">
								<StackPanel>
									<TextBlock Text="{lang:Text Key=Adv.PatchDev.SourcesTitle}"
									           Style="{StaticResource R3SettingsRowTitleText}" />
									<TextBlock Text="{lang:Text Key=Adv.PatchDev.Sources}"
									           Style="{StaticResource R3SettingsRowDescriptionText}"
									           TextWrapping="Wrap"
									           Margin="0,6,0,0" />
								</StackPanel>
							</Border>

							<Border Style="{StaticResource R3SettingsSection}"
							        Margin="0,8,0,0"
							        Padding="12">
								<StackPanel>
									<TextBlock Text="{lang:Text Key=Adv.PatchDev.MatchTitle}"
									           Style="{StaticResource R3SettingsRowTitleText}" />
									<TextBlock Text="{lang:Text Key=Adv.PatchDev.Match}"
									           Style="{StaticResource R3SettingsRowDescriptionText}"
									           TextWrapping="Wrap"
									           Margin="0,6,0,0" />
								</StackPanel>
							</Border>

							<Border Style="{StaticResource R3SettingsSection}"
							        Margin="0,8,0,0"
							        Padding="12">
								<StackPanel>
									<TextBlock Text="{lang:Text Key=Adv.PatchDev.TemplateTitle}"
									           Style="{StaticResource R3SettingsRowTitleText}" />
									<TextBox Text="{lang:Text Key=Adv.PatchDev.Template}"
									         IsReadOnly="True"
									         AcceptsReturn="True"
									         TextWrapping="NoWrap"
									         HorizontalScrollBarVisibility="Auto"
									         VerticalScrollBarVisibility="Auto"
									         FlowDirection="LeftToRight"
									         TextAlignment="Left"
									         FontFamily="Consolas, Cascadia Mono, Segoe UI Mono"
									         MinHeight="210"
									         Margin="0,8,0,0" />
								</StackPanel>
							</Border>

							<Border Style="{StaticResource R3SettingsSection}"
							        Margin="0,8,0,0"
							        Padding="12">
								<StackPanel>
									<TextBlock Text="{lang:Text Key=Adv.PatchDev.WorkflowTitle}"
									           Style="{StaticResource R3SettingsRowTitleText}" />
									<TextBlock Text="{lang:Text Key=Adv.PatchDev.Workflow}"
									           Style="{StaticResource R3SettingsRowDescriptionText}"
									           TextWrapping="Wrap"
									           Margin="0,6,0,0" />
								</StackPanel>
							</Border>

							<Border Style="{StaticResource R3SettingsSection}"
							        Margin="0,8,0,0"
							        Padding="12">
								<StackPanel>
									<TextBlock Text="{lang:Text Key=Adv.PatchDev.SafetyTitle}"
									           Style="{StaticResource R3SettingsRowTitleText}" />
									<TextBlock Text="{lang:Text Key=Adv.PatchDev.Safety}"
									           Style="{StaticResource R3SettingsRowDescriptionText}"
									           TextWrapping="Wrap"
									           Margin="0,6,0,0" />
								</StackPanel>
							</Border>
						</StackPanel>
					</ScrollViewer>
				</TabItem>

				<TabItem Header="{lang:Text Key=HCanary.Title}">
					<controls:HCanaryView HorizontalAlignment="Stretch"
					                      VerticalAlignment="Stretch" />
				</TabItem>

				<TabItem>
					<TabItem.Header>
						<TextBlock Text="{lang:Text Key=Adv.Recovery}" />
					</TabItem.Header>

					<Grid FlowDirection="{DynamicResource App.FlowDirection}"
                          Language="{DynamicResource App.XmlLanguage}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="8" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<Border Grid.Row="0"
                                Style="{StaticResource R3SettingsSection}"
                                Margin="0"
                                Padding="10">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="10" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<TextBlock Grid.Column="0"
                                           Text="{Binding BackupsStatus}"
                                           Style="{StaticResource R3SettingsRowDescriptionText}"
                                           Margin="0"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />

								<Button Grid.Column="2"
                                        Content="{lang:Text Key=Adv.RestoreSelected}"
                                        MinWidth="140"
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        ToolTip="{lang:Text Key=Adv.RestoreTip}"
                                        Command="{Binding RestoreBackupCommand}" />
							</Grid>
						</Border>

						<Grid Grid.Row="2">
							<DataGrid ItemsSource="{Binding Advanced.Backups}"
                                      SelectedItem="{Binding Advanced.SelectedBackup, Mode=TwoWay}"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      CanUserResizeColumns="True"
                                      EnableColumnVirtualization="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      FlowDirection="{DynamicResource App.FlowDirection}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ToolTip="{lang:Text Key=Adv.BackupsTip}">
								<DataGrid.Style>
									<Style TargetType="DataGrid"
                                           BasedOn="{StaticResource {x:Type DataGrid}}">
										<Style.Triggers>
											<DataTrigger Binding="{Binding Advanced.IsBackupsEmpty}"
                                                         Value="True">
												<Setter Property="Visibility"
                                                        Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</DataGrid.Style>

								<DataGrid.Columns>
									<DataGridTextColumn Header="{lang:Text Key=Adv.Date}"
                                                        HeaderStyle="{StaticResource DataGridHeaderUi}"
                                                        Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                        Width="150"
                                                        MinWidth="135"
                                                        ElementStyle="{StaticResource DataGridCellTextLeft}" />

									<DataGridTextColumn Header="{lang:Text Key=Adv.Files}"
                                                        HeaderStyle="{StaticResource DataGridHeaderUi}"
                                                        Binding="{Binding Files.Count}"
                                                        Width="80"
                                                        MinWidth="70"
                                                        ElementStyle="{StaticResource DataGridCellTextCenter}" />

									<DataGridTextColumn Header="{lang:Text Key=Adv.Folder}"
                                                        HeaderStyle="{StaticResource DataGridHeaderUi}"
                                                        Binding="{Binding DirectoryPath}"
                                                        Width="*"
                                                        MinWidth="220"
                                                        ElementStyle="{StaticResource TechText}" />
								</DataGrid.Columns>
							</DataGrid>

							<Border Style="{StaticResource EmptyStatePanel}"
                                    Visibility="{Binding Advanced.IsBackupsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock Text="{Binding Advanced.EmptyBackupsText}"
                                           Style="{StaticResource ArabicEmptyStateText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FlowDirection="{DynamicResource App.FlowDirection}"
                                           TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
							</Border>
						</Grid>
					</Grid>
				</TabItem>

				<TabItem>
					<TabItem.Header>
						<TextBlock Text="{lang:Text Key=Adv.Diagnostics}" />
					</TabItem.Header>

					<Grid FlowDirection="{DynamicResource App.FlowDirection}"
                          Language="{DynamicResource App.XmlLanguage}">
						<ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
							<StackPanel FlowDirection="{DynamicResource App.FlowDirection}"
                                        Language="{DynamicResource App.XmlLanguage}">

								<Border Style="{StaticResource R3SettingsSection}"
                                        Margin="0"
                                        Padding="10">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="8" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="6" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="6" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="6" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>

										<TextBlock Grid.Row="0"
                                                   Text="{lang:Text Key=Adv.Rpcs3Connection}"
                                                   Style="{StaticResource R3SettingsRowTitleText}" />

										<Grid Grid.Row="2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="140" />
												<ColumnDefinition Width="10" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>

											<TextBlock Grid.Column="0"
                                                       Text="{lang:Text Key=Adv.ConfigPath}"
                                                       Style="{StaticResource LabelText}"
                                                       VerticalAlignment="Center" />

											<Border Grid.Column="2"
                                                    Style="{StaticResource R3ValuePill}">
												<TextBlock Text="{Binding Advanced.ConfigPath}"
                                                           Style="{StaticResource R3TechnicalValueText}"
                                                           TextTrimming="CharacterEllipsis" />
											</Border>
										</Grid>

										<Grid Grid.Row="4">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="140" />
												<ColumnDefinition Width="10" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>

											<TextBlock Grid.Column="0"
                                                       Text="{lang:Text Key=Adv.PatchesPath}"
                                                       Style="{StaticResource LabelText}"
                                                       VerticalAlignment="Center" />

											<Border Grid.Column="2"
                                                    Style="{StaticResource R3ValuePill}">
												<TextBlock Text="{Binding Advanced.PatchesPath}"
                                                           Style="{StaticResource R3TechnicalValueText}"
                                                           TextTrimming="CharacterEllipsis" />
											</Border>
										</Grid>

										<Grid Grid.Row="6">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="140" />
												<ColumnDefinition Width="10" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>

											<TextBlock Grid.Column="0"
                                                       Text="{lang:Text Key=Adv.TargetCfg}"
                                                       Style="{StaticResource LabelText}"
                                                       VerticalAlignment="Center" />

											<Border Grid.Column="2"
                                                    Style="{StaticResource R3ValuePill}">
												<TextBlock Text="{Binding Advanced.TargetConfigPath}"
                                                           Style="{StaticResource R3TechnicalValueText}"
                                                           TextTrimming="CharacterEllipsis" />
											</Border>
										</Grid>

										<Grid Grid.Row="8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="140" />
												<ColumnDefinition Width="10" />
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="10" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>

											<TextBlock Grid.Column="0"
                                                       Text="{lang:Text Key=Adv.CatVersion}"
                                                       Style="{StaticResource LabelText}"
                                                       VerticalAlignment="Center" />

											<Border Grid.Column="2"
                                                    Style="{StaticResource R3ValuePill}">
												<TextBlock Text="{Binding Advanced.CatalogVersion}"
                                                           Style="{StaticResource R3TechnicalValueText}"
                                                           TextTrimming="CharacterEllipsis" />
											</Border>

											<TextBlock Grid.Column="4"
                                                       Text="{Binding RecommendationsStatus}"
                                                       Style="{StaticResource R3SettingsRowDescriptionText}"
                                                       Margin="0"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
										</Grid>
									</Grid>
								</Border>

								<Border Style="{StaticResource R3SettingsSection}"
                                        Margin="0,8,0,0"
                                        Padding="10">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="8" />
											<RowDefinition Height="110" />
											<RowDefinition Height="8" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>

										<TextBlock Grid.Row="0"
                                                   Text="{lang:Text Key=Adv.SessionLog}"
                                                   Style="{StaticResource R3SettingsRowTitleText}" />

										<Border Grid.Row="2"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="8">
											<TextBox Text="{Binding Advanced.LogText, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     VerticalContentAlignment="Top"
                                                     TextWrapping="NoWrap"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     VerticalScrollBarVisibility="Auto"
                                                     FlowDirection="LeftToRight"
                                                     TextAlignment="Left"
                                                     FontFamily="Consolas, Cascadia Mono, Segoe UI Mono"
                                                     FontSize="12"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Foreground="{StaticResource TextPrimaryBrush}" />
										</Border>

										<Button Grid.Row="4"
                                                Content="{lang:Text Key=Adv.CopyLog}"
                                                MinWidth="110"
                                                Margin="0"
                                                HorizontalAlignment="{DynamicResource App.HorizontalAlignment}"
                                                ToolTip="{lang:Text Key=Adv.CopyLogTip}"
                                                Command="{Binding CopyLogCommand}" />
									</Grid>
								</Border>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</TabItem>
			</TabControl>

			<Border Grid.Row="2"
                    Style="{StaticResource R3DialogActionBar}"
                    CornerRadius="0,0,14,14">
				<Button Content="{lang:Text Key=Adv.Close}"
                        MinWidth="100"
                        Margin="0"
                        HorizontalAlignment="{DynamicResource App.HorizontalAlignment}"
                        IsCancel="True" />
			</Border>
		</Grid>
	</Border>
</Window>
