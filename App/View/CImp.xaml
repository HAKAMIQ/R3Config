<Window x:Class="R3Config.View.CanaryPatchImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{lang:Text Key=Patch.ImportCanaryTitle}"
        Width="780"
        Height="580"
        MinWidth="680"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}">
    <Border Style="{StaticResource R3WindowRootFrame}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource R3AccentLine}" />
                    <StackPanel Grid.Column="2"
                                FlowDirection="{DynamicResource App.FlowDirection}">
                        <TextBlock Text="{lang:Text Key=Patch.ImportCanaryTitle}"
                                   Style="{StaticResource R3SettingsTitleText}" />
                    </StackPanel>

                    <Button Grid.Column="3"
                            Style="{StaticResource HeaderCloseButton}"
                            ToolTip="{lang:Text Key=Window.CloseTip}"
                            Click="CloseButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="14" Height="14">
                            <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="16"
                  FlowDirection="LeftToRight">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource R3SettingsSection}"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{lang:Text Key=Patch.ImportCanaryPasteLabel}"
                                   Style="{StaticResource R3SettingsDescriptionText}"
                                   FlowDirection="{DynamicResource App.FlowDirection}"
                                   TextAlignment="{DynamicResource Options.SettingsTextAlignment}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <TextBox Grid.Row="1"
                                 Text="{Binding ImportText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Left"
                                 HorizontalContentAlignment="Left"
                                 VerticalContentAlignment="Top"
                                 MinHeight="260"
                                 Style="{StaticResource PathTextBox}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,12,0,0"
                        FlowDirection="{DynamicResource App.FlowDirection}">
                    <StackPanel>
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Style="{StaticResource R3SettingsDescriptionText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ResultMessage}"
                                   Style="{StaticResource R3SettingsDescriptionText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource R3DialogActionBar}">
                <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{lang:Text Key=Patch.ImportCanaryChooseFile}"
                            Command="{Binding ChooseFileCommand}"
                            MinWidth="130"
                            Padding="12,8" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="{Binding HorizontalAlignment, FallbackValue=Right}"
                                FlowDirection="{DynamicResource App.FlowDirection}">
                        <Button Content="{lang:Text Key=Dialog.Cancel}"
                                Command="{Binding CancelCommand}"
                                MinWidth="96"
                                Padding="12,8"
                                Margin="4,0" />
                        <Button Content="{lang:Text Key=Patch.ImportCanaryCreateFile}"
                                Command="{Binding CreateFileCommand}"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="150"
                                Padding="12,8"
                                Margin="4,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
