<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Class="R3Config.View.CanDlg"
        Title="{lang:TextExt Key=Patch.ImportCanaryTitle}"
        AutomationProperties.AutomationId="CanaryImport.Root"
        AutomationProperties.Name="{lang:TextExt Key=Patch.ImportCanaryTitle}"
        Width="620"
        Height="440"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Type.Font.Body}"
        Language="{DynamicResource App.XmlLanguage}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FlowDirection="{DynamicResource App.FlowDirection}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ImportDlgStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{StaticResource Control.Height.Standard}"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource FluentSurface.Dialog}"
            CornerRadius="{StaticResource Radius.None}">

        <Grid ClipToBounds="True"
              KeyboardNavigation.TabNavigation="Cycle">

            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    Padding="0"
                    CornerRadius="{StaticResource Radius.None}"
                    MouseLeftButtonDown="DragWin">

                <Grid Height="32"
                      FlowDirection="{DynamicResource App.CaptionButtonsFlowDirection}"
                      ClipToBounds="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            AutomationProperties.AutomationId="CanaryImport.CloseButton"
                            AutomationProperties.Name="{lang:TextExt Key=Window.CloseTip}"
                            ToolTip="{lang:TextExt Key=Window.CloseTip}"
                            Click="CloseWin"
                            Width="46"
                            Height="{StaticResource Control.Height.Standard}"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            TextBlock.TextAlignment="Center">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource FluentButton.Close.Caption}">
                                <Setter Property="Height"
                                        Value="{StaticResource Control.Height.Standard}" />
                                <Setter Property="MinHeight"
                                        Value="{StaticResource Control.Height.Standard}" />
                            </Style>
                        </Button.Style>

                        <Grid Width="16"
                              Height="16"
                              FlowDirection="LeftToRight"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">

                            <TextBlock Text=""
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{Binding Foreground,
                                                            RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       FlowDirection="LeftToRight"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType" />
                        </Grid>
                    </Button>

                    <TextBlock Grid.Column="0"
                               Text="{lang:TextExt Key=Patch.ImportCanaryTitle}"
                               AutomationProperties.AutomationId="CanaryImport.Title"
                               Style="{StaticResource CanLocalizedTitleText}"
                               FlowDirection="{DynamicResource App.TextFlowDirection}"
                               Language="{DynamicResource App.XmlLanguage}"
                               Margin="14,0"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               TextAlignment="{DynamicResource App.TextAlignment}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               ToolTip="{lang:TextExt Key=Patch.ImportCanaryTitle}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource R3SettingsSection}"
                        Padding="16">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{lang:TextExt Key=Patch.ImportCanaryPasteLabel}"
                                   Style="{StaticResource CanLocalizedDescriptionText}"
                                   HorizontalAlignment="Stretch"
                                   TextWrapping="Wrap"
                                   TextTrimming="None" />

                        <TextBox x:Name="ImportTextBox"
                                 Grid.Row="2"
                                 Text="{Binding ImpText,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="CanaryImport.SourceText"
                                 AutomationProperties.Name="{lang:TextExt Key=Patch.ImportCanaryPasteLabel}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 SpellCheck.IsEnabled="False"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 Padding="12,8"
                                 FontFamily="{DynamicResource Type.Font.Technical}"
                                 FontSize="12"
                                 FlowDirection="{DynamicResource TechnicalText.FlowDirection}"
                                 Language="{DynamicResource TechnicalText.Language}"
                                 NumberSubstitution.Substitution="European"
                                 TextAlignment="{DynamicResource TechnicalText.TextAlignment}"
                                 VerticalContentAlignment="Top"
                                 Style="{StaticResource PathTextBox}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        AutomationProperties.AutomationId="CanaryImport.Status"
                        Margin="0,12,0,0"
                        Padding="12"
                        Background="{DynamicResource Surface.Subtle}"
                        BorderBrush="{DynamicResource Stroke.Subtle}"
                        BorderThickness="{StaticResource Stroke.Thickness.Default}"
                        CornerRadius="{StaticResource Radius.Medium}">

                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility"
                                    Value="Visible" />

                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding VldMsg}"
                                                   Value="{x:Null}" />
                                        <Condition Binding="{Binding ResMsg}"
                                                   Value="{x:Null}" />
                                    </MultiDataTrigger.Conditions>

                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </MultiDataTrigger>

                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding VldMsg}"
                                                   Value="" />
                                        <Condition Binding="{Binding ResMsg}"
                                                   Value="" />
                                    </MultiDataTrigger.Conditions>

                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </MultiDataTrigger>

                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding VldMsg}"
                                                   Value="{x:Null}" />
                                        <Condition Binding="{Binding ResMsg}"
                                                   Value="" />
                                    </MultiDataTrigger.Conditions>

                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </MultiDataTrigger>

                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding VldMsg}"
                                                   Value="" />
                                        <Condition Binding="{Binding ResMsg}"
                                                   Value="{x:Null}" />
                                    </MultiDataTrigger.Conditions>

                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding VldMsg}"
                                   AutomationProperties.AutomationId="CanaryImport.ValidationMessage"
                                   Style="{StaticResource CanValidationText}"
                                   HorizontalAlignment="Stretch"
                                   TextWrapping="Wrap"
                                   TextTrimming="None" />

                        <TextBlock Text="{Binding ResMsg}"
                                   AutomationProperties.AutomationId="CanaryImport.ResultMessage"
                                   Style="{StaticResource CanResultText}"
                                   HorizontalAlignment="Stretch"
                                   TextWrapping="Wrap"
                                   TextTrimming="None" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource R3DialogActionBar}"
                    CornerRadius="{StaticResource Radius.None}"
                    FlowDirection="LeftToRight">

                <Grid FlowDirection="LeftToRight">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{lang:TextExt Key=Patch.ImportCanaryChooseFile}"
                            Command="{Binding PickCmd}"
                            AutomationProperties.AutomationId="CanaryImport.ChooseFileButton"
                            AutomationProperties.Name="{lang:TextExt Key=Patch.ImportCanaryChooseFile}"
                            Style="{StaticResource CanSecondaryActionButton}"
                            FlowDirection="{DynamicResource App.TextFlowDirection}"
                            TextBlock.TextAlignment="Center" />

                    <Button Grid.Column="2"
                            Content="{lang:TextExt Key=Patch.ImportCanaryCreateFile}"
                            Command="{Binding MakeCmd}"
                            AutomationProperties.AutomationId="CanaryImport.CreateFileButton"
                            AutomationProperties.Name="{lang:TextExt Key=Patch.ImportCanaryCreateFile}"
                            Style="{StaticResource CanPrimaryActionButton}"
                            FlowDirection="{DynamicResource App.TextFlowDirection}"
                            IsDefault="True"
                            TextBlock.TextAlignment="Center" />

                    <Button Grid.Column="4"
                            Content="{lang:TextExt Key=Dialog.Cancel}"
                            Command="{Binding CloseCmd}"
                            AutomationProperties.AutomationId="CanaryImport.CancelButton"
                            AutomationProperties.Name="{lang:TextExt Key=Dialog.Cancel}"
                            Style="{StaticResource CanSecondaryActionButton}"
                            FlowDirection="{DynamicResource App.TextFlowDirection}"
                            IsCancel="True"
                            TextBlock.TextAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>