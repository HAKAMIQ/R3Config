<Window x:Class="R3Config.View.CanDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{lang:TextExt Key=Patch.ImportCanaryTitle}"
        Width="700"
        Height="520"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Type.Font.Body}"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>


    <Border Style="{StaticResource FluentSurface.Dialog}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    MouseLeftButtonDown="DragWin">
                <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{lang:TextExt Key=Patch.ImportCanaryTitle}"
                               Style="{StaticResource R3SettingsTitleText}"
                               FlowDirection="{DynamicResource App.FlowDirection}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Style="{StaticResource FluentButton.Close}"
                            AutomationProperties.Name="{lang:TextExt Key=Window.CloseTip}"
                            ToolTip="{lang:TextExt Key=Window.CloseTip}"
                            Click="CloseWin"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="14"
                              Height="14">
                            <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="14"
                  FlowDirection="LeftToRight">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource R3SettingsSection}"
                        Margin="0"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{lang:TextExt Key=Patch.ImportCanaryPasteLabel}"
                                   Style="{StaticResource R3SettingsDescriptionText}"
                                   FlowDirection="{DynamicResource App.FlowDirection}"
                                   TextAlignment="{DynamicResource Options.SettingsTextAlignment}"
                                   TextWrapping="Wrap" />

                        <TextBox Grid.Row="2"
                                 Text="{Binding ImpText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas, Cascadia Mono, Segoe UI Mono"
                                 FontSize="12"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Left"
                                 HorizontalContentAlignment="Left"
                                 VerticalContentAlignment="Top"
                                 MinHeight="220"
                                 Style="{StaticResource PathTextBox}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="10"
                        Background="{DynamicResource Surface.Subtle}"
                        BorderBrush="{DynamicResource Stroke.Subtle}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}"
                        FlowDirection="{DynamicResource App.FlowDirection}">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Visible" />

                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding VldMsg}"
                                                   Value="{x:Null}" />
                                        <Condition Binding="{Binding ResMsg}"
                                                   Value="{x:Null}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>

                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding VldMsg}"
                                                   Value="" />
                                        <Condition Binding="{Binding ResMsg}"
                                                   Value="" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>

                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding VldMsg}"
                                                   Value="{x:Null}" />
                                        <Condition Binding="{Binding ResMsg}"
                                                   Value="" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>

                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding VldMsg}"
                                                   Value="" />
                                        <Condition Binding="{Binding ResMsg}"
                                                   Value="{x:Null}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock Text="{Binding VldMsg}"
                                   Style="{StaticResource FluentStatus.Text}"
                                   Margin="0,0,0,6" />

                        <TextBlock Text="{Binding ResMsg}"
                                   Style="{StaticResource FluentStatus.Text}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource R3DialogActionBar}"
                    CornerRadius="{StaticResource Radius.Dialog.Bottom}">
                <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{lang:TextExt Key=Patch.ImportCanaryChooseFile}"
                            Command="{Binding PickCmd}"
                            MinWidth="118"
                            Margin="0"
                            Padding="12,7" />

                    <Button Grid.Column="2"
                            Content="{lang:TextExt Key=Dialog.Cancel}"
                            Command="{Binding CloseCmd}"
                            MinWidth="88"
                            Margin="0"
                            Padding="12,7" />

                    <Button Grid.Column="4"
                            Content="{lang:TextExt Key=Patch.ImportCanaryCreateFile}"
                            Command="{Binding MakeCmd}"
                            Style="{StaticResource FluentButton.Primary}"
                            MinWidth="138"
                            Margin="0"
                            Padding="12,7" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>