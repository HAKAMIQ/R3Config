<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:svc="clr-namespace:R3Config.Svc"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Class="R3Config.View.NclImportDlg"
        Title="{lang:TextExt Key=Patch.Ncl.Title}"
        Width="760"
        Height="520"
        MinWidth="660"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Type.Font.Body}"
        Language="{DynamicResource App.XmlLanguage}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FlowDirection="{DynamicResource App.FlowDirection}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ImportDlgStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NclLocalizedTitleText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource Type.BodyStrong}">
                <Setter Property="Foreground"
                        Value="{DynamicResource Text.Primary}" />
                <Setter Property="FlowDirection"
                        Value="{DynamicResource App.TextFlowDirection}" />
                <Setter Property="Language"
                        Value="{DynamicResource App.XmlLanguage}" />
                <Setter Property="TextAlignment"
                        Value="{DynamicResource App.TextAlignment}" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="NclLocalizedLabelText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource R3SettingsRowTitleText}">
                <Setter Property="FlowDirection"
                        Value="{DynamicResource App.TextFlowDirection}" />
                <Setter Property="Language"
                        Value="{DynamicResource App.XmlLanguage}" />
                <Setter Property="TextAlignment"
                        Value="{DynamicResource App.TextAlignment}" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="NclStatusText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource FluentStatus.Text}">
                <Setter Property="Foreground"
                        Value="{DynamicResource Text.Secondary}" />
                <Setter Property="FlowDirection"
                        Value="{DynamicResource App.TextFlowDirection}" />
                <Setter Property="Language"
                        Value="{DynamicResource App.XmlLanguage}" />
                <Setter Property="TextAlignment"
                        Value="{DynamicResource App.TextAlignment}" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="TextWrapping"
                        Value="Wrap" />
                <Setter Property="TextTrimming"
                        Value="None" />
            </Style>

            <Style x:Key="NclHintText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource NclStatusText}">
                <Setter Property="Margin"
                        Value="0,8,0,0" />
                <Setter Property="TextWrapping"
                        Value="Wrap" />
                <Setter Property="TextTrimming"
                        Value="None" />
                <Setter Property="Visibility"
                        Value="Visible" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                 Value="{x:Null}">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                 Value="">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="NclTechnicalSummaryText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource TechnicalTextBlock}">
                <Setter Property="FontFamily"
                        Value="{DynamicResource Type.Font.Body}" />
                <Setter Property="FontSize"
                        Value="14" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Text.Primary}" />
                <Setter Property="Language"
                        Value="{DynamicResource TechnicalText.Language}" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="NclTechnicalItemText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource TechnicalTextBlock}">
                <Setter Property="FontFamily"
                        Value="{DynamicResource Type.Font.Body}" />
                <Setter Property="FontSize"
                        Value="14" />
            </Style>

            <Style x:Key="NclLocalizedComboBox"
                   TargetType="{x:Type ComboBox}"
                   BasedOn="{StaticResource FluentComboBox}">
                <Setter Property="Width"
                        Value="360" />
                <Setter Property="FlowDirection"
                        Value="{DynamicResource App.FlowDirection}" />
                <Setter Property="Language"
                        Value="{DynamicResource App.XmlLanguage}" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Stretch" />
            </Style>

            <Style x:Key="NclOptionRowGrid"
                   TargetType="{x:Type Grid}">
                <Setter Property="FlowDirection"
                        Value="{DynamicResource App.FlowDirection}" />
                <Setter Property="Margin"
                        Value="0,0,0,8" />
            </Style>

            <Style x:Key="NclOptionSelectorList"
                   TargetType="{x:Type ItemsControl}">
                <Setter Property="Margin"
                        Value="0,12,0,0" />
                <Setter Property="Visibility"
                        Value="Visible" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasOptionSelectors}"
                                 Value="False">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="NclBundledSourceStage"
                   TargetType="{x:Type StackPanel}">
                <Setter Property="Visibility"
                        Value="Collapsed" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBundledSource, Mode=OneWay}"
                                 Value="True">
                        <Setter Property="Visibility"
                                Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="NclExternalSourceStage"
                   TargetType="{x:Type StackPanel}">
                <Setter Property="Visibility"
                        Value="Collapsed" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExternalSource, Mode=OneWay}"
                                 Value="True">
                        <Setter Property="Visibility"
                                Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="NclPpuRunKeyStage"
                   TargetType="{x:Type StackPanel}">
                <Setter Property="Visibility"
                        Value="Collapsed" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding RequiresPpuRunKey, Mode=OneWay}"
                                 Value="True">
                        <Setter Property="Visibility"
                                Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="NclTechnicalComboBox"
                   TargetType="{x:Type ComboBox}"
                   BasedOn="{StaticResource FluentComboBox}">
                <Setter Property="Width"
                        Value="360" />
                <Setter Property="FlowDirection"
                        Value="{DynamicResource TechnicalText.FlowDirection}" />
                <Setter Property="Language"
                        Value="{DynamicResource TechnicalText.Language}" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Stretch" />
            </Style>

            <Style x:Key="NclPrimaryActionButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource FluentButton.Primary}">
                <Setter Property="MinWidth"
                        Value="{StaticResource Button.MinWidth.Standard}" />
                <Setter Property="FlowDirection"
                        Value="{DynamicResource App.TextFlowDirection}" />
                <Setter Property="TextBlock.TextAlignment"
                        Value="Center" />
            </Style>

            <Style x:Key="NclSecondaryActionButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource FluentButton.Secondary}">
                <Setter Property="MinWidth"
                        Value="{StaticResource Button.MinWidth.Standard}" />
                <Setter Property="FlowDirection"
                        Value="{DynamicResource App.TextFlowDirection}" />
                <Setter Property="TextBlock.TextAlignment"
                        Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource FluentSurface.Dialog}"
            CornerRadius="{StaticResource Radius.None}">

        <Grid ClipToBounds="True"
              KeyboardNavigation.TabNavigation="Cycle">

            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    Padding="0"
                    CornerRadius="{StaticResource Radius.None}"
                    MouseLeftButtonDown="DragWin">

                <Grid x:Name="NclCaptionGrid"
                      Height="32"
                      FlowDirection="{DynamicResource App.CaptionButtonsFlowDirection}"
                      ClipToBounds="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="NclCaptionClose"
                            Grid.Column="1"
                            AutomationProperties.Name="{lang:TextExt Key=Window.CloseTip}"
                            ToolTip="{lang:TextExt Key=Window.CloseTip}"
                            Click="CloseWin"
                            Width="46"
                            Height="32"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            TextBlock.TextAlignment="Center">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource FluentButton.Close.Caption}">
                                <Setter Property="Height"
                                        Value="32" />
                                <Setter Property="MinHeight"
                                        Value="32" />
                            </Style>
                        </Button.Style>

                        <Grid Width="16"
                              Height="16"
                              FlowDirection="LeftToRight"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">

                            <TextBlock Text=""
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{Binding Foreground,
                                                            RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       FlowDirection="LeftToRight"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType" />
                        </Grid>
                    </Button>

                    <TextBlock Grid.Column="0"
                               Text="{lang:TextExt Key=Patch.Ncl.Title}"
                               Style="{StaticResource NclLocalizedTitleText}"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               TextAlignment="{DynamicResource App.TextAlignment}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="16">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Border Style="{StaticResource R3SettingsSection}"
                            Padding="16"
                            VerticalAlignment="Top">

                        <StackPanel>

                            <Grid HorizontalAlignment="Stretch"
                                  FlowDirection="LeftToRight">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource IdentityTile}">
                                    <TextBlock Text="&#xE7FC;"
                                               Style="{StaticResource IdentityTileGlyph}" />
                                </Border>

                                <TextBlock x:Name="NclGameTitle"
                                           Grid.Column="2"
                                           Text="{Binding GameTitle}"
                                           Style="{StaticResource NclTechnicalSummaryText}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           TextAlignment="Left"
                                           Language="{Binding GameTitle,
                                                              Converter={StaticResource ContentTextLanguageConverter},
                                                              ConverterCulture=en-US}"
                                           FlowDirection="{Binding GameTitle,
                                                                   Converter={StaticResource ContentTextFlowConverter}}" />

                                <Border Grid.Column="4"
                                        Style="{StaticResource IdentityChip}">
                                    <TextBlock x:Name="NclGameIdentity"
                                               Text="{Binding GameIdentity}"
                                               Style="{StaticResource NclTechnicalSummaryText}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               TextAlignment="{DynamicResource TechnicalText.TextAlignment}"
                                               FlowDirection="LeftToRight" />
                                </Border>
                            </Grid>

                            <Separator Margin="0,12" />

                            <Grid FlowDirection="{DynamicResource App.FlowDirection}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding Sources}"
                                          IsEnabled="{Binding CanEdit}"
                                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                          IsSynchronizedWithCurrentItem="False"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource NclLocalizedComboBox}"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="{lang:TextExt Key=Patch.Ncl.Source}" />

                                <TextBlock Grid.Column="0"
                                           Text="{lang:TextExt Key=Patch.Ncl.Source}"
                                           Style="{StaticResource NclLocalizedLabelText}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock x:Name="NclSourceNotice"
                                       svc:TextFragments.Content="{Binding SourceNoticeFragments}"
                                       Style="{StaticResource NclHintText}"
                                       AutomationProperties.Name="{lang:TextExt Key=Patch.Ncl.Source}" />

                            <StackPanel Style="{StaticResource NclBundledSourceStage}">

                                <Separator Margin="0,12" />

                                <Grid FlowDirection="{DynamicResource App.FlowDirection}">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="360" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SelectedDialect.Name, Mode=OneWay}"
                                               Style="{StaticResource NclTechnicalSummaryText}"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               AutomationProperties.Name="{lang:TextExt Key=Patch.Ncl.Dialect}">

                                        <TextBlock.ToolTip>
                                            <ToolTip Style="{StaticResource ModernToolTip}">
                                                <TextBlock Text="{Binding SelectedDialect.Name, Mode=OneWay}"
                                                           Style="{StaticResource NclTechnicalItemText}" />
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>

                                    <TextBlock Grid.Column="0"
                                               Text="{lang:TextExt Key=Patch.Ncl.Dialect}"
                                               Style="{StaticResource NclLocalizedLabelText}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Style="{StaticResource NclExternalSourceStage}">

                                <Separator Margin="0,12" />

                                <Grid FlowDirection="LeftToRight">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="360" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Width="360"
                                             Text="{Binding FilePath, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Style="{StaticResource PathTextBox}"
                                             HorizontalAlignment="Left"
                                             AutomationProperties.Name="{lang:TextExt Key=Patch.Ncl.File}">

                                        <TextBox.ToolTip>
                                            <ToolTip Style="{StaticResource ModernToolTip}">
                                                <TextBlock Text="{Binding FilePath}"
                                                           Style="{StaticResource TechnicalTextBlock}"
                                                           TextWrapping="Wrap" />
                                            </ToolTip>
                                        </TextBox.ToolTip>
                                    </TextBox>

                                    <Button Grid.Column="2"
                                            Command="{Binding PickCmd}"
                                            Content="{lang:TextExt Key=Patch.Ncl.ChooseFile}"
                                            Style="{StaticResource NclSecondaryActionButton}"
                                            HorizontalAlignment="Left"
                                            FlowDirection="{DynamicResource App.TextFlowDirection}"
                                            AutomationProperties.Name="{lang:TextExt Key=Patch.Ncl.ChooseFile}" />
                                </Grid>

                                <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                                      Margin="0,12,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="360" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding Dialects}"
                                              IsEnabled="{Binding CanEdit}"
                                              SelectedItem="{Binding SelectedDialect, Mode=TwoWay}"
                                              IsSynchronizedWithCurrentItem="False"
                                              Style="{StaticResource NclTechnicalComboBox}"
                                              HorizontalAlignment="Left"
                                              AutomationProperties.Name="{lang:TextExt Key=Patch.Ncl.Dialect}">

                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource NclTechnicalItemText}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Column="0"
                                               Text="{lang:TextExt Key=Patch.Ncl.Dialect}"
                                               Style="{StaticResource NclLocalizedLabelText}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <Separator Margin="0,12" />

                            <Grid FlowDirection="{DynamicResource App.FlowDirection}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding Cheats}"
                                          IsEnabled="{Binding CanEdit}"
                                          SelectedItem="{Binding SelectedCheat, Mode=TwoWay}"
                                          IsSynchronizedWithCurrentItem="False"
                                          Style="{StaticResource NclLocalizedComboBox}"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="{lang:TextExt Key=Patch.Ncl.Cheat}">

                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>

                                                <TextBlock Text="{Binding Display}"
                                                           FlowDirection="{Binding Display,
                                                                                   Converter={StaticResource ContentTextFlowConverter}}"
                                                           Language="{Binding Display,
                                                                              Converter={StaticResource ContentTextLanguageConverter},
                                                                              ConverterCulture=en-US}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />

                                                <WrapPanel Margin="0,4,0,0"
                                                           FlowDirection="LeftToRight"
                                                           Visibility="{Binding IsVersionMismatch,
                                                                                Converter={StaticResource BoolToVisibilityConverter}}">

                                                    <TextBlock Text="{lang:TextExt Key=Patch.Ncl.Cheat.VersionMismatchBadge}"
                                                               Style="{StaticResource NclHintText}"
                                                               Margin="0" />

                                                    <TextBlock Text="{Binding SourceVersion}"
                                                               Style="{StaticResource NclTechnicalItemText}"
                                                               FlowDirection="LeftToRight"
                                                               Margin="8,0,0,0" />

                                                    <TextBlock Text="→"
                                                               Style="{StaticResource NclTechnicalItemText}"
                                                               FlowDirection="LeftToRight"
                                                               Margin="6,0" />

                                                    <TextBlock Text="{Binding DataContext.GameVersion,
                                                                             RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                               Style="{StaticResource NclTechnicalItemText}"
                                                               FlowDirection="LeftToRight"
                                                               Margin="0" />

                                                    <TextBlock Text="{lang:TextExt Key=Patch.Ncl.Cheat.VersionMismatchStatus}"
                                                               Style="{StaticResource NclHintText}"
                                                               Margin="8,0,0,0" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Column="0"
                                           Text="{lang:TextExt Key=Patch.Ncl.Cheat}"
                                           Style="{StaticResource NclLocalizedLabelText}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="{Binding CheatHint}"
                                       Style="{StaticResource NclHintText}"
                                       AutomationProperties.Name="{lang:TextExt Key=Patch.Ncl.Cheat}" />

                            <ItemsControl ItemsSource="{Binding OptionSelectors}"
                                          IsEnabled="{Binding CanEdit}"
                                          Style="{StaticResource NclOptionSelectorList}">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Grid Style="{StaticResource NclOptionRowGrid}">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="360" />
                                            </Grid.ColumnDefinitions>

                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding Choices}"
                                                      SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                      IsSynchronizedWithCurrentItem="False"
                                                      Style="{StaticResource NclTechnicalComboBox}"
                                                      HorizontalAlignment="Left"
                                                      AutomationProperties.Name="{Binding Caption}">

                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}"
                                                                   Style="{StaticResource NclTechnicalItemText}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Caption}"
                                                       Style="{StaticResource NclLocalizedLabelText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding OptionHint}"
                                       Style="{StaticResource NclHintText}" />

                            <StackPanel Style="{StaticResource NclPpuRunKeyStage}">

                                <Separator Margin="0,12" />

                                <Grid FlowDirection="{DynamicResource App.FlowDirection}">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="360" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding EligibleRunKeys}"
                                              IsEnabled="{Binding CanEdit}"
                                              SelectedItem="{Binding SelectedRunKey, Mode=TwoWay}"
                                              IsSynchronizedWithCurrentItem="False"
                                              Style="{StaticResource NclTechnicalComboBox}"
                                              HorizontalAlignment="Left"
                                              AutomationProperties.Name="{lang:TextExt Key=Patch.Ncl.PpuRunKey}">

                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Style="{StaticResource NclTechnicalItemText}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Column="0"
                                               Text="{lang:TextExt Key=Patch.Ncl.PpuRunKey}"
                                               Style="{StaticResource NclLocalizedLabelText}"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="{Binding RunKeyHint}"
                                           Style="{StaticResource NclHintText}"
                                           AutomationProperties.Name="{lang:TextExt Key=Patch.Ncl.PpuRunKey}" />
                            </StackPanel>

                            <Separator Margin="0,12" />

                            <Grid FlowDirection="LeftToRight">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding PreviewCmd}"
                                        Content="{lang:TextExt Key=Patch.Ncl.Preview}"
                                        Style="{StaticResource NclSecondaryActionButton}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{lang:TextExt Key=Patch.Ncl.Preview}" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding InspectionStatus}"
                                           Style="{StaticResource NclStatusText}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                            </Grid>

                            <TextBlock Text="{Binding PreviewStatus}"
                                       Style="{StaticResource NclHintText}"
                                       AutomationProperties.Name="{lang:TextExt Key=Patch.Ncl.Preview}" />

                            <Expander x:Name="NclDetailsExpander"
                                      Header="{lang:TextExt Key=Ui.Details}"
                                      Margin="0,8,0,0">

                                <Expander.Style>
                                    <Style TargetType="{x:Type Expander}">
                                        <Setter Property="Visibility"
                                                Value="Visible" />

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding Details}"
                                                         Value="{x:Null}">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Details}"
                                                         Value="">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Details}"
                                                         Value="Success">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Expander.Style>

                                <TextBox x:Name="NclDetailsText"
                                         Text="{Binding Details, Mode=OneWay}"
                                         Style="{StaticResource TechnicalTextBox}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Disabled"
                                         HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="{lang:TextExt Key=Ui.Details}" />
                            </Expander>

                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource R3DialogActionBar}"
                    CornerRadius="{StaticResource Radius.None}"
                    FlowDirection="LeftToRight">

                <Grid FlowDirection="LeftToRight">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{lang:TextExt Key=Patch.Ncl.Apply}"
                            Command="{Binding ApplyCmd}"
                            Style="{StaticResource NclPrimaryActionButton}"
                            FlowDirection="{DynamicResource App.TextFlowDirection}"
                            TextBlock.TextAlignment="Center"
                            AutomationProperties.Name="{lang:TextExt Key=Patch.Ncl.Apply}" />

                    <Button Grid.Column="3"
                            Content="{lang:TextExt Key=Patch.Ncl.Close}"
                            Command="{Binding CloseCmd}"
                            Style="{StaticResource NclSecondaryActionButton}"
                            FlowDirection="{DynamicResource App.TextFlowDirection}"
                            IsCancel="True"
                            TextBlock.TextAlignment="Center"
                            AutomationProperties.Name="{lang:TextExt Key=Patch.Ncl.Close}" />
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>