<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="clr-namespace:R3Config.Lang"
             x:Class="R3Config.View.ADiagView"
             mc:Ignorable="d"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ASty.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="DiagnosticsWorkspace"
          Grid.IsSharedSizeScope="True"
          FlowDirection="{DynamicResource App.FlowDirection}"
          Language="{DynamicResource App.XmlLanguage}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource R3SettingsSection}"
                Margin="0"
                Padding="16"
                FlowDirection="{DynamicResource App.FlowDirection}">

            <Grid FlowDirection="{DynamicResource App.FlowDirection}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"
                                      MaxWidth="160"
                                      SharedSizeGroup="DiagnosticsLabel" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="3"
                           Text="{lang:TextExt Key=Adv.Rpcs3Connection}"
                           Style="{StaticResource AdvLocalizedRowTitleText}" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="{lang:TextExt Key=Adv.ConfigPath}"
                           Style="{StaticResource AdvLocalizedLabelText}"
                           VerticalAlignment="Center" />

                <Border Grid.Row="2"
                        Grid.Column="2"
                        MinHeight="32"
                        Style="{StaticResource R3ValuePill}"
                        FlowDirection="LeftToRight">

                    <TextBlock Text="{Binding Advanced.CfgPath}"
                               Style="{StaticResource R3TechnicalValueText}" />
                </Border>

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="{lang:TextExt Key=Adv.PatchesPath}"
                           Style="{StaticResource AdvLocalizedLabelText}"
                           VerticalAlignment="Center" />

                <Border Grid.Row="4"
                        Grid.Column="2"
                        MinHeight="32"
                        Style="{StaticResource R3ValuePill}"
                        FlowDirection="LeftToRight">

                    <TextBlock Text="{Binding Advanced.PatPath}"
                               Style="{StaticResource R3TechnicalValueText}" />
                </Border>

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="{lang:TextExt Key=Adv.TargetCfg}"
                           Style="{StaticResource AdvLocalizedLabelText}"
                           VerticalAlignment="Center" />

                <Border Grid.Row="6"
                        Grid.Column="2"
                        MinHeight="32"
                        Style="{StaticResource R3ValuePill}"
                        FlowDirection="LeftToRight">

                    <TextBlock Text="{Binding Advanced.TgtCfg}"
                               Style="{StaticResource R3TechnicalValueText}" />
                </Border>

                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Text="{lang:TextExt Key=Adv.CatVersion}"
                           Style="{StaticResource AdvLocalizedLabelText}"
                           VerticalAlignment="Top" />

                <StackPanel Grid.Row="8"
                            Grid.Column="2"
                            MinWidth="0">

                    <Border MinHeight="32"
                            Style="{StaticResource R3ValuePill}"
                            FlowDirection="LeftToRight">

                        <TextBlock Text="{Binding Advanced.CatVer}"
                                   Style="{StaticResource R3TechnicalValueText}" />
                    </Border>

                    <TextBlock Text="{Binding RecStat}"
                               Style="{StaticResource AdvLocalizedDescriptionText}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource R3SettingsSection}"
                Margin="0"
                Padding="16"
                FlowDirection="{DynamicResource App.FlowDirection}">

            <Grid FlowDirection="{DynamicResource App.FlowDirection}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{lang:TextExt Key=Adv.SessionLog}"
                           Style="{StaticResource AdvLocalizedRowTitleText}" />

                <TextBox Grid.Row="2"
                         Text="{Binding Advanced.LogText, Mode=OneWay}"
                         Style="{StaticResource TechnicalTextBox}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="{DynamicResource Type.Font.Technical}"
                         FontSize="12" />

                <Grid Grid.Row="4"
                      FlowDirection="{DynamicResource App.FlowDirection}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{lang:TextExt Key=Adv.CopyLog}"
                            Style="{StaticResource AdvCompactActionButton}"
                            ToolTip="{lang:TextExt Key=Adv.CopyLogTip}"
                            Command="{Binding CopyCmd}"
                            TextBlock.TextAlignment="{DynamicResource App.TextAlignment}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>