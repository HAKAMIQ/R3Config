<Window x:Class="R3Config.View.HCanSavedDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{lang:TextExt Key=HCanary.Stored.Title}"
        Width="720"
        MinWidth="600"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Type.Font.Body}"
        Language="{DynamicResource App.XmlLanguage}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FlowDirection="{DynamicResource App.FlowDirection}">

    <Window.Style>
        <Style TargetType="{x:Type Window}">
            <Setter Property="Height"
                    Value="520" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding HCanary.IsStoredEmpty}"
                             Value="True">
                    <Setter Property="Height"
                            Value="360" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <Style x:Key="HCanSavedLocalizedTitleText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource R3SettingsTitleText}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
        </Style>

        <Style x:Key="HCanSavedLocalizedDescriptionText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource SectionCaptionText}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
        </Style>

        <Style x:Key="HCanSavedLocalizedPatchNameText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource SectionTitleText}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
        </Style>

        <Style x:Key="HCanSavedTechnicalHashText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource TechnicalTextBlock}">
            <Setter Property="FlowDirection"
                    Value="LeftToRight" />
            <Setter Property="TextAlignment"
                    Value="Left" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
            <Setter Property="Language"
                    Value="en-US" />
        </Style>

        <Style x:Key="HCanSavedLocalizedEmptyText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource SectionCaptionText}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource FluentSurface.Dialog}">
        <Grid ClipToBounds="True"
              Language="{DynamicResource App.XmlLanguage}"
              KeyboardNavigation.TabNavigation="Cycle">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    MouseLeftButtonDown="DragWin">

                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource FluentButton.Close}"
                            AutomationProperties.Name="{lang:TextExt Key=Window.CloseTip}"
                            ToolTip="{lang:TextExt Key=Window.CloseTip}"
                            Click="CloseWin"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <Grid Width="14"
                              Height="14"
                              FlowDirection="LeftToRight">

                            <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                                  Stroke="{Binding Foreground,
                                                   RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="{lang:TextExt Key=HCanary.Stored.Title}"
                               Style="{StaticResource HCanSavedLocalizedTitleText}"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{lang:TextExt Key=HCanary.Stored.Description}"
                           Style="{StaticResource HCanSavedLocalizedDescriptionText}"
                           TextWrapping="Wrap" />

                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding HCanary.Patches}"
                             SelectedItem="{Binding HCanary.SelPat}"
                             Style="{StaticResource HCanList}"
                             HorizontalContentAlignment="Stretch"
                             Language="{DynamicResource App.XmlLanguage}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SectionCard}"
                                        Margin="0,0,0,8">

                                    <StackPanel>
                                        <TextBlock Text="{Binding Draft.PatName}"
                                                   Style="{StaticResource HCanSavedLocalizedPatchNameText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Draft.PatName}" />

                                        <TextBlock Text="{Binding Draft.ExeHash}"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource HCanSavedTechnicalHashText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Draft.ExeHash}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Style="{StaticResource EmptyStatePanel}"
                            Visibility="{Binding HCanary.IsStoredEmpty,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">

                        <TextBlock Text="{lang:TextExt Key=HCanary.Stored.Empty}"
                                   Style="{StaticResource HCanSavedLocalizedEmptyText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" TextAlignment="{DynamicResource App.TextAlignment}" />
                    </Border>
                </Grid>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="{lang:TextExt Key=HCanary.Open}"
                            Command="{Binding HCanary.OpenCmd}"
                            Style="{StaticResource FluentButton.Primary}"
                            Click="OpenSelected" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
