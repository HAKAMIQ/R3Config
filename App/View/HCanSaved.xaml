<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Class="R3Config.View.HCanSavedDlg"
        Title="{lang:TextExt Key=HCanary.Stored.Title}"
        Width="720"
        MinWidth="600"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Type.Font.Body}"
        Language="{DynamicResource App.XmlLanguage}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FlowDirection="{DynamicResource App.FlowDirection}">

    <Window.Style>
        <Style TargetType="{x:Type Window}">
            <Setter Property="Height"
                    Value="520" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding HCanary.IsStoredEmpty}"
                             Value="True">
                    <Setter Property="Height"
                            Value="360" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HSSty.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource FluentSurface.Dialog}"
            CornerRadius="{StaticResource Radius.None}">

        <Grid ClipToBounds="True"
              Language="{DynamicResource App.XmlLanguage}"
              KeyboardNavigation.TabNavigation="Cycle">

            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    Padding="0"
                    CornerRadius="{StaticResource Radius.None}"
                    MouseLeftButtonDown="DragWin">

                <Grid Height="32"
                      FlowDirection="LeftToRight"
                      ClipToBounds="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            AutomationProperties.Name="{lang:TextExt Key=Window.CloseTip}"
                            ToolTip="{lang:TextExt Key=Window.CloseTip}"
                            Click="CloseWin"
                            Width="46"
                            Height="32"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            TextBlock.TextAlignment="Center">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource FluentButton.Close.Caption}">
                                <Setter Property="Height"
                                        Value="32" />
                                <Setter Property="MinHeight"
                                        Value="32" />
                            </Style>
                        </Button.Style>

                        <Grid Width="16"
                              Height="16"
                              FlowDirection="LeftToRight"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">

                            <TextBlock Text=""
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="10"
                                       Foreground="{Binding Foreground,
                                                            RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       FlowDirection="LeftToRight"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType" />
                        </Grid>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="{lang:TextExt Key=HCanary.Stored.Title}"
                               Style="{StaticResource HCanSavedLocalizedTitleText}"
                               FlowDirection="{DynamicResource App.TextFlowDirection}"
                               Language="{DynamicResource App.XmlLanguage}"
                               Margin="0,0,14,0"
                               HorizontalAlignment="{DynamicResource App.HorizontalAlignment}"
                               VerticalAlignment="Center"
                               TextAlignment="{DynamicResource App.TextAlignment}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{lang:TextExt Key=HCanary.Stored.Description}"
                           Style="{StaticResource HCanSavedLocalizedDescriptionText}"
                           HorizontalAlignment="Stretch"
                           TextAlignment="{DynamicResource App.TextAlignment}"
                           TextWrapping="Wrap" />

                <Grid Grid.Row="2">

                    <ListBox ItemsSource="{Binding HCanary.Patches}"
                             SelectedItem="{Binding HCanary.SelPat}"
                             Style="{StaticResource HCanList}"
                             Padding="0"
                             HorizontalContentAlignment="Stretch"
                             Language="{DynamicResource App.XmlLanguage}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SectionCard}"
                                        Padding="12"
                                        Margin="0,0,0,8">

                                    <StackPanel>
                                        <TextBlock Text="{Binding Draft.PatName}"
                                                   Style="{StaticResource HCanSavedLocalizedPatchNameText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Draft.PatName}" />

                                        <TextBlock Text="{Binding Draft.ExeHash}"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource HCanSavedTechnicalHashText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Draft.ExeHash}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Style="{StaticResource EmptyStatePanel}"
                            Padding="24"
                            Visibility="{Binding HCanary.IsStoredEmpty,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">

                        <TextBlock Text="{lang:TextExt Key=HCanary.Stored.Empty}"
                                   Style="{StaticResource HCanSavedLocalizedEmptyText}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   TextAlignment="{DynamicResource App.TextAlignment}" />
                    </Border>
                </Grid>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FlowDirection="LeftToRight">

                    <Button Content="{lang:TextExt Key=HCanary.Open}"
                            Command="{Binding HCanary.OpenCmd}"
                            Style="{StaticResource HCanSavedPrimaryActionButton}"
                            Click="OpenSelected"
                            FlowDirection="{DynamicResource App.TextFlowDirection}"
                            TextBlock.TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>