<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lang="clr-namespace:R3Config.Lang">

    <Style x:Key="CanLocalizedTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource R3SettingsTitleText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="CanLocalizedDescriptionText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource R3SettingsDescriptionText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="CanValidationText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource FluentStatus.Text}">
        <Setter Property="Margin"
                Value="0" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="CanResultText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource FluentStatus.Text}">
        <Setter Property="Margin"
                Value="0,8,0,0" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />

        <Style.Triggers>
            <DataTrigger Binding="{Binding VldMsg}"
                         Value="{x:Null}">
                <Setter Property="Margin"
                        Value="0" />
            </DataTrigger>

            <DataTrigger Binding="{Binding VldMsg}"
                         Value="">
                <Setter Property="Margin"
                        Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CanSecondaryActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButton.Secondary}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="MinWidth"
                Value="{StaticResource Button.MinWidth.Standard}" />
        <Setter Property="Height"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="MinHeight"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="Padding"
                Value="{StaticResource Button.Padding.Standard}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextBlock.TextAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="CanPrimaryActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButton.Primary}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="MinWidth"
                Value="{StaticResource Button.MinWidth.Standard}" />
        <Setter Property="Height"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="MinHeight"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="Padding"
                Value="{StaticResource Button.Padding.Standard}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextBlock.TextAlignment"
                Value="Center" />
    </Style>

</ResourceDictionary>