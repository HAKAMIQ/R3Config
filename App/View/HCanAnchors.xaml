<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Class="R3Config.View.HCanAnchorsDlg"
        Title="{lang:TextExt Key=HCanary.Anchors.Title}"
        Width="920"
        Height="520"
        MinWidth="760"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Type.Font.Body}"
        Language="{DynamicResource App.XmlLanguage}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FlowDirection="{DynamicResource App.FlowDirection}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HASty.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource FluentSurface.Dialog}"
            CornerRadius="{StaticResource Radius.None}">

        <Grid ClipToBounds="True"
              Language="{DynamicResource App.XmlLanguage}"
              KeyboardNavigation.TabNavigation="Cycle">

            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    Padding="0"
                    CornerRadius="{StaticResource Radius.None}"
                    MouseLeftButtonDown="DragWin">

                <Grid Height="32"
                      FlowDirection="LeftToRight"
                      ClipToBounds="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            AutomationProperties.Name="{lang:TextExt Key=Window.CloseTip}"
                            ToolTip="{lang:TextExt Key=Window.CloseTip}"
                            Click="CloseWin"
                            Width="46"
                            Height="32"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            TextBlock.TextAlignment="Center">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource FluentButton.Close.Caption}">
                                <Setter Property="Height"
                                        Value="32" />
                                <Setter Property="MinHeight"
                                        Value="32" />
                            </Style>
                        </Button.Style>

                        <Grid Width="16"
                              Height="16"
                              FlowDirection="LeftToRight"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">

                            <TextBlock Text=""
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="10"
                                       Foreground="{Binding Foreground,
                                                            RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       FlowDirection="LeftToRight"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType" />
                        </Grid>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="{lang:TextExt Key=HCanary.Anchors.Title}"
                               Style="{StaticResource HCanAnchorsLocalizedTitleText}"
                               FlowDirection="{DynamicResource App.TextFlowDirection}"
                               Language="{DynamicResource App.XmlLanguage}"
                               Margin="0,0,14,0"
                               HorizontalAlignment="{DynamicResource App.HorizontalAlignment}"
                               VerticalAlignment="Center"
                               TextAlignment="{DynamicResource App.TextAlignment}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{lang:TextExt Key=HCanary.Anchors.Description}"
                           Style="{StaticResource HCanAnchorsLocalizedDescriptionText}"
                           HorizontalAlignment="Stretch"
                           TextAlignment="{DynamicResource App.TextAlignment}"
                           TextWrapping="Wrap" />

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0"
                                 ItemsSource="{Binding HCanary.Anchors}"
                                 SelectedItem="{Binding HCanary.SelAnc}"
                                 Style="{StaticResource HCanList}"
                                 Padding="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="32">
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="8,0"
                                                   Style="{StaticResource HCanAnchorsTechnicalListText}"
                                                   ToolTip="{Binding Name}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FlowDirection="LeftToRight">

                            <Button Content="{lang:TextExt Key=HCanary.AddAnchor}"
                                    Command="{Binding HCanary.AddACmd}"
                                    Style="{StaticResource HCanAnchorsActionButton}"
                                    ToolTip="{lang:TextExt Key=HCanary.AddAnchor}"
                                    AutomationProperties.Name="{lang:TextExt Key=HCanary.AddAnchor}"
                                    FlowDirection="{DynamicResource App.TextFlowDirection}"
                                    TextBlock.TextAlignment="Center" />

                            <Button Content="{lang:TextExt Key=HCanary.Delete}"
                                    Command="{Binding HCanary.DelACmd}"
                                    Style="{StaticResource HCanAnchorsActionButton}"
                                    ToolTip="{lang:TextExt Key=HCanary.Delete}"
                                    AutomationProperties.Name="{lang:TextExt Key=HCanary.Delete}"
                                    FlowDirection="{DynamicResource App.TextFlowDirection}"
                                    TextBlock.TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="2">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0"
                                 Height="32"
                                 MinHeight="32"
                                 Padding="8,4"
                                 Text="{Binding HCanary.SelAnc.Name,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TechnicalTextBox}"
                                 ToolTip="{lang:TextExt Key=HCanary.Tooltip.Anchor}"
                                 VerticalContentAlignment="Center" />

                        <DataGrid Grid.Row="2"
                                  Style="{StaticResource FluentDataGrid}"
                                  ItemsSource="{Binding HCanary.SelAnc.Ins}"
                                  SelectedItem="{Binding HCanary.AncIns}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  RowHeight="40"
                                  MinRowHeight="40"
                                  ColumnHeaderHeight="32"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  FlowDirection="{DynamicResource App.FlowDirection}"
                                  ColumnHeaderStyle="{StaticResource HCanAnchorsCenteredHeader}"
                                  SelectionChanged="DataGrid_SelectionChanged">

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="{lang:TextExt Key=HCanary.Instructions.Operation}"
                                                        Width="135"
                                                        MinWidth="120"
                                                        MaxWidth="150">

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Height="32"
                                                      MinHeight="32"
                                                      Margin="4"
                                                      Padding="8,0"
                                                      ItemsSource="{Binding DataContext.HCanary.Op,
                                                                            RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      SelectedItem="{Binding Op,
                                                                             Mode=TwoWay,
                                                                             UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource HCanBox}"
                                                      FlowDirection="{DynamicResource TechnicalText.FlowDirection}"
                                                      HorizontalContentAlignment="{DynamicResource TechnicalText.HorizontalAlignment}"
                                                      VerticalContentAlignment="Center"
                                                      Language="{DynamicResource TechnicalText.Language}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Binding="{Binding Address,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}"
                                                    Width="2*"
                                                    MinWidth="170"
                                                    ElementStyle="{StaticResource HCanAnchorsTechnicalCellText}"
                                                    EditingElementStyle="{StaticResource HCanAnchorsTechnicalCellEditor}">

                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Instructions.Address}"
                                                   ToolTip="{lang:TextExt Key=HCanary.Instructions.Address}"
                                                   Style="{StaticResource HCanAnchorsShortHeaderText}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding Value,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}"
                                                    Width="2*"
                                                    MinWidth="160"
                                                    ElementStyle="{StaticResource HCanAnchorsTechnicalCellText}"
                                                    EditingElementStyle="{StaticResource HCanAnchorsTechnicalCellEditor}">

                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Instructions.Value}"
                                                   ToolTip="{lang:TextExt Key=HCanary.Instructions.Value}"
                                                   Style="{StaticResource HCanAnchorsShortHeaderText}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Validation.Label}"
                                                    Binding="{Binding Error}"
                                                    IsReadOnly="True"
                                                    Width="1.4*"
                                                    MinWidth="130"
                                                    ElementStyle="{StaticResource HCanAnchorsLocalizedCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FlowDirection="LeftToRight">

                            <Button Content="{lang:TextExt Key=HCanary.AddInstruction}"
                                    Command="{Binding HCanary.AncAdd}"
                                    Style="{StaticResource HCanAnchorsActionButton}"
                                    ToolTip="{lang:TextExt Key=HCanary.AddInstruction}"
                                    AutomationProperties.Name="{lang:TextExt Key=HCanary.AddInstruction}"
                                    FlowDirection="{DynamicResource App.TextFlowDirection}"
                                    TextBlock.TextAlignment="Center" />

                            <Button Content="{lang:TextExt Key=HCanary.Delete}"
                                    Command="{Binding HCanary.AncDel}"
                                    Style="{StaticResource HCanAnchorsActionButton}"
                                    ToolTip="{lang:TextExt Key=HCanary.Delete}"
                                    AutomationProperties.Name="{lang:TextExt Key=HCanary.Delete}"
                                    FlowDirection="{DynamicResource App.TextFlowDirection}"
                                    TextBlock.TextAlignment="Center" />

                            <Button Content="{lang:TextExt Key=HCanary.LoadAnchor}"
                                    Command="{Binding HCanary.AncLoad}"
                                    Style="{StaticResource HCanAnchorsActionButton}"
                                    ToolTip="{lang:TextExt Key=HCanary.LoadAnchor}"
                                    AutomationProperties.Name="{lang:TextExt Key=HCanary.LoadAnchor}"
                                    FlowDirection="{DynamicResource App.TextFlowDirection}"
                                    TextBlock.TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>