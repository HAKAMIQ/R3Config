<Window x:Class="R3Config.View.HCanAnchorsDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{lang:TextExt Key=HCanary.Anchors.Title}"
        Width="920"
        Height="560"
        MinWidth="760"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Type.Font.Body}"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource FluentSurface.Dialog}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    MouseLeftButtonDown="DragWin">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{lang:TextExt Key=HCanary.Anchors.Title}"
                               Style="{StaticResource R3SettingsTitleText}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Style="{StaticResource FluentButton.Close}"
                            AutomationProperties.Name="{lang:TextExt Key=Window.CloseTip}"
                            ToolTip="{lang:TextExt Key=Window.CloseTip}"
                            Click="CloseWin"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="14" Height="14">
                            <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{lang:TextExt Key=HCanary.Anchors.Description}"
                           Style="{StaticResource SectionCaptionText}"
                           TextWrapping="Wrap" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.34*"
                                          MinWidth="220"
                                          MaxWidth="300" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*"
                                          MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0"
                                 ItemsSource="{Binding HCanary.Anchors}"
                                 SelectedItem="{Binding HCanary.SelAnc}"
                                 DisplayMemberPath="Name"
                                 FlowDirection="LeftToRight"
                                 Style="{StaticResource HCanList}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

                        <WrapPanel Grid.Row="2"
                                   HorizontalAlignment="Left">
                            <Button Content="{lang:TextExt Key=HCanary.AddAnchor}"
                                    Command="{Binding HCanary.AddACmd}"
                                    Style="{StaticResource FluentButton.Toolbar}" />

                            <Button Content="{lang:TextExt Key=HCanary.Delete}"
                                    Command="{Binding HCanary.DelACmd}"
                                    Style="{StaticResource FluentButton.Compact}" />
                        </WrapPanel>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0"
                                 Text="{Binding HCanary.SelAnc.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TechnicalTextBox}"
                                 ToolTip="{lang:TextExt Key=HCanary.Tooltip.Anchor}" />

                        <DataGrid Grid.Row="2"
                                  Style="{StaticResource FluentDataGrid}"
                                  ItemsSource="{Binding HCanary.SelAnc.Ins}"
                                  SelectedItem="{Binding HCanary.AncIns}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  FlowDirection="LeftToRight"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{lang:TextExt Key=HCanary.Instructions.Operation}"
                                                        Width="Auto"
                                                        MinWidth="130"
                                                        MaxWidth="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.HCanary.Op, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      SelectedItem="{Binding Op, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource HCanBox}"
                                                      FlowDirection="LeftToRight" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Instructions.Address}"
                                                    Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="2*"
                                                    MinWidth="170" />

                                <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Instructions.Value}"
                                                    Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="2*"
                                                    MinWidth="160" />

                                <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Validation.Label}"
                                                    Binding="{Binding Error}"
                                                    IsReadOnly="True"
                                                    Width="2*"
                                                    MinWidth="180"
                                                    ElementStyle="{StaticResource DataGridCellLocalizedText}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="4"
                                   HorizontalAlignment="Left">
                            <Button Content="{lang:TextExt Key=HCanary.AddInstruction}"
                                    Command="{Binding HCanary.AncAdd}"
                                    Style="{StaticResource FluentButton.Toolbar}" />

                            <Button Content="{lang:TextExt Key=HCanary.Delete}"
                                    Command="{Binding HCanary.AncDel}"
                                    Style="{StaticResource FluentButton.Toolbar}" />

                            <Button Content="{lang:TextExt Key=HCanary.LoadAnchor}"
                                    Command="{Binding HCanary.AncLoad}"
                                    Style="{StaticResource FluentButton.Compact}" />
                        </WrapPanel>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
