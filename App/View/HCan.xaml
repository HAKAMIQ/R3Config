<Window x:Class="R3Config.View.HCanDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:R3Config.Ctrl"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{lang:TextExt Key=HCanary.Title}"
        Width="780"
        Height="480"
        MinWidth="600"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Type.Font.Body}"
        Language="{DynamicResource App.XmlLanguage}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FlowDirection="{DynamicResource App.FlowDirection}">

    <Window.Resources>
        <Style x:Key="HCanLocalizedTitleText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource R3SettingsTitleText}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource FluentSurface.Dialog}">
        <Grid ClipToBounds="True"
              Language="{DynamicResource App.XmlLanguage}"
              KeyboardNavigation.TabNavigation="Cycle">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    MouseLeftButtonDown="DragWin">

                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource FluentButton.Close}"
                            AutomationProperties.Name="{lang:TextExt Key=Window.CloseTip}"
                            ToolTip="{lang:TextExt Key=Window.CloseTip}"
                            Click="CloseWin"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <Grid Width="14"
                              Height="14"
                              FlowDirection="LeftToRight">

                            <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                                  Stroke="{Binding Foreground,
                                                   RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="{lang:TextExt Key=HCanary.Title}"
                               Style="{StaticResource HCanLocalizedTitleText}"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </Grid>
            </Border>

            <controls:HCanView Grid.Row="1"
                               Margin="12"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               FlowDirection="{Binding FlowDirection,
                                                       RelativeSource={RelativeSource AncestorType=Window}}"
                               Language="{DynamicResource App.XmlLanguage}" />
        </Grid>
    </Border>
</Window>