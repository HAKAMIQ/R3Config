<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:R3Config.Ctrl"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Class="R3Config.View.HCanDlg"
        Title="{lang:TextExt Key=HCanary.Title}"
        Width="780"
        Height="480"
        MinWidth="600"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Type.Font.Body}"
        Language="{DynamicResource App.XmlLanguage}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FlowDirection="{DynamicResource App.FlowDirection}">

    <Window.Resources>
        <Style x:Key="HCanLocalizedTitleText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource R3SettingsTitleText}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource FluentSurface.Dialog}"
            CornerRadius="{StaticResource Radius.None}">

        <Grid ClipToBounds="True"
              Language="{DynamicResource App.XmlLanguage}"
              KeyboardNavigation.TabNavigation="Cycle"
              FlowDirection="{Binding FlowDirection,
                                      RelativeSource={RelativeSource AncestorType={x:Type Window}}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    Padding="0"
                    CornerRadius="{StaticResource Radius.None}"
                    MouseLeftButtonDown="DragWin">

                <Grid Height="32"
                      FlowDirection="LeftToRight"
                      ClipToBounds="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            AutomationProperties.Name="{lang:TextExt Key=Window.CloseTip}"
                            ToolTip="{lang:TextExt Key=Window.CloseTip}"
                            Click="CloseWin"
                            Width="46"
                            Height="32"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            TextBlock.TextAlignment="Center">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource FluentButton.Close.Caption}">
                                <Setter Property="Height"
                                        Value="32" />
                                <Setter Property="MinHeight"
                                        Value="32" />
                            </Style>
                        </Button.Style>

                        <Grid Width="16"
                              Height="16"
                              FlowDirection="LeftToRight"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">

                            <TextBlock Text=""
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="10"
                                       Foreground="{Binding Foreground,
                                                            RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       FlowDirection="LeftToRight"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType" />
                        </Grid>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="{lang:TextExt Key=HCanary.Title}"
                               Style="{StaticResource HCanLocalizedTitleText}"
                               FlowDirection="{DynamicResource App.TextFlowDirection}"
                               Language="{DynamicResource App.XmlLanguage}"
                               Margin="14,0"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               TextAlignment="{DynamicResource App.TextAlignment}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </Grid>
            </Border>

            <controls:HCanView Grid.Row="1"
                               Margin="16"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               FlowDirection="{Binding FlowDirection,
                                                       RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Language="{DynamicResource App.XmlLanguage}" />
        </Grid>
    </Border>
</Window>