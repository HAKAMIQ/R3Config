<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Class="R3Config.View.HCanTargetsDlg"
        Title="{lang:TextExt Key=HCanary.Targets.Title}"
        Width="820"
        Height="520"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Type.Font.Body}"
        Language="{DynamicResource App.XmlLanguage}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FlowDirection="{DynamicResource App.FlowDirection}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HCanTargetsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource FluentSurface.Dialog}"
            CornerRadius="{StaticResource Radius.None}">

        <Grid ClipToBounds="True"
              Language="{DynamicResource App.XmlLanguage}"
              KeyboardNavigation.TabNavigation="Cycle">

            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    Padding="0"
                    CornerRadius="{StaticResource Radius.None}"
                    MouseLeftButtonDown="DragWin">

                <Grid Height="40"
                      FlowDirection="{DynamicResource App.CaptionButtonsFlowDirection}"
                      ClipToBounds="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            AutomationProperties.Name="{lang:TextExt Key=Window.CloseTip}"
                            ToolTip="{lang:TextExt Key=Window.CloseTip}"
                            Click="CloseWin"
                            Width="46"
                            Height="40"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            TextBlock.TextAlignment="Center">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource FluentButton.Close.Caption}" />
                        </Button.Style>

                        <Grid Width="14"
                              Height="14"
                              FlowDirection="LeftToRight">

                            <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                                  Stroke="{Binding Foreground,
                                                   RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <TextBlock Grid.Column="0"
                               Text="{lang:TextExt Key=HCanary.Targets.Title}"
                               Style="{StaticResource HCanTargetsLocalizedTitleText}"
                               FlowDirection="{DynamicResource App.TextFlowDirection}"
                               Language="{DynamicResource App.XmlLanguage}"
                               Margin="14,0"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               TextAlignment="{DynamicResource App.TextAlignment}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="16"
                  FlowDirection="{DynamicResource App.FlowDirection}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{lang:TextExt Key=HCanary.Targets.Description}"
                           Style="{StaticResource HCanTargetsLocalizedDescriptionText}"
                           HorizontalAlignment="Stretch"
                           TextAlignment="{DynamicResource App.TextAlignment}"
                           TextWrapping="Wrap" />

                <DataGrid Grid.Row="2"
                          Style="{StaticResource FluentDataGrid}"
                          ItemsSource="{Binding HCanary.Games}"
                          SelectedItem="{Binding HCanary.GameTgt}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          FlowDirection="{Binding FlowDirection,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                          Language="{DynamicResource App.XmlLanguage}"
                          ColumnHeaderStyle="{StaticResource HCanTargetsCenteredHeader}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Field.GameName}"
                                            Binding="{Binding GameName,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                            Width="2*"
                                            MinWidth="190"
                                            ElementStyle="{StaticResource HCanTargetsLocalizedCellText}"
                                            EditingElementStyle="{StaticResource HCanTargetsLocalizedCellEditor}" />

                        <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Targets.GameId}"
                                            Binding="{Binding GameId,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                            Width="Auto"
                                            MinWidth="120"
                                            MaxWidth="160"
                                            ElementStyle="{StaticResource HCanTargetsTechnicalCellText}"
                                            EditingElementStyle="{StaticResource HCanTargetsTechnicalCellEditor}" />

                        <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Field.GameVersion}"
                                            Binding="{Binding GameVer,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                            Width="Auto"
                                            MinWidth="110"
                                            MaxWidth="150"
                                            ElementStyle="{StaticResource HCanTargetsTechnicalCellText}"
                                            EditingElementStyle="{StaticResource HCanTargetsTechnicalCellEditor}" />

                        <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Validation.Label}"
                                            Binding="{Binding Error}"
                                            IsReadOnly="True"
                                            Width="2*"
                                            MinWidth="210"
                                            ElementStyle="{StaticResource HCanTargetsLocalizedCellText}" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FlowDirection="LeftToRight">

                    <Button Content="{lang:TextExt Key=HCanary.Add}"
                            Command="{Binding HCanary.AddGmCmd}"
                            Style="{StaticResource HCanTargetsActionButton}"
                            ToolTip="{lang:TextExt Key=HCanary.Add}"
                            AutomationProperties.Name="{lang:TextExt Key=HCanary.Add}"
                            FlowDirection="{DynamicResource App.TextFlowDirection}"
                            TextBlock.TextAlignment="Center" />

                    <Button Content="{lang:TextExt Key=HCanary.Delete}"
                            Command="{Binding HCanary.DelGmCmd}"
                            Style="{StaticResource HCanTargetsActionButton}"
                            ToolTip="{lang:TextExt Key=HCanary.Delete}"
                            AutomationProperties.Name="{lang:TextExt Key=HCanary.Delete}"
                            FlowDirection="{DynamicResource App.TextFlowDirection}"
                            TextBlock.TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>