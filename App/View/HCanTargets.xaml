<Window x:Class="R3Config.View.HCanTargetsDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{lang:TextExt Key=HCanary.Targets.Title}"
        Width="820"
        Height="520"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Type.Font.Body}"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource FluentSurface.Dialog}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3DialogTopBar}"
                    MouseLeftButtonDown="DragWin">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{lang:TextExt Key=HCanary.Targets.Title}"
                               Style="{StaticResource R3SettingsTitleText}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Style="{StaticResource FluentButton.Close}"
                            AutomationProperties.Name="{lang:TextExt Key=Window.CloseTip}"
                            ToolTip="{lang:TextExt Key=Window.CloseTip}"
                            Click="CloseWin"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="14" Height="14">
                            <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{lang:TextExt Key=HCanary.Targets.Description}"
                           Style="{StaticResource SectionCaptionText}"
                           TextWrapping="Wrap" />

                <DataGrid Grid.Row="2"
                          Style="{StaticResource FluentDataGrid}"
                          ItemsSource="{Binding HCanary.Games}"
                          SelectedItem="{Binding HCanary.GameTgt}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          FlowDirection="LeftToRight"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Field.GameName}"
                                            Binding="{Binding GameName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="2*"
                                            MinWidth="190" />

                        <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Field.GameId}"
                                            Binding="{Binding GameId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="Auto"
                                            MinWidth="120"
                                            MaxWidth="160" />

                        <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Field.GameVersion}"
                                            Binding="{Binding GameVer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="Auto"
                                            MinWidth="110"
                                            MaxWidth="150" />

                        <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Validation.Label}"
                                            Binding="{Binding Error}"
                                            IsReadOnly="True"
                                            Width="2*"
                                            MinWidth="210"
                                            ElementStyle="{StaticResource DataGridCellLocalizedText}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{lang:TextExt Key=HCanary.Add}"
                            Command="{Binding HCanary.AddGmCmd}"
                            Style="{StaticResource FluentButton.Toolbar}" />

                    <Button Grid.Column="2"
                            Content="{lang:TextExt Key=HCanary.Delete}"
                            Command="{Binding HCanary.DelGmCmd}"
                            Style="{StaticResource FluentButton.Compact}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
