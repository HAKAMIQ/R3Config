<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lang="clr-namespace:R3Config.Lang">

    <Style x:Key="HCanTargetsLocalizedTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource R3SettingsTitleText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
    </Style>

    <Style x:Key="HCanTargetsLocalizedDescriptionText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource SectionCaptionText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
    </Style>

    <Style x:Key="HCanTargetsLocalizedCellText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource DataGridCellLocalizedText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="HCanTargetsLocalizedCellEditor"
           TargetType="{x:Type TextBox}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalContentAlignment"
                Value="{DynamicResource App.HorizontalAlignment}" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Language"
                Value="{DynamicResource App.XmlLanguage}" />
    </Style>

    <Style x:Key="HCanTargetsTechnicalCellText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource DataGridCellTextLeft}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource TechnicalText.FlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource TechnicalText.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Language"
                Value="{DynamicResource TechnicalText.Language}" />
    </Style>

    <Style x:Key="HCanTargetsTechnicalCellEditor"
           TargetType="{x:Type TextBox}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource TechnicalText.FlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource TechnicalText.TextAlignment}" />
        <Setter Property="HorizontalContentAlignment"
                Value="{DynamicResource TechnicalText.HorizontalAlignment}" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Language"
                Value="{DynamicResource TechnicalText.Language}" />
    </Style>

    <Style x:Key="HCanTargetsCenteredHeader"
           TargetType="{x:Type DataGridColumnHeader}"
           BasedOn="{StaticResource DataGridHeaderUi}">
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="TextBlock.TextAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="HCanTargetsActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButton.Compact}">
        <Setter Property="MinWidth"
                Value="72" />
        <Setter Property="MinHeight"
                Value="30" />
        <Setter Property="Height"
                Value="30" />
        <Setter Property="Padding"
                Value="10,3" />
        <Setter Property="Margin"
                Value="4,0" />
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="TextBlock.TextAlignment"
                Value="Center" />
    </Style>

</ResourceDictionary>