<UserControl x:Class="R3Config.Ctrl.ActionBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}">
	<Border Style="{StaticResource BottomBarBorder}">
		<Grid Language="{DynamicResource App.XmlLanguage}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid Grid.Row="0"
                  VerticalAlignment="Center"
                  FlowDirection="LeftToRight">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="8" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="10" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="8" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock Grid.Column="0"
                           Text="RPCS3"
                           Style="{StaticResource BottomBarLabelText}"
                           VerticalAlignment="Center" />

				<TextBox Grid.Column="2"
                         Text="{Binding Rpcs3ExePath}"
                         IsReadOnly="True"
                         FlowDirection="{DynamicResource TechnicalText.FlowDirection}"
                         TextAlignment="{DynamicResource TechnicalText.TextAlignment}"
                         ToolTip="{lang:Text Key=Top.Rpcs3Tip}" />

				<Button Grid.Column="4"
                        Content="{lang:Text Key=Btn.Browse}"
                        MinWidth="88"
                        ToolTip="{lang:Text Key=Btn.BrowseTip}"
                        Command="{Binding BrowseRpcs3Command}" />

				<Button Grid.Column="6"
                        Content="{lang:Text Key=Btn.Analyze}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="88"
                        ToolTip="{lang:Text Key=Btn.AnalyzeTip}"
                        Command="{Binding AnalyzeCommand}" />
			</Grid>

			<Grid Grid.Row="2"
                  FlowDirection="LeftToRight">
				<StackPanel Orientation="Horizontal"
                            FlowDirection="LeftToRight"
                            HorizontalAlignment="Left">
					<Button Content="{Binding ToggleLanguageText}"
                            MinWidth="48"
                            ToolTip="{Binding ToggleLanguageToolTip}"
                            Command="{Binding ToggleLanguageCommand}" />

					<Button Content="{lang:Text Key=Action.More}"
                            MinWidth="72"
                            ToolTip="{lang:Text Key=Action.MoreTip}"
                            Command="{Binding ShowAdvancedCommand}" />
				</StackPanel>
			</Grid>
		</Grid>
	</Border>
</UserControl>
