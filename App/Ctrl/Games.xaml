<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             xmlns:local="clr-namespace:R3Config.Ctrl"
             xmlns:svc="clr-namespace:R3Config.Svc"
             x:Class="R3Config.Ctrl.GameList"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="GameListLocalizedCaptionText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource RailCaptionText}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
        </Style>

        <Style x:Key="GameListLocalizedSearchTextBox"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource FluentTextBox.Localized}">
            <Setter Property="Height"
                    Value="32" />
            <Setter Property="MinHeight"
                    Value="32" />
            <Setter Property="Padding"
                    Value="12,0" />
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalContentAlignment"
                    Value="{DynamicResource App.HorizontalAlignment}" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="GameListLocalizedFilterCheckBox"
               TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource GameFilterCheckBox}">
            <Setter Property="MinHeight"
                    Value="32" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
            <Setter Property="HorizontalContentAlignment"
                    Value="{DynamicResource App.HorizontalAlignment}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="TextBlock.TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
        </Style>

        <Style x:Key="GameListLocalizedEmptyText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource ArabicEmptyStateText}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
        </Style>

        <Style x:Key="GameListContentTitleText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource GameRailTitleText}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource TechnicalText.FlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource TechnicalText.TextAlignment}" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
            <Setter Property="Language"
                    Value="{DynamicResource TechnicalText.Language}" />
        </Style>

        <Style x:Key="GameListTechnicalSerialText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource GameRailSerialText}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource TechnicalText.FlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="{DynamicResource TechnicalText.TextAlignment}" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
            <Setter Property="Language"
                    Value="{DynamicResource TechnicalText.Language}" />
        </Style>

        <Style x:Key="GameListCompatibilityLineText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource GameListTechnicalSerialText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CompatibilityLine}"
                             Value="">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource LeftRailBorder}"
            Padding="{StaticResource Space.16.All}"
            FlowDirection="{DynamicResource App.FlowDirection}"
            HorizontalAlignment="Stretch">

        <Grid FlowDirection="{DynamicResource App.FlowDirection}"
              HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Height="32"
                  FlowDirection="{DynamicResource App.FlowDirection}">

                <TextBox AutomationProperties.Name="{lang:TextExt Key=Games.SearchPlaceholder}" Height="32"
                         MinHeight="32"
                         Style="{StaticResource GameListLocalizedSearchTextBox}"
                         Text="{Binding GameList.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{lang:TextExt Key=Games.SearchTip}" />

                <TextBlock Text="{lang:TextExt Key=Games.SearchPlaceholder}"
                           Style="{StaticResource GameListLocalizedCaptionText}"
                           Foreground="{DynamicResource Text.Disabled}"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding GameList.IsSearch, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <CheckBox Grid.Row="2"
                      MinHeight="32"
                      Content="{lang:TextExt Key=Games.FilterDetectedOnly}"
                      Style="{StaticResource GameListLocalizedFilterCheckBox}"
                      IsChecked="{Binding GameList.InR3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="{Binding GameList.Tip}"
                      HorizontalAlignment="Left" Checked="CheckBox_Checked" />

            <Grid Grid.Row="4"
                  FlowDirection="{DynamicResource App.FlowDirection}"
                  HorizontalAlignment="Stretch">

                <ListBox x:Name="GamesList"
                         AutomationProperties.AutomationId="Game.List"
                         ItemsSource="{Binding GameList.Games}"
                         SelectedItem="{Binding GameList.SelGame, Mode=TwoWay}"
                         IsEnabled="{Binding CanSelectGame}"
                         ItemContainerStyle="{StaticResource GameRailItem}"
                         Padding="0"
                         Background="Transparent"
                         BorderThickness="0"
                         FlowDirection="{DynamicResource App.FlowDirection}"
                         Language="{DynamicResource App.XmlLanguage}"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Item">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="28"
                                  Margin="0"
                                  FlowDirection="{DynamicResource TechnicalText.FlowDirection}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="36" Height="36" Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      FlowDirection="LeftToRight">
                                    <Image x:Name="GameIconImage"
                                           svc:GameIcon.Game="{Binding Game}"
                                           Width="0"
                                           Height="0"
                                           Opacity="0"
                                           IsHitTestVisible="False"
                                           Focusable="False"
                                           FlowDirection="LeftToRight" />

                                    <Button x:Name="GameImagePreviewButton"
                                            Margin="0"
                                            Tag="{Binding ElementName=GameIconImage}"
                                            ToolTip="{lang:TextExt Key=Games.ImagePreview}"
                                            AutomationProperties.Name="{lang:TextExt Key=Games.ImagePreview}"
                                            Loaded="ToolTipOwner_Loaded"
                                            Click="GameImagePreview_Click">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource FluentButton.Icon}">
                                                <Setter Property="Width"
                                                        Value="36" />
                                                <Setter Property="Height"
                                                        Value="36" />
                                                <Setter Property="MinWidth"
                                                        Value="36" />
                                                <Setter Property="MinHeight"
                                                        Value="36" />
                                                <Setter Property="Background"
                                                        Value="{DynamicResource Surface.Card}" />
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource Stroke.Subtle}" />
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Text.Secondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source, ElementName=GameIconImage}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="IsEnabled"
                                                                Value="False" />
                                                        <Setter Property="ToolTipService.IsEnabled"
                                                                Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>

                                        <TextBlock Text="&#xE91B;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FlowDirection="LeftToRight"
                                                   IsHitTestVisible="False" />
                                    </Button>
                                </Grid>

                                <StackPanel Grid.Column="1" MinWidth="0"
                                            VerticalAlignment="Center"
                                            FlowDirection="{DynamicResource TechnicalText.FlowDirection}">

                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource GameListContentTitleText}"
                                               FlowDirection="{Binding Title, Converter={StaticResource ContentTextFlowConverter}}"
                                               Language="{Binding Title, Converter={StaticResource ContentTextLanguageConverter}, ConverterCulture=en-US}" />

                                    <TextBlock Text="{Binding Serial}"
                                               Style="{StaticResource GameListTechnicalSerialText}"
                                               Margin="0,2,0,0" />

                                    <TextBlock Text="{Binding CompatibilityLine}"
                                               Style="{StaticResource GameListCompatibilityLineText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Popup x:Name="GameImagePreviewPopup"
                       Placement="Right"
                       HorizontalOffset="12"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       Opened="GameImagePreviewPopup_Opened"
                       Closed="GameImagePreviewPopup_Closed"
                       PreviewKeyDown="GameImagePreviewPopup_PreviewKeyDown">
                    <Border x:Name="GameImagePreviewSurface"
                            Style="{StaticResource FluentSurface.Dialog}"
                            Padding="{StaticResource Space.12.All}"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5"
                            FlowDirection="{DynamicResource App.FlowDirection}">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="GameImagePreviewScale"
                                            ScaleX="0.96"
                                            ScaleY="0.96" />
                        </Border.RenderTransform>

                        <Grid>
                            <Border Background="{DynamicResource Surface.Subtle}"
                                    CornerRadius="{DynamicResource Radius.Large}"
                                    Padding="{StaticResource Space.8.All}"
                                    FlowDirection="LeftToRight">
                                <Image x:Name="GameImagePreviewImage"
                                       Width="480"
                                       Height="270"
                                       Stretch="Uniform"
                                       FlowDirection="LeftToRight"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <Button x:Name="GameImagePreviewCloseButton"
                                    Margin="{StaticResource Space.8.All}"
                                    HorizontalAlignment="{DynamicResource App.TrailingHorizontalAlignment}"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Surface.Overlay}"
                                    BorderBrush="{DynamicResource Stroke.Subtle}"
                                    ToolTip="{lang:TextExt Key=Games.ImagePreviewClose}"
                                    AutomationProperties.Name="{lang:TextExt Key=Games.ImagePreviewClose}"
                                    Loaded="ToolTipOwner_Loaded"
                                    Click="GameImagePreviewClose_Click">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource FluentButton.Icon}">
                                        <Setter Property="Width"
                                                Value="28" />
                                        <Setter Property="Height"
                                                Value="28" />
                                        <Setter Property="MinWidth"
                                                Value="28" />
                                        <Setter Property="MinHeight"
                                                Value="28" />
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="&#xE8BB;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           FlowDirection="LeftToRight"
                                           IsHitTestVisible="False" />
                            </Button>
                        </Grid>
                    </Border>
                </Popup>

                <TextBlock Text="{Binding GameList.EmptyTxt}"
                           Style="{StaticResource GameListLocalizedEmptyText}"
                           VerticalAlignment="Top"
                           Visibility="{Binding GameList.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                           IsHitTestVisible="False"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
