<UserControl x:Class="R3Config.Ctrl.GameList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}">
    <Border Style="{StaticResource LeftRailBorder}"
            HorizontalAlignment="Stretch"
            FlowDirection="{DynamicResource App.FlowDirection}">
        <Grid FlowDirection="{DynamicResource App.FlowDirection}"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  FlowDirection="{DynamicResource App.FlowDirection}"
                  HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{lang:TextExt Key=Games.Title}"
                           Style="{StaticResource RailTitleText}"
                           FlowDirection="{DynamicResource App.TextFlowDirection}"
                           TextAlignment="Left"
                           HorizontalAlignment="Stretch" />

            </Grid>

            <Grid Grid.Row="2"
                  FlowDirection="{DynamicResource App.FlowDirection}"
                  ToolTip="{lang:TextExt Key=Games.SearchTip}">
                <TextBox Style="{StaticResource FluentTextBox.Localized}"
                         Text="{Binding GameList.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{lang:TextExt Key=Games.SearchTip}" />

                <TextBlock Text="{lang:TextExt Key=Games.SearchPlaceholder}"
                           Style="{StaticResource RailCaptionText}"
                           Foreground="{DynamicResource Text.Disabled}"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Stretch"
                           FlowDirection="{DynamicResource App.TextFlowDirection}"
                           TextAlignment="Left"
                           IsHitTestVisible="False"
                           Visibility="{Binding GameList.IsSearch, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <Border Grid.Row="4"
                    Style="{StaticResource GameFilterSurface}"
                    FlowDirection="{DynamicResource App.FlowDirection}"
                    ToolTip="{Binding GameList.Tip}">
                <CheckBox Content="{lang:TextExt Key=Games.FilterDetectedOnly}"
                          Style="{StaticResource GameFilterCheckBox}"
                          IsChecked="{Binding GameList.InR3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          FlowDirection="{DynamicResource App.FlowDirection}"
                          HorizontalContentAlignment="{DynamicResource App.HorizontalAlignment}"
                          HorizontalAlignment="Stretch"
                          ToolTip="{Binding GameList.Tip}" />
            </Border>

            <Grid Grid.Row="6"
                  HorizontalAlignment="Stretch">
                <ListBox ItemsSource="{Binding GameList.Games}"
                         SelectedItem="{Binding GameList.SelGame, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource GameRailItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         FlowDirection="{DynamicResource TechnicalText.FlowDirection}"
                         HorizontalAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ToolTip="{lang:TextExt Key=Games.Tooltip}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0"
                                  FlowDirection="LeftToRight">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource GameRailTitleText}" />

                                    <TextBlock Text="{Binding Serial}"
                                               Style="{StaticResource GameRailSerialText}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding GameList.EmptyTxt}"
                           Style="{StaticResource ArabicEmptyStateText}"
                           FlowDirection="{DynamicResource App.TextFlowDirection}"
                           TextAlignment="Left"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           Visibility="{Binding GameList.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                           IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
