<UserControl x:Class="R3Config.Ctrl.GameList" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lang="clr-namespace:R3Config.Lang" FlowDirection="{DynamicResource App.FlowDirection}" Language="{DynamicResource App.XmlLanguage}" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="GameListLocalizedTitleText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource RailTitleText}">
            <Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment" Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="GameListLocalizedCaptionText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource RailCaptionText}">
            <Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment" Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="GameListLocalizedSearchTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource FluentTextBox.Localized}">
            <Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment" Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalContentAlignment" Value="{DynamicResource App.HorizontalAlignment}" />
        </Style>

        <Style x:Key="GameListLocalizedFilterCheckBox" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource GameFilterCheckBox}">
            <Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="{DynamicResource App.HorizontalAlignment}" />
        </Style>

        <Style x:Key="GameListLocalizedEmptyText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ArabicEmptyStateText}">
            <Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment" Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="GameListTechnicalTitleText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource GameRailTitleText}">
            <Setter Property="FlowDirection" Value="{DynamicResource TechnicalText.FlowDirection}" />
            <Setter Property="TextAlignment" Value="{DynamicResource TechnicalText.TextAlignment}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Language" Value="{DynamicResource TechnicalText.Language}" />
        </Style>

        <Style x:Key="GameListTechnicalSerialText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource GameRailSerialText}">
            <Setter Property="FlowDirection" Value="{DynamicResource TechnicalText.FlowDirection}" />
            <Setter Property="TextAlignment" Value="{DynamicResource TechnicalText.TextAlignment}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Language" Value="{DynamicResource TechnicalText.Language}" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource LeftRailBorder}" FlowDirection="{DynamicResource App.FlowDirection}" HorizontalAlignment="Stretch">

        <Grid FlowDirection="{DynamicResource App.FlowDirection}" HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{lang:TextExt Key=Games.Title}" Style="{StaticResource GameListLocalizedTitleText}" />

            <Grid Grid.Row="2" FlowDirection="{DynamicResource App.FlowDirection}">

                <TextBox Style="{StaticResource GameListLocalizedSearchTextBox}" Text="{Binding GameList.Text,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}" ToolTip="{lang:TextExt Key=Games.SearchTip}" />

                <TextBlock Text="{lang:TextExt Key=Games.SearchPlaceholder}" Style="{StaticResource GameListLocalizedCaptionText}" Foreground="{DynamicResource Text.Disabled}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding GameList.IsSearch,
                                                Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <CheckBox Content="{lang:TextExt Key=Games.FilterDetectedOnly}" Style="{StaticResource GameListLocalizedFilterCheckBox}" IsChecked="{Binding GameList.InR3,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding GameList.Tip}" Grid.Row="4" VerticalAlignment="Center" Margin="0,2" HorizontalAlignment="Left" />

            <Grid Grid.Row="6" FlowDirection="{DynamicResource App.FlowDirection}" HorizontalAlignment="Stretch">

                <ListBox ItemsSource="{Binding GameList.Games}" SelectedItem="{Binding GameList.SelGame, Mode=TwoWay}" ItemContainerStyle="{StaticResource GameRailItem}" Background="Transparent" BorderThickness="0" FlowDirection="{DynamicResource App.FlowDirection}" Language="{DynamicResource App.XmlLanguage}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ToolTip="{lang:TextExt Key=Games.Tooltip}" ScrollViewer.CanContentScroll="True">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel MinWidth="0" FlowDirection="{DynamicResource TechnicalText.FlowDirection}">

                                <TextBlock Text="{Binding Title}" Style="{StaticResource GameListTechnicalTitleText}" />

                                <TextBlock Text="{Binding Serial}" Style="{StaticResource GameListTechnicalSerialText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding GameList.EmptyTxt}" Style="{StaticResource GameListLocalizedEmptyText}" VerticalAlignment="Top" Visibility="{Binding GameList.IsEmpty,
                                                Converter={StaticResource BoolToVisibilityConverter}}" IsHitTestVisible="False" Margin="8,12,8,0" TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
