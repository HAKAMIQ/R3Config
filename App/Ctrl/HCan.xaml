<UserControl x:Class="R3Config.Ctrl.HCanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource SectionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            FlowDirection="{DynamicResource App.FlowDirection}">
                    <TextBlock Text="{lang:TextExt Key=HCanary.Title}"
                               Style="{StaticResource SectionTitleText}"
                               TextAlignment="Left"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{lang:TextExt Key=HCanary.Description}"
                               Style="{StaticResource SectionCaptionText}"
                               Margin="0,4,0,0"
                               TextAlignment="Left"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding HCanary.Msg}"
                               Style="{StaticResource SectionCaptionText}"
                               Margin="0,4,0,0"
                               TextAlignment="Left"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="2"
                      FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{lang:TextExt Key=HCanary.New}"
                            Command="{Binding HCanary.NewCmd}"
                            MinWidth="110"
                            MinHeight="32" />

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding HCanary.Patches}"
                              SelectedItem="{Binding HCanary.SelPat}"
                              DisplayMemberPath="DisplayName"
                              FlowDirection="LeftToRight"
                              HorizontalAlignment="Stretch"
                              Style="{StaticResource HCanBox}" />

                    <Button Grid.Column="4"
                            Content="{lang:TextExt Key=HCanary.Open}"
                            Command="{Binding HCanary.OpenCmd}"
                            MinWidth="110"
                            MinHeight="32" />
                </Grid>
            </Grid>
        </Border>

        <TabControl Grid.Row="2"
                    Style="{StaticResource FluentTabControl}"
                    ItemContainerStyle="{StaticResource FluentTabItem}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

            <TabItem Header="{lang:TextExt Key=HCanary.Tab.Information}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"
                                       MinHeight="150" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="2*"
                                       MinHeight="190"
                                       MaxHeight="270" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{lang:TextExt Key=HCanary.Section.GameHash}"
                                           Style="{StaticResource SectionTitleText}"
                                           TextAlignment="Left" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{lang:TextExt Key=HCanary.Field.GameName}"
                                               Style="{StaticResource RecommendationInlineLabelText}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="2"
                                               Text="{Binding HCanary.GameName}"
                                               Style="{StaticResource RecommendationInlineValueText}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="4"
                                               Text="Game ID"
                                               Style="{StaticResource RecommendationInlineLabelText}"
                                               FlowDirection="LeftToRight"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="6"
                                               Text="{Binding HCanary.GameId}"
                                               Style="{StaticResource TechnicalTextBlock}"
                                               FlowDirection="LeftToRight"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="{lang:TextExt Key=HCanary.Field.GameVersion}"
                                               Style="{StaticResource RecommendationInlineLabelText}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="2"
                                               Text="{Binding HCanary.GameVer}"
                                               Style="{StaticResource TechnicalTextBlock}"
                                               FlowDirection="LeftToRight" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="4"
                                               Text="RPCS3"
                                               Style="{StaticResource RecommendationInlineLabelText}"
                                               FlowDirection="LeftToRight"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="6"
                                               Text="{Binding HCanary.R3Path}"
                                               Style="{StaticResource TechnicalTextBlock}"
                                               FlowDirection="LeftToRight"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding HCanary.R3Path}" />

                                    <TextBlock Grid.Row="4"
                                               Grid.Column="0"
                                               Text="RPCS3.log"
                                               Style="{StaticResource RecommendationInlineLabelText}"
                                               FlowDirection="LeftToRight"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="4"
                                               Grid.Column="2"
                                               Grid.ColumnSpan="5"
                                               Text="{Binding HCanary.LogStat}"
                                               Style="{StaticResource SectionCaptionText}"
                                               TextAlignment="Left"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="{lang:TextExt Key=HCanary.ReadLog}"
                                            Command="{Binding HCanary.ReadCmd}"
                                            MinWidth="130" />

                                    <Button Grid.Column="2"
                                            Content="{lang:TextExt Key=HCanary.UseCurrentGame}"
                                            Command="{Binding HCanary.UseCmd}"
                                            MinWidth="150" />
                                </Grid>

                                <ListBox ItemsSource="{Binding HCanary.Hashes}"
                                         SelectedItem="{Binding HCanary.SelHash}"
                                         Style="{StaticResource HCanList}"
                                         MinHeight="96"
                                         MaxHeight="170"
                                         Margin="0,10,0,0"
                                         FlowDirection="LeftToRight"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Kind}"
                                                           Style="{StaticResource TechnicalTextBlock}"
                                                           FontWeight="SemiBold" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Key}"
                                                           Style="{StaticResource TechnicalTextBlock}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Key}" />

                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding Source}"
                                                           Style="{StaticResource RecommendationMicroMetaText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{lang:TextExt Key=HCanary.Section.PatchData}"
                                           Style="{StaticResource SectionTitleText}"
                                           TextAlignment="Left" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0">
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Field.PatchType}"
                                                   Style="{StaticResource HCanLbl}" />

                                        <ComboBox ItemsSource="{Binding HCanary.PatTypes}"
                                                  SelectedItem="{Binding HCanary.PatType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  FlowDirection="LeftToRight"
                                                  Style="{StaticResource HCanBox}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="2">
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Field.PatchName}"
                                                   Style="{StaticResource HCanLbl}" />

                                        <TextBox Text="{Binding HCanary.PatName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Text="{Binding HCanary.NameErr}"
                                                   Style="{StaticResource HCanErr}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.Column="0">
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Field.ExecutableHash}"
                                                   Style="{StaticResource HCanLbl}" />

                                        <TextBox Text="{Binding HCanary.ExeHash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FlowDirection="LeftToRight"
                                                 TextAlignment="Left" />

                                        <TextBlock Text="{Binding HCanary.HashErr}"
                                                   Style="{StaticResource HCanErr}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.Column="2">
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Field.PatchVersion}"
                                                   Style="{StaticResource HCanLbl}" />

                                        <TextBox Text="{Binding HCanary.PatVer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FlowDirection="LeftToRight"
                                                 TextAlignment="Left" />

                                        <TextBlock Text="{Binding HCanary.VerErr}"
                                                   Style="{StaticResource HCanErr}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4"
                                                Grid.Column="0">
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Field.Author}"
                                                   Style="{StaticResource HCanLbl}" />

                                        <TextBox Text="{Binding HCanary.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4"
                                                Grid.Column="2">
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Field.Group}"
                                                   Style="{StaticResource HCanLbl}"
                                                   ToolTip="{lang:TextExt Key=HCanary.Tooltip.Group}" />

                                        <TextBox Text="{Binding HCanary.Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FlowDirection="LeftToRight"
                                                 TextAlignment="Left"
                                                 ToolTip="{lang:TextExt Key=HCanary.Tooltip.Group}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="6"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3">
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Field.Notes}"
                                                   Style="{StaticResource HCanLbl}" />

                                        <TextBox Text="{Binding HCanary.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"
                                                 MinHeight="72" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="8"
                                                 Grid.Column="0">
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Field.Status}"
                                                   Style="{StaticResource HCanLbl}" />

                                        <ComboBox ItemsSource="{Binding HCanary.Statuses}"
                                                  SelectedItem="{Binding HCanary.Status, Mode=TwoWay}"
                                                  FlowDirection="LeftToRight"
                                                   Style="{StaticResource HCanBox}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="8"
                                                Grid.Column="2">
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Field.Category}"
                                                   Style="{StaticResource HCanLbl}" />

                                        <ComboBox SelectedValue="{Binding HCanary.Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag"
                                                  ToolTip="{lang:TextExt Key=HCanary.Tooltip.Experimental}"
                                                  Style="{StaticResource HCanBox}">
                                            <ComboBoxItem Tag="Regular"
                                                          Content="{lang:TextExt Key=HCanary.Category.Regular}" />
                                            <ComboBoxItem Tag="Experimental"
                                                          Content="{lang:TextExt Key=HCanary.Field.Experimental}" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                    <Border Grid.Row="2"
                            Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{lang:TextExt Key=HCanary.Section.Games}"
                                           Style="{StaticResource SectionTitleText}"
                                           TextAlignment="Left" />

                                <DataGrid Grid.Row="2"
                                          Style="{StaticResource FluentDataGrid}"
                                          ItemsSource="{Binding HCanary.Games}"
                                          SelectedItem="{Binding HCanary.GameTgt}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          FlowDirection="LeftToRight"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Field.GameName}"
                                                            Binding="{Binding GameName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="2*"
                                                            MinWidth="180" />

                                        <DataGridTextColumn Header="Game ID"
                                                            Binding="{Binding GameId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="Auto"
                                                            MinWidth="110"
                                                            MaxWidth="150" />

                                        <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Field.GameVersion}"
                                                            Binding="{Binding GameVer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="Auto"
                                                            MinWidth="100"
                                                            MaxWidth="130" />

                                        <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Validation.Label}"
                                                            Binding="{Binding Error}"
                                                            IsReadOnly="True"
                                                            Width="2*"
                                                            MinWidth="160" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="{lang:TextExt Key=HCanary.Add}"
                                            Command="{Binding HCanary.AddGmCmd}"
                                            MinWidth="96" />

                                    <Button Grid.Column="2"
                                            Content="{lang:TextExt Key=HCanary.Delete}"
                                            Command="{Binding HCanary.DelGmCmd}"
                                            MinWidth="96" />
                                </Grid>
                            </Grid>
                        </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{lang:TextExt Key=HCanary.Tab.Instructions}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{lang:TextExt Key=HCanary.Instructions.Help}"
                               Style="{StaticResource SectionCaptionText}"
                               FlowDirection="{DynamicResource App.FlowDirection}"
                               TextAlignment="Left"
                               TextWrapping="Wrap" />

                    <DataGrid Grid.Row="2"
                              Style="{StaticResource FluentDataGrid}"
                              ItemsSource="{Binding HCanary.Ins}"
                              SelectedItem="{Binding HCanary.SelIns}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              FlowDirection="LeftToRight"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Operation"
                                                    Width="Auto"
                                                    MinWidth="130"
                                                    MaxWidth="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.HCanary.Op, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                  SelectedItem="{Binding Op, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource HCanBox}"
                                                  FlowDirection="LeftToRight" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Address / Anchor"
                                                Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="2*"
                                                MinWidth="160" />

                            <DataGridTextColumn Header="Value"
                                                Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="2*"
                                                MinWidth="140" />

                            <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Validation.Label}"
                                                Binding="{Binding Error}"
                                                IsReadOnly="True"
                                                Width="2*"
                                                MinWidth="180" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="4"
                               HorizontalAlignment="Left">
                        <Button Content="{lang:TextExt Key=HCanary.Add}"
                                Command="{Binding HCanary.AddICmd}"
                                Style="{StaticResource FluentButton.Compact}" />

                        <Button Content="{lang:TextExt Key=HCanary.Delete}"
                                Command="{Binding HCanary.DelICmd}"
                                Style="{StaticResource FluentButton.Compact}" />

                        <Button Content="{lang:TextExt Key=HCanary.Duplicate}"
                                Command="{Binding HCanary.DupICmd}"
                                Style="{StaticResource FluentButton.Compact}" />

                        <Button Content="{lang:TextExt Key=HCanary.MoveUp}"
                                Command="{Binding HCanary.InsUp}"
                                Style="{StaticResource FluentButton.Compact}" />

                        <Button Content="{lang:TextExt Key=HCanary.MoveDown}"
                                Command="{Binding HCanary.InsDown}"
                                Style="{StaticResource FluentButton.Compact}" />
                    </WrapPanel>

                    <TextBlock Grid.Row="6"
                               Text="{lang:TextExt Key=HCanary.Instructions.Example}"
                               Style="{StaticResource TechnicalTextBlock}"
                               FlowDirection="LeftToRight"
                               TextAlignment="Left"
                               TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="{lang:TextExt Key=HCanary.Tab.Anchors}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.34*"
                                          MinWidth="220"
                                          MaxWidth="320" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0"
                             Grid.Column="0"
                             ItemsSource="{Binding HCanary.Anchors}"
                             SelectedItem="{Binding HCanary.SelAnc}"
                             DisplayMemberPath="Name"
                             FlowDirection="LeftToRight"
                             Style="{StaticResource HCanList}" />

                    <WrapPanel Grid.Row="2"
                               Grid.Column="0"
                               HorizontalAlignment="Left">
                        <Button
                                Content="{lang:TextExt Key=HCanary.AddAnchor}"
                                Command="{Binding HCanary.AddACmd}"
                                Style="{StaticResource FluentButton.Compact}" />

                        <Button
                                Content="{lang:TextExt Key=HCanary.Delete}"
                                Command="{Binding HCanary.DelACmd}"
                                Style="{StaticResource FluentButton.Compact}" />
                    </WrapPanel>

                    <Grid Grid.Row="0"
                          Grid.RowSpan="3"
                          Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0"
                                 Text="{Binding HCanary.SelAnc.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Left"
                                 ToolTip="{lang:TextExt Key=HCanary.Tooltip.Anchor}" />

                        <DataGrid Grid.Row="2"
                                  Style="{StaticResource FluentDataGrid}"
                                  ItemsSource="{Binding HCanary.SelAnc.Ins}"
                                  SelectedItem="{Binding HCanary.AncIns}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  FlowDirection="LeftToRight"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Operation"
                                                        Width="Auto"
                                                        MinWidth="130"
                                                        MaxWidth="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.HCanary.Op, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                      SelectedItem="{Binding Op, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource HCanBox}"
                                                      FlowDirection="LeftToRight" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Address"
                                                    Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="2*"
                                                    MinWidth="160" />

                                <DataGridTextColumn Header="Value"
                                                    Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="2*"
                                                    MinWidth="140" />

                                <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Validation.Label}"
                                                    Binding="{Binding Error}"
                                                    IsReadOnly="True"
                                                    Width="2*"
                                                    MinWidth="180" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="4"
                                   HorizontalAlignment="Left">
                            <Button Content="{lang:TextExt Key=HCanary.AddInstruction}"
                                    Command="{Binding HCanary.AncAdd}"
                                    Style="{StaticResource FluentButton.Compact}" />

                            <Button Content="{lang:TextExt Key=HCanary.Delete}"
                                    Command="{Binding HCanary.AncDel}"
                                    Style="{StaticResource FluentButton.Compact}" />

                            <Button Content="{lang:TextExt Key=HCanary.LoadAnchor}"
                                    Command="{Binding HCanary.AncLoad}"
                                    Style="{StaticResource FluentButton.Compact}" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{lang:TextExt Key=HCanary.Tab.Preview}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding HCanary.Preview, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono, Consolas"
                             FlowDirection="LeftToRight"
                             TextAlignment="Left"
                             VerticalContentAlignment="Top" />

                    <TextBox Grid.Column="2"
                             Text="{Binding HCanary.VldSum, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FlowDirection="{DynamicResource App.FlowDirection}"
                             TextAlignment="Left"
                             VerticalContentAlignment="Top" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4"
                Style="{StaticResource BottomBarBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0"
                           HorizontalAlignment="Center">
                    <Button Content="{lang:TextExt Key=HCanary.OpenFolder}"
                            Command="{Binding HCanary.PatDir}"
                            Style="{StaticResource FluentButton.Compact}" />

                    <Button Content="imported_patch.yml"
                            Command="{Binding HCanary.ImpFile}"
                            FlowDirection="LeftToRight"
                            Style="{StaticResource FluentButton.Compact}" />

                    <Button Content="RPCS3"
                            Command="{Binding HCanary.R3Cmd}"
                            FlowDirection="LeftToRight"
                            Style="{StaticResource FluentButton.Compact}" />
                </WrapPanel>

                <WrapPanel Grid.Row="2"
                           HorizontalAlignment="Center">
                    <Button Content="{lang:TextExt Key=HCanary.CopyYaml}"
                            Command="{Binding HCanary.CopyCmd}"
                            Style="{StaticResource FluentButton.Compact}" />

                    <Button Content="{lang:TextExt Key=HCanary.DeletePatch}"
                            Command="{Binding HCanary.DelCmd}"
                            Style="{StaticResource FluentButton.Compact}" />

                    <Button Content="{lang:TextExt Key=HCanary.SaveAs}"
                            Command="{Binding HCanary.SaveAs}"
                            Style="{StaticResource FluentButton.Compact}" />

                    <Button Content="{lang:TextExt Key=HCanary.Save}"
                            Command="{Binding HCanary.SaveCmd}"
                            Style="{StaticResource FluentButton.Primary}"
                            MinWidth="104"
                            MinHeight="32"
                            Margin="4"
                            Padding="12,6" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
