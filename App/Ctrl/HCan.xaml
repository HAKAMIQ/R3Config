<UserControl x:Class="R3Config.Ctrl.HCanaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}">

    <UserControl.Resources>
        <Style x:Key="HCanaryComboBox"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight"
                    Value="32" />
            <Setter Property="Padding"
                    Value="8,3" />
            <Setter Property="Background"
                    Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
        </Style>

        <Style x:Key="HCanaryListBox"
               TargetType="{x:Type ListBox}"
               BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background"
                    Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="4" />
        </Style>

        <Style x:Key="HCanaryFieldLabel"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource RecommendationInlineLabelText}">
            <Setter Property="Margin"
                    Value="0,0,0,5" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.FlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="Justify" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>

        <Style x:Key="HCanaryErrorText"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground"
                    Value="{StaticResource DangerBrush}" />
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="Margin"
                    Value="0,4,0,0" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.FlowDirection}" />
            <Setter Property="TextAlignment"
                    Value="Justify" />
        </Style>

        <Style x:Key="HCanaryActionButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth"
                    Value="104" />
            <Setter Property="MinHeight"
                    Value="32" />
            <Setter Property="Margin"
                    Value="4" />
            <Setter Property="Padding"
                    Value="12,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource SectionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            FlowDirection="{DynamicResource App.FlowDirection}">
                    <TextBlock Text="{lang:Text Key=HCanary.Title}"
                               Style="{StaticResource SectionTitleText}"
                               TextAlignment="Justify"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{lang:Text Key=HCanary.Description}"
                               Style="{StaticResource SectionCaptionText}"
                               Margin="0,4,0,0"
                               TextAlignment="Justify"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding HCanary.StatusMessage}"
                               Style="{StaticResource SectionCaptionText}"
                               Margin="0,4,0,0"
                               TextAlignment="Justify"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="2"
                      FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{lang:Text Key=HCanary.New}"
                            Command="{Binding HCanary.NewCommand}"
                            MinWidth="110"
                            MinHeight="32" />

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding HCanary.StoredPatches}"
                              SelectedItem="{Binding HCanary.SelectedStoredPatch}"
                              DisplayMemberPath="DisplayName"
                              FlowDirection="LeftToRight"
                              HorizontalAlignment="Stretch"
                              Style="{StaticResource HCanaryComboBox}" />

                    <Button Grid.Column="4"
                            Content="{lang:Text Key=HCanary.Open}"
                            Command="{Binding HCanary.OpenStoredCommand}"
                            MinWidth="110"
                            MinHeight="32" />
                </Grid>
            </Grid>
        </Border>

        <TabControl Grid.Row="2"
                    Style="{StaticResource Win11TabControl}"
                    ItemContainerStyle="{StaticResource Win11TabItem}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

            <TabItem Header="{lang:Text Key=HCanary.Tab.Information}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{lang:Text Key=HCanary.Section.GameHash}"
                                           Style="{StaticResource SectionTitleText}"
                                           TextAlignment="Justify" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{lang:Text Key=HCanary.Field.GameName}"
                                               Style="{StaticResource RecommendationInlineLabelText}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="2"
                                               Text="{Binding HCanary.CurrentGameName}"
                                               Style="{StaticResource RecommendationInlineValueText}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="4"
                                               Text="Game ID"
                                               Style="{StaticResource RecommendationInlineLabelText}"
                                               FlowDirection="LeftToRight"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="6"
                                               Text="{Binding HCanary.CurrentGameId}"
                                               Style="{StaticResource TechnicalTextBlock}"
                                               FlowDirection="LeftToRight"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="{lang:Text Key=HCanary.Field.GameVersion}"
                                               Style="{StaticResource RecommendationInlineLabelText}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="2"
                                               Text="{Binding HCanary.CurrentGameVersion}"
                                               Style="{StaticResource TechnicalTextBlock}"
                                               FlowDirection="LeftToRight" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="4"
                                               Text="RPCS3"
                                               Style="{StaticResource RecommendationInlineLabelText}"
                                               FlowDirection="LeftToRight"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="6"
                                               Text="{Binding HCanary.Rpcs3Path}"
                                               Style="{StaticResource TechnicalTextBlock}"
                                               FlowDirection="LeftToRight"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding HCanary.Rpcs3Path}" />

                                    <TextBlock Grid.Row="4"
                                               Grid.Column="0"
                                               Text="RPCS3.log"
                                               Style="{StaticResource RecommendationInlineLabelText}"
                                               FlowDirection="LeftToRight"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="4"
                                               Grid.Column="2"
                                               Grid.ColumnSpan="5"
                                               Text="{Binding HCanary.LogStatus}"
                                               Style="{StaticResource SectionCaptionText}"
                                               TextAlignment="Justify"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="{lang:Text Key=HCanary.ReadLog}"
                                            Command="{Binding HCanary.ReadLogCommand}"
                                            MinWidth="130" />

                                    <Button Grid.Column="2"
                                            Content="{lang:Text Key=HCanary.UseCurrentGame}"
                                            Command="{Binding HCanary.UseSelectedGameCommand}"
                                            MinWidth="150" />
                                </Grid>

                                <ListBox ItemsSource="{Binding HCanary.Hashes}"
                                         SelectedItem="{Binding HCanary.SelectedHash}"
                                         Style="{StaticResource HCanaryListBox}"
                                         MinHeight="96"
                                         MaxHeight="170"
                                         Margin="0,10,0,0"
                                         FlowDirection="LeftToRight"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Kind}"
                                                           Style="{StaticResource TechnicalTextBlock}"
                                                           FontWeight="SemiBold" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Key}"
                                                           Style="{StaticResource TechnicalTextBlock}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Key}" />

                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding Source}"
                                                           Style="{StaticResource RecommendationMicroMetaText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{lang:Text Key=HCanary.Section.PatchData}"
                                           Style="{StaticResource SectionTitleText}"
                                           TextAlignment="Justify" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0">
                                        <TextBlock Text="{lang:Text Key=HCanary.Field.PatchType}"
                                                   Style="{StaticResource HCanaryFieldLabel}" />

                                        <ComboBox ItemsSource="{Binding HCanary.PatchTypes}"
                                                  SelectedItem="{Binding HCanary.PatchType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  FlowDirection="LeftToRight"
                                                  Style="{StaticResource HCanaryComboBox}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="2">
                                        <TextBlock Text="{lang:Text Key=HCanary.Field.PatchName}"
                                                   Style="{StaticResource HCanaryFieldLabel}" />

                                        <TextBox Text="{Binding HCanary.PatchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Text="{Binding HCanary.PatchNameError}"
                                                   Style="{StaticResource HCanaryErrorText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.Column="0">
                                        <TextBlock Text="{lang:Text Key=HCanary.Field.ExecutableHash}"
                                                   Style="{StaticResource HCanaryFieldLabel}" />

                                        <TextBox Text="{Binding HCanary.ExecutableHash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FlowDirection="LeftToRight"
                                                 TextAlignment="Left" />

                                        <TextBlock Text="{Binding HCanary.HashError}"
                                                   Style="{StaticResource HCanaryErrorText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.Column="2">
                                        <TextBlock Text="{lang:Text Key=HCanary.Field.PatchVersion}"
                                                   Style="{StaticResource HCanaryFieldLabel}" />

                                        <TextBox Text="{Binding HCanary.PatchVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FlowDirection="LeftToRight"
                                                 TextAlignment="Left" />

                                        <TextBlock Text="{Binding HCanary.PatchVersionError}"
                                                   Style="{StaticResource HCanaryErrorText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4"
                                                Grid.Column="0">
                                        <TextBlock Text="{lang:Text Key=HCanary.Field.Author}"
                                                   Style="{StaticResource HCanaryFieldLabel}" />

                                        <TextBox Text="{Binding HCanary.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4"
                                                Grid.Column="2">
                                        <TextBlock Text="{lang:Text Key=HCanary.Field.Group}"
                                                   Style="{StaticResource HCanaryFieldLabel}"
                                                   ToolTip="{lang:Text Key=HCanary.Tooltip.Group}" />

                                        <TextBox Text="{Binding HCanary.Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FlowDirection="LeftToRight"
                                                 TextAlignment="Left"
                                                 ToolTip="{lang:Text Key=HCanary.Tooltip.Group}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="6"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3">
                                        <TextBlock Text="{lang:Text Key=HCanary.Field.Notes}"
                                                   Style="{StaticResource HCanaryFieldLabel}" />

                                        <TextBox Text="{Binding HCanary.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"
                                                 MinHeight="72" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="8"
                                                 Grid.Column="0">
                                        <TextBlock Text="{lang:Text Key=HCanary.Field.Status}"
                                                   Style="{StaticResource HCanaryFieldLabel}" />

                                        <ComboBox ItemsSource="{Binding HCanary.Statuses}"
                                                  SelectedItem="{Binding HCanary.Status, Mode=TwoWay}"
                                                  FlowDirection="LeftToRight"
                                                   Style="{StaticResource HCanaryComboBox}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="8"
                                                Grid.Column="2">
                                        <TextBlock Text="{lang:Text Key=HCanary.Field.Category}"
                                                   Style="{StaticResource HCanaryFieldLabel}" />

                                        <ComboBox SelectedValue="{Binding HCanary.PatchCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag"
                                                  ToolTip="{lang:Text Key=HCanary.Tooltip.Experimental}"
                                                  Style="{StaticResource HCanaryComboBox}">
                                            <ComboBoxItem Tag="Regular"
                                                          Content="{lang:Text Key=HCanary.Category.Regular}" />
                                            <ComboBoxItem Tag="Experimental"
                                                          Content="{lang:Text Key=HCanary.Field.Experimental}" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}"
                                Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="150" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{lang:Text Key=HCanary.Section.Games}"
                                           Style="{StaticResource SectionTitleText}"
                                           TextAlignment="Justify" />

                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding HCanary.Games}"
                                          SelectedItem="{Binding HCanary.SelectedGameTarget}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          FlowDirection="LeftToRight"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{lang:Text Key=HCanary.Field.GameName}"
                                                            Binding="{Binding GameName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="*" />

                                        <DataGridTextColumn Header="Game ID"
                                                            Binding="{Binding GameId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="150" />

                                        <DataGridTextColumn Header="{lang:Text Key=HCanary.Field.GameVersion}"
                                                            Binding="{Binding GameVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="130" />

                                        <DataGridTextColumn Header="{lang:Text Key=HCanary.Validation.Label}"
                                                            Binding="{Binding Error}"
                                                            IsReadOnly="True"
                                                            Width="220" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="{lang:Text Key=HCanary.Add}"
                                            Command="{Binding HCanary.AddGameCommand}"
                                            MinWidth="96" />

                                    <Button Grid.Column="2"
                                            Content="{lang:Text Key=HCanary.Delete}"
                                            Command="{Binding HCanary.DeleteGameCommand}"
                                            MinWidth="96" />
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{lang:Text Key=HCanary.Tab.Instructions}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{lang:Text Key=HCanary.Instructions.Help}"
                               Style="{StaticResource SectionCaptionText}"
                               FlowDirection="{DynamicResource App.FlowDirection}"
                               TextAlignment="Justify"
                               TextWrapping="Wrap" />

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding HCanary.Instructions}"
                              SelectedItem="{Binding HCanary.SelectedInstruction}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              FlowDirection="LeftToRight"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Operation"
                                                    Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.HCanary.Operations, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                  SelectedItem="{Binding Operation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource HCanaryComboBox}"
                                                  FlowDirection="LeftToRight" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Address / Anchor"
                                                Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" />

                            <DataGridTextColumn Header="Value"
                                                Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" />

                            <DataGridTextColumn Header="{lang:Text Key=HCanary.Validation.Label}"
                                                Binding="{Binding Error}"
                                                IsReadOnly="True"
                                                Width="240" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <UniformGrid Grid.Row="4"
                                 Rows="1"
                                 Columns="5"
                                 HorizontalAlignment="Stretch">
                        <Button Content="{lang:Text Key=HCanary.Add}"
                                Command="{Binding HCanary.AddInstructionCommand}"
                                Style="{StaticResource HCanaryActionButton}" />

                        <Button Content="{lang:Text Key=HCanary.Delete}"
                                Command="{Binding HCanary.DeleteInstructionCommand}"
                                Style="{StaticResource HCanaryActionButton}" />

                        <Button Content="{lang:Text Key=HCanary.Duplicate}"
                                Command="{Binding HCanary.DuplicateInstructionCommand}"
                                Style="{StaticResource HCanaryActionButton}" />

                        <Button Content="{lang:Text Key=HCanary.MoveUp}"
                                Command="{Binding HCanary.MoveInstructionUpCommand}"
                                Style="{StaticResource HCanaryActionButton}" />

                        <Button Content="{lang:Text Key=HCanary.MoveDown}"
                                Command="{Binding HCanary.MoveInstructionDownCommand}"
                                Style="{StaticResource HCanaryActionButton}" />
                    </UniformGrid>

                    <TextBlock Grid.Row="6"
                               Text="{lang:Text Key=HCanary.Instructions.Example}"
                               Style="{StaticResource TechnicalTextBlock}"
                               FlowDirection="LeftToRight"
                               TextAlignment="Left"
                               TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="{lang:Text Key=HCanary.Tab.Anchors}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0"
                             Grid.Column="0"
                             ItemsSource="{Binding HCanary.Anchors}"
                             SelectedItem="{Binding HCanary.SelectedAnchor}"
                             DisplayMemberPath="Name"
                             FlowDirection="LeftToRight"
                             Style="{StaticResource HCanaryListBox}" />

                    <Grid Grid.Row="2"
                          Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="{lang:Text Key=HCanary.AddAnchor}"
                                Command="{Binding HCanary.AddAnchorCommand}" />

                        <Button Grid.Column="2"
                                Content="{lang:Text Key=HCanary.Delete}"
                                Command="{Binding HCanary.DeleteAnchorCommand}" />
                    </Grid>

                    <Grid Grid.Row="0"
                          Grid.RowSpan="3"
                          Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0"
                                 Text="{Binding HCanary.SelectedAnchor.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Left"
                                 ToolTip="{lang:Text Key=HCanary.Tooltip.Anchor}" />

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding HCanary.SelectedAnchor.Instructions}"
                                  SelectedItem="{Binding HCanary.SelectedAnchorInstruction}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  FlowDirection="LeftToRight"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Operation"
                                                        Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.HCanary.Operations, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                      SelectedItem="{Binding Operation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource HCanaryComboBox}"
                                                      FlowDirection="LeftToRight" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Address"
                                                    Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*" />

                                <DataGridTextColumn Header="Value"
                                                    Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*" />

                                <DataGridTextColumn Header="{lang:Text Key=HCanary.Validation.Label}"
                                                    Binding="{Binding Error}"
                                                    IsReadOnly="True"
                                                    Width="210" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <UniformGrid Grid.Row="4"
                                     Rows="1"
                                     Columns="3"
                                     HorizontalAlignment="Stretch">
                            <Button Content="{lang:Text Key=HCanary.AddInstruction}"
                                    Command="{Binding HCanary.AddAnchorInstructionCommand}"
                                    Style="{StaticResource HCanaryActionButton}" />

                            <Button Content="{lang:Text Key=HCanary.Delete}"
                                    Command="{Binding HCanary.DeleteAnchorInstructionCommand}"
                                    Style="{StaticResource HCanaryActionButton}" />

                            <Button Content="{lang:Text Key=HCanary.LoadAnchor}"
                                    Command="{Binding HCanary.AddAnchorLoadCommand}"
                                    Style="{StaticResource HCanaryActionButton}" />
                        </UniformGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{lang:Text Key=HCanary.Tab.Preview}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding HCanary.YamlPreview, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono, Consolas"
                             FlowDirection="LeftToRight"
                             TextAlignment="Left"
                             VerticalContentAlignment="Top" />

                    <TextBox Grid.Column="2"
                             Text="{Binding HCanary.ValidationSummary, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FlowDirection="{DynamicResource App.FlowDirection}"
                             TextAlignment="Justify"
                             VerticalContentAlignment="Top" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4"
                Style="{StaticResource BottomBarBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0"
                             Rows="1"
                             Columns="3"
                             MaxWidth="520"
                             HorizontalAlignment="Center">
                    <Button Content="{lang:Text Key=HCanary.OpenFolder}"
                            Command="{Binding HCanary.OpenPatchesFolderCommand}"
                            Style="{StaticResource HCanaryActionButton}" />

                    <Button Content="imported_patch.yml"
                            Command="{Binding HCanary.OpenImportedFileCommand}"
                            FlowDirection="LeftToRight"
                            Style="{StaticResource HCanaryActionButton}" />

                    <Button Content="RPCS3"
                            Command="{Binding HCanary.OpenRpcs3Command}"
                            FlowDirection="LeftToRight"
                            Style="{StaticResource HCanaryActionButton}" />
                </UniformGrid>

                <UniformGrid Grid.Row="2"
                             Rows="1"
                             Columns="4"
                             MaxWidth="650"
                             HorizontalAlignment="Center">
                    <Button Content="{lang:Text Key=HCanary.CopyYaml}"
                            Command="{Binding HCanary.CopyYamlCommand}"
                            Style="{StaticResource HCanaryActionButton}" />

                    <Button Content="{lang:Text Key=HCanary.DeletePatch}"
                            Command="{Binding HCanary.DeleteStoredCommand}"
                            Style="{StaticResource HCanaryActionButton}" />

                    <Button Content="{lang:Text Key=HCanary.SaveAs}"
                            Command="{Binding HCanary.SaveAsCommand}"
                            Style="{StaticResource HCanaryActionButton}" />

                    <Button Content="{lang:Text Key=HCanary.Save}"
                            Command="{Binding HCanary.SaveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="104"
                            MinHeight="32"
                            Margin="4"
                            Padding="12,6" />
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
