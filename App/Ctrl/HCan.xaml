<UserControl x:Class="R3Config.Ctrl.HCanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource SectionCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{lang:TextExt Key=HCanary.Workflow.Title}"
                               Style="{StaticResource SectionTitleText}" />

                    <TextBlock Text="{lang:TextExt Key=HCanary.Workflow.Description}"
                               Margin="0,4,0,0"
                               Style="{StaticResource SectionCaptionText}"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding HCanary.Msg}"
                               Margin="0,4,0,0"
                               Style="{StaticResource RecommendationMicroMetaText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding HCanary.Msg}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="{lang:TextExt Key=HCanary.Stored.Manage}"
                        Style="{StaticResource FluentButton.Secondary}"
                        Click="ShowSaved" />

                <Button Grid.Column="4"
                        Content="{lang:TextExt Key=HCanary.New}"
                        Command="{Binding HCanary.NewCmd}"
                        Style="{StaticResource FluentButton.Secondary}"
                        Click="StartDraft" />
            </Grid>
        </Border>

        <TabControl x:Name="Steps"
                    Grid.Row="2"
                    SelectedIndex="0"
                    SelectionChanged="StepChanged"
                    Style="{StaticResource FluentTabControl}"
                    ItemContainerStyle="{StaticResource FluentTabItem}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

            <TabItem x:Name="TargetStep" Header="{lang:TextExt Key=HCanary.Step.Target}">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{lang:TextExt Key=HCanary.Start.Game.Title}"
                                       Style="{StaticResource SectionTitleText}" />

                            <TextBlock Grid.Row="2"
                                       Text="{lang:TextExt Key=HCanary.Start.Game.Description}"
                                       Style="{StaticResource SectionCaptionText}"
                                       TextWrapping="Wrap" />

                            <Border Grid.Row="4"
                                    Style="{StaticResource R3ValuePill}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" MinWidth="0">
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Field.GameName}"
                                                   Style="{StaticResource HCanLbl}" />
                                        <TextBlock Text="{Binding HCanary.GameName}"
                                                   Style="{StaticResource RecommendationInlineValueText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding HCanary.GameName}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Field.GameId}"
                                                   Style="{StaticResource HCanLbl}"
                                                   FlowDirection="LeftToRight"
                                                   Language="{DynamicResource TechnicalText.Language}" />
                                        <TextBlock Text="{Binding HCanary.GameId}"
                                                   Style="{StaticResource TechnicalTextBlock}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Field.GameVersion}"
                                                   Style="{StaticResource HCanLbl}" />
                                        <TextBlock Text="{Binding HCanary.GameVer}"
                                                   Style="{StaticResource TechnicalTextBlock}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{lang:TextExt Key=HCanary.Start.Game.Missing}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource HCanErr}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HCanary.HasGame}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button Grid.Column="2"
                                        Content="{lang:TextExt Key=HCanary.Start.Game.Return}"
                                        Click="ReturnToGames">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}"
                                               BasedOn="{StaticResource FluentButton.Primary}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HCanary.HasGame}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="2"
                                        Content="{lang:TextExt Key=HCanary.UseCurrentGame}"
                                        Command="{Binding HCanary.UseCmd}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}"
                                               BasedOn="{StaticResource FluentButton.Primary}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HCanary.HasGame}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{lang:TextExt Key=HCanary.Start.Hash.Title}"
                                       Style="{StaticResource SectionTitleText}" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{lang:TextExt Key=HCanary.Start.Hash.Description}"
                                           Style="{StaticResource SectionCaptionText}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="2"
                                        Content="{lang:TextExt Key=HCanary.Launch.Action}"
                                        Command="{Binding HCanary.LaunchCmd}"
                                        Style="{StaticResource FluentButton.Primary}"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{lang:TextExt Key=HCanary.Field.PatchType}"
                                               Style="{StaticResource HCanLbl}" />

                                    <ComboBox ItemsSource="{Binding HCanary.PatTypes}"
                                              SelectedItem="{Binding HCanary.PatType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource HCanBox}"
                                              FlowDirection="LeftToRight" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{lang:TextExt Key=HCanary.Field.ExecutableHash}"
                                               Style="{StaticResource HCanLbl}" />

                                    <TextBox Text="{Binding HCanary.ExeHash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TechnicalTextBox}" />
                                </StackPanel>

                                <Button Grid.Column="4"
                                        Content="{lang:TextExt Key=HCanary.ReadLog}"
                                        Command="{Binding HCanary.ReadCmd}"
                                        Style="{StaticResource FluentButton.Secondary}"
                                        VerticalAlignment="Bottom" />
                            </Grid>

                            <TextBlock Grid.Row="6"
                                       Text="{Binding HCanary.HashErr}"
                                       Style="{StaticResource HCanErr}"
                                       Visibility="{Binding HCanary.HasHashInput, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <TextBlock Grid.Row="8"
                                       Text="{Binding HCanary.LogStat}"
                                       Style="{StaticResource SectionCaptionText}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding HCanary.LogStat}" />

                            <ListBox Grid.Row="10"
                                     ItemsSource="{Binding HCanary.Hashes}"
                                     SelectedItem="{Binding HCanary.SelHash}"
                                     Style="{StaticResource HCanList}"
                                     Visibility="{Binding HCanary.HasHash, Converter={StaticResource BoolToVisibilityConverter}}"
                                     FlowDirection="LeftToRight"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Kind}"
                                                       Style="{StaticResource TechnicalTextBlock}"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Key}"
                                                       Style="{StaticResource TechnicalTextBlock}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Key}" />

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding Source}"
                                                       Style="{StaticResource RecommendationMicroMetaText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Expander x:Name="TargetsPanel"
                              Grid.Row="4"
                              Header="{lang:TextExt Key=HCanary.Targets.Manage}"
                              IsExpanded="False">
                        <Border Style="{StaticResource SectionCard}"
                                Margin="0,8,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DataGrid Grid.Row="0"
                                          MaxHeight="180"
                                          Style="{StaticResource FluentDataGrid}"
                                          ItemsSource="{Binding HCanary.Games}"
                                          SelectedItem="{Binding HCanary.GameTgt}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          FlowDirection="LeftToRight"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Field.GameName}"
                                                            Binding="{Binding GameName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="2*"
                                                            MinWidth="190" />
                                        <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Field.GameId}"
                                                            Binding="{Binding GameId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="Auto"
                                                            MinWidth="120"
                                                            MaxWidth="160" />
                                        <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Field.GameVersion}"
                                                            Binding="{Binding GameVer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="Auto"
                                                            MinWidth="110"
                                                            MaxWidth="150" />
                                        <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Validation.Label}"
                                                            Binding="{Binding Error}"
                                                            IsReadOnly="True"
                                                            Width="2*"
                                                            MinWidth="210"
                                                            ElementStyle="{StaticResource DataGridCellLocalizedText}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <WrapPanel Grid.Row="2"
                                           HorizontalAlignment="Left">
                                    <Button Content="{lang:TextExt Key=HCanary.Add}"
                                            Command="{Binding HCanary.AddGmCmd}"
                                            Style="{StaticResource FluentButton.Toolbar}" />
                                    <Button Content="{lang:TextExt Key=HCanary.Delete}"
                                            Command="{Binding HCanary.DelGmCmd}"
                                            Style="{StaticResource FluentButton.Compact}" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem x:Name="DetailsStep" Header="{lang:TextExt Key=HCanary.Step.Details}">
                <ScrollViewer Margin="6"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"
                                                  MinWidth="280" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*"
                                                  MinWidth="280" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0">
                                <TextBlock Text="{lang:TextExt Key=HCanary.Field.PatchName}"
                                           Style="{StaticResource HCanLbl}" />

                                <TextBox Text="{Binding HCanary.PatName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource LocalizedTextBox}" />

                                <TextBlock Text="{Binding HCanary.NameErr}"
                                           Style="{StaticResource HCanErr}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="2">
                                <TextBlock Text="{lang:TextExt Key=HCanary.Field.PatchVersion}"
                                           Style="{StaticResource HCanLbl}" />

                                <TextBox Text="{Binding HCanary.PatVer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TechnicalTextBox}" />

                                <TextBlock Text="{Binding HCanary.VerErr}"
                                           Style="{StaticResource HCanErr}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.Column="0">
                                <TextBlock Text="{lang:TextExt Key=HCanary.Field.Author}"
                                           Style="{StaticResource HCanLbl}" />

                                <TextBox Text="{Binding HCanary.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource LocalizedTextBox}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.Column="2">
                                <TextBlock Text="{lang:TextExt Key=HCanary.Field.Group}"
                                           Style="{StaticResource HCanLbl}"
                                           ToolTip="{lang:TextExt Key=HCanary.Tooltip.Group}" />

                                <TextBox Text="{Binding HCanary.Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TechnicalTextBox}"
                                         ToolTip="{lang:TextExt Key=HCanary.Tooltip.Group}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3">
                                <TextBlock Text="{lang:TextExt Key=HCanary.Field.Notes}"
                                           Style="{StaticResource HCanLbl}" />

                                <TextBox Text="{Binding HCanary.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource LocalizedTextBox}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         MinHeight="72" />
                            </StackPanel>

                            <StackPanel Grid.Row="6"
                                        Grid.Column="0">
                                <TextBlock Text="{lang:TextExt Key=HCanary.Field.Category}"
                                           Style="{StaticResource HCanLbl}" />

                                <ComboBox SelectedValue="{Binding HCanary.Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          ToolTip="{lang:TextExt Key=HCanary.Tooltip.Experimental}"
                                          Style="{StaticResource HCanBox}">
                                    <ComboBoxItem Tag="Regular">
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Category.Regular}"
                                                   FlowDirection="{DynamicResource App.TextFlowDirection}" />
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="Experimental">
                                        <TextBlock Text="{lang:TextExt Key=HCanary.Field.Experimental}"
                                                   FlowDirection="{DynamicResource App.TextFlowDirection}" />
                                    </ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="6"
                                        Grid.Column="2">
                                <TextBlock Text="{lang:TextExt Key=HCanary.Field.Status}"
                                           Style="{StaticResource HCanLbl}" />

                                <ComboBox ItemsSource="{Binding HCanary.Statuses}"
                                          SelectedValue="{Binding HCanary.Status, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          Style="{StaticResource HCanBox}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}"
                                                       FlowDirection="{DynamicResource App.TextFlowDirection}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Border Grid.Row="8"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Style="{StaticResource EmptyStatePanel}">
                                <TextBlock Text="{lang:TextExt Key=HCanary.LocalOptions.Description}"
                                           Style="{StaticResource SectionCaptionText}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="InstructionsStep" Header="{lang:TextExt Key=HCanary.Step.Instructions}">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{lang:TextExt Key=HCanary.Tab.Instructions}"
                                   Style="{StaticResource SectionTitleText}" />

                        <TextBlock Text="{lang:TextExt Key=HCanary.Instructions.SchemaHelp}"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource SectionCaptionText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              Style="{StaticResource FluentDataGrid}"
                              ItemsSource="{Binding HCanary.Ins}"
                              SelectedItem="{Binding HCanary.SelIns}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              FlowDirection="LeftToRight"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{lang:TextExt Key=HCanary.Instructions.Operation}"
                                                    Width="Auto"
                                                    MinWidth="140"
                                                    MaxWidth="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.HCanary.Op, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                  SelectedItem="{Binding Op, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource HCanBox}"
                                                  FlowDirection="LeftToRight" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Instructions.Address}"
                                                Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="2*"
                                                MinWidth="190" />

                            <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Instructions.Value}"
                                                Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="2*"
                                                MinWidth="180" />

                            <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Validation.Label}"
                                                Binding="{Binding Error}"
                                                IsReadOnly="True"
                                                Width="2*"
                                                MinWidth="190"
                                                ElementStyle="{StaticResource DataGridCellLocalizedText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="4"
                               HorizontalAlignment="Left">
                        <Button Content="{lang:TextExt Key=HCanary.Add}"
                                Command="{Binding HCanary.AddICmd}"
                                Style="{StaticResource FluentButton.Toolbar}" />

                        <Button Content="{lang:TextExt Key=HCanary.Delete}"
                                Command="{Binding HCanary.DelICmd}"
                                Style="{StaticResource FluentButton.Toolbar}" />

                        <Button Content="{lang:TextExt Key=HCanary.Duplicate}"
                                Command="{Binding HCanary.DupICmd}"
                                Style="{StaticResource FluentButton.Toolbar}" />

                        <Button Content="{lang:TextExt Key=HCanary.MoveUp}"
                                Command="{Binding HCanary.InsUp}"
                                Style="{StaticResource FluentButton.Toolbar}" />

                        <Button Content="{lang:TextExt Key=HCanary.MoveDown}"
                                Command="{Binding HCanary.InsDown}"
                                Style="{StaticResource FluentButton.Compact}" />
                    </WrapPanel>

                    <TextBlock Grid.Row="6"
                               Text="{lang:TextExt Key=HCanary.Instructions.Example}"
                               Style="{StaticResource TechnicalTextBlock}"
                               FlowDirection="LeftToRight"
                               TextAlignment="Left"
                               TextWrapping="Wrap" />

                    <Expander x:Name="AnchorsPanel"
                              Grid.Row="8"
                              Header="{lang:TextExt Key=HCanary.Anchors.Manage}"
                              IsExpanded="False">
                        <Border Style="{StaticResource SectionCard}"
                                Margin="0,8,0,0">
                            <Grid MinHeight="140"
                                  MaxHeight="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.34*"
                                                      MinWidth="210"
                                                      MaxWidth="280" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*"
                                                      MinWidth="420" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ListBox Grid.Row="0"
                                             ItemsSource="{Binding HCanary.Anchors}"
                                             SelectedItem="{Binding HCanary.SelAnc}"
                                             DisplayMemberPath="Name"
                                             FlowDirection="LeftToRight"
                                             Style="{StaticResource HCanList}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />

                                    <WrapPanel Grid.Row="2"
                                               HorizontalAlignment="Left">
                                        <Button Content="{lang:TextExt Key=HCanary.AddAnchor}"
                                                Command="{Binding HCanary.AddACmd}"
                                                Style="{StaticResource FluentButton.Toolbar}" />
                                        <Button Content="{lang:TextExt Key=HCanary.Delete}"
                                                Command="{Binding HCanary.DelACmd}"
                                                Style="{StaticResource FluentButton.Compact}" />
                                    </WrapPanel>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBox Grid.Row="0"
                                             Text="{Binding HCanary.SelAnc.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TechnicalTextBox}"
                                             ToolTip="{lang:TextExt Key=HCanary.Tooltip.Anchor}" />

                                    <DataGrid Grid.Row="2"
                                              Style="{StaticResource FluentDataGrid}"
                                              ItemsSource="{Binding HCanary.SelAnc.Ins}"
                                              SelectedItem="{Binding HCanary.AncIns}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserReorderColumns="False"
                                              FlowDirection="LeftToRight"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="{lang:TextExt Key=HCanary.Instructions.Operation}"
                                                                    Width="Auto"
                                                                    MinWidth="130"
                                                                    MaxWidth="180">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.HCanary.Op, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                  SelectedItem="{Binding Op, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Style="{StaticResource HCanBox}"
                                                                  FlowDirection="LeftToRight" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Instructions.Address}"
                                                                Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="2*"
                                                                MinWidth="170" />
                                            <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Instructions.Value}"
                                                                Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="2*"
                                                                MinWidth="160" />
                                            <DataGridTextColumn Header="{lang:TextExt Key=HCanary.Validation.Label}"
                                                                Binding="{Binding Error}"
                                                                IsReadOnly="True"
                                                                Width="2*"
                                                                MinWidth="180"
                                                                ElementStyle="{StaticResource DataGridCellLocalizedText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <WrapPanel Grid.Row="4"
                                               HorizontalAlignment="Left">
                                        <Button Content="{lang:TextExt Key=HCanary.AddInstruction}"
                                                Command="{Binding HCanary.AncAdd}"
                                                Style="{StaticResource FluentButton.Toolbar}" />
                                        <Button Content="{lang:TextExt Key=HCanary.Delete}"
                                                Command="{Binding HCanary.AncDel}"
                                                Style="{StaticResource FluentButton.Toolbar}" />
                                        <Button Content="{lang:TextExt Key=HCanary.LoadAnchor}"
                                                Command="{Binding HCanary.AncLoad}"
                                                Style="{StaticResource FluentButton.Compact}" />
                                    </WrapPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem x:Name="ReviewStep" Header="{lang:TextExt Key=HCanary.Step.Review}">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{lang:TextExt Key=HCanary.Review.Description}"
                               Style="{StaticResource SectionCaptionText}"
                               TextWrapping="Wrap" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"
                                              MinWidth="380" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*"
                                              MinWidth="280" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding HCanary.Preview, Mode=OneWay}"
                                 Style="{StaticResource TechnicalTextBox}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 VerticalContentAlignment="Top" />

                        <TextBox Grid.Column="2"
                                 Text="{Binding HCanary.VldSum, Mode=OneWay}"
                                 Style="{StaticResource LocalizedTextBox}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalContentAlignment="Top" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4"
                Style="{StaticResource BottomBarBorder}">
            <Grid FlowDirection="LeftToRight">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{lang:TextExt Key=HCanary.StepHint.Target}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource SectionCaptionText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedIndex, ElementName=Steps}" Value="0" />
                                        <Condition Binding="{Binding IsEnabled, ElementName=NextButton}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Row="0"
                           Text="{lang:TextExt Key=HCanary.StepHint.Details}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource SectionCaptionText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedIndex, ElementName=Steps}" Value="1" />
                                        <Condition Binding="{Binding IsEnabled, ElementName=NextButton}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Row="0"
                           Text="{lang:TextExt Key=HCanary.StepHint.Instructions}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource SectionCaptionText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedIndex, ElementName=Steps}" Value="2" />
                                        <Condition Binding="{Binding IsEnabled, ElementName=NextButton}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Row="0"
                           Text="{Binding HCanary.SaveHint}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource SectionCaptionText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Steps}"
                                             Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="MoreButton"
                            Grid.Column="0"
                            Content="{lang:TextExt Key=HCanary.FilesAndTools}"
                            Style="{StaticResource FluentButton.Compact}"
                            Click="OpenMore">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Top">
                                <MenuItem Header="{lang:TextExt Key=HCanary.OpenFolder}"
                                          Command="{Binding HCanary.PatDir}" />
                                <MenuItem Header="imported_patch.yml"
                                          Command="{Binding HCanary.ImpFile}" />
                                <MenuItem Header="RPCS3"
                                          Command="{Binding HCanary.R3Cmd}" />
                                <Separator />
                                <MenuItem Header="{lang:TextExt Key=HCanary.CopyYaml}"
                                          Command="{Binding HCanary.CopyCmd}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Grid.Column="2"
                            Content="{lang:TextExt Key=HCanary.Back}"
                            Click="PreviousStep">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource FluentButton.Secondary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=Steps}"
                                                 Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="NextButton"
                            Grid.Column="4"
                            Content="{lang:TextExt Key=HCanary.Next}"
                            Click="NextStep">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource FluentButton.Primary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=Steps}"
                                                 Value="3">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <WrapPanel Grid.Column="4"
                               HorizontalAlignment="Right">
                        <WrapPanel.Style>
                            <Style TargetType="{x:Type WrapPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=Steps}"
                                                 Value="3">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>

                        <Button Content="{lang:TextExt Key=HCanary.DeletePatch}"
                                Command="{Binding HCanary.DelCmd}"
                                Visibility="{Binding HCanary.HasStoredPatch, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{StaticResource FluentButton.Danger}" />

                        <Button Content="{lang:TextExt Key=HCanary.SaveAs}"
                                Command="{Binding HCanary.SaveAs}"
                                Visibility="{Binding HCanary.HasStoredPatch, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{StaticResource FluentButton.Secondary}" />

                        <Button Content="{lang:TextExt Key=HCanary.Save}"
                                Command="{Binding HCanary.SaveCmd}"
                                Style="{StaticResource FluentButton.Primary}" />
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="SavedDrawer"
                Grid.Row="0"
                Grid.RowSpan="5"
                Width="360"
                Margin="0"
                Padding="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Panel.ZIndex="20"
                Style="{StaticResource FluentSurface.Dialog}"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{lang:TextExt Key=HCanary.Stored.Title}"
                               Style="{StaticResource SectionTitleText}" />
                    <Button Grid.Column="2"
                            Content="{lang:TextExt Key=HCanary.Stored.Close}"
                            Style="{StaticResource FluentButton.Compact}"
                            Click="CloseSaved" />
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="{lang:TextExt Key=HCanary.Stored.Description}"
                           Style="{StaticResource SectionCaptionText}"
                           TextWrapping="Wrap" />

                <Grid Grid.Row="4">
                    <ListBox ItemsSource="{Binding HCanary.Patches}"
                             SelectedItem="{Binding HCanary.SelPat}"
                             Style="{StaticResource HCanList}"
                             FlowDirection="LeftToRight"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SectionCard}"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Draft.PatName}"
                                                   Style="{StaticResource SectionTitleText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Draft.PatName}" />
                                        <TextBlock Text="{Binding Draft.ExeHash}"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource TechnicalTextBlock}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Draft.ExeHash}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Style="{StaticResource EmptyStatePanel}"
                            Visibility="{Binding HCanary.IsStoredEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{lang:TextExt Key=HCanary.Stored.Empty}"
                                   Style="{StaticResource SectionCaptionText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <Button Grid.Row="6"
                        Content="{lang:TextExt Key=HCanary.Open}"
                        Command="{Binding HCanary.OpenCmd}"
                        Style="{StaticResource FluentButton.Primary}"
                        HorizontalAlignment="Right"
                        Click="OpenStoredPatch" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
