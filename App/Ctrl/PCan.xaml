<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="clr-namespace:R3Config.Lang"
             x:Class="R3Config.Ctrl.PCanView"
             AutomationProperties.AutomationId="Patches.CanaryList"
             mc:Ignorable="d"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PSty.xaml" />
                <ResourceDictionary Source="PTmp.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="CanItem">
                <Border Style="{StaticResource PatCompactItemRow}"
                        FlowDirection="{DynamicResource App.FlowDirection}"
                        ToolTipService.IsEnabled="{Binding HasCanNote}">
                    <Border.ToolTip>
                        <ToolTip Style="{StaticResource PatCanaryNoteToolTip}"
                                 DataContext="{Binding PlacementTarget.DataContext,
                                                       RelativeSource={RelativeSource Self}}">
                            <TextBlock Text="{Binding CanNote}"
                                       Style="{StaticResource PatCanaryHelpText}" />
                        </ToolTip>
                    </Border.ToolTip>

                    <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="124" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="4"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        FlowDirection="LeftToRight"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="✓"
                                           Style="{StaticResource PatEnabledGlyph}"
                                           Margin="0,0,5,0"
                                           Visibility="{Binding IsOn,
                                                                Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{Binding CurrentStateDsp}"
                                           Tag="{Binding StateTon}"
                                           Style="{StaticResource PatStateText}" />
                            </StackPanel>

                            <TextBlock Text="{Binding PendingDsp}"
                                       Tag="{Binding PendingTone}"
                                       Style="{StaticResource PatPendingText}"
                                       Margin="0,2,0,0"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding HasPendingAction,
                                                            Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding DspTitle}"
                                   Style="{StaticResource PatPatchTitleText}"
                                   NumberSubstitution.Substitution="European" />

                        <CheckBox Grid.Column="0"
                                  Style="{StaticResource IconCheckBox}"
                                  IsChecked="{Binding IsSel,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanSel}"
                                  AutomationProperties.Name="{Binding DspTitle}"
                                  AutomationProperties.HelpText="{lang:TextExt Key=Patch.SelectTip}"
                                  Padding="0"
                                  Margin="0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="CanHead">
                <Border Style="{StaticResource PatCompactGroupRow}"
                        FlowDirection="{DynamicResource App.FlowDirection}">
                    <Grid HorizontalAlignment="Stretch"
                          FlowDirection="{DynamicResource App.FlowDirection}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Style="{StaticResource PatDisclosureChevron}" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding Header}"
                                       Style="{StaticResource PatGroupTitleText}"
                                       NumberSubstitution.Substitution="European" />
                            <TextBlock Text="{Binding CanMeta}"
                                       Style="{StaticResource PatCanaryMetaText}"
                                       FlowDirection="{Binding TextFlow}"
                                       TextAlignment="{DynamicResource App.TextAlignment}"
                                       NumberSubstitution.Substitution="European"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="CanGrp">
                <Expander Style="{StaticResource PatDisclosureExpander}"
                  IsExpanded="{Binding IsOpen, Mode=TwoWay}"
                          FlowDirection="{DynamicResource App.FlowDirection}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Margin="0,0,0,6"
                          Padding="0">
                    <Expander.Header>
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource CanHead}"
                                        FlowDirection="{DynamicResource App.FlowDirection}"
                                        HorizontalContentAlignment="Stretch" />
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Items}"
                                  ItemTemplate="{StaticResource CanItem}"
                                  Style="{StaticResource PatCanaryItemsControl}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"
                                            FlowDirection="{DynamicResource App.FlowDirection}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Expander>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="CanBody"
          AutomationProperties.AutomationId="Patches.CanaryList"
          FlowDirection="{DynamicResource App.FlowDirection}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Status.WarningSurface}"
                BorderBrush="{DynamicResource Status.Warning}"
                BorderThickness="{StaticResource Stroke.Thickness.Default}"
                CornerRadius="{StaticResource Radius.Medium}"
                Padding="10,7"
                Margin="0,0,0,10"
                FlowDirection="{DynamicResource App.FlowDirection}"
                HorizontalAlignment="Stretch"
                Visibility="{Binding ShowCanaryVerificationPanel,
                                     Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                  HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding CanaryVerificationText}"
                           Style="{StaticResource PatLocalizedSubtitleText}"
                           Foreground="{DynamicResource Text.Primary}"
                           TextAlignment="{DynamicResource App.TextAlignment}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="{Binding ShowCanaryVerificationText,
                                                Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Grid.Column="2"
                        Content="{lang:TextExt Key=PatchReadiness.VerifyAction}"
                        Style="{StaticResource PatReadinessPrimaryButton}"
                        Command="{Binding FingerprintCaptureCmd}"
                        VerticalAlignment="Center"
                        TextBlock.TextAlignment="Center"
                        Visibility="{Binding ShowCanaryVerificationAction,
                                             Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Grid.Column="2"
                        Content="{lang:TextExt Key=PatchReadiness.ReverifyAction}"
                        Style="{StaticResource PatReadinessPrimaryButton}"
                        Command="{Binding FingerprintCaptureCmd}"
                        VerticalAlignment="Center"
                        TextBlock.TextAlignment="Center"
                        Visibility="{Binding ShowCanaryReverificationAction,
                                             Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>


        <Border Grid.Row="2"
                Style="{StaticResource PatResultSurface}"
                MinHeight="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid FlowDirection="{DynamicResource App.FlowDirection}">
                <ScrollViewer AutomationProperties.AutomationId="Patches.CanaryScroll"
                              Style="{StaticResource PatContentScrollViewer}">
                    <ItemsControl ItemsSource="{Binding Preview.CanGrps}"
                                  ItemTemplate="{StaticResource CanGrp}"
                                  FlowDirection="{DynamicResource App.FlowDirection}"
                                  HorizontalAlignment="Stretch" />
                </ScrollViewer>

                <Border Style="{StaticResource PatEmptyStateHost}"
                        Visibility="{Binding Preview.CanEmpty,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding Preview.CanEmptyText}"
                               Style="{StaticResource PatEmptyStateTitleText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="520"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="CanActions"
              Grid.Row="3"
              FlowDirection="{DynamicResource App.FlowDirection}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom"
              Margin="0,10,0,0"
              Visibility="{Binding Preview.HasCanActions,
                                   Converter={StaticResource BoolToVisibilityConverter}}">
            <WrapPanel Orientation="Horizontal"
                       FlowDirection="{DynamicResource App.FlowDirection}"
                       HorizontalAlignment="{DynamicResource App.HorizontalAlignment}"
                       VerticalAlignment="Center">
                <Button Style="{StaticResource PatCanaryPrimaryButton}"
                        Command="{Binding CanOn}"
                        Content="{lang:TextExt Key=Patch.ApplyCanarySection}"
                        ToolTip="{lang:TextExt Key=Patch.ApplyCanarySectionTip}"
                        Visibility="{Binding Preview.SelCanOn,
                                             Converter={StaticResource BoolToVisibilityConverter}}"
                        TextBlock.TextAlignment="Center" />
                <Button Style="{StaticResource PatCanarySecondaryButton}"
                        Command="{Binding CanOCmd}"
                        Content="{lang:TextExt Key=Patch.Off}"
                        ToolTip="{lang:TextExt Key=Patch.OffTip}"
                        Visibility="{Binding Preview.CanOff,
                                             Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0"
                        TextBlock.TextAlignment="Center" />
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
