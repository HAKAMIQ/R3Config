<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             x:Class="R3Config.Ctrl.StatBar"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="StatBarLocalizedStatusText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource StatusText}">

            <Setter Property="FlowDirection"
                    Value="{DynamicResource App.TextFlowDirection}" />

            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />

            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Setter Property="TextWrapping"
                    Value="NoWrap" />

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Surface.Subtle}"
            BorderBrush="{DynamicResource Stroke.Subtle}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.None}"
            Padding="4"
            FlowDirection="{DynamicResource App.FlowDirection}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">

        <UniformGrid Rows="1"
                     Columns="5"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"
                     FlowDirection="{DynamicResource App.FlowDirection}">

            <Border Style="{StaticResource StatusMetricPill}"
                    CornerRadius="{StaticResource Radius.None}"
                    HorizontalAlignment="Stretch">

                <TextBlock Text="{Binding R3Status}"
                           Style="{StaticResource StatBarLocalizedStatusText}"
                           ToolTip="{lang:TextExt Key=Status.Rpcs3Tip}" />
            </Border>

            <Border Style="{StaticResource StatusMetricPill}"
                    CornerRadius="{StaticResource Radius.None}"
                    HorizontalAlignment="Stretch">

                <TextBlock Text="{Binding Status}"
                           Style="{StaticResource StatBarLocalizedStatusText}"
                           ToolTip="{lang:TextExt Key=Status.DataTip}" />
            </Border>

            <Border Style="{StaticResource StatusMetricPill}"
                    CornerRadius="{StaticResource Radius.None}"
                    HorizontalAlignment="Stretch">

                <TextBlock Text="{Binding RecStat}"
                           Style="{StaticResource StatBarLocalizedStatusText}"
                           ToolTip="{lang:TextExt Key=Status.RecTip}" />
            </Border>

            <Border Style="{StaticResource StatusMetricPill}"
                    CornerRadius="{StaticResource Radius.None}"
                    HorizontalAlignment="Stretch">

                <TextBlock Text="{Binding HwStatus}"
                           Style="{StaticResource StatBarLocalizedStatusText}"
                           ToolTip="{Binding HwTip}" />
            </Border>

            <Border Style="{StaticResource StatusMetricPill}"
                    CornerRadius="{StaticResource Radius.None}"
                    HorizontalAlignment="Stretch">

                <TextBlock Text="{Binding BkpStat}"
                           Style="{StaticResource StatBarLocalizedStatusText}"
                           ToolTip="{lang:TextExt Key=Status.BkpTip}" />
            </Border>
        </UniformGrid>
    </Border>
</UserControl>