<UserControl x:Class="R3Config.Ctrl.StatBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}">

    <Border Background="{DynamicResource Surface.Subtle}"
            BorderBrush="{DynamicResource Stroke.Subtle}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Medium}"
            Padding="4">

        <UniformGrid Rows="1"
                     Columns="5"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"
                     FlowDirection="{DynamicResource App.FlowDirection}">

            <Border Style="{StaticResource StatusMetricPill}"
                    HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding R3Status}"
                           Style="{StaticResource StatusText}"
                           FlowDirection="{DynamicResource App.TextFlowDirection}"
                           TextAlignment="Left"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{lang:TextExt Key=Status.Rpcs3Tip}" />
            </Border>

            <Border Style="{StaticResource StatusMetricPill}"
                    HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding Status}"
                           Style="{StaticResource StatusText}"
                           FlowDirection="{DynamicResource App.TextFlowDirection}"
                           TextAlignment="Left"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{lang:TextExt Key=Status.DataTip}" />
            </Border>

            <Border Style="{StaticResource StatusMetricPill}"
                    HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding RecStat}"
                           Style="{StaticResource StatusText}"
                           FlowDirection="{DynamicResource App.TextFlowDirection}"
                           TextAlignment="Left"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{lang:TextExt Key=Status.RecTip}" />
            </Border>

            <Border Style="{StaticResource StatusMetricPill}"
                    HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding HwStatus}"
                           Style="{StaticResource StatusText}"
                           FlowDirection="{DynamicResource App.TextFlowDirection}"
                           TextAlignment="Left"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding HwTip}" />
            </Border>

            <Border Style="{StaticResource StatusMetricPill}"
                    HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding BkpStat}"
                           Style="{StaticResource StatusText}"
                           FlowDirection="{DynamicResource App.TextFlowDirection}"
                           TextAlignment="Left"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{lang:TextExt Key=Status.BkpTip}" />
            </Border>
        </UniformGrid>
    </Border>
</UserControl>