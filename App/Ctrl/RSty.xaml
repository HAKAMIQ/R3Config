<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lang="clr-namespace:R3Config.Lang">

    <Style x:Key="RecSecondaryActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButton.Secondary}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="MinWidth"
                Value="96" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="MinHeight"
                Value="32" />
        <Setter Property="Padding"
                Value="12,4" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextBlock.TextAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="RecPrimaryActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButton.Primary}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="MinWidth"
                Value="96" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="MinHeight"
                Value="32" />
        <Setter Property="Padding"
                Value="12,4" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextBlock.TextAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="RecLocalizedTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource SectionTitleText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
    </Style>

    <Style x:Key="RecLocalizedSubtitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource RecommendationRowSubtitleText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="RecLocalizedBodyText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource ChecklistToolTipBodyText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>

    <Style x:Key="RecLocalizedLabelText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource ChecklistToolTipLabelText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
    </Style>

    <Style x:Key="RecTechnicalValueText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource ChecklistToolTipValueText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource TechnicalText.FlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource TechnicalText.TextAlignment}" />
        <Setter Property="Language"
                Value="{DynamicResource TechnicalText.Language}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="RecToolTipSectionLabelText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource RecLocalizedLabelText}">
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Secondary}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
    </Style>

    <Style x:Key="RecToolTipTechnicalValueText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource RecTechnicalValueText}">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
    </Style>

    <Style x:Key="RecToolTipWikiHeadingText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource RecLocalizedLabelText}">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Primary}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
    </Style>

    <Style x:Key="RecLocalizedEmptyText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource ArabicEmptyStateText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>

    <Style x:Key="RecSettingRow"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource ChecklistOptionRow}">
        <Setter Property="CornerRadius"
                Value="0" />
        <Setter Property="Padding"
                Value="8,1" />
        <Setter Property="Margin"
                Value="0,0,0,1" />
        <Setter Property="MinHeight"
                Value="38" />
    </Style>

    <Style x:Key="RecRowValueText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Technical}">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource TechnicalText.FlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource TechnicalText.TextAlignment}" />
        <Setter Property="Language"
                Value="{DynamicResource TechnicalText.Language}" />
    </Style>

    <Style x:Key="RecAppliedStatusText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Caption}">
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Status.Success}" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
    </Style>

    <Style x:Key="RecInactiveStatusText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Caption}">
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>

</ResourceDictionary>