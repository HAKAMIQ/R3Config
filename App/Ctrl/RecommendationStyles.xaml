<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lang="clr-namespace:R3Config.Lang">

    <Style x:Key="RecSecondaryActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButton.Secondary}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="MinWidth"
                Value="96" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="MinHeight"
                Value="32" />
        <Setter Property="Padding"
                Value="12,4" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextBlock.TextAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="RecPrimaryActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButton.Primary}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="MinWidth"
                Value="96" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="MinHeight"
                Value="32" />
        <Setter Property="Padding"
                Value="12,4" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextBlock.TextAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="RecLocalizedTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource SectionTitleText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="RecLocalizedSubtitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource RecommendationRowSubtitleText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="RecLocalizedBodyText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource ChecklistToolTipBodyText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="RecLocalizedLabelText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource ChecklistToolTipLabelText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="RecTechnicalValueText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource ChecklistToolTipValueText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource TechnicalText.FlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource TechnicalText.TextAlignment}" />
        <Setter Property="Language"
                Value="{DynamicResource TechnicalText.Language}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="RecToolTipSectionLabelText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource RecLocalizedLabelText}">
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Secondary}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
    </Style>

    <Style x:Key="RecToolTipTechnicalValueText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource RecTechnicalValueText}">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
    </Style>

    <!-- Small secondary line under a ToolTip value (where it comes from).
         Direction and alignment come from RecLocalizedLabelText. -->
    <Style x:Key="RecToolTipSourceText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource RecLocalizedLabelText}">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Secondary}" />
    </Style>

    <Style x:Key="RecToolTipWikiHeadingText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource RecLocalizedLabelText}">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Primary}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="RecLocalizedEmptyText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource ArabicEmptyStateText}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="RecSettingRow"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource ChecklistOptionRow}">
        <!-- Fluent 2 settings list: each setting is its own card-like row. -->
        <Setter Property="Background"
                Value="{DynamicResource Surface.Card}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Stroke.Subtle}" />
        <Setter Property="CornerRadius"
                Value="{StaticResource Radius.Medium}" />
        <Setter Property="Padding"
                Value="10,2" />
        <Setter Property="Margin"
                Value="0,0,0,4" />
        <Setter Property="MinHeight"
                Value="38" />
    </Style>

    <Style x:Key="RecRowValueText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Technical}">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource TechnicalText.FlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource TechnicalText.TextAlignment}" />
        <Setter Property="Language"
                Value="{DynamicResource TechnicalText.Language}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="RecAppliedStatusText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Caption}">
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Status.Success}" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="RecInactiveStatusText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Caption}">
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="RecEvidenceCard"
           TargetType="{x:Type Border}">
        <Setter Property="Background"
                Value="{DynamicResource Surface.Subtle}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Stroke.Subtle}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="0" />
        <Setter Property="Padding"
                Value="12,10" />
        <Setter Property="Margin"
                Value="0,0,0,10" />
    </Style>

    <Style x:Key="RecDetailsHeaderText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Caption}">
        <Setter Property="Foreground"
                Value="{DynamicResource Accent.Default}" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="TextDecorations"
                        Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RecDetailsExpander"
           TargetType="{x:Type Expander}">
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ToggleButton Grid.Row="0"
                                      IsChecked="{Binding IsExpanded,
                                                          Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                      Content="{TemplateBinding Header}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0"
                                      HorizontalAlignment="Left">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      VerticalAlignment="Center" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ExpandSite"
                                          Grid.Row="1"
                                          ContentSource="Content"
                                          HorizontalAlignment="Stretch"
                                          Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded"
                                 Value="True">
                            <Setter TargetName="ExpandSite"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
