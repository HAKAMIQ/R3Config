<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             xmlns:ctrl="clr-namespace:R3Config.Ctrl"
             x:Class="R3Config.Ctrl.RuntimeView"
             AutomationProperties.AutomationId="Runtime.Root"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="RecommendationStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Every ItemsControl here only lays out rows. WPF makes an
                 ItemsControl a Tab stop by default, an unnamed stop a screen
                 reader cannot announce; the buttons and Details toggles inside
                 stay reachable. -->
            <Style TargetType="{x:Type ItemsControl}">
                <Setter Property="Focusable"
                        Value="False" />
            </Style>

            <!-- One evidence fact: label, technical value or localized text, weaker-than-known state. -->
            <DataTemplate x:Key="RuntimeFactTemplate">
                <Grid Margin="0,3,0,0"
                      FlowDirection="{DynamicResource App.FlowDirection}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               Style="{StaticResource RecToolTipSectionLabelText}"
                               TextAlignment="{DynamicResource App.TextAlignment}" />

                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                HorizontalAlignment="Stretch">

                        <TextBlock Text="{Binding Value}"
                                   Style="{StaticResource RecToolTipTechnicalValueText}"
                                   Visibility="{Binding IsTechnical,
                                                        Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="{Binding Value}"
                                   Style="{StaticResource RecLocalizedBodyText}"
                                   Visibility="{Binding IsLocalizedValue,
                                                        Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="{Binding Note}"
                                   Style="{StaticResource RecLocalizedSubtitleText}"
                                   Visibility="{Binding HasNote,
                                                        Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding StateText}"
                               Style="{StaticResource RecLocalizedSubtitleText}"
                               Margin="12,0,0,0"
                               Visibility="{Binding HasState,
                                                    Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </DataTemplate>

            <!-- One trusted PPU executable hash: the raw hash (LTR technical text),
                 its localized source, the evidence time and a Copy button. -->
            <DataTemplate x:Key="RuntimePpuHashTemplate">
                <Grid Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               Style="{StaticResource RecToolTipSectionLabelText}" />

                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                HorizontalAlignment="Stretch">

                        <TextBlock Text="{Binding Hash}"
                                   AutomationProperties.AutomationId="Runtime.PpuHash.Value"
                                   Style="{StaticResource RecToolTipTechnicalValueText}" />

                        <TextBlock Text="{Binding SourceText}"
                                   Style="{StaticResource RecLocalizedSubtitleText}" />

                        <TextBlock Text="{Binding TimeText}"
                                   Style="{StaticResource RecToolTipTechnicalValueText}"
                                   Visibility="{Binding HasTime,
                                                        Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            AutomationProperties.AutomationId="Runtime.PpuHash.Copy"
                            Content="{Binding CopyLabel}"
                            Command="{Binding CopyCmd}"
                            Style="{StaticResource RecSecondaryActionButton}"
                            Margin="12,0,0,0"
                            VerticalAlignment="Top" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="RuntimeGroupTemplate">
                <Border Style="{StaticResource RecEvidenceCard}">

                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Stretch">

                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource RecToolTipWikiHeadingText}"
                                   TextAlignment="{DynamicResource App.TextAlignment}" />

                        <ItemsControl ItemsSource="{Binding SummaryRows}"
                                      ItemTemplate="{StaticResource RuntimeFactTemplate}"
                                      HorizontalContentAlignment="Stretch" />

                        <!-- Game group only: trusted PPU hashes (several are all
                             listed, none picked), else the HashUnknown guidance. -->
                        <ItemsControl ItemsSource="{Binding PpuHashes}"
                                      AutomationProperties.AutomationId="Runtime.PpuHashes"
                                      ItemTemplate="{StaticResource RuntimePpuHashTemplate}"
                                      Visibility="{Binding HasPpuHashes,
                                                           Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Grid Margin="0,3,0,0"
                              Visibility="{Binding HasPpuHashGuidance,
                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding PpuHashLabel}"
                                       Style="{StaticResource RecToolTipSectionLabelText}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding PpuHashGuidance}"
                                       AutomationProperties.AutomationId="Runtime.PpuHash.Guidance"
                                       Style="{StaticResource RecLocalizedBodyText}" />
                        </Grid>

                        <Expander Style="{StaticResource RecDetailsExpander}"
                                  Margin="0,8,0,0"
                                  Visibility="{Binding HasDetails,
                                                       Converter={StaticResource BoolToVisibilityConverter}}">
                            <Expander.Header>
                                <TextBlock Text="{Binding DetailsLabel}"
                                           Style="{StaticResource RecDetailsHeaderText}" />
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding DetailRows}"
                                          ItemTemplate="{StaticResource RuntimeFactTemplate}"
                                          Margin="0,6,0,0"
                                          HorizontalContentAlignment="Stretch" />
                        </Expander>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- One diagnostic line: label, technical value, optional localized note. -->
            <DataTemplate x:Key="DiagLineTemplate">
                <Grid Margin="0,3,0,0"
                      FlowDirection="{DynamicResource App.FlowDirection}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               Style="{StaticResource RecToolTipSectionLabelText}"
                               TextAlignment="{DynamicResource App.TextAlignment}" />

                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                HorizontalAlignment="Stretch">

                        <TextBlock Text="{Binding Value}"
                                   Style="{StaticResource RecToolTipTechnicalValueText}"
                                   Visibility="{Binding IsTechnical,
                                                        Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- LinkText keeps whole English segments such as
                             "GitHub #19262" left to right inside Arabic text. -->
                        <TextBlock ctrl:LinkText.Text="{Binding Value}"
                                   Style="{StaticResource RecLocalizedBodyText}"
                                   Visibility="{Binding IsLocalized,
                                                        Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="{Binding Note}"
                                   Style="{StaticResource RecLocalizedSubtitleText}"
                                   Visibility="{Binding HasNote,
                                                        Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="DiagEventTemplate">
                <Border Style="{StaticResource RecSettingRow}"
                        FlowDirection="{DynamicResource App.FlowDirection}"
                        HorizontalAlignment="Stretch">

                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Stretch">

                        <Grid FlowDirection="{DynamicResource App.FlowDirection}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Categories}"
                                       Style="{StaticResource RecToolTipWikiHeadingText}"
                                       TextAlignment="{DynamicResource App.TextAlignment}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Count}"
                                       Style="{StaticResource RecToolTipTechnicalValueText}"
                                       Margin="12,0,0,0" />
                        </Grid>

                        <TextBlock Text="{Binding Message}"
                                   Style="{StaticResource RecToolTipTechnicalValueText}"
                                   Margin="0,2,0,0" />

                        <TextBlock Text="{Binding Where}"
                                   Style="{StaticResource RecToolTipTechnicalValueText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="DiagSolutionTemplate">
                <Grid Margin="0,3,0,0"
                      FlowDirection="{DynamicResource App.FlowDirection}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               Style="{StaticResource RecToolTipSectionLabelText}"
                               TextAlignment="{DynamicResource App.TextAlignment}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding Detail}"
                               Style="{StaticResource RecToolTipTechnicalValueText}" />

                    <TextBlock Grid.Column="2"
                               ctrl:LinkText.Text="{Binding DownloadLabel}"
                               ctrl:LinkText.Target="{Binding DownloadUrl}"
                               Style="{StaticResource RecLocalizedSubtitleText}"
                               Margin="12,0,0,0"
                               Visibility="{Binding HasDownload,
                                                    Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="DiagFindingTemplate">
                <Border Style="{StaticResource RecEvidenceCard}"
                        AutomationProperties.AutomationId="Runtime.Finding">

                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Stretch">

                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource RecToolTipWikiHeadingText}"
                                   TextAlignment="{DynamicResource App.TextAlignment}" />

                        <TextBlock Text="{Binding Symptom}"
                                   Style="{StaticResource RecLocalizedSubtitleText}" />

                        <TextBlock ctrl:LinkText.Text="{Binding SourceText}"
                                   ctrl:LinkText.Target="{Binding SourceUrl}"
                                   Style="{StaticResource RecLocalizedBodyText}"
                                   Margin="0,4,0,0" />

                        <ItemsControl ItemsSource="{Binding Rows}"
                                      ItemTemplate="{StaticResource DiagLineTemplate}"
                                      HorizontalContentAlignment="Stretch" />

                        <ItemsControl ItemsSource="{Binding Solutions}"
                                      ItemTemplate="{StaticResource DiagSolutionTemplate}"
                                      Margin="0,8,0,0"
                                      HorizontalContentAlignment="Stretch" />

                        <TextBlock Text="{Binding NoSolution}"
                                   Style="{StaticResource RecLocalizedBodyText}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasNoSolution,
                                                        Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <TabControl x:Name="Tabs"
                AutomationProperties.AutomationId="Runtime.Tabs"
                Style="{StaticResource FluentTabControl}"
                ItemContainerStyle="{StaticResource FluentTabItem}"
                SelectedIndex="{Binding Runtime.LogDiag.SelectedTab, Mode=TwoWay}"
                Margin="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                FlowDirection="{DynamicResource App.FlowDirection}">

        <!-- The headers are one Tab stop (the selected tab), and the arrow keys
             move between them, as WPF's TabPanel does; otherwise Tab selects the
             next header and never reaches the selected tab's content. -->
        <TabControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"
                            KeyboardNavigation.TabNavigation="Once"
                            KeyboardNavigation.DirectionalNavigation="Cycle" />
            </ItemsPanelTemplate>
        </TabControl.ItemsPanel>

        <!-- 1. Overview: the concise diagnostic result. -->
        <TabItem Header="{Binding Runtime.TabOverview}"
                 AutomationProperties.AutomationId="Runtime.Overview.Tab"
                 TextBlock.TextAlignment="Left">

            <ScrollViewer AutomationProperties.AutomationId="Runtime.Overview.Scroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          FlowDirection="{DynamicResource App.FlowDirection}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Padding="{DynamicResource App.ScrollPadding4}">

                <StackPanel Orientation="Vertical"
                            FlowDirection="{DynamicResource App.FlowDirection}"
                            HorizontalAlignment="Stretch">

                    <!-- RPCS3 writes one log for its last session, not one
                         log per game, so this card names its own subject in
                         every case instead of warning only on a mismatch.
                         The serial and version are a technical value and keep
                         the shared LTR technical style; no direction attribute
                         is set here, so the frozen direction contract stays
                         unchanged. -->
                    <Border Style="{StaticResource RecEvidenceCard}"
                            Margin="0,4,0,8"
                            AutomationProperties.AutomationId="Runtime.Overview.Session"
                            Visibility="{Binding Runtime.LogDiag.HasSessionIdentity,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">

                        <StackPanel Orientation="Vertical">

                            <TextBlock Text="{Binding Runtime.LogDiag.SessionTitle}"
                                       AutomationProperties.AutomationId="Runtime.Overview.SessionTitle"
                                       Style="{StaticResource RecToolTipWikiHeadingText}" />

                            <TextBlock Text="{Binding Runtime.LogDiag.SessionIdentityText}"
                                       AutomationProperties.AutomationId="Runtime.Overview.SessionIdentity"
                                       Style="{StaticResource RecToolTipTechnicalValueText}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding Runtime.LogDiag.HasSessionSerial,
                                                            Converter={StaticResource BoolToVisibilityConverter}}" />

                            <TextBlock Text="{Binding Runtime.LogDiag.SessionOwnerText}"
                                       AutomationProperties.AutomationId="Runtime.Overview.SessionOwner"
                                       Style="{StaticResource RecLocalizedBodyText}"
                                       Margin="0,4,0,0" />

                            <TextBlock Text="{Binding Runtime.LogDiag.SessionScopeText}"
                                       AutomationProperties.AutomationId="Runtime.Overview.SessionScope"
                                       Style="{StaticResource RecLocalizedSubtitleText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Runtime.LogDiag.StateText}"
                               AutomationProperties.AutomationId="Runtime.Overview.State"
                               Style="{StaticResource RecLocalizedBodyText}"
                               Margin="0,4,0,8"
                               Visibility="{Binding Runtime.LogDiag.HasStateText,
                                                    Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Text="{Binding Runtime.LogDiag.NotesText}"
                               AutomationProperties.AutomationId="Runtime.Overview.Notes"
                               Style="{StaticResource RecLocalizedSubtitleText}"
                               Margin="0,0,0,8"
                               Visibility="{Binding Runtime.LogDiag.HasNotes,
                                                    Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Border Style="{StaticResource RecEvidenceCard}"
                            AutomationProperties.AutomationId="Runtime.Overview.Card">

                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Stretch">

                            <ItemsControl ItemsSource="{Binding Runtime.LogDiag.OverviewRows}"
                                          ItemTemplate="{StaticResource DiagLineTemplate}"
                                          HorizontalContentAlignment="Stretch" />

                            <TextBlock Text="{lang:TextExt Key=Diag.Overview.Action}"
                                       Style="{StaticResource RecToolTipWikiHeadingText}"
                                       Margin="0,10,0,0"
                                       TextAlignment="{DynamicResource App.TextAlignment}"
                                       Visibility="{Binding Runtime.LogDiag.HasAction,
                                                            Converter={StaticResource BoolToVisibilityConverter}}" />

                            <TextBlock Text="{Binding Runtime.LogDiag.ActionText}"
                                       AutomationProperties.AutomationId="Runtime.Overview.Action"
                                       Style="{StaticResource RecLocalizedBodyText}"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding Runtime.LogDiag.HasAction,
                                                            Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,10,0,0"
                                        FlowDirection="{DynamicResource App.FlowDirection}">

                                <TextBlock ctrl:LinkText.Text="{Binding Runtime.LogDiag.ViewEvidenceLabel}"
                                           ctrl:LinkText.Target="{Binding Runtime.LogDiag.EvidenceUrl}"
                                           Style="{StaticResource RecLocalizedSubtitleText}"
                                           Margin="0,0,16,0"
                                           Visibility="{Binding Runtime.LogDiag.HasEvidenceUrl,
                                                                Converter={StaticResource BoolToVisibilityConverter}}" />

                                <TextBlock ctrl:LinkText.Text="{Binding Runtime.LogDiag.DownloadLabel}"
                                           ctrl:LinkText.Target="{Binding Runtime.LogDiag.DownloadUrl}"
                                           Style="{StaticResource RecLocalizedSubtitleText}"
                                           Margin="0,0,16,0"
                                           Visibility="{Binding Runtime.LogDiag.HasDownloadUrl,
                                                                Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,8"
                                FlowDirection="{DynamicResource App.FlowDirection}">

                        <Button AutomationProperties.AutomationId="Runtime.Analyze"
                                Content="{Binding Runtime.LogDiag.AnalyzeLabel}"
                                Command="{Binding Runtime.LogDiag.AnalyzeCmd}"
                                Style="{StaticResource RecSecondaryActionButton}"
                                Margin="0,0,8,0"
                                FlowDirection="{DynamicResource App.TextFlowDirection}"
                                TextBlock.TextAlignment="Center" />

                        <Button AutomationProperties.AutomationId="Runtime.ViewEvents"
                                Content="{Binding Runtime.LogDiag.ViewEventsLabel}"
                                Command="{Binding Runtime.LogDiag.ShowEventsCmd}"
                                Style="{StaticResource RecSecondaryActionButton}"
                                FlowDirection="{DynamicResource App.TextFlowDirection}"
                                TextBlock.TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 2. Hardware & environment: the runtime evidence groups. -->
        <TabItem Header="{Binding Runtime.TabHardware}"
                 AutomationProperties.AutomationId="Runtime.Hardware.Tab"
                 TextBlock.TextAlignment="Left">

            <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <ScrollViewer AutomationProperties.AutomationId="Runtime.Scroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              FlowDirection="{DynamicResource App.FlowDirection}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Padding="{DynamicResource App.ScrollPadding4}">

                    <ItemsControl AutomationProperties.AutomationId="Runtime.Groups"
                                  ItemsSource="{Binding Runtime.Groups}"
                                  ItemTemplate="{StaticResource RuntimeGroupTemplate}"
                                  FlowDirection="{DynamicResource App.FlowDirection}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch" />
                </ScrollViewer>

                <Border CornerRadius="{StaticResource Radius.None}"
                        FlowDirection="{DynamicResource App.FlowDirection}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                    <Border.Style>
                        <Style TargetType="{x:Type Border}"
                               BasedOn="{StaticResource ViewportEmptyStatePanel}">

                            <Setter Property="Visibility"
                                    Value="Visible" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Runtime.HasGroups}"
                                             Value="True">

                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="{Binding Runtime.EmptyText}"
                               Style="{StaticResource RecLocalizedEmptyText}"
                               MaxWidth="460"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="{DynamicResource App.TextAlignment}"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </TabItem>

        <!-- 3. Log diagnostics: session, timeline, observed events; raw lines under Details. -->
        <TabItem Header="{Binding Runtime.TabLogs}"
                 AutomationProperties.AutomationId="Runtime.Logs.Tab"
                 TextBlock.TextAlignment="Left">

            <ScrollViewer AutomationProperties.AutomationId="Runtime.Logs.Scroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          FlowDirection="{DynamicResource App.FlowDirection}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Padding="{DynamicResource App.ScrollPadding4}">

                <StackPanel Orientation="Vertical"
                            FlowDirection="{DynamicResource App.FlowDirection}"
                            HorizontalAlignment="Stretch">

                    <TextBlock Text="{Binding Runtime.LogDiag.StateText}"
                               Style="{StaticResource RecLocalizedBodyText}"
                               Margin="0,4,0,8"
                               Visibility="{Binding Runtime.LogDiag.HasStateText,
                                                    Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Text="{Binding Runtime.LogDiag.NotesText}"
                               AutomationProperties.AutomationId="Runtime.Logs.Notes"
                               Style="{StaticResource RecLocalizedSubtitleText}"
                               Margin="0,0,0,8"
                               Visibility="{Binding Runtime.LogDiag.HasNotes,
                                                    Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Border Style="{StaticResource RecEvidenceCard}"
                            Visibility="{Binding Runtime.LogDiag.IsReady,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">

                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Stretch">

                            <TextBlock Text="{Binding Runtime.LogDiag.SourceText}"
                                       Style="{StaticResource RecLocalizedBodyText}" />

                            <ItemsControl ItemsSource="{Binding Runtime.LogDiag.SessionRows}"
                                          ItemTemplate="{StaticResource DiagLineTemplate}"
                                          Margin="0,6,0,0"
                                          HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RecEvidenceCard}"
                            AutomationProperties.AutomationId="Runtime.Timeline"
                            Visibility="{Binding Runtime.LogDiag.HasTimeline,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">

                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Stretch">

                            <TextBlock Text="{lang:TextExt Key=Diag.Timeline}"
                                       Style="{StaticResource RecToolTipWikiHeadingText}"
                                       TextAlignment="{DynamicResource App.TextAlignment}" />

                            <TextBlock Text="{Binding Runtime.LogDiag.TimelineText}"
                                       Style="{StaticResource RecLocalizedBodyText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RecEvidenceCard}"
                            AutomationProperties.AutomationId="Runtime.Events"
                            Visibility="{Binding Runtime.LogDiag.HasEvents,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">

                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Stretch">

                            <TextBlock Text="{lang:TextExt Key=Diag.Events}"
                                       Style="{StaticResource RecToolTipWikiHeadingText}"
                                       TextAlignment="{DynamicResource App.TextAlignment}" />

                            <ItemsControl ItemsSource="{Binding Runtime.LogDiag.Events}"
                                          ItemTemplate="{StaticResource DiagEventTemplate}"
                                          Margin="0,4,0,0"
                                          HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Expander Style="{StaticResource RecDetailsExpander}"
                              AutomationProperties.AutomationId="Runtime.Logs.Details"
                              Margin="0,4,0,8"
                              Visibility="{Binding Runtime.LogDiag.IsReady,
                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                        <Expander.Header>
                            <TextBlock Text="{Binding Runtime.LogDiag.DetailsLabel}"
                                       Style="{StaticResource RecDetailsHeaderText}" />
                        </Expander.Header>

                        <StackPanel Orientation="Vertical"
                                    Margin="0,6,0,0">

                            <TextBlock Text="{lang:TextExt Key=Diag.Settings}"
                                       Style="{StaticResource RecToolTipWikiHeadingText}"
                                       TextAlignment="{DynamicResource App.TextAlignment}"
                                       Visibility="{Binding Runtime.LogDiag.HasSettings,
                                                            Converter={StaticResource BoolToVisibilityConverter}}" />

                            <ItemsControl ItemsSource="{Binding Runtime.LogDiag.SettingRows}"
                                          ItemTemplate="{StaticResource DiagLineTemplate}"
                                          HorizontalContentAlignment="Stretch" />

                            <TextBlock Text="{lang:TextExt Key=Diag.MinorEvents}"
                                       Style="{StaticResource RecToolTipWikiHeadingText}"
                                       Margin="0,10,0,0"
                                       TextAlignment="{DynamicResource App.TextAlignment}"
                                       Visibility="{Binding Runtime.LogDiag.HasMinorEvents,
                                                            Converter={StaticResource BoolToVisibilityConverter}}" />

                            <ItemsControl ItemsSource="{Binding Runtime.LogDiag.MinorEvents}"
                                          ItemTemplate="{StaticResource DiagEventTemplate}"
                                          HorizontalContentAlignment="Stretch" />

                            <TextBlock Text="{lang:TextExt Key=Diag.RawLines}"
                                       Style="{StaticResource RecToolTipWikiHeadingText}"
                                       Margin="0,10,0,0"
                                       TextAlignment="{DynamicResource App.TextAlignment}"
                                       Visibility="{Binding Runtime.LogDiag.HasRawLines,
                                                            Converter={StaticResource BoolToVisibilityConverter}}" />

                            <ItemsControl ItemsSource="{Binding Runtime.LogDiag.RawLines}"
                                          HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Style="{StaticResource RecToolTipTechnicalValueText}"
                                                   Margin="0,1,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 4. Evidence & solutions: documented cases, with source, evidence class and match quality. -->
        <TabItem Header="{Binding Runtime.TabEvidence}"
                 AutomationProperties.AutomationId="Runtime.Evidence.Tab"
                 TextBlock.TextAlignment="Left">

            <ScrollViewer AutomationProperties.AutomationId="Runtime.Evidence.Scroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          FlowDirection="{DynamicResource App.FlowDirection}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Padding="{DynamicResource App.ScrollPadding4}">

                <StackPanel Orientation="Vertical"
                            FlowDirection="{DynamicResource App.FlowDirection}"
                            HorizontalAlignment="Stretch">

                    <TextBlock Text="{Binding Runtime.LogDiag.StateText}"
                               Style="{StaticResource RecLocalizedBodyText}"
                               Margin="0,4,0,8"
                               Visibility="{Binding Runtime.LogDiag.HasStateText,
                                                    Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Text="{Binding Runtime.LogDiag.EvidenceErrorText}"
                               Style="{StaticResource RecLocalizedSubtitleText}"
                               Margin="0,0,0,8" />

                    <ItemsControl AutomationProperties.AutomationId="Runtime.Findings"
                                  ItemsSource="{Binding Runtime.LogDiag.Findings}"
                                  ItemTemplate="{StaticResource DiagFindingTemplate}"
                                  HorizontalContentAlignment="Stretch" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
