<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="clr-namespace:R3Config.Lang"
             x:Class="R3Config.Ctrl.POffView"
             AutomationProperties.AutomationId="Patches.OfficialList"
             mc:Ignorable="d"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PSty.xaml" />
                <ResourceDictionary Source="PTmp.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="OfclBody"
          FlowDirection="{DynamicResource App.FlowDirection}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Preview.OfclSum}"
                   Style="{StaticResource PatSectionSummaryText}"
                   Margin="8,0,8,8"
                   Visibility="{Binding Preview.HasOfcl,
                                        Converter={StaticResource BoolToVisibilityConverter}}" />

        <Border Grid.Row="1"
                Style="{StaticResource PatResultSurface}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <ScrollViewer AutomationProperties.AutomationId="Patches.OfficialScroll"
                              Style="{StaticResource PatContentScrollViewer}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding Preview.OfclGrp}"
                                  ItemTemplate="{StaticResource TgtGrp}"
                                  FlowDirection="{DynamicResource App.FlowDirection}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch" />
                </ScrollViewer>

                <Border Style="{StaticResource PatEmptyStateHost}"
                        Visibility="{Binding Preview.IsOfcl,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="480">
                        <TextBlock Text="{lang:TextExt Key=Patch.OfficialEmptyTitle}"
                                   Style="{StaticResource PatEmptyStateTitleText}" />
                        <TextBlock Text="{lang:TextExt Key=Patch.OfficialEmptyHint}"
                                   Style="{StaticResource PatEmptyStateHintText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="OfclActions"
              Grid.Row="2"
              FlowDirection="{DynamicResource App.FlowDirection}"
              HorizontalAlignment="Stretch"
              Margin="0,10,0,0"
              VerticalAlignment="Bottom"
              Visibility="{Binding Preview.HasOfclActions,
                                   Converter={StaticResource BoolToVisibilityConverter}}">

            <WrapPanel Orientation="Horizontal"
                       FlowDirection="{DynamicResource App.FlowDirection}"
                       HorizontalAlignment="{DynamicResource App.HorizontalAlignment}"
                       VerticalAlignment="Center">

                <Button Style="{StaticResource PatOfficialPrimaryButton}"
                        Command="{Binding OfclOn}"
                        Content="{lang:TextExt Key=Patch.ApplyOfficialSection}"
                        ToolTip="{lang:TextExt Key=Patch.ApplyOfficialSectionTip}"
                        Visibility="{Binding Preview.OfclOn,
                                             Converter={StaticResource BoolToVisibilityConverter}}"
                        TextBlock.TextAlignment="Center" />

                <Button Style="{StaticResource PatOfficialSecondaryButton}"
                        Command="{Binding OfclOff}"
                        Content="{lang:TextExt Key=Patch.Off}"
                        ToolTip="{lang:TextExt Key=Patch.OffTip}"
                        Visibility="{Binding Preview.OfclOff,
                                             Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0"
                        TextBlock.TextAlignment="Center" />
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
