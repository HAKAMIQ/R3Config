<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="clr-namespace:R3Config.Lang"
             xmlns:local="clr-namespace:R3Config.Ctrl"
             x:Class="R3Config.Ctrl.HGamView"
             mc:Ignorable="d"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HCanStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource HCanSectionSurface}"
            CornerRadius="{StaticResource Radius.None}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

        <Grid MinHeight="0">
            <Grid.Resources>
                <CollectionViewSource x:Key="HCanGameSelectionView"
                                      Source="{Binding GameList.Games}"
                                      Filter="GameSelectionFilter" />
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{lang:TextExt Key=HCanary.Start.Game.Title}"
                       Style="{StaticResource HCanLocalizedSectionTitleText}"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="2"
                       Text="{lang:TextExt Key=HCanary.Start.Game.Description}"
                       Style="{StaticResource HCanLocalizedSectionCaptionText}"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="4"
                       Text="{lang:TextExt Key=HCanary.Start.Game.Search}"
                       Style="{StaticResource HCanLocalizedLabelText}" />

            <TextBox AutomationProperties.Name="{lang:TextExt Key=HCanary.Start.Game.Search}" x:Name="GameSearchBox"
                     Grid.Row="6"
                     Height="32"
                     Style="{StaticResource HCanLocalizedTextBox}"
                     TextChanged="GameSearchChanged" />

            <TextBlock Grid.Row="8"
                       Text="{lang:TextExt Key=HCanary.Start.Game.ListTitle}"
                       Style="{StaticResource HCanLocalizedSectionTitleText}"
                       TextWrapping="Wrap" />

            <Grid Grid.Row="10"
                  MinHeight="160"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="12,0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{lang:TextExt Key=HCanary.Field.GameName}"
                               Style="{StaticResource HCanLocalizedLabelText}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap" />

                    <TextBlock Grid.Column="2"
                               Text="{lang:TextExt Key=HCanary.Field.GameId}"
                               Style="{StaticResource HCanLocalizedLabelText}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap" />

                    <TextBlock Grid.Column="4"
                               Text="{lang:TextExt Key=HCanary.Field.GameVersion}"
                               Style="{StaticResource HCanLocalizedLabelText}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap" />
                </Grid>

                <Grid Grid.Row="2"
                      MinHeight="0">

                    <Border BorderThickness="{StaticResource Stroke.Thickness.Default}"
                            BorderBrush="{DynamicResource Stroke.Subtle}"
                            CornerRadius="{StaticResource Radius.None}"
                            ClipToBounds="True">

                        <ListBox x:Name="GameSelectionList"
                                 ItemsSource="{Binding Source={StaticResource HCanGameSelectionView}}"
                                 SelectedItem="{Binding GameList.SelGame,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource HCanList}"
                                 ItemContainerStyle="{StaticResource GameRailItem}"
                                 Padding="4"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Item">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="44"
                                          Margin="4,0"
                                          VerticalAlignment="Center">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   Style="{StaticResource HCanContentTitleText}"
                                                   FlowDirection="{Binding Title, Converter={StaticResource ContentTextFlowConverter}}"
                                                   Language="{Binding Title, Converter={StaticResource ContentTextLanguageConverter}, ConverterCulture=en-US}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Title}" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Game.Serial}"
                                                   Style="{StaticResource HCanTechnicalTextBlock}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Game.Serial}" />

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Game.Version}"
                                                   Style="{StaticResource HCanTechnicalTextBlock}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Game.Version}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Border Panel.ZIndex="2"
                            Background="{DynamicResource Surface.Subtle}"
                            Padding="12"
                            CornerRadius="{StaticResource Radius.None}">

                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems,
                                                                  ElementName=GameSelectionList}"
                                                 Value="False">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top">

                            <TextBlock Text="&#xE7FC;"
                                       Style="{StaticResource EmptyStateGlyph}"
                                       HorizontalAlignment="Left" />

                            <TextBlock Text="{lang:TextExt Key=HCanary.Start.Game.Empty}"
                                       Style="{StaticResource HCanLocalizedSectionCaptionText}"
                                       TextWrapping="Wrap" />

                            <Button Content="{lang:TextExt Key=Btn.Analyze}"
                                    Command="{Binding AnlzCmd}"
                                    ToolTip="{lang:TextExt Key=Btn.AnalyzeTip}"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource HCanPrimaryActionButton}"
                                    VerticalAlignment="Top"
                                    FlowDirection="{DynamicResource App.TextFlowDirection}"
                                    TextBlock.TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
