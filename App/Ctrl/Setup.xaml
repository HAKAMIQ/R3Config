<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             x:Class="R3Config.Ctrl.SetupView"
             AutomationProperties.AutomationId="Setup.Root"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="SetupPlanRow"
               TargetType="Border">
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Stroke.Subtle}" />
            <Setter Property="BorderThickness"
                    Value="0,0,0,1" />
            <Setter Property="Padding"
                    Value="0,9" />
        </Style>

        <Style x:Key="SetupPlanLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource Type.Body}">
            <Setter Property="TextAlignment"
                    Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="SetupPlanValue"
               TargetType="TextBlock"
               BasedOn="{StaticResource Type.BodyStrong}">
            <Setter Property="Foreground"
                    Value="{DynamicResource Text.Secondary}" />
            <Setter Property="HorizontalAlignment"
                    Value="{DynamicResource App.TrailingHorizontalAlignment}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer AutomationProperties.AutomationId="Setup.Scroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="{DynamicResource App.ScrollPadding4}">

        <Border Style="{StaticResource SectionCard}"
                HorizontalAlignment="Stretch">

            <StackPanel HorizontalAlignment="Stretch">

                <TextBlock Text="{Binding SetupStatus}"
                           AutomationProperties.AutomationId="Setup.Status"
                           Style="{StaticResource SectionCaptionText}"
                           HorizontalAlignment="Stretch"
                           TextWrapping="Wrap" />

                <Grid Margin="0,6,0,0"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{lang:TextExt Key=Setup.SourceLabel}"
                               Style="{StaticResource Type.Caption}"
                               Foreground="{DynamicResource Text.Secondary}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding SetupSource}"
                               Style="{StaticResource Type.Caption}"
                               FlowDirection="{DynamicResource TechnicalText.FlowDirection}"
                               TextAlignment="{DynamicResource TechnicalText.TextAlignment}"
                               Language="{DynamicResource TechnicalText.Language}"
                               Foreground="{DynamicResource Text.Secondary}"
                               HorizontalAlignment="Stretch"
                               TextWrapping="Wrap" />
                </Grid>

                <Border BorderBrush="{DynamicResource Stroke.Subtle}"
                        BorderThickness="0,1,0,0"
                        Margin="0,12,0,0"
                        Padding="0,12,0,0"
                        Visibility="{Binding SetupHasPendingChanges,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Stretch">

                        <TextBlock Text="{lang:TextExt Key=Setup.Plan}"
                                   Style="{StaticResource Type.BodyStrong}"
                                   TextAlignment="{DynamicResource App.TextAlignment}"
                                   HorizontalAlignment="Stretch" />

                        <Border Style="{StaticResource SetupPlanRow}"
                                Margin="0,3,0,0"
                                Visibility="{Binding SetupHasBaseChanges,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{lang:TextExt Key=Setup.PlanSettings}"
                                           Style="{StaticResource SetupPlanLabel}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SetupBaseCount}"
                                           Style="{StaticResource SetupPlanValue}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SetupPlanRow}"
                                Visibility="{Binding SetupHasOfficialChanges,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{lang:TextExt Key=Setup.PlanOfficial}"
                                           Style="{StaticResource SetupPlanLabel}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SetupOfficialCount}"
                                           Style="{StaticResource SetupPlanValue}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SetupPlanRow}"
                                Visibility="{Binding SetupHasCanaryChanges,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{lang:TextExt Key=Setup.PlanCanary}"
                                           Style="{StaticResource SetupPlanLabel}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SetupCanaryCount}"
                                           Style="{StaticResource SetupPlanValue}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SetupPlanRow}"
                                Visibility="{Binding SetupHasArtemisChanges,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{lang:TextExt Key=Setup.PlanArtemis}"
                                           Style="{StaticResource SetupPlanLabel}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SetupArtemisCount}"
                                           Style="{StaticResource SetupPlanValue}" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,9,0,0"
                              Visibility="{Binding SetupHasRequirements,
                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{lang:TextExt Key=Setup.PlanRequirements}"
                                       Style="{StaticResource SetupPlanLabel}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SetupRequirementCount}"
                                       Style="{StaticResource SetupPlanValue}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,12,0,0"
                      HorizontalAlignment="Stretch"
                      Visibility="{Binding SetupCanApply,
                                           Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="2"
                            Content="{lang:TextExt Key=Setup.PrepareAction}"
                            ToolTip="{lang:TextExt Key=Setup.PrepareTip}"
                            Command="{Binding PrepareGameCmd}"
                            AutomationProperties.AutomationId="Setup.PrepareButton"
                            Style="{StaticResource FluentButton.Primary}"
                            FlowDirection="{DynamicResource App.TextFlowDirection}"
                            TextBlock.TextAlignment="Center"
                            VerticalAlignment="Center" />
                </Grid>

                <Border BorderBrush="{DynamicResource Stroke.Subtle}"
                        BorderThickness="0,1,0,0"
                        Margin="0,14,0,0"
                        Padding="0,12,0,0"
                        Visibility="{Binding SetupHasReview,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Stretch">

                        <TextBlock Text="{lang:TextExt Key=Setup.Review}"
                                   Style="{StaticResource Type.BodyStrong}"
                                   TextAlignment="{DynamicResource App.TextAlignment}"
                                   HorizontalAlignment="Stretch" />

                        <StackPanel Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch"
                                    Visibility="{Binding SetupHasFiles,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{lang:TextExt Key=Setup.Files}"
                                       Style="{StaticResource Type.Caption}"
                                       FontWeight="SemiBold"
                                       TextAlignment="{DynamicResource App.TextAlignment}"
                                       HorizontalAlignment="Stretch" />

                            <TextBlock Text="{Binding SetupFiles}"
                                       AutomationProperties.AutomationId="Setup.Files"
                                       Style="{StaticResource Type.Caption}"
                                       Margin="0,4,0,0"
                                       FlowDirection="{DynamicResource TechnicalText.FlowDirection}"
                                       TextAlignment="{DynamicResource TechnicalText.TextAlignment}"
                                       Language="{DynamicResource TechnicalText.Language}"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       HorizontalAlignment="Stretch"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch"
                                    Visibility="{Binding SetupHasIssues,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{lang:TextExt Key=Setup.Warnings}"
                                       Style="{StaticResource Type.Caption}"
                                       FontWeight="SemiBold"
                                       TextAlignment="{DynamicResource App.TextAlignment}"
                                       HorizontalAlignment="Stretch" />

                            <TextBlock Text="{Binding SetupWarnings}"
                                       AutomationProperties.AutomationId="Setup.Warnings"
                                       Style="{StaticResource Type.Caption}"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Margin="0,4,0,0"
                                       TextAlignment="{DynamicResource App.TextAlignment}"
                                       HorizontalAlignment="Stretch"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding SetupHasWarnings,
                                                            Converter={StaticResource BoolToVisibilityConverter}}" />

                            <TextBlock Text="{Binding SetupConflicts}"
                                       Style="{StaticResource Type.Caption}"
                                       Foreground="{DynamicResource Status.Danger}"
                                       Margin="0,6,0,0"
                                       TextAlignment="{DynamicResource App.TextAlignment}"
                                       HorizontalAlignment="Stretch"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding SetupHasConflicts,
                                                            Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
