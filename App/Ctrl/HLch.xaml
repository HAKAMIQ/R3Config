<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="clr-namespace:R3Config.Lang"
             x:Class="R3Config.Ctrl.HLchView"
             mc:Ignorable="d"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HCanStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="WorkflowActions"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Background="Transparent">

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FlowDirection="LeftToRight">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="{lang:TextExt Key=HCanary.New}"
                    Command="{Binding HCanary.NewCmd}"
                    Click="RaiseStartRequested"
                    Style="{StaticResource HCanPrimaryActionButton}"
                    FlowDirection="{DynamicResource App.TextFlowDirection}"
                    TextBlock.TextAlignment="Center" />

            <Button Grid.Column="2"
                    Content="{lang:TextExt Key=HCanary.Stored.Manage}"
                    Click="RaiseSavedRequested"
                    Style="{StaticResource HCanSecondaryActionButton}"
                    FlowDirection="{DynamicResource App.TextFlowDirection}"
                    TextBlock.TextAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>