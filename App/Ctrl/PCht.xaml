<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="clr-namespace:R3Config.Lang"
             x:Class="R3Config.Ctrl.PChtView"
             mc:Ignorable="d"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PSty.xaml" />
                <ResourceDictionary Source="PTmp.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="ChtRoot"
          FlowDirection="{DynamicResource App.FlowDirection}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Preview.ChtSum}"
                   Style="{StaticResource PatSectionSummaryText}"
                   Margin="8,0,8,8"
                   Visibility="{Binding Preview.HasCht,
                                        Converter={StaticResource BoolToVisibilityConverter}}" />

        <Border Grid.Row="1"
                Style="{StaticResource PatResultSurface}"
                MinHeight="160"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <ScrollViewer Style="{StaticResource PatContentScrollViewer}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding Preview.ChtGrps}"
                                  ItemTemplate="{StaticResource ArtemisTgtGrp}"
                                  FlowDirection="{DynamicResource App.FlowDirection}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch" />
                </ScrollViewer>

                <Border Style="{StaticResource PatEmptyStateHost}"
                        Visibility="{Binding Preview.ChtEmpty,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="480">
                        <TextBlock Text="{lang:TextExt Key=Patch.CheatEmptyTitle}"
                                   Style="{StaticResource PatEmptyStateTitleText}" />
                        <TextBlock Text="{lang:TextExt Key=Patch.CheatEmptyHint}"
                                   Style="{StaticResource PatEmptyStateHintText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="ChtActions"
              Grid.Row="2"
              FlowDirection="{DynamicResource App.FlowDirection}"
              HorizontalAlignment="Stretch"
              Margin="0,10,0,0"
              VerticalAlignment="Bottom"
              Visibility="{Binding Preview.HasCht,
                                   Converter={StaticResource BoolToVisibilityConverter}}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0"
                       Orientation="Horizontal"
                       FlowDirection="{DynamicResource App.FlowDirection}"
                       HorizontalAlignment="{DynamicResource App.HorizontalAlignment}"
                       VerticalAlignment="Center">
                <Button Style="{StaticResource PatCheatPrimaryButton}"
                        Command="{Binding ChtOn}"
                        Content="{lang:TextExt Key=Patch.ApplyCheatSection}"
                        ToolTip="{lang:TextExt Key=Patch.ApplyCheatSectionTip}"
                        Visibility="{Binding Preview.SelChtOn,
                                             Converter={StaticResource BoolToVisibilityConverter}}"
                        TextBlock.TextAlignment="Center" />

                <Button Style="{StaticResource PatCheatSecondaryButton}"
                        Command="{Binding ChtOff}"
                        Content="{lang:TextExt Key=Patch.Off}"
                        ToolTip="{lang:TextExt Key=Patch.OffTip}"
                        Visibility="{Binding Preview.ChtOff,
                                             Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0"
                        TextBlock.TextAlignment="Center" />
            </WrapPanel>

            <Button x:Name="ArtemisOptionsButton"
                    Grid.Column="2"
                    Style="{StaticResource PatCheatSecondaryButton}"
                    Content="{lang:TextExt Key=Patch.Artemis.Options}"
                    Click="OpenArtemisOptions_Click"
                    AutomationProperties.Name="{lang:TextExt Key=Patch.Artemis.Options}"
                    Margin="0"
                    TextBlock.TextAlignment="Center">

                <Button.ToolTip>
                    <ToolTip Style="{StaticResource PatCanaryNoteToolTip}">
                        <StackPanel Orientation="Vertical"
                                    MaxWidth="320"
                                    FlowDirection="{DynamicResource App.FlowDirection}">
                            <TextBlock Text="{Binding Preview.ChtHint}"
                                       Style="{StaticResource PatCanaryHelpText}"
                                       TextAlignment="{DynamicResource App.TextAlignment}"
                                       HorizontalAlignment="Stretch"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Preview.ChtSelectionNotice}"
                                       Style="{StaticResource PatCanaryHelpText}"
                                       Foreground="{DynamicResource Status.Warning}"
                                       Margin="0,6,0,0"
                                       TextAlignment="{DynamicResource App.TextAlignment}"
                                       HorizontalAlignment="Stretch"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Preview.HasChtSelectionNotice,
                                                            Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>

                <Button.ContextMenu>
                    <ContextMenu FlowDirection="{DynamicResource App.FlowDirection}"
                                 Language="{DynamicResource App.XmlLanguage}"
                                 DataContext="{Binding PlacementTarget.DataContext,
                                                       RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{lang:TextExt Key=Patch.Artemis.SelectAll}"
                                  Command="{Binding ChtSelectAll}" />
                        <MenuItem Header="{lang:TextExt Key=Patch.Artemis.ClearSelection}"
                                  Command="{Binding ChtClearSelection}" />
                        <Separator />
                        <MenuItem Header="{lang:TextExt Key=Patch.Artemis.RemoveSelected}"
                                  Command="{Binding ChtRemove}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>
    </Grid>
</UserControl>
