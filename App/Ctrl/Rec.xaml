<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             xmlns:ctrl="clr-namespace:R3Config.Ctrl"
             x:Class="R3Config.Ctrl.RecView"
             AutomationProperties.AutomationId="Settings.Root"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="RecommendationStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="WikiNoteTemplate">
                <StackPanel Orientation="Vertical"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch">

                    <TextBlock Text="{Binding Header}"
                               Style="{StaticResource RecToolTipSectionLabelText}"
                               TextAlignment="{DynamicResource App.TextAlignment}" />

                    <TextBlock ctrl:LinkText.Text="{Binding DisplayText}"
                               ctrl:LinkText.Source="{Binding Text}"
                               Style="{StaticResource RecLocalizedBodyText}"
                               FlowDirection="{DynamicResource App.TextFlowDirection}"
                               Margin="0,2,0,0" />

                    <Expander Style="{StaticResource RecDetailsExpander}"
                              Margin="0,4,0,0">
                        <Expander.Header>
                            <TextBlock Text="{Binding DetailsLabel}"
                                       Style="{StaticResource RecDetailsHeaderText}" />
                        </Expander.Header>
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock ctrl:LinkText.Text="{Binding OriginalText}"
                                       Style="{StaticResource RecLocalizedBodyText}"
                                       FlowDirection="LeftToRight"
                                       Language="en-US" />
                            <TextBlock ctrl:LinkText.Text="{Binding SourceUrl}"
                                       ctrl:LinkText.Target="{Binding SourceUrl}"
                                       Style="{StaticResource RecLocalizedSubtitleText}"
                                       FlowDirection="LeftToRight"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </DataTemplate>

            <!-- One lost database setting: RPCS3 section/key and values, LTR. -->
            <DataTemplate x:Key="DbWarnLineTemplate">
                <TextBlock Text="{Binding}"
                           Style="{StaticResource RecLocalizedBodyText}"
                           FlowDirection="LeftToRight"
                           Language="en-US"
                           Margin="0,2,0,0" />
            </DataTemplate>

            <DataTemplate x:Key="OnlineRowTemplate">
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               Style="{StaticResource RecToolTipSectionLabelText}"
                               TextAlignment="{DynamicResource App.TextAlignment}" />

                    <TextBlock Grid.Column="1"
                               ctrl:LinkText.Text="{Binding Value}"
                               ctrl:LinkText.Target="{Binding Url}"
                               Style="{StaticResource RecToolTipTechnicalValueText}" />

                    <TextBlock Grid.Column="2"
                               ctrl:LinkText.Text="{Binding ActionLabel}"
                               ctrl:LinkText.Target="{Binding ActionUrl}"
                               Style="{StaticResource RecLocalizedSubtitleText}"
                               Margin="12,0,0,0"
                               Visibility="{Binding HasAction,
                                                    Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="OnlineTemplate">
                <StackPanel Orientation="Vertical"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch">

                    <ItemsControl ItemsSource="{Binding SummaryRows}"
                                  ItemTemplate="{StaticResource OnlineRowTemplate}"
                                  HorizontalContentAlignment="Stretch" />

                    <Expander Style="{StaticResource RecDetailsExpander}"
                              Margin="0,8,0,0"
                              Visibility="{Binding HasDetails,
                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                        <Expander.Header>
                            <TextBlock Text="{Binding DetailsLabel}"
                                       Style="{StaticResource RecDetailsHeaderText}" />
                        </Expander.Header>

                        <StackPanel Orientation="Vertical"
                                    Margin="0,6,0,0">
                            <ItemsControl ItemsSource="{Binding DetailRows}"
                                          ItemTemplate="{StaticResource OnlineRowTemplate}"
                                          HorizontalContentAlignment="Stretch" />

                            <TextBlock ctrl:LinkText.Text="{Binding Notes}"
                                       ctrl:LinkText.Source="{Binding RawNotes}"
                                       Style="{StaticResource RecLocalizedBodyText}"
                                       FlowDirection="{Binding Notes, Converter={StaticResource ContentTextFlowConverter}}"
                                       Language="{Binding Notes, Converter={StaticResource ContentTextLanguageConverter}, ConverterCulture=en-US}"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding HasNotes,
                                                            Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="PlanRowTemplate">

                <Border Style="{StaticResource RecSettingRow}"
                        FlowDirection="{DynamicResource App.FlowDirection}"
                        HorizontalAlignment="Stretch">

                    <Border.ToolTip>
                        <ToolTip Style="{StaticResource ChecklistDetailToolTip}"
                                 DataContext="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource Self}}">

                            <Border Padding="2"
                                    CornerRadius="{StaticResource Radius.None}"
                                    FlowDirection="{DynamicResource App.FlowDirection}">

                                <StackPanel Orientation="Vertical"
                                            HorizontalAlignment="Stretch">

                                    <TextBlock Text="{Binding Key}"
                                               Style="{StaticResource ChecklistToolTipTitleText}"
                                               FlowDirection="{DynamicResource TechnicalText.FlowDirection}"
                                               Language="{DynamicResource TechnicalText.Language}"
                                               TextAlignment="{DynamicResource TechnicalText.TextAlignment}"
                                               HorizontalAlignment="Stretch"
                                               TextWrapping="Wrap" />

                                    <StackPanel Orientation="Vertical"
                                                Margin="0,10,0,0"
                                                HorizontalAlignment="Stretch">

                                        <TextBlock Text="{lang:TextExt Key=Plan.Current}"
                                                   Style="{StaticResource RecToolTipSectionLabelText}"
                                                   TextAlignment="{DynamicResource App.TextAlignment}" />

                                        <TextBlock Text="{Binding CurDsp}"
                                                   Style="{StaticResource RecToolTipTechnicalValueText}"
                                                   Margin="0,3,0,0" />

                                        <TextBlock Text="{Binding SrcDsp}"
                                                   Style="{StaticResource RecToolTipSourceText}"
                                                   Margin="0,2,0,10" />

                                        <!-- Only when R3Config's copy of the RPCS3 database makes RPCS3 boot
                                             another value; direction from the styles only. -->
                                        <StackPanel Margin="0,0,0,10"
                                                    Visibility="{Binding HasDbBoot,
                                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{lang:TextExt Key=Plan.DbBoot}"
                                                       Style="{StaticResource RecToolTipSourceText}" />

                                            <TextBlock Text="{Binding DbBootDsp}"
                                                       Style="{StaticResource RecToolTipTechnicalValueText}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>

                                        <TextBlock Text="{lang:TextExt Key=Plan.Proposed}"
                                                   Style="{StaticResource RecToolTipSectionLabelText}"
                                                   TextAlignment="{DynamicResource App.TextAlignment}" />

                                        <TextBlock Text="{Binding Val}"
                                                   Style="{StaticResource RecToolTipTechnicalValueText}"
                                                   Margin="0,3,0,0" />

                                        <TextBlock Text="{Binding OrigDsp}"
                                                   Style="{StaticResource RecToolTipSourceText}"
                                                   Margin="0,2,0,10" />

                                        <!-- Direction comes from the styles only, so the frozen
                                             UiGate direction/alignment contract is unchanged. -->
                                        <TextBlock Text="{lang:TextExt Key=Plan.Default}"
                                                   Style="{StaticResource RecToolTipSectionLabelText}" />

                                        <TextBlock Text="{Binding DefDsp}"
                                                   Style="{StaticResource RecToolTipTechnicalValueText}"
                                                   Margin="0,3,0,0"
                                                   Visibility="{Binding HasDef,
                                                                        Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <TextBlock Text="{lang:TextExt Key=Ui.Unknown}"
                                                   Style="{StaticResource RecToolTipSourceText}"
                                                   Margin="0,3,0,0"
                                                   Visibility="{Binding NoDef,
                                                                        Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>

                                    <Border Height="1"
                                            Background="{DynamicResource Stroke.Subtle}"
                                            Margin="0,12,0,10"
                                            Visibility="{Binding HasNote,
                                                                 Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <TextBlock Text="{lang:TextExt Key=Plan.WikiInstructions}"
                                               Style="{StaticResource RecToolTipWikiHeadingText}"
                                               TextAlignment="{DynamicResource App.TextAlignment}"
                                               Visibility="{Binding HasNote,
                                                                    Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <TextBlock ctrl:LinkText.Text="{Binding LocBody}"
                                               ctrl:LinkText.Source="{Binding Notes}"
                                               ctrl:LinkText.Interactive="False"
                                               Style="{StaticResource RecLocalizedBodyText}"
                                               FlowDirection="{Binding NoteFlow}"
                                               TextAlignment="{Binding NoteText}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasNote,
                                                                    Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <TextBlock Text="{Binding ReasonTitle}"
                                               Style="{StaticResource RecToolTipWikiHeadingText}"
                                               TextAlignment="{DynamicResource App.TextAlignment}"
                                               Margin="0,12,0,0"
                                               Visibility="{Binding HasReason,
                                                                    Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <TextBlock Text="{Binding ReasonText}"
                                               Style="{StaticResource RecLocalizedBodyText}"
                                               TextAlignment="{DynamicResource App.TextAlignment}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasReason,
                                                                    Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </ToolTip>
                    </Border.ToolTip>

                    <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="184" />
                            <ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Key}"
                                   Style="{StaticResource ChecklistOptionText}"
                                   FlowDirection="{DynamicResource TechnicalText.FlowDirection}"
                                   TextAlignment="{DynamicResource TechnicalText.TextAlignment}"
                                   Language="{DynamicResource TechnicalText.Language}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Val}"
                                   Style="{StaticResource RecRowValueText}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="12,0" />

                        <Grid Grid.Column="2"
                              MinWidth="96"
                              Height="28"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center">

                            <CheckBox Style="{StaticResource IconCheckBox}"
                                      IsChecked="{Binding IsSel,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsAction}"
                                      AutomationProperties.Name="{Binding Key}"
                                      Visibility="{Binding ShowSelection,
                                                           Converter={StaticResource BoolToVisibilityConverter}}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="0"
                                      TextBlock.TextAlignment="{DynamicResource App.TextAlignment}" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FlowDirection="LeftToRight"
                                        Visibility="{Binding IsApply,
                                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                <Viewbox Width="14"
                                         Height="14"
                                         Stretch="Uniform"
                                         FlowDirection="LeftToRight"
                                         VerticalAlignment="Center">
                                    <Path Data="M 1,6.5 L 2.6,4.9 L 4.7,7 L 9.6,2.1 L 11.2,3.7 L 4.7,10.2 Z"
                                          Fill="{DynamicResource Status.Success}"
                                          Stretch="Uniform" />
                                </Viewbox>

                                <TextBlock Text="{Binding StatDsp}"
                                           Style="{StaticResource RecAppliedStatusText}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{Binding StatDsp}"
                                       Style="{StaticResource RecInactiveStatusText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ShowNonActionState,
                                                            Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SectionCard}"
            CornerRadius="{StaticResource Radius.None}"
            FlowDirection="{DynamicResource App.FlowDirection}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

        <Grid FlowDirection="{DynamicResource App.FlowDirection}"
              Language="{DynamicResource App.XmlLanguage}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Primary action first; Restore Defaults closes the list below. -->
            <Grid Grid.Row="0"
                  FlowDirection="{DynamicResource App.FlowDirection}"
                  HorizontalAlignment="Stretch">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Margin="0,0,0,10"
                        AutomationProperties.AutomationId="Settings.ApplyButton"
                        Content="{lang:TextExt Key=Plan.ApplySection}"
                        ToolTip="{lang:TextExt Key=Plan.ApplySectionTip}"
                        Command="{Binding ApplyCmd}"
                        Style="{StaticResource RecPrimaryActionButton}"
                        Visibility="{Binding Plan.HasChg,
                                             Converter={StaticResource BoolToVisibilityConverter}}"
                        FlowDirection="{DynamicResource App.TextFlowDirection}"
                        TextBlock.TextAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1"
                  FlowDirection="{DynamicResource App.FlowDirection}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <ScrollViewer AutomationProperties.AutomationId="Settings.Scroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              FlowDirection="{DynamicResource App.FlowDirection}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Padding="{DynamicResource App.ScrollPadding4}">

                    <StackPanel Orientation="Vertical"
                                FlowDirection="{DynamicResource App.FlowDirection}"
                                HorizontalAlignment="Stretch">

                        <!-- Effective configuration source: one quiet line in the UI direction. A database
                             source lists its RPCS3 keys/values in the tip (technical text, LTR). -->
                        <TextBlock Text="{Binding Plan.BootSrcText}"
                                   AutomationProperties.AutomationId="Settings.BootSource"
                                   Style="{StaticResource RecLocalizedSubtitleText}"
                                   Margin="0,0,0,10"
                                   ToolTipService.IsEnabled="{Binding Plan.HasBootSrcTip}"
                                   Visibility="{Binding Plan.HasBootSrc,
                                                        Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock.ToolTip>
                                <ToolTip Style="{StaticResource ChecklistDetailToolTip}"
                                         DataContext="{Binding PlacementTarget.DataContext,
                                                              RelativeSource={RelativeSource Self}}">
                                    <TextBlock Text="{Binding Plan.BootSrcTip}"
                                               Style="{StaticResource RecToolTipTechnicalValueText}" />
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>

                        <!-- 0. G1: the selected writes would create config_SERIAL.yml, and RPCS3 then
                             ignores its database config for the game. Lines are RPCS3 keys/values (LTR). -->
                        <Border Style="{StaticResource RecEvidenceCard}"
                                AutomationProperties.AutomationId="Settings.DbConfigWarning"
                                Background="{DynamicResource Status.WarningSurface}"
                                BorderBrush="{DynamicResource Status.Warning}"
                                Margin="0,0,0,10"
                                Visibility="{Binding Plan.HasDbWarn,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">

                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Stretch">

                                <TextBlock Text="{Binding Plan.DbWarnTitle}"
                                           Style="{StaticResource RecLocalizedBodyText}"
                                           Foreground="{DynamicResource Status.Warning}" />

                                <!-- (a) A recommendation above writes the same value: selecting it keeps the setting.
                                     The button selects these rows only when pressed; nothing is selected automatically. -->
                                <TextBlock Text="{Binding Plan.DbKeepTitle}"
                                           AutomationProperties.AutomationId="Settings.DbConfigKeepTitle"
                                           Style="{StaticResource RecLocalizedSubtitleText}"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding Plan.HasDbKeep,
                                                                Converter={StaticResource BoolToVisibilityConverter}}" />

                                <ItemsControl ItemsSource="{Binding Plan.DbKeepLines}"
                                              ItemTemplate="{StaticResource DbWarnLineTemplate}"
                                              HorizontalContentAlignment="Stretch"
                                              Visibility="{Binding Plan.HasDbKeep,
                                                                   Converter={StaticResource BoolToVisibilityConverter}}" />

                                <Grid Margin="0,6,0,0"
                                      Visibility="{Binding Plan.HasDbKeep,
                                                           Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button AutomationProperties.AutomationId="Settings.DbConfigSelectKeep"
                                            Content="{lang:TextExt Key=Plan.DbWarnSelectKeep}"
                                            ToolTip="{lang:TextExt Key=Plan.DbWarnSelectKeepTip}"
                                            Command="{Binding Plan.SelDbKeepCmd}"
                                            Style="{StaticResource RecSecondaryActionButton}" />
                                </Grid>

                                <!-- (b+d) R3Config cannot write these values: they are lost. -->
                                <TextBlock Text="{Binding Plan.DbLostTitle}"
                                           AutomationProperties.AutomationId="Settings.DbConfigLostTitle"
                                           Style="{StaticResource RecLocalizedSubtitleText}"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding Plan.HasDbLost,
                                                                Converter={StaticResource BoolToVisibilityConverter}}" />

                                <ItemsControl ItemsSource="{Binding Plan.DbLostLines}"
                                              ItemTemplate="{StaticResource DbWarnLineTemplate}"
                                              HorizontalContentAlignment="Stretch"
                                              Visibility="{Binding Plan.HasDbLost,
                                                                   Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <!-- 1. Actionable settings: one flat compact list; no column titles, no tab headers. -->
                        <ItemsControl AutomationProperties.AutomationId="Settings.List"
                                      ItemsSource="{Binding Plan.Rows}"
                                      ItemTemplate="{StaticResource PlanRowTemplate}"
                                      FlowDirection="{DynamicResource App.FlowDirection}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch" />

                        <!-- 2. Warnings and instructions applicable to this game. -->
                        <Border Style="{StaticResource RecEvidenceCard}"
                                AutomationProperties.AutomationId="Settings.Notes"
                                Margin="0,14,0,10"
                                Visibility="{Binding Plan.Evidence.HasNotes,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">

                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Stretch">

                                <TextBlock Text="{lang:TextExt Key=Wiki.Notes.Title}"
                                           Style="{StaticResource RecToolTipWikiHeadingText}"
                                           TextAlignment="{DynamicResource App.TextAlignment}" />

                                <TextBlock Text="{lang:TextExt Key=Wiki.OriginalText}"
                                           Style="{StaticResource RecLocalizedSubtitleText}"
                                           Visibility="{Binding Plan.Evidence.ShowOriginalCaption,
                                                                Converter={StaticResource BoolToVisibilityConverter}}" />

                                <ItemsControl ItemsSource="{Binding Plan.Evidence.Notes}"
                                              ItemTemplate="{StaticResource WikiNoteTemplate}"
                                              HorizontalContentAlignment="Stretch" />
                            </StackPanel>
                        </Border>

                        <!-- 3. Compact RPCN information for the installed game version. -->
                        <Border Style="{StaticResource RecEvidenceCard}"
                                AutomationProperties.AutomationId="Settings.Online"
                                Visibility="{Binding Plan.Evidence.HasOnline,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">

                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Stretch">

                                <TextBlock Text="{lang:TextExt Key=Wiki.Online.Title}"
                                           Style="{StaticResource RecToolTipWikiHeadingText}"
                                           TextAlignment="{DynamicResource App.TextAlignment}" />

                                <ItemsControl ItemsSource="{Binding Plan.Evidence.Online}"
                                              ItemTemplate="{StaticResource OnlineTemplate}"
                                              HorizontalContentAlignment="Stretch" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding Plan.Evidence.OnlineMismatchText}"
                                   AutomationProperties.AutomationId="Settings.OnlineNoMatch"
                                   Style="{StaticResource RecLocalizedSubtitleText}"
                                   Margin="0,4,0,10"
                                   Visibility="{Binding Plan.Evidence.HasOnlineMismatch,
                                                        Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="{Binding Plan.Evidence.OnlineUnknownVersionText}"
                                   AutomationProperties.AutomationId="Settings.OnlineUnknownVersion"
                                   Style="{StaticResource RecLocalizedSubtitleText}"
                                   Margin="0,4,0,10"
                                   Visibility="{Binding Plan.Evidence.HasOnlineUnknownVersion,
                                                        Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- 3b. History and community hardware evidence: informational lines only. -->
                        <Border Style="{StaticResource RecEvidenceCard}"
                                AutomationProperties.AutomationId="Settings.Knowledge"
                                Visibility="{Binding Plan.Evidence.HasKnowledge,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">

                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Stretch">

                                <TextBlock Text="{Binding Plan.Evidence.KnowledgeTitle}"
                                           Style="{StaticResource RecToolTipWikiHeadingText}"
                                           TextAlignment="{DynamicResource App.TextAlignment}" />

                                <ItemsControl ItemsSource="{Binding Plan.Evidence.KnowledgeLines}"
                                              HorizontalContentAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Style="{StaticResource RecLocalizedSubtitleText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 4. Restore Defaults belongs after the settings and information. -->
                        <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                              Margin="0,14,0,4"
                              HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="1"
                                    AutomationProperties.AutomationId="Settings.RestoreDefaults"
                                    Content="{lang:TextExt Key=Plan.RemoveWikiSettings}"
                                    ToolTip="{lang:TextExt Key=Plan.RemoveWikiSettingsTip}"
                                    Command="{Binding DelSet}"
                                    Style="{StaticResource RecSecondaryActionButton}"
                                    Visibility="{Binding Plan.CanDel,
                                                         Converter={StaticResource BoolToVisibilityConverter}}"
                                    FlowDirection="{DynamicResource App.TextFlowDirection}"
                                    TextBlock.TextAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Border Style="{StaticResource ViewportEmptyStatePanel}"
                        CornerRadius="{StaticResource Radius.None}"
                        FlowDirection="{DynamicResource App.FlowDirection}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="{Binding Plan.ShowEmpty,
                                             Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock Text="{Binding Plan.EmptyTxt}"
                               Style="{StaticResource RecLocalizedEmptyText}"
                               MaxWidth="460"
                               Margin="0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="{DynamicResource App.TextAlignment}"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
