<UserControl x:Class="R3Config.Ctrl.RecView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Border Style="{StaticResource SectionCard}"
            FlowDirection="{DynamicResource App.FlowDirection}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top">

        <Grid FlowDirection="{DynamicResource App.FlowDirection}"
              Language="{DynamicResource App.XmlLanguage}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,12"
                  FlowDirection="{DynamicResource App.FlowDirection}"
                  HorizontalAlignment="Stretch">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            HorizontalAlignment="Stretch">

                    <TextBlock Text="{lang:TextExt Key=Shell.SettingsSection}"
                               Style="{StaticResource SectionTitleText}"
                               FlowDirection="{DynamicResource App.TextFlowDirection}"
                               TextAlignment="{DynamicResource App.TextAlignment}"
                               HorizontalAlignment="Stretch" />

                    <TextBlock Text="{Binding Plan.Summary}"
                               Style="{StaticResource RecommendationRowSubtitleText}"
                               FlowDirection="{DynamicResource App.TextFlowDirection}"
                               TextAlignment="{DynamicResource App.TextAlignment}"
                               HorizontalAlignment="Stretch"
                               Margin="0,4,0,0"
                               ToolTip="{Binding Plan.TgtCfg}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="{lang:TextExt Key=Plan.RemoveWikiSettings}"
                        ToolTip="{lang:TextExt Key=Plan.RemoveWikiSettingsTip}"
                        Command="{Binding DelSet}"
                        VerticalAlignment="Center"
                        Visibility="{Binding Plan.CanDel,
                                             Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Grid.Column="4"
                        Content="{lang:TextExt Key=Plan.ApplySection}"
                        ToolTip="{lang:TextExt Key=Plan.ApplySectionTip}"
                        Command="{Binding ApplyCmd}"
                        VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1"
                  FlowDirection="{DynamicResource App.FlowDirection}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="320"
                              FlowDirection="{DynamicResource App.FlowDirection}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Padding="{DynamicResource App.ScrollPadding4}">

                    <ItemsControl ItemsSource="{Binding Plan.Items}"
                                  FlowDirection="{DynamicResource App.FlowDirection}"
                                  HorizontalAlignment="Stretch">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"
                                            FlowDirection="{DynamicResource App.FlowDirection}"
                                            HorizontalAlignment="Stretch" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ChecklistOptionRow}"
                                        FlowDirection="{DynamicResource App.FlowDirection}"
                                        HorizontalAlignment="Stretch"
                                        MinHeight="48"
                                        Margin="0,0,0,6"
                                        ToolTipService.InitialShowDelay="180"
                                        ToolTipService.ShowDuration="60000">

                                    <Border.ToolTip>
                                        <ToolTip Style="{StaticResource ModernToolTip}"
                                                 Placement="Mouse"
                                                 DataContext="{Binding PlacementTarget.DataContext,
                                                                      RelativeSource={RelativeSource Self}}"
                                                 MaxWidth="420">

                                            <Border Padding="2"
                                                    FlowDirection="{DynamicResource App.FlowDirection}">

                                                <StackPanel Orientation="Vertical">

                                                    <TextBlock Text="{Binding Key}"
                                                               Style="{StaticResource ChecklistToolTipTitleText}"
                                                               FlowDirection="{DynamicResource TechnicalText.FlowDirection}"
                                                               Language="{DynamicResource TechnicalText.Language}"
                                                               TextAlignment="{DynamicResource TechnicalText.TextAlignment}" />

                                                    <TextBlock Text="{Binding BeginSum}"
                                                               Style="{StaticResource ChecklistToolTipBodyText}"
                                                               FlowDirection="{DynamicResource App.TextFlowDirection}"
                                                               TextAlignment="{DynamicResource App.TextAlignment}"
                                                               Margin="0,4,0,8" />

                                                    <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                                                          Margin="0,0,0,8">

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   Text="{lang:TextExt Key=Plan.Current}"
                                                                   Style="{StaticResource ChecklistToolTipLabelText}"
                                                                   FlowDirection="{DynamicResource App.TextFlowDirection}"
                                                                   TextAlignment="{DynamicResource App.TextAlignment}" />

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding CurDsp}"
                                                                   Style="{StaticResource ChecklistToolTipValueText}"
                                                                   ToolTip="{Binding CurDsp}" />

                                                        <TextBlock Grid.Column="4"
                                                                   Text="{lang:TextExt Key=Plan.Proposed}"
                                                                   Style="{StaticResource ChecklistToolTipLabelText}"
                                                                   FlowDirection="{DynamicResource App.TextFlowDirection}"
                                                                   TextAlignment="{DynamicResource App.TextAlignment}" />

                                                        <TextBlock Grid.Column="6"
                                                                   Text="{Binding Val}"
                                                                   Style="{StaticResource ChecklistToolTipValueText}"
                                                                   ToolTip="{Binding Val}" />
                                                    </Grid>

                                                    <TextBlock Text="{Binding DspPath}"
                                                               Style="{StaticResource ChecklistToolTipSubtleText}"
                                                               FlowDirection="{DynamicResource TechnicalText.FlowDirection}"
                                                               Language="{DynamicResource TechnicalText.Language}"
                                                               TextAlignment="{DynamicResource TechnicalText.TextAlignment}"
                                                               Margin="0,0,0,6" />

                                                    <TextBlock Text="{Binding LocBody}"
                                                               Style="{StaticResource ChecklistToolTipBodyText}"
                                                               FlowDirection="{Binding NoteFlow}"
                                                               TextAlignment="{Binding NoteText}"
                                                               Visibility="{Binding HasNote,
                                                                                    Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Border>
                                        </ToolTip>
                                    </Border.ToolTip>

                                    <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  Style="{StaticResource IconCheckBox}"
                                                  IsChecked="{Binding IsSel,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsAction}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="0"
                                                  ToolTip="{lang:TextExt Key=Plan.SelectTip}" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Key}"
                                                   Style="{StaticResource ChecklistOptionText}"
                                                   FlowDirection="{DynamicResource TechnicalText.FlowDirection}"
                                                   TextAlignment="{DynamicResource TechnicalText.TextAlignment}"
                                                   Language="{DynamicResource TechnicalText.Language}"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Key}" />

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding BeginSum}"
                                                   Style="{StaticResource Type.BodyStrong}"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   FlowDirection="{DynamicResource App.TextFlowDirection}"
                                                   TextAlignment="{DynamicResource App.TextAlignment}"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0"
                                                   ToolTip="{Binding BeginSum}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Style="{StaticResource ViewportEmptyStatePanel}"
                        FlowDirection="{DynamicResource App.FlowDirection}"
                        Visibility="{Binding Plan.IsEmpty,
                                             Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock Text="{Binding Plan.EmptyTxt}"
                               Style="{StaticResource ArabicEmptyStateText}"
                               FlowDirection="{DynamicResource App.TextFlowDirection}"
                               TextAlignment="{DynamicResource App.TextAlignment}"
                               HorizontalAlignment="{DynamicResource App.HorizontalAlignment}"
                               MaxWidth="460"
                               VerticalAlignment="Center"
                               Margin="0" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>