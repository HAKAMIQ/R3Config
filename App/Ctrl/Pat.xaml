<UserControl x:Class="R3Config.Ctrl.PatView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lang="clr-namespace:R3Config.Lang" FlowDirection="{DynamicResource App.FlowDirection}" Language="{DynamicResource App.XmlLanguage}" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="PatTrailingWrapPanel" TargetType="{x:Type WrapPanel}">
            <Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="HorizontalAlignment" Value="{DynamicResource App.TrailingHorizontalAlignment}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PatLocalizedTitleText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource R3SettingsRowTitleText}">
            <Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment" Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="PatLocalizedDescriptionText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource R3SettingsRowDescriptionText}">
            <Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment" Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="PatLocalizedSubtitleText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource RecommendationRowSubtitleText}">
            <Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment" Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>

        <Style x:Key="PatStatusSummaryText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.BodyStrong}">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment" Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>

        <Style x:Key="PatLocalizedEmptyText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ArabicEmptyStateText}">
            <Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment" Value="{DynamicResource App.TextAlignment}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PatLocalizedPillText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SourcePillText}">
            <Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="TextAlignment" Value="{DynamicResource App.TextAlignment}" />
        </Style>

        <Style x:Key="PatStatusBadge" TargetType="{x:Type Border}" BasedOn="{StaticResource SourcePill}">
            <Setter Property="Margin" Value="{DynamicResource App.Before8Margin}" />
            <Setter Property="HorizontalAlignment" Value="{DynamicResource App.HorizontalAlignment}" />
        </Style>

        <Style x:Key="PatPillWithGap" TargetType="{x:Type Border}" BasedOn="{StaticResource SourcePill}">
            <Setter Property="Margin" Value="{DynamicResource App.After6Margin}" />
        </Style>

        <Style x:Key="PatPrimaryInlineButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FluentButton.Primary}">
            <Setter Property="Margin" Value="{DynamicResource App.After8Margin}" /><Setter Property="MinHeight" Value="32" /><Setter Property="MinWidth" Value="112" /><Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PatToolbarInlineButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FluentButton.Toolbar}">
            <Setter Property="Margin" Value="{DynamicResource App.After8Margin}" /><Setter Property="MinHeight" Value="32" /><Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PatSourceActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PatToolbarInlineButton}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="TextBlock.TextAlignment" Value="{DynamicResource App.TextAlignment}" />
        </Style>

        <Style x:Key="PatOfficialPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PatPrimaryInlineButton}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="TextBlock.TextAlignment" Value="{DynamicResource App.TextAlignment}" />
        </Style>

        <Style x:Key="PatOfficialSecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FluentButton.Secondary}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="TextBlock.TextAlignment" Value="{DynamicResource App.TextAlignment}" />
        </Style>

        <Style x:Key="PatCanaryPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PatPrimaryInlineButton}">
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="TextBlock.TextAlignment" Value="{DynamicResource App.TextAlignment}" />
        </Style>

        <Style x:Key="PatCanarySecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FluentButton.Secondary}">
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="TextBlock.TextAlignment" Value="{DynamicResource App.TextAlignment}" />
        </Style>

        <Style x:Key="PatCheatPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PatPrimaryInlineButton}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="TextBlock.TextAlignment" Value="{DynamicResource App.TextAlignment}" />
        </Style>

        <Style x:Key="PatCheatSecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FluentButton.Secondary}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="TextBlock.TextAlignment" Value="{DynamicResource App.TextAlignment}" />
        </Style>

        <Style x:Key="PatReadinessPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FluentButton.Primary}">
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style x:Key="PatNestedItemsControl" TargetType="{x:Type ItemsControl}">
            <Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="{DynamicResource App.Indent24Margin}" />
        </Style>

        <Style x:Key="PatContentScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="PatResultSurface" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" />
        </Style>

        <DataTemplate x:Key="PatItem">
            <Border Style="{StaticResource ChecklistOptionRow}" Padding="10,8" Margin="0,0,0,6" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch" MinHeight="56">

                <Grid FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource IconCheckBox}" IsChecked="{Binding IsSel,&#xD;&#xA;                                                  Mode=TwoWay,&#xD;&#xA;                                                  UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSel}" Width="20" Height="20" MinWidth="20" MinHeight="20" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <Grid Grid.Row="0" Grid.Column="2" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Stretch">

                            <TextBlock Text="{Binding DspTitle}" Style="{StaticResource Type.BodyStrong}" Foreground="{DynamicResource Text.Primary}" FlowDirection="LeftToRight" TextAlignment="Left" HorizontalAlignment="Stretch" Language="en-US" NumberSubstitution.Substitution="European" TextWrapping="Wrap" />

                            <TextBlock Text="{Binding DirStat}" Style="{StaticResource PatStatusSummaryText}" FlowDirection="{Binding NoteFlow}" TextAlignment="{Binding NoteText}" NumberSubstitution.Substitution="European" Margin="0,5,0,0" />
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource PatStatusBadge}" Tag="{Binding StateTon}" Margin="0" HorizontalAlignment="{DynamicResource App.TrailingHorizontalAlignment}" VerticalAlignment="Top">

                            <TextBlock Text="{Binding StateDsp}" Style="{StaticResource PatLocalizedPillText}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,8,0,0">

                        <TextBlock Text="{Binding InsText}" Style="{StaticResource PatLocalizedSubtitleText}" FlowDirection="{Binding NoteFlow}" TextAlignment="{Binding NoteText}" NumberSubstitution.Substitution="European" Visibility="{Binding HasIns,&#xD;&#xA;                                                        Converter={StaticResource BoolToVisibilityConverter}}" />

                        <WrapPanel Orientation="Horizontal" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="{DynamicResource App.HorizontalAlignment}" Margin="0,8,0,0">

                            <Border Style="{StaticResource PatPillWithGap}" Tag="{Binding DefTone}" Visibility="{Binding HasDef,&#xD;&#xA;                                                         Converter={StaticResource BoolToVisibilityConverter}}">

                                <TextBlock Text="{Binding DefState}" Style="{StaticResource PatLocalizedPillText}" />
                            </Border>

                            <Border Style="{StaticResource SourcePill}" Tag="{Binding SrcTone}">

                                <TextBlock Text="{Binding SrcDsp}" Style="{StaticResource PatLocalizedPillText}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TgtHead">
            <Border Style="{StaticResource ChecklistOptionRow}" Padding="12,10" Margin="0,0,0,6" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch">

                <Grid FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Header}" Style="{StaticResource Type.BodyStrong}" Foreground="{DynamicResource Text.Primary}" FlowDirection="LeftToRight" TextAlignment="Left" HorizontalAlignment="Stretch" Language="en-US" NumberSubstitution.Substitution="European" TextWrapping="Wrap" />

                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource PatStatusBadge}" Tag="{Binding Tone}" Margin="0" HorizontalAlignment="{DynamicResource App.TrailingHorizontalAlignment}" VerticalAlignment="Center">

                        <TextBlock Text="{Binding StatDsp}" Style="{StaticResource PatLocalizedPillText}" />
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Details}" Style="{StaticResource PatLocalizedSubtitleText}" FlowDirection="{Binding TextFlow}" TextAlignment="{Binding TxtAlign}" NumberSubstitution.Substitution="European" Margin="0,6,0,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TgtGrp">
            <Expander IsExpanded="{Binding IsOpen, Mode=TwoWay}" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="0">
                <Expander.Header>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TgtHead}" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalContentAlignment="Stretch" />
                </Expander.Header>

                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PatItem}" Style="{StaticResource PatNestedItemsControl}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" FlowDirection="{DynamicResource App.TextFlowDirection}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Expander>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Language="{DynamicResource App.XmlLanguage}" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Status.WarningSurface}" BorderBrush="{DynamicResource Status.Warning}" BorderThickness="{StaticResource Stroke.Thickness.Default}" CornerRadius="{StaticResource Radius.Medium}" Padding="12,8" Margin="0,0,0,12" FlowDirection="{DynamicResource App.TextFlowDirection}" Visibility="{Binding Preview.HasWarn,&#xD;&#xA;                                     Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid FlowDirection="{DynamicResource App.TextFlowDirection}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding Preview.WarnText}" Style="{StaticResource Type.BodyStrong}" Foreground="{DynamicResource Text.Primary}" FlowDirection="{Binding Preview.TextFlow}" TextAlignment="{Binding Preview.TxtAlign}" HorizontalAlignment="Stretch" NumberSubstitution.Substitution="European" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding HashLaunchHint}" Style="{StaticResource PatLocalizedSubtitleText}" FlowDirection="{Binding Preview.TextFlow}" TextAlignment="{Binding Preview.TxtAlign}" Margin="0,4,0,0" Visibility="{Binding NeedsHashEvidence,&#xD;&#xA;                                                    Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <Grid Grid.Column="2" FlowDirection="{DynamicResource App.TextFlowDirection}" VerticalAlignment="Center">
                    <Button Content="{lang:TextExt Key=PatchReadiness.LaunchAction}" Style="{StaticResource PatReadinessPrimaryButton}" Command="{Binding LaunchGameCmd}" Visibility="{Binding ShowHashLaunchAction,&#xD;&#xA;                                                 Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center" />

                    <Button Content="{lang:TextExt Key=PatchReadiness.ReanalyzeAction}" Style="{StaticResource PatReadinessPrimaryButton}" Command="{Binding HashRefreshCmd}" Visibility="{Binding ShowHashRefreshAction,&#xD;&#xA;                                                 Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="SourceArea" Grid.Row="1" Margin="0,0,0,12" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch">
            <Border x:Name="OfclSrc" FlowDirection="{DynamicResource App.TextFlowDirection}" Background="{DynamicResource Surface.Subtle}" BorderThickness="0" CornerRadius="{StaticResource Radius.Medium}" Padding="12,10" HorizontalAlignment="Stretch">
                <Grid FlowDirection="{DynamicResource App.TextFlowDirection}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Stretch">

                        <Grid FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="{DynamicResource App.HorizontalAlignment}" VerticalAlignment="Center">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{lang:TextExt Key=Patch.SourceStatus.OfficialTitle}" Style="{StaticResource PatLocalizedTitleText}" VerticalAlignment="Center" />

                            <Border Grid.Column="2" Style="{StaticResource PatStatusBadge}" Tag="{Binding SrcTone}" Margin="0" VerticalAlignment="Center">

                                <TextBlock Text="{Binding SrcBadge}" Style="{StaticResource PatLocalizedPillText}" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding PatSrc}" Style="{StaticResource PatLocalizedDescriptionText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
                    </StackPanel>

                    <WrapPanel Grid.Column="2" Orientation="Horizontal" Style="{StaticResource PatTrailingWrapPanel}" VerticalAlignment="Center" Margin="0">
                        <Button Command="{Binding MgrCmd}" Style="{StaticResource PatSourceActionButton}" VerticalAlignment="Center" Width="88" Height="30" Margin="3,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="13" Width="16" Height="16" FlowDirection="LeftToRight" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" /><TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FlowDirection="{DynamicResource App.TextFlowDirection}"><TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Text" Value="Update" /><Style.Triggers><DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="RightToLeft"><Setter Property="Text" Value="تحديث" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Button>

                        <Button Command="{Binding AnlzCmd}" Style="{StaticResource PatSourceActionButton}" VerticalAlignment="Center" Width="88" Height="30" Margin="3,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="13" Width="16" Height="16" FlowDirection="LeftToRight" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" /><TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FlowDirection="{DynamicResource App.TextFlowDirection}"><TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Text" Value="Analyze" /><Style.Triggers><DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="RightToLeft"><Setter Property="Text" Value="تحليل" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border x:Name="CanSrc" Visibility="Collapsed" FlowDirection="{DynamicResource App.TextFlowDirection}" Background="{DynamicResource Surface.Subtle}" BorderThickness="0" CornerRadius="{StaticResource Radius.Medium}" Padding="12,10" HorizontalAlignment="Stretch">
                <Grid FlowDirection="{DynamicResource App.TextFlowDirection}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Stretch">
                        <WrapPanel Orientation="Horizontal" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="{DynamicResource App.HorizontalAlignment}">
                            <TextBlock Text="{lang:TextExt Key=Patch.SourceStatus.CanaryTitle}" Style="{StaticResource PatLocalizedTitleText}" VerticalAlignment="Center" />

                            <Border Style="{StaticResource PatStatusBadge}" Tag="{Binding CanTone}">
                                <TextBlock Text="{Binding CanBadge}" Style="{StaticResource PatLocalizedPillText}" />
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="{Binding CanState}" Style="{StaticResource PatLocalizedDescriptionText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="PatRoot" Grid.Row="2" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="OfclBody" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="OfclActions" Grid.Row="0" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Stretch">
                        <TextBlock Text="{lang:TextExt Key=Patch.OfficialActionsTitle}" Style="{StaticResource PatLocalizedTitleText}" />

                        <TextBlock Text="{Binding Preview.OfclSum}" Style="{StaticResource PatStatusSummaryText}" FlowDirection="{Binding Preview.TextFlow}" TextAlignment="{Binding Preview.TxtAlign}" HorizontalAlignment="Stretch" NumberSubstitution.Substitution="European" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />

                        <TextBlock Text="{Binding Preview.OfclHint}" Style="{StaticResource RecommendationRowSubtitleText}" FlowDirection="{Binding Preview.TextFlow}" TextAlignment="{Binding Preview.TxtAlign}" HorizontalAlignment="Stretch" NumberSubstitution.Substitution="European" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />

                        <TextBlock Text="{lang:TextExt Key=Patch.ApplyOfficialSectionTip}" Style="{StaticResource PatLocalizedSubtitleText}" Margin="0,4,0,0" />
                    </StackPanel>

                    <WrapPanel Grid.Column="2" Orientation="Horizontal" Style="{StaticResource PatTrailingWrapPanel}">
                        <Button Style="{StaticResource PatOfficialPrimaryButton}" Command="{Binding OfclOn}" Width="76" Height="30" Margin="3,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="13" Width="16" Height="16" FlowDirection="LeftToRight" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" /><TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FlowDirection="{DynamicResource App.TextFlowDirection}"><TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Text" Value="Enable" /><Style.Triggers><DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="RightToLeft"><Setter Property="Text" Value="تفعيل" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Button>

                        <Button Style="{StaticResource PatOfficialSecondaryButton}" Command="{Binding OfclOff}" VerticalAlignment="Center" Width="76" Height="30" Margin="3,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="13" Width="16" Height="16" FlowDirection="LeftToRight" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" /><TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FlowDirection="{DynamicResource App.TextFlowDirection}"><TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Text" Value="Disable" /><Style.Triggers><DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="RightToLeft"><Setter Property="Text" Value="تعطيل" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Button>
                    </WrapPanel>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource PatResultSurface}" MaxHeight="320" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid FlowDirection="{DynamicResource App.TextFlowDirection}">
                        <ScrollViewer Style="{StaticResource PatContentScrollViewer}">
                            <ItemsControl ItemsSource="{Binding Preview.OfclGrp}" ItemTemplate="{StaticResource TgtGrp}" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch" />
                        </ScrollViewer>

                        <TextBlock Text="{lang:TextExt Key=Patch.OfficialEmpty}" Style="{StaticResource PatLocalizedEmptyText}" Margin="12,8" Visibility="{Binding Preview.IsOfcl,&#xD;&#xA;                                                     Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="CanBody" Visibility="Collapsed" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="CanActions" Grid.Row="0" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch" Margin="0,0,0,10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Stretch">
                        <TextBlock Text="{lang:TextExt Key=Patch.CanaryActionsTitle}" Style="{StaticResource PatLocalizedTitleText}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,3" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="{Binding Preview.CanSum}" Style="{StaticResource PatStatusSummaryText}" FlowDirection="{Binding Preview.TextFlow}" TextAlignment="{Binding Preview.TxtAlign}" HorizontalAlignment="Stretch" NumberSubstitution.Substitution="European" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0" FontSize="12" Opacity="0.82" />

                        <TextBlock Text="{Binding Preview.CanHint}" Style="{StaticResource RecommendationRowSubtitleText}" FlowDirection="{Binding Preview.TextFlow}" TextAlignment="{Binding Preview.TxtAlign}" HorizontalAlignment="Stretch" NumberSubstitution.Substitution="European" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" Visibility="Collapsed" />

                        <TextBlock Text="{lang:TextExt Key=Patch.ApplyCanarySectionTip}" Style="{StaticResource PatLocalizedSubtitleText}" Margin="0,4,0,0" />


                    </StackPanel>

                    <WrapPanel Grid.Column="2" Orientation="Horizontal" Style="{StaticResource PatTrailingWrapPanel}" VerticalAlignment="Center" Margin="0">
                        <Button Style="{StaticResource PatCanaryPrimaryButton}" Command="{Binding CanOn}" Margin="3,0" VerticalAlignment="Center"><Button.Content><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Text" Value="Enable" /><Style.Triggers><DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="RightToLeft"><Setter Property="Text" Value="تفعيل" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button.Content></Button>

                        <Button Style="{StaticResource PatCanarySecondaryButton}" Command="{Binding CanOCmd}" VerticalAlignment="Center" Margin="3,0"><Button.Content><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Text" Value="Disable" /><Style.Triggers><DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="RightToLeft"><Setter Property="Text" Value="تعطيل" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button.Content></Button>
                    </WrapPanel>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource PatResultSurface}" MaxHeight="320" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,8,0,0" Padding="16,14" MinHeight="150">
                    <Grid FlowDirection="{DynamicResource App.TextFlowDirection}">
                        <ScrollViewer Style="{StaticResource PatContentScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                            <ItemsControl ItemsSource="{Binding Preview.CanGrps}" ItemTemplate="{StaticResource TgtGrp}" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch" />
                        </ScrollViewer>

                        <TextBlock Text="{lang:TextExt Key=Patch.CanaryEmpty}" Style="{StaticResource PatLocalizedEmptyText}" Margin="16,12" Visibility="{Binding Preview.CanEmpty,&#xD;&#xA;                                                     Converter={StaticResource BoolToVisibilityConverter}}" FontSize="13" FontWeight="SemiBold" Opacity="0.86" TextAlignment="{DynamicResource App.TextAlignment}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="ChtRoot" Grid.Row="2" Visibility="Collapsed" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Stretch">
                    <TextBlock Text="{lang:TextExt Key=Patch.CheatTitle}" Style="{StaticResource PatLocalizedTitleText}" />

                    <TextBlock Text="{Binding Preview.ChtSum}" Style="{StaticResource PatStatusSummaryText}" FlowDirection="{Binding Preview.TextFlow}" TextAlignment="{Binding Preview.TxtAlign}" NumberSubstitution.Substitution="European" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" HorizontalAlignment="Stretch" />

                    <TextBlock Text="{lang:TextExt Key=Patch.ApplyCheatSectionTip}" Style="{StaticResource PatLocalizedSubtitleText}" Margin="0,4,0,0" />
                </StackPanel>

                <WrapPanel Grid.Column="2" Orientation="Horizontal" Style="{StaticResource PatTrailingWrapPanel}">
                    <Button Style="{StaticResource PatCheatPrimaryButton}" Command="{Binding ChtOn}" Visibility="{Binding Preview.HasCht,&#xD;&#xA;                                                 Converter={StaticResource BoolToVisibilityConverter}}" Width="88" Height="32" Margin="4,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center">

                    <Button.Content><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Text" Value="Enable" /><Style.Triggers><DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="RightToLeft"><Setter Property="Text" Value="تفعيل" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button.Content></Button>

                    <Button Style="{StaticResource PatCheatSecondaryButton}" Command="{Binding ChtOff}" Visibility="{Binding Preview.HasCht,&#xD;&#xA;                                                 Converter={StaticResource BoolToVisibilityConverter}}" Width="88" Height="32" Margin="4,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center">

                    <Button.Content><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Text" Value="Disable" /><Style.Triggers><DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="RightToLeft"><Setter Property="Text" Value="تعطيل" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button.Content></Button>
                </WrapPanel>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource PatResultSurface}" MaxHeight="320" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Grid FlowDirection="{DynamicResource App.TextFlowDirection}">
                    <ScrollViewer Style="{StaticResource PatContentScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Preview.ChtGrps}" ItemTemplate="{StaticResource TgtGrp}" FlowDirection="{DynamicResource App.TextFlowDirection}" HorizontalAlignment="Stretch" />
                    </ScrollViewer>

                    <TextBlock Text="{lang:TextExt Key=Patch.CheatEmpty}" Style="{StaticResource PatLocalizedEmptyText}" Margin="12,8" Visibility="{Binding Preview.ChtEmpty,&#xD;&#xA;                                                 Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
