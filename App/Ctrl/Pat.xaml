<UserControl x:Class="R3Config.Ctrl.PatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             FlowDirection="{Binding Preview.TextFlow}"
             Language="{DynamicResource App.XmlLanguage}">
    <UserControl.Resources>
        <DataTemplate x:Key="PatItem">
            <Border Style="{StaticResource ChecklistOptionRow}"
                    Padding="10,9">
                <Grid FlowDirection="{Binding NoteFlow}"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              Style="{StaticResource IconCheckBox}"
                              IsChecked="{Binding IsSel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanSel}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              Margin="0,3,0,0" />

                    <StackPanel Grid.Column="2"
                                Orientation="Vertical"
                                HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding DspTitle}"
                                   Style="{StaticResource ChecklistOptionText}"
                                   FlowDirection="LeftToRight"
                                   TextAlignment="Left"
                                   NumberSubstitution.Substitution="European"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DirStat}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="{Binding NoteFlow}"
                                   TextAlignment="{Binding NoteText}"
                                   NumberSubstitution.Substitution="European"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding InsText}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="{Binding NoteFlow}"
                                   TextAlignment="{Binding NoteText}"
                                   NumberSubstitution.Substitution="European"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding HasIns, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Orientation="Vertical"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <WrapPanel Orientation="Horizontal"
                                   FlowDirection="LeftToRight"
                                   HorizontalAlignment="Right">
                            <Border Style="{StaticResource SourcePill}"
                                    Tag="{Binding StateTon}"
                                    Margin="0,0,6,0">
                                <TextBlock Text="{Binding StateDsp}"
                                           Style="{StaticResource SourcePillText}" />
                            </Border>
                            <Border Style="{StaticResource SourcePill}"
                                    Tag="{Binding DefTone}"
                                    Margin="0,0,6,0"
                                    Visibility="{Binding HasDef, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding DefState}"
                                           Style="{StaticResource SourcePillText}" />
                            </Border>
                            <Border Style="{StaticResource SourcePill}"
                                    Tag="{Binding SrcTone}">
                                <TextBlock Text="{Binding SrcDsp}"
                                           Style="{StaticResource SourcePillText}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TgtHead">
            <Border Style="{StaticResource ChecklistOptionRow}"
                    Padding="12,9">
                <Grid FlowDirection="{Binding TextFlow}"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding Header}"
                                   Style="{StaticResource ChecklistOptionText}"
                                   FlowDirection="LeftToRight"
                                   TextAlignment="Left"
                                   NumberSubstitution.Substitution="European" />
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="{Binding TextFlow}"
                                   TextAlignment="{Binding TxtAlign}"
                                   NumberSubstitution.Substitution="European"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Style="{StaticResource SourcePill}"
                            Tag="{Binding Tone}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatDsp}"
                                   Style="{StaticResource SourcePillText}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TgtGrp">
            <Expander IsExpanded="{Binding IsOpen, Mode=TwoWay}"
                      Margin="0,0,0,10"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource TgtHead}"
                                    HorizontalContentAlignment="Stretch" />
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource PatItem}"
                              Margin="24,6,0,0"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Expander>
        </DataTemplate>

    </UserControl.Resources>

    <Border Style="{StaticResource SectionCard}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid Language="{DynamicResource App.XmlLanguage}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource WarningBadgeBackgroundBrush}"
                    BorderBrush="{StaticResource WarningBadgeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding Preview.HasWarn, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding Preview.WarnText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FlowDirection="{Binding Preview.TextFlow}"
                           TextAlignment="{Binding Preview.TxtAlign}"
                           NumberSubstitution.Substitution="European"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="1"
                  Margin="0,0,0,10"
                  HorizontalAlignment="Stretch">
                <Border x:Name="OfclSrc"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,9">
                    <Grid FlowDirection="{Binding Preview.TextFlow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Stretch">
                            <WrapPanel Orientation="Horizontal"
                                       FlowDirection="{Binding Preview.TextFlow}">
                                <TextBlock Text="{lang:TextExt Key=Patch.SourceStatus.OfficialTitle}"
                                           Style="{StaticResource R3SettingsRowTitleText}"
                                           VerticalAlignment="Center" />
                                <Border Style="{StaticResource SourcePill}"
                                        Tag="{Binding SrcTone}"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="{Binding SrcBadge}"
                                               Style="{StaticResource SourcePillText}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding PatSrc}"
                                       Style="{StaticResource R3SettingsRowDescriptionText}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <WrapPanel Grid.Column="2"
                                   Orientation="Horizontal"
                                   FlowDirection="{Binding Preview.TextFlow}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                            <Button Content="{lang:TextExt Key=Patch.SourceStatus.OpenRpcs3}"
                                    Command="{Binding MgrCmd}"
                                    MinWidth="118"
                                    Margin="0,0,6,0" />
                            <Button Content="{lang:TextExt Key=Patch.SourceStatus.Refresh}"
                                    Command="{Binding AnlzCmd}"
                                    MinWidth="94" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border x:Name="CanSrc"
                        Visibility="Collapsed"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,9">
                    <Grid FlowDirection="{Binding Preview.TextFlow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Stretch">
                            <WrapPanel Orientation="Horizontal"
                                       FlowDirection="{Binding Preview.TextFlow}">
                                <TextBlock Text="{lang:TextExt Key=Patch.SourceStatus.CanaryTitle}"
                                           Style="{StaticResource R3SettingsRowTitleText}"
                                           VerticalAlignment="Center" />
                                <Border Style="{StaticResource SourcePill}"
                                        Tag="{Binding CanTone}"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="{Binding CanBadge}"
                                               Style="{StaticResource SourcePillText}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding CanState}"
                                       Style="{StaticResource R3SettingsRowDescriptionText}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <WrapPanel Grid.Column="2"
                                   Orientation="Horizontal"
                                   FlowDirection="{Binding Preview.TextFlow}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                            <Button Content="{lang:TextExt Key=Patch.SourceStatus.Refresh}"
                                    Command="{Binding AnlzCmd}"
                                    MinWidth="94" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="PatRoot"
                  Grid.Row="2"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid x:Name="OfclBody"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,12"
                              HorizontalAlignment="Stretch"
                              Visibility="{Binding Preview.HasOfcl, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding Preview.OfclSum}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{Binding Preview.TextFlow}"
                                           TextAlignment="{Binding Preview.TxtAlign}"
                                           NumberSubstitution.Substitution="European" />
                                <TextBlock Text="{Binding Preview.OfclHint}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{Binding Preview.TextFlow}"
                                           TextAlignment="{Binding Preview.TxtAlign}"
                                           NumberSubstitution.Substitution="European"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="{lang:TextExt Key=Patch.ApplyOfficialSectionTip}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{Binding Preview.TextFlow}"
                                           TextAlignment="{Binding Preview.TxtAlign}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="2"
                                       Orientation="Horizontal"
                                       FlowDirection="{Binding Preview.TextFlow}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Button Content="{lang:TextExt Key=Patch.ApplyOfficialSection}"
                                        Style="{StaticResource MainBtn}"
                                        MinWidth="104"
                                        Margin="0,0,6,0"
                                        Command="{Binding OfclOn}" />
                                <Button Content="{lang:TextExt Key=Patch.Off}"
                                        MinWidth="76"
                                        Command="{Binding OfclOff}" />
                            </WrapPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              MinHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding Preview.OfclGrp}"
                                              ItemTemplate="{StaticResource TgtGrp}"
                                              HorizontalAlignment="Stretch" />
                            </ScrollViewer>
                            <Border Style="{StaticResource ViewportEmptyStatePanel}"
                                    Visibility="{Binding Preview.IsOfcl, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{lang:TextExt Key=Patch.OfficialEmpty}"
                                           Style="{StaticResource ArabicEmptyStateText}"
                                           FlowDirection="{Binding Preview.TextFlow}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MaxWidth="460" />
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="CanBody"
                          Visibility="Collapsed"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,12"
                              HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding Preview.HasCan, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding Preview.CanSum}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{Binding Preview.TextFlow}"
                                           TextAlignment="{Binding Preview.TxtAlign}"
                                           NumberSubstitution.Substitution="European" />
                                <TextBlock Text="{Binding Preview.CanHint}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{Binding Preview.TextFlow}"
                                           TextAlignment="{Binding Preview.TxtAlign}"
                                           NumberSubstitution.Substitution="European"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="{lang:TextExt Key=Patch.ApplyCanarySectionTip}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{Binding Preview.TextFlow}"
                                           TextAlignment="{Binding Preview.TxtAlign}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="2"
                                       Orientation="Horizontal"
                                       FlowDirection="{Binding Preview.TextFlow}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Button Content="{lang:TextExt Key=Patch.ApplyCanarySection}"
                                        Style="{StaticResource MainBtn}"
                                        MinWidth="118"
                                        Margin="0,0,6,0"
                                        Command="{Binding CanOn}"
                                        Visibility="{Binding Preview.HasCan, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="{lang:TextExt Key=Patch.Off}"
                                        MinWidth="76"
                                        Command="{Binding CanOCmd}"
                                        Visibility="{Binding Preview.HasCan, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </WrapPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              MinHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding Preview.CanGrps}"
                                              ItemTemplate="{StaticResource TgtGrp}"
                                              HorizontalAlignment="Stretch" />
                            </ScrollViewer>
                            <Border Style="{StaticResource ViewportEmptyStatePanel}"
                                    Visibility="{Binding Preview.CanEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{lang:TextExt Key=Patch.CanaryEmpty}"
                                           Style="{StaticResource ArabicEmptyStateText}"
                                           FlowDirection="{Binding Preview.TextFlow}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MaxWidth="460" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="ChtRoot"
                  Grid.Row="2"
                  Visibility="Collapsed"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="140" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,12"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding Preview.ChtSum}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="{Binding Preview.TextFlow}"
                                   TextAlignment="{Binding Preview.TxtAlign}"
                                   NumberSubstitution.Substitution="European" />
                        <TextBlock Text="{lang:TextExt Key=Patch.CheatLibrary.Notice}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="{Binding Preview.TextFlow}"
                                   TextAlignment="{Binding Preview.TxtAlign}"
                                   TextWrapping="Wrap"
                                   MaxWidth="720"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{lang:TextExt Key=Patch.ApplyCheatSectionTip}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="{Binding Preview.TextFlow}"
                                   TextAlignment="{Binding Preview.TxtAlign}"
                                   TextWrapping="Wrap"
                                   MaxWidth="720"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <WrapPanel Grid.Column="2"
                               Orientation="Horizontal"
                               FlowDirection="{Binding Preview.TextFlow}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <Button Content="{lang:TextExt Key=Patch.ApplyCheatSection}"
                                Style="{StaticResource MainBtn}"
                                MinWidth="118"
                                Margin="0,0,6,0"
                                Command="{Binding ChtOn}"
                                Visibility="{Binding Preview.HasCht, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Content="{lang:TextExt Key=Patch.Off}"
                                MinWidth="76"
                                Command="{Binding ChtOff}"
                                Visibility="{Binding Preview.HasCht, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </WrapPanel>
                </Grid>

                <Grid Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      MinHeight="140">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,4,0">
                        <ItemsControl ItemsSource="{Binding Preview.ChtGrps}"
                                      ItemTemplate="{StaticResource TgtGrp}"
                                      HorizontalAlignment="Stretch" />
                    </ScrollViewer>
                    <Border Style="{StaticResource ViewportEmptyStatePanel}"
                            Visibility="{Binding Preview.ChtEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{lang:TextExt Key=Patch.CheatEmpty}"
                                   Style="{StaticResource ArabicEmptyStateText}"
                                   FlowDirection="{Binding Preview.TextFlow}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="460" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
