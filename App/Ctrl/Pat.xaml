<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             xmlns:local="clr-namespace:R3Config.Ctrl"
             x:Class="R3Config.Ctrl.PatView"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PSty.xaml" />
                <ResourceDictionary Source="PTmp.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Language="{DynamicResource App.XmlLanguage}"
          FlowDirection="{DynamicResource App.FlowDirection}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Status.WarningSurface}"
                BorderBrush="{DynamicResource Status.Warning}"
                BorderThickness="{StaticResource Stroke.Thickness.Default}"
                CornerRadius="{StaticResource Radius.Medium}"
                Padding="12,8"
                Margin="0,0,0,12"
                FlowDirection="{DynamicResource App.FlowDirection}"
                HorizontalAlignment="Stretch"
                Visibility="{Binding Preview.HasWarn,
                                     Converter={StaticResource BoolToVisibilityConverter}}">

            <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                  HorizontalAlignment="Stretch">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding Preview.WarnText}"
                               Style="{StaticResource Type.BodyStrong}"
                               Foreground="{DynamicResource Text.Primary}"
                               FlowDirection="{Binding Preview.TextFlow}"
                               TextAlignment="{DynamicResource App.TextAlignment}"
                               HorizontalAlignment="Stretch"
                               NumberSubstitution.Substitution="European"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding FingerprintCaptureStatus}"
                               Style="{StaticResource PatLocalizedSubtitleText}"
                               FlowDirection="{Binding Preview.TextFlow}"
                               TextAlignment="{DynamicResource App.TextAlignment}"
                               HorizontalAlignment="Stretch"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowFingerprintCaptureStatus,
                                                    Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="{lang:TextExt Key=PatchReadiness.CaptureAction}"
                        Style="{StaticResource PatReadinessPrimaryButton}"
                        Command="{Binding FingerprintCaptureCmd}"
                        VerticalAlignment="Center"
                        TextBlock.TextAlignment="{DynamicResource App.TextAlignment}"
                        Visibility="{Binding ShowFingerprintCaptureAction,
                                             Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>

        <local:PSrcView x:Name="SourceArea"
                        Grid.Row="1"
                        Margin="0,0,0,12"
                        FlowDirection="{DynamicResource App.FlowDirection}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top" />

        <Border Grid.Row="2"
                Background="{DynamicResource Status.WarningSurface}"
                BorderBrush="{DynamicResource Status.Warning}"
                BorderThickness="{StaticResource Stroke.Thickness.Default}"
                CornerRadius="{StaticResource Radius.Medium}"
                Padding="10,7"
                Margin="0,0,0,10"
                FlowDirection="{DynamicResource App.FlowDirection}"
                HorizontalAlignment="Stretch"
                Visibility="{Binding Preview.HasItems,
                                     Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{lang:TextExt Key=Patch.Launch.BootRecommended}"
                       Style="{StaticResource PatLocalizedSubtitleText}"
                       Foreground="{DynamicResource Text.Primary}"
                       TextAlignment="{DynamicResource App.TextAlignment}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Stretch" />
        </Border>

        <Grid x:Name="PatRoot"
              Grid.Row="3"
              FlowDirection="{DynamicResource App.FlowDirection}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <local:POffView x:Name="OfclBody"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

            <local:PCanView x:Name="CanBody"
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

            <local:PChtView x:Name="ChtRoot"
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
        </Grid>
    </Grid>
</UserControl>