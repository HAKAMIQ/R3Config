<UserControl x:Class="R3Config.Ctrl.PatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             xmlns:local="clr-namespace:R3Config.Ctrl"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}">
    <UserControl.Resources>
        <DataTemplate x:Key="PatchTipContentTemplate">
            <Border Padding="6"
                    MaxWidth="430"
                    FlowDirection="{DynamicResource App.FlowDirection}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding DisplayTitle}"
                               Style="{StaticResource ChecklistToolTipTitleText}"
                               FlowDirection="LeftToRight"
                               TextAlignment="Left"
                               NumberSubstitution.Substitution="European"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding PlayerBenefitText}"
                               Style="{StaticResource ChecklistToolTipBodyText}"
                               FlowDirection="{Binding NoteFlow}"
                               TextAlignment="{Binding NoteTextAlignment}"
                               NumberSubstitution.Substitution="European"
                               Margin="0,0,0,10" />
                    <TextBlock Text="{Binding TargetLine}"
                               Style="{StaticResource ChecklistToolTipSubtleText}"
                               FlowDirection="{DynamicResource App.FlowDirection}"
                               TextAlignment="{DynamicResource App.DefaultTextAlignment}"
                               NumberSubstitution.Substitution="European"
                               Margin="0,0,0,6" />
                    <TextBlock Text="{Binding DirectStatusText}"
                               Style="{StaticResource ChecklistToolTipSubtleText}"
                               FlowDirection="{DynamicResource App.FlowDirection}"
                               TextAlignment="{DynamicResource App.DefaultTextAlignment}"
                               NumberSubstitution.Substitution="European" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PatchListItemTemplate">
            <Border Style="{StaticResource ChecklistOptionRow}"
                    Padding="10,9"
                    ToolTipService.InitialShowDelay="180"
                    ToolTipService.ShowDuration="60000">
                <Border.ToolTip>
                    <ToolTip Style="{StaticResource ModernToolTip}"
                             Placement="Mouse"
                             MaxWidth="460">
                        <ContentControl Content="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ToolTip}}}"
                                        ContentTemplate="{StaticResource PatchTipContentTemplate}" />
                    </ToolTip>
                </Border.ToolTip>

                <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              Style="{StaticResource IconCheckBox}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsSelectable}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              Margin="0,3,0,0"
                              ToolTip="{Binding DirectStatusText}" />

                    <StackPanel Grid.Column="2"
                                Orientation="Vertical"
                                HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding DisplayTitle}"
                                   Style="{StaticResource ChecklistOptionText}"
                                   FlowDirection="LeftToRight"
                                   TextAlignment="Left"
                                   NumberSubstitution.Substitution="European"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding TargetLine}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="{DynamicResource App.FlowDirection}"
                                   TextAlignment="{DynamicResource App.DefaultTextAlignment}"
                                   NumberSubstitution.Substitution="European"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding DirectStatusText}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="{DynamicResource App.FlowDirection}"
                                   TextAlignment="{DynamicResource App.DefaultTextAlignment}"
                                   NumberSubstitution.Substitution="European"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Orientation="Vertical"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <WrapPanel Orientation="Horizontal"
                                   FlowDirection="LeftToRight"
                                   HorizontalAlignment="Right">
                            <Border Style="{StaticResource SourcePill}"
                                    Tag="{Binding StateTone}"
                                    ToolTip="{Binding DirectStatusText}"
                                    Margin="0,0,6,0">
                                <TextBlock Text="{Binding StateDisplay}"
                                           Style="{StaticResource SourcePillText}" />
                            </Border>
                            <Border Style="{StaticResource SourcePill}"
                                    Tag="{Binding PatchSourceTone}"
                                    ToolTip="{Binding PatchSourceTooltip}">
                                <TextBlock Text="{Binding PatchSourceDisplay}"
                                           Style="{StaticResource SourcePillText}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding GroupDisplay}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Right"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding TechnicalTargetDisplay}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="LeftToRight"
                                   TextAlignment="Right"
                                   NumberSubstitution.Substitution="European"
                                   HorizontalAlignment="Right"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PatchTargetGroupHeaderTemplate">
            <Border Style="{StaticResource ChecklistOptionRow}"
                    ToolTip="{Binding Tooltip}"
                    Padding="12,9">
                <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding Header}"
                                   Style="{StaticResource ChecklistOptionText}"
                                   FlowDirection="LeftToRight"
                                   TextAlignment="Left"
                                   NumberSubstitution.Substitution="European" />
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="{DynamicResource App.FlowDirection}"
                                   TextAlignment="{DynamicResource App.DefaultTextAlignment}"
                                   NumberSubstitution.Substitution="European"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Style="{StaticResource SourcePill}"
                            Tag="{Binding StatusTone}"
                            ToolTip="{Binding Tooltip}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusDisplay}"
                                   Style="{StaticResource SourcePillText}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PatchTargetGroupTemplate">
            <Expander IsExpanded="{Binding IsExpanded, Mode=OneTime}"
                      Margin="0,0,0,10"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource PatchTargetGroupHeaderTemplate}"
                                    HorizontalContentAlignment="Stretch" />
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource PatchListItemTemplate}"
                              Margin="24,6,0,0"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Expander>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource SectionCard}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid Language="{DynamicResource App.XmlLanguage}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource WarningBadgeBackgroundBrush}"
                    BorderBrush="{StaticResource WarningBadgeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding PatchPreview.HasWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding PatchPreview.WarningText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FlowDirection="{DynamicResource App.FlowDirection}"
                           TextAlignment="{DynamicResource App.DefaultTextAlignment}"
                           NumberSubstitution.Substitution="European"
                           TextWrapping="Wrap" />
            </Border>

            <TabControl Grid.Row="1"
                        SelectedIndex="{Binding SelectedIndex, RelativeSource={RelativeSource AncestorType={x:Type local:PatchView}}}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        FlowDirection="{DynamicResource App.FlowDirection}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                <TabControl.Template>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <ContentPresenter ContentSource="SelectedContent"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="{lang:Text Key=Tab.Official}">
                    <Grid HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,12"
                              HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding PatchPreview.OfficialSummary}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{DynamicResource App.FlowDirection}"
                                           TextAlignment="{DynamicResource App.DefaultTextAlignment}"
                                           NumberSubstitution.Substitution="European" />
                                <TextBlock Text="{Binding PatchPreview.OfficialActionHint}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{DynamicResource App.FlowDirection}"
                                           TextAlignment="{DynamicResource App.DefaultTextAlignment}"
                                           NumberSubstitution.Substitution="European"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="2"
                                       Orientation="Horizontal"
                                       FlowDirection="{DynamicResource App.FlowDirection}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Button Content="{lang:Text Key=Patch.ApplySection}"
                                        MinWidth="76"
                                        Margin="0,0,6,0"
                                        ToolTip="{lang:Text Key=Patch.ApplySectionTip}"
                                        Command="{Binding ApplyOfficialPatchesCommand}"
                                        Visibility="{Binding PatchPreview.HasOfficialItems, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="{lang:Text Key=Patch.Off}"
                                        MinWidth="76"
                                        ToolTip="{lang:Text Key=Patch.OffTip}"
                                        Command="{Binding DisableOfficialPatchesCommand}"
                                        Visibility="{Binding PatchPreview.HasOfficialItems, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </WrapPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              MinHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding PatchPreview.OfficialGroups}"
                                              ItemTemplate="{StaticResource PatchTargetGroupTemplate}"
                                              HorizontalAlignment="Stretch" />
                            </ScrollViewer>
                            <Border Style="{StaticResource ViewportEmptyStatePanel}"
                                    Visibility="{Binding PatchPreview.IsOfficialEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{lang:Text Key=Patch.OfficialEmpty}"
                                           Style="{StaticResource ArabicEmptyStateText}"
                                           FlowDirection="{DynamicResource App.FlowDirection}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MaxWidth="460" />
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="{lang:Text Key=Tab.Canary}">
                    <Grid HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,12"
                              HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding PatchPreview.CanarySummary}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{DynamicResource App.FlowDirection}"
                                           TextAlignment="{DynamicResource App.DefaultTextAlignment}"
                                           NumberSubstitution.Substitution="European" />
                                <TextBlock Text="{Binding PatchPreview.CanaryActionHint}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{DynamicResource App.FlowDirection}"
                                           TextAlignment="{DynamicResource App.DefaultTextAlignment}"
                                           NumberSubstitution.Substitution="European"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="2"
                                       Orientation="Horizontal"
                                       FlowDirection="{DynamicResource App.FlowDirection}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Button Content="{lang:Text Key=Patch.ImportCanaryManual}"
                                        MinWidth="76"
                                        Margin="0,0,6,0"
                                        ToolTip="{lang:Text Key=Patch.ImportCanaryManualTip}"
                                        Command="{Binding ImportCanaryPatchCommand}" />
                                <Button Content="{lang:Text Key=Patch.RemoveCanary}"
                                        MinWidth="76"
                                        Margin="0,0,6,0"
                                        ToolTip="{lang:Text Key=Patch.RemoveCanaryTip}"
                                        Command="{Binding RemoveCanaryPatchesCommand}"
                                        Visibility="{Binding HasPreparedCanaryPatches, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="{lang:Text Key=Patch.ApplySection}"
                                        MinWidth="76"
                                        Margin="0,0,6,0"
                                        ToolTip="{lang:Text Key=Patch.ApplySectionTip}"
                                        Command="{Binding ApplyCanaryPatchesCommand}"
                                        Visibility="{Binding PatchPreview.HasCanaryItems, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="{lang:Text Key=Patch.Off}"
                                        MinWidth="76"
                                        ToolTip="{lang:Text Key=Patch.OffTip}"
                                        Command="{Binding DisableCanaryPatchesCommand}"
                                        Visibility="{Binding PatchPreview.HasCanaryItems, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </WrapPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              MinHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding PatchPreview.CanaryGroups}"
                                              ItemTemplate="{StaticResource PatchTargetGroupTemplate}"
                                              HorizontalAlignment="Stretch" />
                            </ScrollViewer>
                            <Border Style="{StaticResource ViewportEmptyStatePanel}"
                                    Visibility="{Binding PatchPreview.IsCanaryEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{lang:Text Key=Patch.CanaryEmpty}"
                                           Style="{StaticResource ArabicEmptyStateText}"
                                           FlowDirection="{DynamicResource App.FlowDirection}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MaxWidth="460" />
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="{lang:Text Key=Tab.Cheats}">
                    <Grid HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,12"
                              HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding PatchPreview.CheatSummary}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{DynamicResource App.FlowDirection}"
                                           TextAlignment="{DynamicResource App.DefaultTextAlignment}"
                                           NumberSubstitution.Substitution="European" />
                                <TextBlock Text="{Binding PatchPreview.CheatActionHint}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{DynamicResource App.FlowDirection}"
                                           TextAlignment="{DynamicResource App.DefaultTextAlignment}"
                                           NumberSubstitution.Substitution="European"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="2"
                                       Orientation="Horizontal"
                                       FlowDirection="{DynamicResource App.FlowDirection}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Button Content="{lang:Text Key=Patch.ApplySection}"
                                        MinWidth="76"
                                        Margin="0,0,6,0"
                                        ToolTip="{lang:Text Key=Patch.ApplySectionTip}"
                                        Command="{Binding ApplyCheatPatchesCommand}"
                                        Visibility="{Binding PatchPreview.HasCheatItems, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="{lang:Text Key=Patch.Off}"
                                        MinWidth="76"
                                        ToolTip="{lang:Text Key=Patch.OffTip}"
                                        Command="{Binding DisableCheatPatchesCommand}"
                                        Visibility="{Binding PatchPreview.HasCheatItems, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </WrapPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              MinHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding PatchPreview.CheatGroups}"
                                              ItemTemplate="{StaticResource PatchTargetGroupTemplate}"
                                              HorizontalAlignment="Stretch" />
                            </ScrollViewer>
                            <Border Style="{StaticResource ViewportEmptyStatePanel}"
                                    Visibility="{Binding PatchPreview.IsCheatEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{lang:Text Key=Patch.CheatEmpty}"
                                           Style="{StaticResource ArabicEmptyStateText}"
                                           FlowDirection="{DynamicResource App.FlowDirection}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MaxWidth="460" />
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
