<UserControl x:Class="R3Config.Ctrl.PatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:R3Config.Lang"
             FlowDirection="{Binding PatchPreview.TextFlow}"
             Language="{DynamicResource App.XmlLanguage}">
    <UserControl.Resources>
        <DataTemplate x:Key="PatchListItemTemplate">
            <Border Style="{StaticResource ChecklistOptionRow}"
                    Padding="10,9">
                <Grid FlowDirection="{Binding NoteFlow}"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              Style="{StaticResource IconCheckBox}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsSelectable}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              Margin="0,3,0,0" />

                    <StackPanel Grid.Column="2"
                                Orientation="Vertical"
                                HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding DisplayTitle}"
                                   Style="{StaticResource ChecklistOptionText}"
                                   FlowDirection="LeftToRight"
                                   TextAlignment="Left"
                                   NumberSubstitution.Substitution="European"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DirectStatusText}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="{Binding NoteFlow}"
                                   TextAlignment="{Binding NoteTextAlignment}"
                                   NumberSubstitution.Substitution="European"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding PlayerInstructionText}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="{Binding NoteFlow}"
                                   TextAlignment="{Binding NoteTextAlignment}"
                                   NumberSubstitution.Substitution="European"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding HasPlayerInstruction, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Orientation="Vertical"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <WrapPanel Orientation="Horizontal"
                                   FlowDirection="LeftToRight"
                                   HorizontalAlignment="Right">
                            <Border Style="{StaticResource SourcePill}"
                                    Tag="{Binding StateTone}"
                                    Margin="0,0,6,0">
                                <TextBlock Text="{Binding StateDisplay}"
                                           Style="{StaticResource SourcePillText}" />
                            </Border>
                            <Border Style="{StaticResource SourcePill}"
                                    Tag="{Binding DefinitionStateTone}"
                                    Margin="0,0,6,0"
                                    Visibility="{Binding HasDefinitionState, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding DefinitionStateDisplay}"
                                           Style="{StaticResource SourcePillText}" />
                            </Border>
                            <Border Style="{StaticResource SourcePill}"
                                    Tag="{Binding PatchSourceTone}">
                                <TextBlock Text="{Binding PatchSourceDisplay}"
                                           Style="{StaticResource SourcePillText}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PatchTargetGroupHeaderTemplate">
            <Border Style="{StaticResource ChecklistOptionRow}"
                    Padding="12,9">
                <Grid FlowDirection="{Binding TextFlow}"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding Header}"
                                   Style="{StaticResource ChecklistOptionText}"
                                   FlowDirection="LeftToRight"
                                   TextAlignment="Left"
                                   NumberSubstitution.Substitution="European" />
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="{Binding TextFlow}"
                                   TextAlignment="{Binding TextAlignment}"
                                   NumberSubstitution.Substitution="European"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Style="{StaticResource SourcePill}"
                            Tag="{Binding StatusTone}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusDisplay}"
                                   Style="{StaticResource SourcePillText}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PatchTargetGroupTemplate">
            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                      Margin="0,0,0,10"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource PatchTargetGroupHeaderTemplate}"
                                    HorizontalContentAlignment="Stretch" />
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource PatchListItemTemplate}"
                              Margin="24,6,0,0"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Expander>
        </DataTemplate>

    </UserControl.Resources>

    <Border Style="{StaticResource SectionCard}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid Language="{DynamicResource App.XmlLanguage}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource WarningBadgeBackgroundBrush}"
                    BorderBrush="{StaticResource WarningBadgeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding PatchPreview.HasWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding PatchPreview.WarningText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FlowDirection="{Binding PatchPreview.TextFlow}"
                           TextAlignment="{Binding PatchPreview.TextAlignment}"
                           NumberSubstitution.Substitution="European"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="1"
                  Margin="0,0,0,10"
                  HorizontalAlignment="Stretch">
                <Border x:Name="OfficialSourcePanel"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,9">
                    <Grid FlowDirection="{Binding PatchPreview.TextFlow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Stretch">
                            <WrapPanel Orientation="Horizontal"
                                       FlowDirection="{Binding PatchPreview.TextFlow}">
                                <TextBlock Text="{lang:Text Key=Patch.SourceStatus.OfficialTitle}"
                                           Style="{StaticResource R3SettingsRowTitleText}"
                                           VerticalAlignment="Center" />
                                <Border Style="{StaticResource SourcePill}"
                                        Tag="{Binding OfficialPatchSourceTone}"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="{Binding OfficialPatchSourceBadgeText}"
                                               Style="{StaticResource SourcePillText}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding OfficialPatchSourceStatusText}"
                                       Style="{StaticResource R3SettingsRowDescriptionText}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <WrapPanel Grid.Column="2"
                                   Orientation="Horizontal"
                                   FlowDirection="{Binding PatchPreview.TextFlow}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                            <Button Content="{lang:Text Key=Patch.SourceStatus.OpenRpcs3}"
                                    Command="{Binding OpenRpcs3PatchManagerCommand}"
                                    MinWidth="118"
                                    Margin="0,0,6,0" />
                            <Button Content="{lang:Text Key=Patch.SourceStatus.Refresh}"
                                    Command="{Binding AnalyzeCommand}"
                                    MinWidth="94" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border x:Name="CanarySourcePanel"
                        Visibility="Collapsed"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,9">
                    <Grid FlowDirection="{Binding PatchPreview.TextFlow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Stretch">
                            <WrapPanel Orientation="Horizontal"
                                       FlowDirection="{Binding PatchPreview.TextFlow}">
                                <TextBlock Text="{lang:Text Key=Patch.SourceStatus.CanaryTitle}"
                                           Style="{StaticResource R3SettingsRowTitleText}"
                                           VerticalAlignment="Center" />
                                <Border Style="{StaticResource SourcePill}"
                                        Tag="{Binding CanaryPatchSourceTone}"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="{Binding CanaryPatchSourceBadgeText}"
                                               Style="{StaticResource SourcePillText}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding CanaryPatchSourceStatusText}"
                                       Style="{StaticResource R3SettingsRowDescriptionText}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <WrapPanel Grid.Column="2"
                                   Orientation="Horizontal"
                                   FlowDirection="{Binding PatchPreview.TextFlow}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                            <Button Content="{lang:Text Key=Patch.SourceStatus.Refresh}"
                                    Command="{Binding AnalyzeCommand}"
                                    MinWidth="94" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="PatchesRoot"
                  Grid.Row="2"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid x:Name="OfficialContent"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,12"
                              HorizontalAlignment="Stretch"
                              Visibility="{Binding PatchPreview.HasOfficialItems, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding PatchPreview.OfficialSummary}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{Binding PatchPreview.TextFlow}"
                                           TextAlignment="{Binding PatchPreview.TextAlignment}"
                                           NumberSubstitution.Substitution="European" />
                                <TextBlock Text="{Binding PatchPreview.OfficialActionHint}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{Binding PatchPreview.TextFlow}"
                                           TextAlignment="{Binding PatchPreview.TextAlignment}"
                                           NumberSubstitution.Substitution="European"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="{lang:Text Key=Patch.ApplyOfficialSectionTip}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{Binding PatchPreview.TextFlow}"
                                           TextAlignment="{Binding PatchPreview.TextAlignment}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="2"
                                       Orientation="Horizontal"
                                       FlowDirection="{Binding PatchPreview.TextFlow}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Button Content="{lang:Text Key=Patch.ApplyOfficialSection}"
                                        Style="{StaticResource PrimaryButton}"
                                        MinWidth="104"
                                        Margin="0,0,6,0"
                                        Command="{Binding ApplyOfficialPatchesCommand}" />
                                <Button Content="{lang:Text Key=Patch.Off}"
                                        MinWidth="76"
                                        Command="{Binding DisableOfficialPatchesCommand}" />
                            </WrapPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              MinHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding PatchPreview.OfficialGroups}"
                                              ItemTemplate="{StaticResource PatchTargetGroupTemplate}"
                                              HorizontalAlignment="Stretch" />
                            </ScrollViewer>
                            <Border Style="{StaticResource ViewportEmptyStatePanel}"
                                    Visibility="{Binding PatchPreview.IsOfficialEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{lang:Text Key=Patch.OfficialEmpty}"
                                           Style="{StaticResource ArabicEmptyStateText}"
                                           FlowDirection="{Binding PatchPreview.TextFlow}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MaxWidth="460" />
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="CanaryContent"
                          Visibility="Collapsed"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,12"
                              HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding PatchPreview.HasCanaryItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding PatchPreview.CanarySummary}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{Binding PatchPreview.TextFlow}"
                                           TextAlignment="{Binding PatchPreview.TextAlignment}"
                                           NumberSubstitution.Substitution="European" />
                                <TextBlock Text="{Binding PatchPreview.CanaryActionHint}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{Binding PatchPreview.TextFlow}"
                                           TextAlignment="{Binding PatchPreview.TextAlignment}"
                                           NumberSubstitution.Substitution="European"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="{lang:Text Key=Patch.ApplyCanarySectionTip}"
                                           Style="{StaticResource RecommendationRowSubtitleText}"
                                           FlowDirection="{Binding PatchPreview.TextFlow}"
                                           TextAlignment="{Binding PatchPreview.TextAlignment}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="2"
                                       Orientation="Horizontal"
                                       FlowDirection="{Binding PatchPreview.TextFlow}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Button Content="{lang:Text Key=Patch.ApplyCanarySection}"
                                        Style="{StaticResource PrimaryButton}"
                                        MinWidth="118"
                                        Margin="0,0,6,0"
                                        Command="{Binding ApplyCanaryPatchesCommand}"
                                        Visibility="{Binding PatchPreview.HasCanaryItems, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="{lang:Text Key=Patch.Off}"
                                        MinWidth="76"
                                        Command="{Binding DisableCanaryPatchesCommand}"
                                        Visibility="{Binding PatchPreview.HasCanaryItems, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </WrapPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              MinHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding PatchPreview.CanaryGroups}"
                                              ItemTemplate="{StaticResource PatchTargetGroupTemplate}"
                                              HorizontalAlignment="Stretch" />
                            </ScrollViewer>
                            <Border Style="{StaticResource ViewportEmptyStatePanel}"
                                    Visibility="{Binding PatchPreview.IsCanaryEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{lang:Text Key=Patch.CanaryEmpty}"
                                           Style="{StaticResource ArabicEmptyStateText}"
                                           FlowDirection="{Binding PatchPreview.TextFlow}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MaxWidth="460" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="CheatRoot"
                  Grid.Row="2"
                  Visibility="Collapsed"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="140" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,12"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding PatchPreview.CheatSummary}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="{Binding PatchPreview.TextFlow}"
                                   TextAlignment="{Binding PatchPreview.TextAlignment}"
                                   NumberSubstitution.Substitution="European" />
                        <TextBlock Text="{lang:Text Key=Patch.CheatLibrary.Notice}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="{Binding PatchPreview.TextFlow}"
                                   TextAlignment="{Binding PatchPreview.TextAlignment}"
                                   TextWrapping="Wrap"
                                   MaxWidth="720"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{lang:Text Key=Patch.ApplyCheatSectionTip}"
                                   Style="{StaticResource RecommendationRowSubtitleText}"
                                   FlowDirection="{Binding PatchPreview.TextFlow}"
                                   TextAlignment="{Binding PatchPreview.TextAlignment}"
                                   TextWrapping="Wrap"
                                   MaxWidth="720"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <WrapPanel Grid.Column="2"
                               Orientation="Horizontal"
                               FlowDirection="{Binding PatchPreview.TextFlow}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <Button Content="{lang:Text Key=Patch.ApplyCheatSection}"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="118"
                                Margin="0,0,6,0"
                                Command="{Binding ApplyCheatPatchesCommand}"
                                Visibility="{Binding PatchPreview.HasCheatItems, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Content="{lang:Text Key=Patch.Off}"
                                MinWidth="76"
                                Command="{Binding DisableCheatPatchesCommand}"
                                Visibility="{Binding PatchPreview.HasCheatItems, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </WrapPanel>
                </Grid>

                <Grid Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      MinHeight="140">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,4,0">
                        <ItemsControl ItemsSource="{Binding PatchPreview.CheatGroups}"
                                      ItemTemplate="{StaticResource PatchTargetGroupTemplate}"
                                      HorizontalAlignment="Stretch" />
                    </ScrollViewer>
                    <Border Style="{StaticResource ViewportEmptyStatePanel}"
                            Visibility="{Binding PatchPreview.IsCheatEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{lang:Text Key=Patch.CheatEmpty}"
                                   Style="{StaticResource ArabicEmptyStateText}"
                                   FlowDirection="{Binding PatchPreview.TextFlow}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="460" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
