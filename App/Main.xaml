<Window x:Class="R3Config.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:R3Config.Ctrl"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{lang:Text Key=App.Title}"
        Icon="Data/Icon.ico"
        Width="1180"
        Height="740"
        MinWidth="1040"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

	<Border Style="{StaticResource R3WindowRootFrame}"
            Margin="0">
		<Grid Style="{StaticResource ShellLayout}"
              FlowDirection="LeftToRight"
              Language="{DynamicResource App.XmlLanguage}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource R3ShellTopBar}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{lang:Text Key=App.Title}"
                               Style="{StaticResource R3ShellTitleText}"
                               FlowDirection="{DynamicResource TechnicalText.FlowDirection}"
                               TextAlignment="{DynamicResource TechnicalText.TextAlignment}" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentLanguageText}"
                               Style="{StaticResource ArabicCaptionText}"
                               FlowDirection="{DynamicResource App.FlowDirection}"
                               TextAlignment="{DynamicResource App.DefaultTextAlignment}"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                FlowDirection="{DynamicResource App.CaptionButtonsFlowDirection}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource HeaderIconButton}"
                                ToolTip="{lang:Text Key=Window.MinimizeTip}"
                                Click="MinimizeButton_Click">
                            <Grid Width="14" Height="14">
                                <Path Data="M 2 7 L 12 7"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button x:Name="MaximizeRestoreButton"
                                Style="{StaticResource HeaderIconButton}"
                                ToolTip="{lang:Text Key=Window.MaximizeTip}"
                                Click="MaximizeRestoreButton_Click" />
                        <Button Style="{StaticResource HeaderCloseButton}"
                                ToolTip="{lang:Text Key=Window.CloseTip}"
                                Click="CloseButton_Click">
                            <Grid Width="14" Height="14">
                                <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

			<Grid Grid.Row="1"
                  Margin="16,16,16,0"
                  FlowDirection="LeftToRight"
                  Language="{DynamicResource App.XmlLanguage}">
				<Grid HorizontalAlignment="Stretch"
					  VerticalAlignment="Stretch"
					  Background="Transparent">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="{Binding LeftShellColumnWidth}" />
						<ColumnDefinition Width="{Binding RightShellColumnWidth}" />
					</Grid.ColumnDefinitions>

					<controls:GamesListView Grid.Column="{Binding GamesPanelColumn}"
                                            Margin="0,0,12,0" />

					<Grid Grid.Column="{Binding DetailsPanelColumn}"
						  HorizontalAlignment="Stretch"
						  VerticalAlignment="Stretch"
						  Background="Transparent">
						<Grid>
							<Grid.Style>
								<Style TargetType="{x:Type Grid}">
									<Setter Property="Visibility" Value="Visible" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding HasSelectedGame}" Value="False">
											<Setter Property="Visibility" Value="Collapsed" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Grid.Style>

							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<Border Grid.Row="0"
									Style="{StaticResource GameHeaderCard}"
									HorizontalAlignment="Stretch"
									Margin="0,0,0,8">
								<Grid FlowDirection="{DynamicResource App.FlowDirection}"
									  Language="{DynamicResource App.XmlLanguage}"
									  HorizontalAlignment="Stretch">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>

									<Border Grid.Column="0"
											Style="{StaticResource HeaderWarningBadge}"
											Visibility="{Binding ShowGameAlert, Converter={StaticResource BoolToVisibilityConverter}}"
											ToolTip="{lang:Text Key=Shell.GameAlertTip}">
										<TextBlock Text="!"
												   FontSize="12"
												   FontWeight="Bold"
												   Foreground="{StaticResource WarningBrush}"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center" />
									</Border>

									<Grid Grid.Column="1"
										  FlowDirection="{DynamicResource App.FlowDirection}"
										  HorizontalAlignment="Stretch"
										  MinWidth="0">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

										<TextBlock Grid.Row="0"
												   Text="{Binding SelectedGameTitle}"
												   Style="{StaticResource HeroTitleText}"
											   FlowDirection="{Binding SelectedGameTitleFlow}"
											   TextAlignment="{Binding SelectedGameTitleAlignment}"
											   HorizontalAlignment="Stretch" />
										<Border Grid.Row="1"
											Style="{StaticResource GameHeaderStatusChip}"
											Tag="{Binding SelectedGamePatchReadinessTone}"
											ToolTip="{Binding SelectedGamePatchReadinessTooltip}"
											HorizontalAlignment="Left"
											Margin="0,8,0,0">
										<TextBlock Text="{Binding SelectedGamePatchReadinessText}"
												   Style="{StaticResource GameHeaderStatusText}"
												   FlowDirection="{DynamicResource App.FlowDirection}"
												   TextAlignment="{DynamicResource App.DefaultTextAlignment}"
												   Padding="2,1" />
									</Border>
									</Grid>
								</Grid>
							</Border>

							<TabControl x:Name="DetailsTabControl"
                                        Grid.Row="1"
                                        Style="{StaticResource Win11TabControl}"
                                        ItemContainerStyle="{StaticResource Win11TabItem}"
                                        Margin="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        FlowDirection="{DynamicResource App.FlowDirection}">
                                <TabItem Header="{lang:Text Key=Tab.Settings}">
                                    <controls:RecPlanView HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch" />
                                </TabItem>
                                <TabItem x:Name="PatchesTab"
                                         Header="{lang:Text Key=Tab.Patches}">
                                    <controls:PatchView Mode="Patches"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch" />
                                </TabItem>
                                <TabItem x:Name="CanaryPatchTab"
                                         Header="{lang:Text Key=Tab.Canary}">
                                    <controls:PatchView Mode="Canary"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch" />
                                </TabItem>
                                <TabItem x:Name="CheatPatchTab"
                                         Header="{lang:Text Key=Tab.Cheats}">
                                    <controls:PatchView Mode="Cheat"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch" />
                                </TabItem>
                            </TabControl>
						</Grid>

						<Border HorizontalAlignment="Stretch"
								VerticalAlignment="Stretch">
							<Border.Style>
								<Style TargetType="{x:Type Border}" BasedOn="{StaticResource SectionCard}">
									<Setter Property="Visibility" Value="Visible" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding HasSelectedGame}" Value="True">
											<Setter Property="Visibility" Value="Collapsed" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>

							<Grid MaxWidth="560"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  FlowDirection="{DynamicResource App.FlowDirection}">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="8" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<TextBlock Grid.Row="0"
										   Text="{lang:Text Key=Shell.NoGameTitle}"
										   Style="{StaticResource SectionTitleText}"
										   FontSize="18"
										   TextAlignment="{DynamicResource App.DefaultTextAlignment}" />

								<TextBlock Grid.Row="2"
										   Text="{lang:Text Key=Shell.NoGameHint}"
										   Style="{StaticResource SectionCaptionText}"
										   TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
							</Grid>
						</Border>
					</Grid>
				</Grid>
			</Grid>

			<controls:ActionBarView Grid.Row="2"
									Margin="12" />
		</Grid>
	</Border>
</Window>
