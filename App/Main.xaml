<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:R3Config.Ctrl"
        xmlns:lang="clr-namespace:R3Config.Lang"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Class="R3Config.MainWin"
        Title="{lang:TextExt Key=App.Title}"
        Icon="Data/Icon.ico"
        Width="1080"
        Height="680"
        MinWidth="920"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}"
        FontFamily="{DynamicResource Type.Font.Body}"
        Background="{DynamicResource Surface.Background}"
        Foreground="{DynamicResource Text.Primary}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="{StaticResource Radius.None}"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource FluentSurface.Dialog}"
            Margin="0"
            BorderThickness="0"
            CornerRadius="{StaticResource Radius.None}"
            Effect="{x:Null}"
            ClipToBounds="True">

        <Grid>
            <Grid x:Name="ApplicationContent"
                  FlowDirection="{DynamicResource App.FlowDirection}"
                  Language="{DynamicResource App.XmlLanguage}">

                <Grid.Style>
                    <Style TargetType="{x:Type Grid}"
                           BasedOn="{StaticResource ShellLayout}">
                        <Setter Property="IsEnabled"
                                Value="True" />
                        <Setter Property="Effect"
                                Value="{x:Null}" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}"
                                         Value="True">
                                <Setter Property="IsEnabled"
                                        Value="False" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect Radius="6"
                                                    KernelType="Gaussian"
                                                    RenderingBias="Performance" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="40"
                    MinHeight="40"
                    Style="{StaticResource R3ShellTopBar}"
                    Padding="0"
                    ClipToBounds="True">

                <Grid x:Name="CaptionGrid"
                      Height="40"
                      FlowDirection="{DynamicResource App.CaptionButtonsFlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{lang:TextExt Key=App.Title}"
                               Style="{StaticResource R3ShellTitleText}"
                               FlowDirection="{DynamicResource TechnicalText.FlowDirection}"
                               TextAlignment="{DynamicResource TechnicalText.TextAlignment}"
                               VerticalAlignment="Center"
                               Margin="16,0,12,0"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False" />

                    <Border Grid.Column="1"
                            Background="Transparent"
                            IsHitTestVisible="False" />

                    <Button Grid.Column="2"
                            Height="30"
                            Padding="{StaticResource Button.Padding.Compact}"
                            Margin="0,5,8,5"
                            Style="{StaticResource FluentButton.Toolbar}"
                            Content="{lang:TextExt Key=Action.More}"
                            Command="{Binding AdvCmd}"
                            ToolTip="{lang:TextExt Key=Action.MoreTip}"
                            ToolTipService.Placement="Bottom"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Panel.ZIndex="20"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />

                    <Button Grid.Column="3"
                            Width="64"
                            Height="30"
                            MinWidth="{StaticResource Button.MinWidth.Compact}"
                            Padding="{StaticResource Button.Padding.Compact}"
                            Margin="0,5,8,5"
                            Style="{StaticResource FluentButton.Toolbar}"
                            Command="{Binding LangCmd}"
                            ToolTip="{Binding ToolTip}"
                            ToolTipService.Placement="Bottom"
                            AutomationProperties.Name="{Binding ToolTip}"
                            AutomationProperties.AutomationId="App.LanguageToggle"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Panel.ZIndex="20"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <Grid FlowDirection="LeftToRight"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">

                                <Ellipse Margin="2"
                                         Stroke="{DynamicResource Text.Primary}"
                                         StrokeThickness="1.2" />

                                <Path Data="M 8 2 C 5.5 4.5, 5.5 11.5, 8 14 M 8 2 C 10.5 4.5, 10.5 11.5, 8 14 M 2 8 L 14 8"
                                      Stroke="{DynamicResource Text.Primary}"
                                      StrokeThickness="1.1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding LangText}"
                                       FlowDirection="{DynamicResource TechnicalText.FlowDirection}"
                                       Language="{DynamicResource TechnicalText.Language}"
                                       TextAlignment="{DynamicResource TechnicalText.TextAlignment}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <ToggleButton x:Name="ThemeToggle"
                                  Grid.Column="4"
                                  Width="46"
                                  Height="40"
                                  Margin="0"
                                  Padding="0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ToolTip="{lang:TextExt Key=App.ThemeToggleTip}"
                                  ToolTipService.Placement="Bottom"
                                  AutomationProperties.Name="{lang:TextExt Key=App.ThemeToggleTip}"
                                  AutomationProperties.AutomationId="App.ThemeToggle"
                                  Click="ToggleTheme"
                                  Panel.ZIndex="20"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border x:Name="ButtonBackground"
                                        Background="Transparent">

                                    <Grid Width="30"
                                          Height="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          FlowDirection="LeftToRight">

                                        <Border x:Name="Track"
                                                Width="30"
                                                Height="16"
                                                CornerRadius="{StaticResource Radius.Large}"
                                                Background="{DynamicResource Surface.CardHover}"
                                                BorderBrush="{DynamicResource Stroke.Default}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />

                                        <Border x:Name="Thumb"
                                                Width="12"
                                                Height="12"
                                                CornerRadius="{StaticResource Radius.Circle.12}"
                                                Margin="2,0,0,0"
                                                Background="{DynamicResource Text.Primary}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked"
                                             Value="True">

                                        <Setter TargetName="Track"
                                                Property="Background"
                                                Value="{DynamicResource Accent.Default}" />

                                        <Setter TargetName="Track"
                                                Property="BorderBrush"
                                                Value="{DynamicResource Accent.Default}" />

                                        <Setter TargetName="Thumb"
                                                Property="HorizontalAlignment"
                                                Value="Right" />

                                        <Setter TargetName="Thumb"
                                                Property="Margin"
                                                Value="0,0,2,0" />
                                    </Trigger>

                                    <Trigger Property="IsMouseOver"
                                             Value="True">

                                        <Setter TargetName="ButtonBackground"
                                                Property="Background"
                                                Value="{DynamicResource Surface.CardHover}" />
                                    </Trigger>

                                    <Trigger Property="IsPressed"
                                             Value="True">

                                        <Setter TargetName="ButtonBackground"
                                                Property="Background"
                                                Value="{DynamicResource Surface.CardPressed}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Button Grid.Column="5"
                            Margin="0"
                            Style="{StaticResource FluentButton.Icon.Caption}"
                            AutomationProperties.Name="{lang:TextExt Key=Window.MinimizeTip}"
                            ToolTip="{lang:TextExt Key=Window.MinimizeTip}"
                            ToolTipService.Placement="Bottom"
                            Click="MinWin"
                            TextBlock.TextAlignment="Left"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Panel.ZIndex="20"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <Grid Width="16"
                              Height="16"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">

                            <TextBlock Text=""
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="10"
                                       Foreground="{Binding Foreground,
                                                            RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FlowDirection="LeftToRight"
                                       TextAlignment="Center"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType" />
                        </Grid>
                    </Button>

                    <Button x:Name="MaxBtn"
                            Grid.Column="6"
                            Margin="0"
                            Style="{StaticResource FluentButton.Icon.Caption}"
                            AutomationProperties.Name="{lang:TextExt Key=Window.MaximizeTip}"
                            ToolTip="{lang:TextExt Key=Window.MaximizeTip}"
                            ToolTipService.Placement="Bottom"
                            Click="MaxWin"
                            TextBlock.TextAlignment="Left"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Panel.ZIndex="20"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    </Button>

                    <Button Grid.Column="7"
                            Margin="0"
                            Style="{StaticResource FluentButton.Close.Caption}"
                            AutomationProperties.Name="{lang:TextExt Key=Window.CloseTip}"
                            ToolTip="{lang:TextExt Key=Window.CloseTip}"
                            ToolTipService.Placement="Bottom"
                            Click="CloseWin"
                            TextBlock.TextAlignment="Left"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Panel.ZIndex="20"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <Grid Width="16"
                              Height="16"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">

                            <TextBlock Text=""
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="10"
                                       Foreground="{Binding Foreground,
                                                            RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FlowDirection="LeftToRight"
                                       TextAlignment="Center"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="8,16,8,0"
                  FlowDirection="{DynamicResource App.FlowDirection}"
                  Language="{DynamicResource App.XmlLanguage}">

                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding LeftWide}"
                                          MinWidth="320" />

                        <ColumnDefinition Width="{Binding RghtWide}"
                                          MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <controls:GameList Grid.Column="{Binding GameCol}"
                                       Margin="8,0"
                                       MinWidth="320" />

                    <Grid Grid.Column="{Binding DetCol}"
                          Margin="8,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent">

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility"
                                            Value="Visible" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGame}"
                                                     Value="False">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Style="{StaticResource GameHeaderCard}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8">

                                <Grid Language="{DynamicResource App.XmlLanguage}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SelGame}"
                                               Style="{StaticResource HeroTitleText}"
                                               FlowDirection="{Binding SelGame, Converter={StaticResource ContentTextFlowConverter}}"
                                               TextAlignment="{DynamicResource App.TextAlignment}"
                                               Language="{Binding SelGame, Converter={StaticResource ContentTextLanguageConverter}, ConverterCulture=en-US}"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelGame}" />

                                </Grid>
                            </Border>

                            <TabControl x:Name="Tabs"
                                        Grid.Row="1"
                                        Style="{StaticResource FluentTabControl}"
                                        ItemContainerStyle="{StaticResource FluentTabItem}"
                                        Margin="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        FlowDirection="{DynamicResource App.FlowDirection}">

                                <TabItem Header="{lang:TextExt Key=Tab.Settings}"
                                         AutomationProperties.AutomationId="Settings.Tab"
                                         TextBlock.TextAlignment="Left">

                                    <controls:RecView HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch" />
                                </TabItem>

                                <TabItem x:Name="PatTab"
                                         Header="{lang:TextExt Key=Tab.Patches}"
                                         AutomationProperties.AutomationId="Patches.Tab"
                                         TextBlock.TextAlignment="Left">

                                    <controls:PatView Mode="Patches"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch" />
                                </TabItem>

                                <TabItem x:Name="CanTab"
                                         Header="{lang:TextExt Key=Tab.Canary}"
                                         AutomationProperties.AutomationId="Canary.Tab"
                                         TextBlock.TextAlignment="Left">

                                    <controls:PatView Mode="Canary"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch" />
                                </TabItem>

                                <TabItem x:Name="ChtTab"
                                         Header="{lang:TextExt Key=Tab.Cheats}"
                                         AutomationProperties.AutomationId="Artemis.Tab"
                                         TextBlock.TextAlignment="Left">

                                    <controls:PatView Mode="Cheat"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch" />
                                </TabItem>

                            </TabControl>
                        </Grid>

                        <Border HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">

                            <Border.Style>
                                <Style TargetType="{x:Type Border}"
                                       BasedOn="{StaticResource SectionCard}">

                                    <Setter Property="Visibility"
                                            Value="Visible" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGame}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid MaxWidth="560"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  FlowDirection="{DynamicResource App.FlowDirection}">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{lang:TextExt Key=Shell.NoGameTitle}"
                                           Style="{StaticResource Type.Title}"
                                           TextAlignment="Left" />

                                <TextBlock Grid.Row="2"
                                           Text="{lang:TextExt Key=Shell.NoGameHint}"
                                           Style="{StaticResource SectionCaptionText}"
                                           TextAlignment="Left" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <controls:ActBar Grid.Row="2"
                             Margin="16,12,16,16" />
            </Grid>

            <Grid x:Name="BusyOverlay"
                  Background="Transparent"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                  IsHitTestVisible="True"
                  Focusable="True"
                  Panel.ZIndex="1000"
                  AutomationProperties.AutomationId="App.BusyOverlay"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">

                <Border Background="{DynamicResource Surface.Overlay}"
                        Opacity="0.72"
                        CornerRadius="{StaticResource Radius.None}" />

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Grid Width="44"
                          Height="44"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FlowDirection="LeftToRight">

                        <Ellipse Width="40"
                                 Height="40"
                                 Stroke="{DynamicResource Stroke.Subtle}"
                                 StrokeThickness="3"
                                 Opacity="0.75"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />

                        <Path x:Name="BusySpinner"
                              Width="40"
                              Height="40"
                              Data="M 20,2 A 18,18 0 1 1 2,20"
                              Stretch="Uniform"
                              Stroke="{DynamicResource Accent.Default}"
                              StrokeThickness="3.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">

                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>

                            <Path.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BusySpinner"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0"
                                                             To="360"
                                                             Duration="0:0:0.85"
                                                             RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Grid>

                    <TextBlock x:Name="BusyMessage"
                               Text="{Binding BusyText}"
                               Style="{StaticResource Type.BodyStrong}"
                               FlowDirection="{DynamicResource App.TextFlowDirection}"
                               TextAlignment="{DynamicResource App.TextAlignment}"
                               HorizontalAlignment="Center"
                               MaxWidth="440"
                               Margin="0,14,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
