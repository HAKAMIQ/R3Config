<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Type.Font.Body">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Type.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Type.Font.Technical">Cascadia Mono, Consolas, Segoe UI Mono</FontFamily>

    <Style x:Key="Type.Body"
           TargetType="{x:Type TextBlock}">
        <Setter Property="NumberSubstitution.Substitution"
                Value="European" />
        <Setter Property="FontFamily"
                Value="{DynamicResource Type.Font.Body}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="Regular" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Primary}" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="Language"
                Value="{DynamicResource App.XmlLanguage}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
    </Style>

    <Style x:Key="Type.BodyStrong"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Body}">
        <Setter Property="FontWeight"
                Value="SemiBold" />
    </Style>

    <Style x:Key="Type.Caption"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Body}">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Secondary}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="Type.Subtitle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.BodyStrong}">
        <Setter Property="FontSize"
                Value="16" />
    </Style>

    <Style x:Key="Type.Title"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.BodyStrong}">
        <Setter Property="FontFamily"
                Value="{DynamicResource Type.Font.Display}" />
        <Setter Property="FontSize"
                Value="20" />
    </Style>

    <Style x:Key="Type.TitleLarge"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Title}">
        <Setter Property="FontSize"
                Value="24" />
    </Style>

    <Style x:Key="Type.Display"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.TitleLarge}">
        <Setter Property="FontSize"
                Value="28" />
    </Style>

    <Style x:Key="TechnicalTextSpan"
           TargetType="{x:Type Span}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource TechnicalText.FlowDirection}" />
        <Setter Property="Language"
                Value="{DynamicResource TechnicalText.Language}" />
        <Setter Property="NumberSubstitution.Substitution"
                Value="European" />
    </Style>

    <Style x:Key="Type.Technical"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily"
                Value="{DynamicResource Type.Font.Technical}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="Regular" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Primary}" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource TechnicalText.FlowDirection}" />
        <Setter Property="Language"
                Value="{DynamicResource TechnicalText.Language}" />
        <Setter Property="NumberSubstitution.Substitution"
                Value="European" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource TechnicalText.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
    </Style>

    <Style x:Key="ArabicHeadingText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.BodyStrong}" />

    <Style x:Key="ArabicCaptionText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Caption}" />

    <Style x:Key="ArabicEmptyStateText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Body}">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Secondary}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
        <Setter Property="Margin"
                Value="24" />
    </Style>

    <Style x:Key="StatusText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Caption}" />

    <Style x:Key="LabelText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.BodyStrong}">
        <Setter Property="FontSize"
                Value="12" />
    </Style>

    <Style x:Key="TechText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Technical}">
        <Setter Property="Padding"
                Value="8,0" />
    </Style>

    <Style x:Key="RailTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Subtitle}" />

    <Style x:Key="RailCaptionText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Caption}">
        <Setter Property="FontSize"
                Value="12" />
    </Style>

    <Style x:Key="GameRailTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.BodyStrong}">
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
        <Setter Property="ToolTip"
                Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style x:Key="GameRailSerialText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Technical}">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Secondary}" />
        <Setter Property="ToolTip"
                Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style x:Key="HeroTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.TitleLarge}">
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource TechnicalText.FlowDirection}" />
        <Setter Property="Language"
                Value="{DynamicResource TechnicalText.Language}" />
        <Setter Property="NumberSubstitution.Substitution"
                Value="European" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource TechnicalText.TextAlignment}" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
        <Setter Property="ToolTip"
                Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style x:Key="SectionTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Subtitle}">
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="SectionCaptionText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Caption}">
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="BottomBarLabelText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource Type.Caption}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource TechnicalText.FlowDirection}" />
        <Setter Property="Language"
                Value="{DynamicResource TechnicalText.Language}" />
        <Setter Property="NumberSubstitution.Substitution"
                Value="European" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource TechnicalText.TextAlignment}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="TextTrimming"
                Value="None" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

</ResourceDictionary>