    <Style x:Key="FluentTabControl"
           TargetType="{x:Type TabControl}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.ShellFlowDirection}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Stretch" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                Value="Auto" />

        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local"
                          SnapsToDevicePixels="True">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Margin="0,0,0,12">

                            <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.TabIndex="1" />
                            </ScrollViewer>
                        </Border>

                        <ContentPresenter Grid.Row="1"
                                          ContentSource="SelectedContent"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          KeyboardNavigation.TabIndex="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentTabItem"
       TargetType="{x:Type TabItem}">
        <Setter Property="Background"
            Value="Transparent" />
        <Setter Property="Foreground"
            Value="{DynamicResource Text.Secondary}" />
        <Setter Property="BorderBrush"
            Value="Transparent" />
        <Setter Property="BorderThickness"
            Value="0" />
        <Setter Property="Padding"
            Value="10,0" />
        <Setter Property="Margin"
            Value="0" />
        <Setter Property="MinWidth"
            Value="72" />
        <Setter Property="MinHeight"
            Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="MaxHeight"
            Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="FontSize"
            Value="14" />
        <Setter Property="FlowDirection"
            Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="HorizontalContentAlignment"
            Value="{DynamicResource App.HorizontalAlignment}" />
        <Setter Property="VerticalContentAlignment"
            Value="Center" />
        <Setter Property="FocusVisualStyle"
            Value="{StaticResource Stroke.FocusVisualStyle}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid MinHeight="{TemplateBinding MinHeight}"
                      MaxHeight="{TemplateBinding MaxHeight}">

                        <Border x:Name="TabSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="{StaticResource Stroke.Thickness.Default}"
                            CornerRadius="{StaticResource Radius.Medium}"
                            Padding="{TemplateBinding Padding}">

                            <DockPanel HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="Center"
                                       LastChildFill="True">

                                <!-- Optional Fluent 2 tab glyph, supplied through TabItem.Tag. -->
                                <TextBlock x:Name="TabGlyph"
                                           DockPanel.Dock="Left"
                                           Text="{TemplateBinding Tag}"
                                           Style="{StaticResource IconGlyphText}"
                                           FontSize="{StaticResource Tab.GlyphSize}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Margin="0,0,6,0"
                                           Visibility="Visible" />

                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  FlowDirection="{DynamicResource App.TextFlowDirection}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  RecognizesAccessKey="True" />
                            </DockPanel>
                        </Border>

                        <Border x:Name="SelectionIndicator"
                                Height="2"
                                Margin="8,0"
                                Background="{DynamicResource Accent.Default}"
                                CornerRadius="{StaticResource Radius.Small}"
                                VerticalAlignment="Bottom"
                                Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag"
                                 Value="{x:Null}">
                            <Setter TargetName="TabGlyph"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>

                        <Trigger SourceName="TabSurface"
                             Property="IsMouseOver"
                             Value="True">
                            <Setter TargetName="TabSurface"
                                Property="Background"
                                Value="{DynamicResource Surface.CardHover}" />
                            <Setter Property="Foreground"
                                Value="{DynamicResource Text.Primary}" />
                        </Trigger>

                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="TabSurface"
                                    Property="Background"
                                    Value="{DynamicResource Selection.Default}" />
                            <Setter TargetName="SelectionIndicator"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Text.Primary}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected"
                                           Value="True" />
                                <Condition Property="Selector.IsSelectionActive"
                                           Value="False" />
                            </MultiTrigger.Conditions>

                            <Setter TargetName="TabSurface"
                                    Property="Background"
                                    Value="{DynamicResource Selection.Inactive}" />
                        </MultiTrigger>


                        <Trigger Property="IsEnabled"
                             Value="False">
                            <Setter TargetName="TabSurface"
                                Property="Background"
                                Value="{DynamicResource Surface.CardPressed}" />
                            <Setter Property="Foreground"
                                Value="{DynamicResource Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

