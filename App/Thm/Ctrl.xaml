<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:ctrl="clr-namespace:R3Config.Ctrl">

    <sys:Double x:Key="Space.2">2</sys:Double>
    <sys:Double x:Key="Space.4">4</sys:Double>
    <sys:Double x:Key="Space.8">8</sys:Double>
    <sys:Double x:Key="Space.12">12</sys:Double>
    <sys:Double x:Key="Space.16">16</sys:Double>
    <sys:Double x:Key="Space.20">20</sys:Double>
    <sys:Double x:Key="Space.24">24</sys:Double>
    <sys:Double x:Key="Space.32">32</sys:Double>

    <Thickness x:Key="Space.4.All">4</Thickness>
    <Thickness x:Key="Space.8.All">8</Thickness>
    <Thickness x:Key="Space.12.All">12</Thickness>
    <Thickness x:Key="Space.16.All">16</Thickness>
    <Thickness x:Key="Space.20.All">20</Thickness>
    <Thickness x:Key="Space.24.All">24</Thickness>

    <CornerRadius x:Key="Radius.None">0</CornerRadius>
    <CornerRadius x:Key="Radius.Small">2</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">4</CornerRadius>
    <CornerRadius x:Key="Radius.Large">8</CornerRadius>
    <CornerRadius x:Key="Radius.XLarge">12</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog.Bottom">0,0,12,12</CornerRadius>
    <CornerRadius x:Key="Radius.Circle.12">6</CornerRadius>
    <CornerRadius x:Key="Radius.Circle.28">14</CornerRadius>
    <CornerRadius x:Key="Radius.Circle.32">16</CornerRadius>
    <!-- Fluent 2 badge/chip shape: fully rounded at the 24px chip height. -->
    <CornerRadius x:Key="Radius.Pill">12</CornerRadius>
    <CornerRadius x:Key="Radius.Input.Underline">0,0,4,4</CornerRadius>

    <sys:Double x:Key="IdentityTile.Size">44</sys:Double>
    <sys:Double x:Key="EmptyState.GlyphSize">32</sys:Double>
    <sys:Double x:Key="Tab.GlyphSize">16</sys:Double>

    <sys:Double x:Key="Stroke.Width.Default">1</sys:Double>
    <sys:Double x:Key="Stroke.Width.Focus">2</sys:Double>
    <Thickness x:Key="Stroke.Thickness.Default">1</Thickness>
    <Thickness x:Key="Stroke.Thickness.Focus">2</Thickness>

    <!--
        Centralized keyboard-focus adorner. WPF renders this
        automatically (via the Control.FocusVisualStyle mechanism)
        only while the templated control actually has keyboard focus,
        so controls that reference it never need their own
        IsKeyboardFocused/IsKeyboardFocusWithin trigger; those are
        intentionally forbidden in this theme (see UiGate's
        "Theme controls must not render keyboard-focus outlines"
        check) so every control shares one consistent focus stroke
        instead of duplicating ad-hoc focus logic per style.
    -->
    <Style x:Key="Stroke.FocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="1"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Stroke.Focus}"
                               StrokeThickness="{StaticResource Stroke.Width.Focus}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <sys:Double x:Key="Control.Height.Compact">24</sys:Double>
    <sys:Double x:Key="Control.Height.Standard">32</sys:Double>
    <sys:Double x:Key="Control.Height.Large">40</sys:Double>

    <sys:Double x:Key="Button.MinWidth.Compact">64</sys:Double>
    <sys:Double x:Key="Button.MinWidth.Standard">96</sys:Double>

    <Thickness x:Key="Button.Padding.Compact">8,3</Thickness>
    <Thickness x:Key="Button.Padding.Standard">12,5</Thickness>
    <Thickness x:Key="Button.Padding.Large">16,8</Thickness>

    <sys:Double x:Key="DataGrid.HeaderHeight">32</sys:Double>
    <sys:Double x:Key="DataGrid.RowHeight">36</sys:Double>

    <Duration x:Key="Motion.Hover">0:0:0.12</Duration>
    <Duration x:Key="Motion.Press">0:0:0.09</Duration>
    <Duration x:Key="Motion.Surface">0:0:0.18</Duration>

    <DropShadowEffect x:Key="Elevation.1"
                      po:Freeze="False"
                      BlurRadius="12"
                      ShadowDepth="2"
                      Opacity="0.24"
                      Direction="270"
                      Color="{StaticResource Elevation.Shadow.Color}" />

    <DropShadowEffect x:Key="Elevation.2"
                      po:Freeze="False"
                      BlurRadius="20"
                      ShadowDepth="4"
                      Opacity="0.28"
                      Direction="270"
                      Color="{StaticResource Elevation.Shadow.Color}" />

    <DropShadowEffect x:Key="Elevation.3"
                      po:Freeze="False"
                      BlurRadius="28"
                      ShadowDepth="8"
                      Opacity="0.32"
                      Direction="270"
                      Color="{StaticResource Elevation.Shadow.Color}" />

    <!-- Fluent 2 icon glyph: one family with the Windows 10 fallback, never
         mirrored, centered in its slot. Decorative unless the owner names it. -->
    <Style x:Key="IconGlyphText"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily"
                Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="FlowDirection"
                Value="LeftToRight" />
        <Setter Property="TextAlignment"
                Value="Center" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Secondary}" />
    </Style>

    <!-- Leading visual anchor of an entity header (the selected game). -->
    <Style x:Key="IdentityTile"
           TargetType="{x:Type Border}">
        <Setter Property="Width"
                Value="{StaticResource IdentityTile.Size}" />
        <Setter Property="Height"
                Value="{StaticResource IdentityTile.Size}" />
        <Setter Property="CornerRadius"
                Value="{StaticResource Radius.Large}" />
        <Setter Property="Background"
                Value="{DynamicResource Selection.Default}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Stroke.Subtle}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
    </Style>

    <Style x:Key="IdentityTileGlyph"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource IconGlyphText}">
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="Foreground"
                Value="{DynamicResource Accent.Default}" />
    </Style>

    <Style x:Key="EmptyStateGlyph"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource IconGlyphText}">
        <Setter Property="FontSize"
                Value="{StaticResource EmptyState.GlyphSize}" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Tertiary}" />
        <Setter Property="Margin"
                Value="0,0,0,8" />
    </Style>

    <Style x:Key="ShellLayout"
           TargetType="FrameworkElement">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.ShellFlowDirection}" />
    </Style>

    <Style x:Key="FluentSurface.Card"
           TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource Surface.Card}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Stroke.Subtle}" />
        <Setter Property="BorderThickness"
                Value="{StaticResource Stroke.Thickness.Default}" />
        <Setter Property="CornerRadius"
                Value="{StaticResource Radius.Large}" />
        <Setter Property="Padding"
                Value="12" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.ShellFlowDirection}" />
    </Style>

    <Style x:Key="LeftRailBorder"
           TargetType="Border"
           BasedOn="{StaticResource FluentSurface.Card}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.ShellFlowDirection}" />
        <Setter Property="Background"
                Value="{DynamicResource Surface.Subtle}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Stroke.Subtle}" />
        <Setter Property="Padding"
                Value="12" />
        <Setter Property="CornerRadius"
                Value="{StaticResource Radius.Large}" />
    </Style>

    <Style x:Key="SectionCard"
           TargetType="Border"
           BasedOn="{StaticResource FluentSurface.Card}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.ShellFlowDirection}" />
        <Setter Property="Padding"
                Value="12" />
        <Setter Property="CornerRadius"
                Value="{StaticResource Radius.Large}" />
    </Style>

    <Style x:Key="GameHeaderCard"
           TargetType="Border"
           BasedOn="{StaticResource FluentSurface.Card}">
        <Setter Property="Background"
                Value="{DynamicResource Surface.Card}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Stroke.Subtle}" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.ShellFlowDirection}" />
        <Setter Property="Padding"
                Value="10" />
        <Setter Property="CornerRadius"
                Value="{StaticResource Radius.Large}" />
    </Style>

    <Style x:Key="BottomBarBorder"
           TargetType="Border"
           BasedOn="{StaticResource FluentSurface.Card}">
        <Setter Property="Padding"
                Value="8" />
        <Setter Property="CornerRadius"
                Value="{StaticResource Radius.Large}" />
    </Style>

    <Style x:Key="EmptyStatePanel"
           TargetType="Border">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.ShellFlowDirection}" />
        <Setter Property="Background"
                Value="{DynamicResource Surface.Subtle}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Stroke.Subtle}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="{StaticResource Radius.Large}" />
        <Setter Property="Padding"
                Value="12" />
        <Setter Property="MinHeight"
                Value="96" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Stretch" />
    </Style>

    <Style x:Key="ViewportEmptyStatePanel"
           TargetType="Border"
           BasedOn="{StaticResource EmptyStatePanel}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="MinHeight"
                Value="128" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Stretch" />
    </Style>

    <Style x:Key="StatusMetricPill"
           TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource Surface.Card}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Stroke.Subtle}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="{StaticResource Radius.Large}" />
        <Setter Property="Padding"
                Value="10,6" />
        <Setter Property="Margin"
                Value="4,0" />
        <Setter Property="MinHeight"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="MinWidth"
                Value="148" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="GameRailItem"
           TargetType="ListBoxItem">
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Margin"
                Value="0,0,0,2" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Primary}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="FocusVisualStyle"
                Value="{StaticResource Stroke.FocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid>
                        <Border x:Name="ItemRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Large}"
                                Padding="10,6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ItemRoot"
                                    Property="Background"
                                    Value="{DynamicResource Surface.CardHover}" />
                            <Setter TargetName="ItemRoot"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Stroke.Subtle}" />
                        </Trigger>

                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="ItemRoot"
                                    Property="Background"
                                    Value="{DynamicResource Selection.Default}" />
                            <Setter TargetName="ItemRoot"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Stroke.Subtle}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected"
                                           Value="True" />
                                <Condition Property="Selector.IsSelectionActive"
                                           Value="False" />
                            </MultiTrigger.Conditions>

                            <Setter TargetName="ItemRoot"
                                    Property="Background"
                                    Value="{DynamicResource Selection.Inactive}" />
                            <Setter TargetName="ItemRoot"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Stroke.Subtle}" />
                        </MultiTrigger>


                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Text.Disabled}" />
                            <Setter TargetName="ItemRoot"
                                    Property="Background"
                                    Value="{DynamicResource Surface.CardPressed}" />
                            <Setter TargetName="ItemRoot"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Stroke.Subtle}" />
                            <Setter Property="Opacity"
                                    Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollLineButton"
           TargetType="RepeatButton">
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="IsTabStop"
                Value="False" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkScrollThumb"
           TargetType="Thumb">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="MinHeight"
                Value="42" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Thumb"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Medium}"
                            Margin="2" />

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Thumb"
                                    Property="Background"
                                    Value="{DynamicResource Scroll.ThumbHover}" />
                        </Trigger>

                        <Trigger Property="IsDragging"
                                 Value="True">
                            <Setter TargetName="Thumb"
                                    Property="Background"
                                    Value="{DynamicResource Accent.Default}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkHorizontalScrollThumb"
           TargetType="Thumb"
           BasedOn="{StaticResource DarkScrollThumb}">
        <Setter Property="MinHeight"
                Value="0" />
        <Setter Property="MinWidth"
                Value="42" />
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate"
                     TargetType="{x:Type ScrollBar}">
        <Border Width="8"
                Background="{TemplateBinding Background}"
                BorderThickness="0"
                CornerRadius="{StaticResource Radius.Medium}">
            <Track x:Name="PART_Track"
                   IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                  Style="{StaticResource ScrollLineButton}" />
                </Track.DecreaseRepeatButton>

                <Track.Thumb>
                    <Thumb Style="{StaticResource DarkScrollThumb}" />
                </Track.Thumb>

                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                  Style="{StaticResource ScrollLineButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate"
                     TargetType="{x:Type ScrollBar}">
        <Border Height="8"
                Background="{TemplateBinding Background}"
                BorderThickness="0"
                CornerRadius="{StaticResource Radius.Medium}">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand"
                                  Style="{StaticResource ScrollLineButton}" />
                </Track.DecreaseRepeatButton>

                <Track.Thumb>
                    <Thumb Style="{StaticResource DarkHorizontalScrollThumb}" />
                </Track.Thumb>

                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand"
                                  Style="{StaticResource ScrollLineButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <!-- Keeps the WPF ScrollViewer template (always-visible, full-size R3Config
         scrollbars below) instead of WPF UI's auto-hiding overlay scrollbars. -->
    <Style TargetType="{x:Type ScrollViewer}" />
    <!-- Same for Expander: WPF UI's template glyph would inherit the shell
         direction through R3Config's implicit TextBlock style, breaking the
         icon left-to-right convention. The verified WPF template is kept. -->
    <Style TargetType="{x:Type Expander}" />
    <!-- Same for ToggleButton: WPF UI's setters moved the ComboBox dropdown
         chevron over the selected text inside R3Config's ComboBox template. -->
    <Style TargetType="{x:Type ToggleButton}" />

    <!-- R3Config grids show column headers only (RowHeaderWidth 0), so the
         select-all corner is never shown; it stays empty instead of taking
         WPF UI's glyph through the component resource key. -->
    <Style x:Key="{ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}"
           TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource Scroll.Thumb}" />
        <Setter Property="Width"
                Value="8" />
        <Setter Property="MinWidth"
                Value="8" />
        <Setter Property="Template"
                Value="{StaticResource VerticalScrollBarTemplate}" />

        <Style.Triggers>
            <Trigger Property="Orientation"
                     Value="Horizontal">
                <Setter Property="Height"
                        Value="8" />
                <Setter Property="MinHeight"
                        Value="8" />
                <Setter Property="Width"
                        Value="Auto" />
                <Setter Property="Template"
                        Value="{StaticResource HorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button">
        <Setter Property="MinHeight"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="MinWidth"
                Value="{StaticResource Button.MinWidth.Standard}" />
        <Setter Property="Padding"
                Value="{StaticResource Button.Padding.Standard}" />
        <Setter Property="Margin"
                Value="0" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background"
                Value="{DynamicResource Surface.Subtle}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Stroke.Default}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Medium}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          FlowDirection="{TemplateBinding FlowDirection}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="False" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Chrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Stroke.Strong}" />
                            <Setter TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource Surface.CardHover}" />
                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource Surface.CardPressed}" />
                        </Trigger>


                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Text.Disabled}" />
                            <Setter TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource Surface.CardPressed}" />
                            <Setter TargetName="Chrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Stroke.Subtle}" />
                            <Setter Property="Cursor"
                                    Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentButton.Primary"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"
                Value="{DynamicResource Accent.Default}" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.OnAccent}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Accent.Default}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Medium}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          FlowDirection="{TemplateBinding FlowDirection}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="False">
                            <ContentPresenter.Resources>
                                <!-- The application-wide implicit TextBlock style sets
                                     Text.Primary, which outranks the inherited
                                     TextElement.Foreground above. The label must keep
                                     the button's own foreground (Text.OnAccent, or
                                     Text.Disabled when disabled) on the accent fill. -->
                                <Style TargetType="{x:Type TextBlock}"
                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource Accent.Hover}" />
                            <Setter TargetName="Chrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Accent.Hover}" />
                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource Accent.Pressed}" />
                            <Setter TargetName="Chrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Accent.Pressed}" />
                        </Trigger>


                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Text.Disabled}" />
                            <Setter TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource Surface.CardPressed}" />
                            <Setter TargetName="Chrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Stroke.Subtle}" />
                            <Setter Property="Cursor"
                                    Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentButton.Icon"
           TargetType="Button">
        <Setter Property="Width"
                Value="40" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="MinWidth"
                Value="40" />
        <Setter Property="MinHeight"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Margin"
                Value="0" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Primary}" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="FlowDirection"
                Value="LeftToRight" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Medium}"
                            SnapsToDevicePixels="True">
