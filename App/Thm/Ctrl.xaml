                Value="{StaticResource Stroke.FocusVisualStyle}" />
        <Setter Property="Width"
                Value="28" />
        <Setter Property="Height"
                Value="28" />
        <Setter Property="MinWidth"
                Value="28" />
        <Setter Property="MinHeight"
                Value="28" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="FlowDirection"
                Value="LeftToRight" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Root"
                          Width="28"
                          Height="28"
                          SnapsToDevicePixels="True">

                        <Border x:Name="HoverSurface"
                                Width="28"
                                Height="28"
                                CornerRadius="{StaticResource Radius.Medium}"
                                Background="Transparent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <Border x:Name="Box"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{StaticResource Stroke.Thickness.Default}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <Grid>
                                    <Viewbox x:Name="ChkGlyph"
                                             Width="11"
                                             Height="11"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Stretch="Uniform"
                                             Visibility="Collapsed">

                                        <Path Data="M 1,6.5 L 2.6,4.9 L 4.7,7 L 9.6,2.1 L 11.2,3.7 L 4.7,10.2 Z"
                                              Fill="{DynamicResource Text.OnAccent}"
                                              Stretch="Uniform" />
                                    </Viewbox>

                                    <Rectangle x:Name="IndMark"
                                               Width="8"
                                               Height="2"
                                               RadiusX="1"
                                               RadiusY="1"
                                               Fill="{DynamicResource Text.OnAccent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="Box"
                                    Property="Background"
                                    Value="{DynamicResource Accent.Default}" />
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Accent.Default}" />
                            <Setter TargetName="ChkGlyph"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsChecked"
                                 Value="{x:Null}">
                            <Setter TargetName="Box"
                                    Property="Background"
                                    Value="{DynamicResource Accent.Default}" />
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Accent.Default}" />
                            <Setter TargetName="IndMark"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="HoverSurface"
                                    Property="Background"
                                    Value="{DynamicResource Surface.CardHover}" />
                            <Setter TargetName="Box"
                                    Property="Background"
                                    Value="{DynamicResource Accent.Disabled}" />
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Accent.Hover}" />
                            <Setter TargetName="Box"
                                    Property="BorderThickness"
                                    Value="{StaticResource Stroke.Thickness.Focus}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver"
                                           Value="True" />
                                <Condition Property="IsChecked"
                                           Value="True" />
                            </MultiTrigger.Conditions>

                            <Setter TargetName="Box"
                                    Property="Background"
                                    Value="{DynamicResource Accent.Hover}" />
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Accent.Hover}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver"
                                           Value="True" />
                                <Condition Property="IsChecked"
                                           Value="{x:Null}" />
                            </MultiTrigger.Conditions>

                            <Setter TargetName="Box"
                                    Property="Background"
                                    Value="{DynamicResource Accent.Hover}" />
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Accent.Hover}" />
                        </MultiTrigger>

                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="HoverSurface"
                                    Property="Background"
                                    Value="{DynamicResource Surface.CardPressed}" />
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Accent.Pressed}" />
                        </Trigger>


                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Cursor"
                                    Value="Arrow" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Text.Disabled}" />
                            <Setter TargetName="HoverSurface"
                                    Property="Background"
                                    Value="Transparent" />
                            <Setter TargetName="Box"
                                    Property="Background"
                                    Value="{DynamicResource Surface.CardPressed}" />
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Stroke.Subtle}" />
                            <Setter TargetName="Box"
                                    Property="BorderThickness"
                                    Value="{StaticResource Stroke.Thickness.Default}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
