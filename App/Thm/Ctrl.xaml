<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Fluent 2 layout, shape, size, elevation, and motion tokens. -->
    <sys:Double x:Key="Space.2">2</sys:Double>
    <sys:Double x:Key="Space.4">4</sys:Double>
    <sys:Double x:Key="Space.8">8</sys:Double>
    <sys:Double x:Key="Space.12">12</sys:Double>
    <sys:Double x:Key="Space.16">16</sys:Double>
    <sys:Double x:Key="Space.20">20</sys:Double>
    <sys:Double x:Key="Space.24">24</sys:Double>
    <sys:Double x:Key="Space.32">32</sys:Double>
    <Thickness x:Key="Space.4.All">4</Thickness>
    <Thickness x:Key="Space.8.All">8</Thickness>
    <Thickness x:Key="Space.12.All">12</Thickness>
    <Thickness x:Key="Space.16.All">16</Thickness>
    <Thickness x:Key="Space.20.All">20</Thickness>
    <Thickness x:Key="Space.24.All">24</Thickness>
    <CornerRadius x:Key="Radius.Small">2</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">4</CornerRadius>
    <CornerRadius x:Key="Radius.Large">8</CornerRadius>
    <CornerRadius x:Key="Radius.XLarge">12</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog.Bottom">0,0,12,12</CornerRadius>
    <CornerRadius x:Key="Radius.Circle.28">14</CornerRadius>
    <sys:Double x:Key="Stroke.Width.Default">1</sys:Double>
    <sys:Double x:Key="Stroke.Width.Focus">2</sys:Double>
    <Thickness x:Key="Stroke.Thickness.Default">1</Thickness>
    <Thickness x:Key="Stroke.Thickness.Focus">2</Thickness>
    <sys:Double x:Key="Control.Height.Compact">24</sys:Double>
    <sys:Double x:Key="Control.Height.Standard">32</sys:Double>
    <sys:Double x:Key="Control.Height.Large">40</sys:Double>
    <sys:Double x:Key="Button.MinWidth.Compact">64</sys:Double>
    <sys:Double x:Key="Button.MinWidth.Standard">96</sys:Double>
    <Thickness x:Key="Button.Padding.Compact">8,3</Thickness>
    <Thickness x:Key="Button.Padding.Standard">12,5</Thickness>
    <Thickness x:Key="Button.Padding.Large">16,8</Thickness>
    <sys:Double x:Key="DataGrid.HeaderHeight">32</sys:Double>
    <sys:Double x:Key="DataGrid.RowHeight">36</sys:Double>
    <Duration x:Key="Motion.Hover">0:0:0.12</Duration>
    <Duration x:Key="Motion.Press">0:0:0.09</Duration>
    <Duration x:Key="Motion.Surface">0:0:0.18</Duration>
    <DropShadowEffect x:Key="Elevation.1" po:Freeze="False"
                      BlurRadius="12"
                      ShadowDepth="2"
                      Opacity="0.24"
                      Direction="270"
                      Color="{StaticResource Elevation.Shadow.Color}" />
    <DropShadowEffect x:Key="Elevation.2" po:Freeze="False"
                      BlurRadius="20"
                      ShadowDepth="4"
                      Opacity="0.28"
                      Direction="270"
                      Color="{StaticResource Elevation.Shadow.Color}" />
    <DropShadowEffect x:Key="Elevation.3" po:Freeze="False"
                      BlurRadius="28"
                      ShadowDepth="8"
                      Opacity="0.32"
                      Direction="270"
                      Color="{StaticResource Elevation.Shadow.Color}" />

	<Style x:Key="ShellLayout" TargetType="FrameworkElement">
		<Setter Property="FlowDirection" Value="{DynamicResource App.ShellFlowDirection}" />
	</Style>

	<Style x:Key="FluentSurface.Card" TargetType="Border">
		<Setter Property="Background" Value="{DynamicResource Surface.Card}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
		<Setter Property="BorderThickness" Value="{StaticResource Stroke.Thickness.Default}" />
		<Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
		<Setter Property="Padding" Value="12" />
		<Setter Property="FlowDirection" Value="{DynamicResource App.ShellFlowDirection}" />
	</Style>

	<Style x:Key="LeftRailBorder" TargetType="Border" BasedOn="{StaticResource FluentSurface.Card}">
		<Setter Property="FlowDirection" Value="{DynamicResource App.ShellFlowDirection}" />
		<Setter Property="Background" Value="{DynamicResource Surface.Subtle}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
		<Setter Property="Padding" Value="12" />
		<Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
	</Style>

	<Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource FluentSurface.Card}">
		<Setter Property="FlowDirection" Value="{DynamicResource App.ShellFlowDirection}" />
		<Setter Property="Padding" Value="12" />
		<Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
	</Style>

	<Style x:Key="GameHeaderCard" TargetType="Border" BasedOn="{StaticResource FluentSurface.Card}">
		<Setter Property="Background" Value="{DynamicResource Surface.Card}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
		<Setter Property="FlowDirection" Value="{DynamicResource App.ShellFlowDirection}" />
		<Setter Property="Padding" Value="12" />
		<Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
	</Style>

	<Style x:Key="BottomBarBorder" TargetType="Border" BasedOn="{StaticResource FluentSurface.Card}">
		<Setter Property="Padding" Value="8" />
		<Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
	</Style>

	<Style x:Key="EmptyStatePanel" TargetType="Border">
		<Setter Property="FlowDirection" Value="{DynamicResource App.ShellFlowDirection}" />
		<Setter Property="Background" Value="{DynamicResource Surface.Subtle}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
		<Setter Property="Padding" Value="12" />
		<Setter Property="MinHeight" Value="96" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
	</Style>

	<Style x:Key="ViewportEmptyStatePanel" TargetType="Border" BasedOn="{StaticResource EmptyStatePanel}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="MinHeight" Value="128" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
	</Style>

	<Style x:Key="HeaderWarningBadge" TargetType="Border">
		<Setter Property="Width" Value="18" />
		<Setter Property="Height" Value="18" />
		<Setter Property="CornerRadius" Value="9" />
		<Setter Property="Background" Value="{DynamicResource Status.WarningSurface}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Status.Warning}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Margin" Value="0,4,10,0" />
		<Setter Property="VerticalAlignment" Value="Top" />
	</Style>

	<Style x:Key="StatusMetricPill" TargetType="Border">
		<Setter Property="Background" Value="{DynamicResource Surface.Card}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
		<Setter Property="Padding" Value="10,6" />
		<Setter Property="Margin" Value="4,0" />
		<Setter Property="MinHeight" Value="{StaticResource Control.Height.Standard}" />
		<Setter Property="MinWidth" Value="148" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style x:Key="GameRailItem" TargetType="ListBoxItem">
		<Setter Property="Padding" Value="0" />
		<Setter Property="Margin" Value="0,0,0,4" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ListBoxItem}">
					<Border x:Name="ItemRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{StaticResource Radius.Large}"
                            Padding="8"
                            SnapsToDevicePixels="True">
						<ContentPresenter />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Surface.CardHover}" />
							<Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Selection.Default}" />
							<Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource Accent.Default}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
							<Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Surface.CardPressed}" />
							<Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
							<Setter Property="Opacity" Value="0.55" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="ScrollLineButton" TargetType="RepeatButton">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RepeatButton">
					<Border Background="Transparent" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="DarkScrollThumb" TargetType="Thumb">
		<Setter Property="Background" Value="{DynamicResource Scroll.Thumb}" />
		<Setter Property="MinHeight" Value="42" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Thumb">
					<Border x:Name="Thumb"
                            Background="{TemplateBinding Background}"
							CornerRadius="{StaticResource Radius.Medium}"
                            Margin="2" />
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Thumb" Property="Background" Value="{DynamicResource Scroll.ThumbHover}" />
						</Trigger>
						<Trigger Property="IsDragging" Value="True">
							<Setter TargetName="Thumb" Property="Background" Value="{DynamicResource Accent.Default}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="DarkHorizontalScrollThumb"
           TargetType="Thumb"
           BasedOn="{StaticResource DarkScrollThumb}">
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="MinWidth" Value="42" />
	</Style>

	<ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
		<Border Width="8"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="{StaticResource Radius.Medium}">
			<Track x:Name="PART_Track" IsDirectionReversed="True">
				<Track.DecreaseRepeatButton>
					<RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollLineButton}" />
				</Track.DecreaseRepeatButton>
				<Track.Thumb>
					<Thumb Style="{StaticResource DarkScrollThumb}" />
				</Track.Thumb>
				<Track.IncreaseRepeatButton>
					<RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollLineButton}" />
				</Track.IncreaseRepeatButton>
			</Track>
		</Border>
	</ControlTemplate>

	<ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
		<Border Height="8"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="{StaticResource Radius.Medium}">
			<Track x:Name="PART_Track">
				<Track.DecreaseRepeatButton>
					<RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollLineButton}" />
				</Track.DecreaseRepeatButton>
				<Track.Thumb>
					<Thumb Style="{StaticResource DarkHorizontalScrollThumb}" />
				</Track.Thumb>
				<Track.IncreaseRepeatButton>
					<RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollLineButton}" />
				</Track.IncreaseRepeatButton>
			</Track>
		</Border>
	</ControlTemplate>

	<Style TargetType="{x:Type ScrollBar}">
		<Setter Property="Background" Value="{DynamicResource Scroll.Track}" />
		<Setter Property="Foreground" Value="{DynamicResource Scroll.Thumb}" />
		<Setter Property="Width" Value="8" />
		<Setter Property="MinWidth" Value="8" />
		<Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
		<Style.Triggers>
			<Trigger Property="Orientation" Value="Horizontal">
				<Setter Property="Height" Value="8" />
				<Setter Property="MinHeight" Value="8" />
				<Setter Property="Width" Value="Auto" />
				<Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style TargetType="Button">
		<Setter Property="MinHeight" Value="{StaticResource Control.Height.Standard}" />
		<Setter Property="MinWidth" Value="{StaticResource Button.MinWidth.Standard}" />
		<Setter Property="Padding" Value="{StaticResource Button.Padding.Standard}" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
		<Setter Property="Background" Value="{DynamicResource Surface.Subtle}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Stroke.Default}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FlowDirection" Value="{DynamicResource App.TextFlowDirection}" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Medium}"
                            Padding="{TemplateBinding Padding}">
						<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          FlowDirection="{TemplateBinding FlowDirection}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent.Default}" />
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.CardHover}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.CardPressed}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Stroke.Focus}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.CardPressed}" />
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
							<Setter Property="Cursor" Value="Arrow" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="FluentButton.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
		<Setter Property="Background" Value="{DynamicResource Accent.Default}" />
		<Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Accent.Default}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Chrome"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{StaticResource Radius.Medium}"
							Padding="{TemplateBinding Padding}">
						<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
										  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
										  FlowDirection="{TemplateBinding FlowDirection}"
										  TextElement.Foreground="{TemplateBinding Foreground}"
										  RecognizesAccessKey="True" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent.Hover}" />
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent.Pressed}" />
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent.Pressed}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Text.OnAccent}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.CardPressed}" />
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
							<Setter Property="Cursor" Value="Arrow" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="FluentButton.Icon" TargetType="Button">
		<Setter Property="Width" Value="40" />
		<Setter Property="Height" Value="32" />
		<Setter Property="MinWidth" Value="40" />
		<Setter Property="MinHeight" Value="{StaticResource Control.Height.Standard}" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FlowDirection" Value="LeftToRight" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{StaticResource Radius.Medium}"
                            SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{DynamicResource Surface.CardHover}" />
				<Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter Property="Background" Value="{DynamicResource Surface.CardPressed}" />
				<Setter Property="BorderBrush" Value="{DynamicResource Stroke.Default}" />
			</Trigger>
			<Trigger Property="IsKeyboardFocused" Value="True">
				<Setter Property="BorderBrush" Value="{DynamicResource Accent.Default}" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
				<Setter Property="Background" Value="{DynamicResource Surface.CardPressed}" />
				<Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
				<Setter Property="Opacity" Value="0.45" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="FluentButton.Close" TargetType="Button" BasedOn="{StaticResource FluentButton.Icon}">
		<Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{DynamicResource Status.DangerSurface}" />
				<Setter Property="BorderBrush" Value="{DynamicResource Status.Danger}" />
				<Setter Property="Foreground" Value="{DynamicResource Status.Danger}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter Property="Background" Value="{DynamicResource Status.DangerSurface}" />
				<Setter Property="BorderBrush" Value="{DynamicResource Status.Danger}" />
				<Setter Property="Foreground" Value="{DynamicResource Status.Danger}" />
			</Trigger>
			<Trigger Property="IsKeyboardFocused" Value="True">
				<Setter Property="BorderBrush" Value="{DynamicResource Status.Danger}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="GameFilterSurface" TargetType="Border">
		<Setter Property="Background" Value="{DynamicResource Surface.Card}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="FlowDirection" Value="LeftToRight" />
	</Style>

	<Style TargetType="TextBox">
		<Setter Property="MinHeight" Value="{StaticResource Control.Height.Standard}" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Padding" Value="8,4" />
		<Setter Property="Background" Value="{DynamicResource Surface.Subtle}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
		<Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
		<Setter Property="SelectionBrush" Value="{DynamicResource Accent.Default}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type TextBox}">
					<Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Medium}"
                            SnapsToDevicePixels="True">
						<ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsKeyboardFocusWithin" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Stroke.Focus}" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Stroke.Default}" />
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.CardHover}" />
						</Trigger>
						<Trigger Property="IsReadOnly" Value="True">
							<Setter Property="CaretBrush" Value="Transparent" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.CardPressed}" />
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type ComboBoxItem}">
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="Padding" Value="10,6" />
		<Setter Property="Margin" Value="3,1" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ComboBoxItem}">
					<Border x:Name="ItemRoot"
							Background="{TemplateBinding Background}"
							BorderBrush="Transparent"
							BorderThickness="1"
							CornerRadius="{StaticResource Radius.Medium}"
							Padding="{TemplateBinding Padding}"
							SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
										  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
										  TextElement.Foreground="{TemplateBinding Foreground}" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsHighlighted" Value="True">
							<Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Surface.CardHover}" />
							<Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource Stroke.Default}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
