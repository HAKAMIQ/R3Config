         The chip itself is direction-neutral; the value keeps its LTR order. -->
    <Style x:Key="IdentityChip"
           TargetType="{x:Type Border}">
        <Setter Property="Background"
                Value="{DynamicResource Surface.Subtle}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Stroke.Subtle}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="{StaticResource Radius.Pill}" />
        <Setter Property="Padding"
                Value="8,2" />
        <Setter Property="MinHeight"
                Value="{StaticResource Control.Height.Compact}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
    </Style>

    <Style x:Key="IdentityChipText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource R3TechnicalValueText}">
        <Setter Property="FontFamily"
                Value="{DynamicResource Type.Font.Technical}" />
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Secondary}" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="FluentButton.Secondary"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight"
                Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="Background"
                Value="{DynamicResource Surface.Subtle}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Stroke.Default}" />
    </Style>

    <Style x:Key="FluentButton.Subtle"
           TargetType="Button"
           BasedOn="{StaticResource FluentButton.Secondary}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
    </Style>

    <Style x:Key="FluentButton.Danger"
           TargetType="Button"
           BasedOn="{StaticResource FluentButton.Secondary}">
        <Setter Property="Foreground"
                Value="{DynamicResource Status.Danger}" />
        <Setter Property="Background"
                Value="{DynamicResource Status.DangerSurface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Status.Danger}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Medium}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          FlowDirection="{TemplateBinding FlowDirection}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="False">
                            <ContentPresenter.Resources>
                                <!-- The application-wide implicit TextBlock style sets
                                     Text.Primary, which outranks the inherited
                                     TextElement.Foreground above. The label must keep
                                     the button's own foreground (Status.Danger, or
                                     Text.Disabled when disabled). -->
                                <Style TargetType="{x:Type TextBlock}"
                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Chrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Stroke.Strong}" />
                            <Setter TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource Surface.CardHover}" />
                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource Surface.CardPressed}" />
                        </Trigger>


                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Text.Disabled}" />
                            <Setter TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource Surface.CardPressed}" />
                            <Setter TargetName="Chrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Stroke.Subtle}" />
                            <Setter Property="Cursor"
                                    Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentTextBox"
           TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight"
                Value="{StaticResource Control.Height.Standard}" />
    </Style>

    <Style x:Key="FluentTextBox.Localized"
           TargetType="TextBox"
           BasedOn="{StaticResource FluentTextBox}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="Language"
                Value="{DynamicResource App.XmlLanguage}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalContentAlignment"
                Value="{DynamicResource App.HorizontalAlignment}" />
    </Style>

    <Style x:Key="FluentTextBox.Technical"
           TargetType="TextBox"
           BasedOn="{StaticResource FluentTextBox}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource TechnicalText.FlowDirection}" />
        <Setter Property="Language"
                Value="{DynamicResource TechnicalText.Language}" />
        <Setter Property="NumberSubstitution.Substitution"
                Value="European" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource TechnicalText.TextAlignment}" />
        <Setter Property="HorizontalContentAlignment"
                Value="{DynamicResource TechnicalText.HorizontalAlignment}" />
        <Setter Property="SpellCheck.IsEnabled"
                Value="False" />
    </Style>

    <Style x:Key="FluentComboBox"
           TargetType="ComboBox"
           BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight"
                Value="{StaticResource Control.Height.Standard}" />
    </Style>

    <Style x:Key="FluentCheckBox"
           TargetType="CheckBox"
           BasedOn="{StaticResource {x:Type CheckBox}}" />

    <Style x:Key="FluentDataGridRow"
           TargetType="DataGridRow"
           BasedOn="{StaticResource {x:Type DataGridRow}}" />

    <Style x:Key="FluentDataGridHeader"
           TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" />

    <Style x:Key="FluentDataGridCell"
           TargetType="DataGridCell"
           BasedOn="{StaticResource {x:Type DataGridCell}}" />

    <Style x:Key="FluentDataGrid"
           TargetType="DataGrid"
           BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="RowStyle"
                Value="{StaticResource FluentDataGridRow}" />
        <Setter Property="ColumnHeaderStyle"
                Value="{StaticResource FluentDataGridHeader}" />
        <Setter Property="CellStyle"
                Value="{StaticResource FluentDataGridCell}" />
    </Style>

    <Style x:Key="FluentSurface.Subtle"
           TargetType="Border"
           BasedOn="{StaticResource FluentSurface.Card}">
        <Setter Property="Background"
                Value="{DynamicResource Surface.Subtle}" />
        <Setter Property="CornerRadius"
                Value="{StaticResource Radius.Medium}" />
        <Setter Property="Padding"
                Value="{StaticResource Space.12.All}" />
    </Style>

    <Style x:Key="FluentDialog.Flow"
           TargetType="FrameworkElement">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.ShellFlowDirection}" />
    </Style>

    <Style x:Key="FluentDialog.Title"
           TargetType="TextBlock"
           BasedOn="{StaticResource Type.Title}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="FluentDialog.Message"
           TargetType="TextBlock"
           BasedOn="{StaticResource Type.Body}">
        <Setter Property="Foreground"
                Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Margin"
                Value="0,8,0,0" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
    </Style>

    <Style x:Key="FluentDialog.Buttons"
           TargetType="StackPanel">
        <Setter Property="Orientation"
                Value="Horizontal" />
        <Setter Property="HorizontalAlignment"
                Value="{DynamicResource App.TrailingHorizontalAlignment}" />
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.ShellFlowDirection}" />
    </Style>

    <Style x:Key="FluentStatus.Text"
           TargetType="TextBlock"
           BasedOn="{StaticResource Type.Caption}">
        <Setter Property="FlowDirection"
                Value="{DynamicResource App.TextFlowDirection}" />
        <Setter Property="TextAlignment"
                Value="{DynamicResource App.TextAlignment}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="None" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />

        <Style.Triggers>
            <Trigger Property="Text"
                     Value="{x:Null}">
                <Setter Property="Visibility"
                        Value="Collapsed" />
            </Trigger>

            <Trigger Property="Text"
                     Value="">
                <Setter Property="Visibility"
                        Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
